DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOSTNAME=localhost
DB_DATABASE=ravner_dev
DB_POOL_SIZE=10

# =============================================================================
# API Keys for External Services
# =============================================================================
# 
# These can also be configured in the application at Admin > Settings.
# Settings have precedence over environment variables.
#
# All keys are encrypted at rest using Phoenix's secret_key_base.

# ProjectDiscovery Chaos API - Required for subdomain discovery
# Get yours at: https://cloud.projectdiscovery.io/
CHAOS_API_KEY=

# SecurityTrails API - Optional, for DNS intelligence (not currently used)
# Get yours at: https://securitytrails.com/
SECURITYTRAILS_API_KEY=

# Shodan API - Optional, for internet scanning (not currently used)
# Get yours at: https://www.shodan.io/
SHODAN_API_KEY=
