<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Uptime Monitor</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          30-day availability overview for all monitored domains.
        </p>
      </div>
      <%= if @current_scope.user.role in [:admin, :editor] do %>
        <.link
          navigate={~p"/admin/uptime/notifications"}
          class="px-4 py-2 text-xs font-medium border border-neutral-200 rounded-lg hover:bg-neutral-50 transition-colors dark:border-neutral-700 dark:hover:bg-neutral-800"
        >
          Manage Alerts
        </.link>
      <% end %>
    </div>

    <%!-- Summary stats --%>
    <div class="grid grid-cols-4 gap-4 mb-8">
      <div class="card-line p-4">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Monitored</p>
        <p class="text-2xl font-light">{length(@monitors)}</p>
      </div>
      <div class="card-line p-4">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Up</p>
        <p class="text-2xl font-light text-green-600">{@up_count}</p>
      </div>
      <div class="card-line p-4">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Down</p>
        <p class="text-2xl font-light text-red-600">{@down_count}</p>
      </div>
      <div class="card-line p-4">
        <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Avg Uptime</p>
        <p class={[
          "text-2xl font-light",
          @avg_uptime >= 99.9 && "text-green-600",
          @avg_uptime >= 99.0 && @avg_uptime < 99.9 && "text-yellow-600",
          @avg_uptime < 99.0 && "text-red-600"
        ]}>
          {@avg_uptime}%
        </p>
      </div>
    </div>

    <%!-- Domain list with uptime bars --%>
    <div class="space-y-3">
      <div
        :for={m <- @monitors}
        class="card-line !p-4 flex items-center gap-4 group"
      >
        <%!-- Status dot --%>
        <div class="shrink-0">
          <%= cond do %>
            <% m.status == :up -> %>
              <span class="inline-block w-3 h-3 rounded-full bg-green-500 shadow-sm shadow-green-500/30">
              </span>
            <% m.status == :down -> %>
              <span class="inline-block w-3 h-3 rounded-full bg-red-500 shadow-sm shadow-red-500/30 animate-pulse">
              </span>
            <% true -> %>
              <span class="inline-block w-3 h-3 rounded-full bg-yellow-500 shadow-sm shadow-yellow-500/30">
              </span>
          <% end %>
        </div>

        <%!-- Domain info --%>
        <div class="w-48 shrink-0">
          <.link navigate={~p"/uptime/#{m.domain.id}"} class="font-medium text-sm hover:underline">
            {m.domain.name}
          </.link>
          <p class="text-[11px] text-neutral-400 mt-0.5">
            <%= if m.meta.last_heartbeat_at do %>
              Last: {Calendar.strftime(m.meta.last_heartbeat_at, "%H:%M:%S")}
            <% else %>
              No checks yet
            <% end %>
          </p>
        </div>

        <%!-- Uptime bar (the dominant visual) --%>
        <div class="flex-1 min-w-0">
          <RavnerWeb.UptimeComponents.uptime_bar days={m.bar_data} />
        </div>

        <%!-- Uptime percentage --%>
        <div class="w-20 text-right shrink-0">
          <span class={[
            "text-sm font-medium",
            m.uptime_percent >= 99.9 && "text-green-600",
            m.uptime_percent >= 99.0 && m.uptime_percent < 99.9 && "text-yellow-600",
            m.uptime_percent < 99.0 && "text-red-600"
          ]}>
            {m.uptime_percent}%
          </span>
        </div>

        <%!-- Active scans + interval --%>
        <div class="w-40 text-right shrink-0 flex items-center justify-end gap-1.5 flex-wrap">
          <%= if m.active_scans != [] do %>
            <span
              :for={scan <- m.active_scans}
              class="inline-flex px-1 py-0.5 text-[9px] uppercase tracking-wide rounded-sm font-medium bg-neutral-50 text-neutral-400 dark:bg-neutral-800 dark:text-neutral-500"
            >
              {scan}
            </span>
          <% end %>
          <span class="inline-flex px-1.5 py-0.5 text-[10px] uppercase tracking-wide rounded-sm font-medium bg-blue-50 text-blue-600 dark:bg-blue-900/30 dark:text-blue-400">
            {m.meta.heartbeat_interval_minutes}m
          </span>
        </div>
      </div>
    </div>

    <%!-- Empty state --%>
    <%= if @monitors == [] do %>
      <div class="card-line p-12 text-center">
        <p class="text-neutral-500 text-sm">No domains are configured for uptime monitoring.</p>
        <p class="text-neutral-400 text-xs mt-1">
          Set a heartbeat interval on any domain to start monitoring.
        </p>
      </div>
    <% end %>
  </div>
</Layouts.app>
