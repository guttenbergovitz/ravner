<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="mb-8">
      <%!-- Breadcrumb — for subdomains shows parent chain, for root domains simple back link --%>
      <%= if @domain.parent_domain do %>
        <nav class="flex items-center gap-1 text-xs font-light text-neutral-500 mb-4">
          <.link
            navigate={~p"/domains"}
            class="hover:text-neutral-900 transition-colors"
          >
            Domains
          </.link>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/domains/#{@domain.parent_domain.id}"}
            class="hover:text-neutral-900 transition-colors"
          >
            {@domain.parent_domain.name}
          </.link>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <span class="text-neutral-900">{@domain.name}</span>
        </nav>
      <% else %>
        <.link
          navigate={~p"/domains"}
          class="text-xs font-light text-neutral-500 hover:text-neutral-900 transition-colors mb-4 inline-flex items-center gap-1"
        >
          <.icon name="hero-arrow-left" class="w-3 h-3" /> Back to domains
        </.link>
      <% end %>

      <div class="flex items-center gap-3 mt-4">
        <div
          class={lifecycle_dot_class(@domain.lifecycle_state)}
          title={@domain.lifecycle_state |> Atom.to_string() |> String.replace("_", " ")}
        >
        </div>
        <.technical_status_indicator status={@domain.technical_status} variant={:icon} />
        <h1 class="text-2xl font-light tracking-tight">{@domain.name}</h1>
        <span class="text-xs font-light text-neutral-400 uppercase tracking-wide">
          {@domain.type}
        </span>
      </div>

      <.severity_badges counts={@severity_counts} />
    </div>

    <%!-- Tab Navigation --%>
    <div class="border-b border-neutral-200 dark:border-neutral-800 mb-6 flex items-center justify-between">
      <div class="flex items-center gap-1 overflow-x-auto text-xs" id="domain-tab-nav">
        <.link
          patch={~p"/domains/#{@domain.id}?tab=technical"}
          id="tab-technical"
          class={[
            "px-3 py-2.5 font-medium border-b-2 transition-colors inline-flex items-center gap-1.5 whitespace-nowrap",
            @active_tab == :technical &&
              "border-neutral-900 text-neutral-900 font-semibold dark:border-white dark:text-white",
            @active_tab != :technical &&
              "border-transparent text-neutral-500 hover:text-neutral-800 hover:border-neutral-300 dark:text-neutral-400 dark:hover:text-neutral-200"
          ]}
        >
          <.icon name="hero-cpu-chip" class="w-4 h-4" /> Technical Overview
        </.link>
        <.link
          patch={~p"/domains/#{@domain.id}?tab=governance"}
          id="tab-governance"
          class={[
            "px-3 py-2.5 font-medium border-b-2 transition-colors inline-flex items-center gap-1.5 whitespace-nowrap",
            @active_tab == :governance &&
              "border-neutral-900 text-neutral-900 font-semibold dark:border-white dark:text-white",
            @active_tab != :governance &&
              "border-transparent text-neutral-500 hover:text-neutral-800 hover:border-neutral-300 dark:text-neutral-400 dark:hover:text-neutral-200"
          ]}
        >
          <.icon name="hero-user-group" class="w-4 h-4" /> Ownership & Governance
        </.link>
        <.link
          patch={~p"/domains/#{@domain.id}?tab=audit"}
          id="tab-audit"
          class={[
            "px-3 py-2.5 font-medium border-b-2 transition-colors inline-flex items-center gap-1.5 whitespace-nowrap",
            @active_tab == :audit &&
              "border-neutral-900 text-neutral-900 font-semibold dark:border-white dark:text-white",
            @active_tab != :audit &&
              "border-transparent text-neutral-500 hover:text-neutral-800 hover:border-neutral-300 dark:text-neutral-400 dark:hover:text-neutral-200"
          ]}
        >
          <.icon name="hero-clock" class="w-4 h-4" /> Audit Trail
          <%= if @versions != [] do %>
            <span class={[
              "text-[10px] px-1.5 py-0.2 rounded-full",
              @active_tab == :audit &&
                "bg-neutral-900 text-white dark:bg-white dark:text-neutral-900",
              @active_tab != :audit &&
                "bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300"
            ]}>
              {length(@versions)}
            </span>
          <% end %>
        </.link>
      </div>

      <div class="hidden sm:flex items-center gap-3 text-xs font-light text-neutral-400">
        <.link
          navigate={~p"/domains/#{@domain.id}/security"}
          class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors inline-flex items-center gap-1"
        >
          <.icon name="hero-shield-check" class="w-3.5 h-3.5" /> Security Report
        </.link>
        <span>·</span>
        <.link
          navigate={~p"/domains/#{@domain.id}/a11y"}
          class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors inline-flex items-center gap-1"
        >
          <.icon name="hero-eye" class="w-3.5 h-3.5" /> A11y Report
        </.link>
        <span>·</span>
        <.link
          navigate={~p"/domains/#{@domain.id}/lighthouse"}
          class="hover:text-neutral-900 dark:hover:text-neutral-100 transition-colors inline-flex items-center gap-1"
        >
          <.icon name="hero-bolt" class="w-3.5 h-3.5" /> PageSpeed
        </.link>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <%= case @active_tab do %>
          <% :technical -> %>
            <.domain_technical_tab
              domain={@domain}
              domain_class={@domain_class}
              current_scope={@current_scope}
              can_manage?={@can_manage?}
              can_scan?={@can_scan?}
              escalation_chain={@escalation_chain}
              primary_repo={@primary_repo}
              domain_repos={@domain_repos}
              project_repos={@project_repos}
            />
          <% :governance -> %>
            <.domain_governance_tab
              domain={@domain}
              can_manage?={@can_manage?}
              brands={@brands}
              orgs={@orgs}
              projects={@projects}
              primary_repo={@primary_repo}
              pm_person={@pm_person}
              po_person={@po_person}
              escalation_chain={@escalation_chain}
            />
          <% :audit -> %>
            <.governance_audit_trail
              versions={@versions}
              brands={@brands}
              orgs={@orgs}
              projects={@projects}
            />
        <% end %>
      </div>

      <div class="space-y-6">
        <.live_component
          module={RavnerWeb.DomainLive.ScanPanel}
          id="domain-scan-panel"
          domain={@domain}
          scanning={@scanning}
          active_scan_kind={@active_scan_kind}
          running_security_scan={@running_security_scan}
          can_scan?={@can_scan?}
          can_manage?={@can_manage?}
          current_scope={@current_scope}
          a11y_scannable?={@a11y_scannable?}
          a11y_running?={@a11y_running?}
          a11y_scan={@a11y_scan}
          lighthouse_running?={@lighthouse_running?}
          lighthouse_scan={@lighthouse_scan}
        >
          <.live_component
            module={RavnerWeb.DomainLive.SecurityPostureComponent}
            id="security-posture"
            domain={@domain}
            current_scope={@current_scope}
            scanning={@scanning}
            running_security_scan={@running_security_scan}
            latest_security_scan={@latest_security_scan}
            latest_breach_scan={@latest_breach_scan}
            latest_failed_security_scan={@latest_failed_security_scan}
          />
        </.live_component>

        <div class="card-line">
          <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Tags</h2>
          <%= if @domain.domain_tags == [] do %>
            <p class="text-sm font-light text-neutral-400">No tags</p>
          <% else %>
            <div class="flex flex-wrap gap-2">
              <%= for tag <- @domain.domain_tags do %>
                <span class="px-2 py-0.5 border border-neutral-200 text-neutral-500 text-[10px] uppercase tracking-wide">
                  {tag.tag}
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%= if @domain.subdomains != [] do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Subdomains</h2>
            <div class="space-y-2">
              <%= for sub <- @domain.subdomains do %>
                <.link
                  navigate={~p"/domains/#{sub.id}"}
                  class="text-sm font-light hover:underline block"
                >
                  {sub.name}
                </.link>
              <% end %>
            </div>

            <div
              :if={@domain.domain_metadata && @domain.domain_metadata.subdomains_scanned_at}
              class="mt-4 pt-4 border-t border-neutral-100"
            >
              <span class="text-[10px] font-light text-neutral-400">
                Scanned {DateTime.to_iso8601(@domain.domain_metadata.subdomains_scanned_at)}
              </span>
            </div>
          </div>
        <% end %>

        <%= if @domain.parent_domain do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Parent Domain</h2>
            <.link
              navigate={~p"/domains/#{@domain.parent_domain.id}"}
              class="text-sm font-light hover:underline"
            >
              {@domain.parent_domain.name}
            </.link>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <%= if @show_contacts_modal do %>
    <.live_component
      module={RavnerWeb.DomainLive.ContactsModal}
      id="contacts-modal-component"
      domain={@domain}
      current_scope={@current_scope}
    />
  <% end %>
</Layouts.app>
