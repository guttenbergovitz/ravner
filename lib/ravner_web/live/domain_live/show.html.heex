<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="mb-8">
      <%!-- Breadcrumb — for subdomains shows parent chain, for root domains simple back link --%>
      <%= if @domain.parent_domain do %>
        <nav class="flex items-center gap-1 text-xs font-light text-neutral-500 mb-4">
          <.link
            navigate={~p"/domains"}
            class="hover:text-neutral-900 transition-colors"
          >
            Domains
          </.link>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/domains/#{@domain.parent_domain.id}"}
            class="hover:text-neutral-900 transition-colors"
          >
            {@domain.parent_domain.name}
          </.link>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <span class="text-neutral-900">{@domain.name}</span>
        </nav>
      <% else %>
        <.link
          navigate={~p"/domains"}
          class="text-xs font-light text-neutral-500 hover:text-neutral-900 transition-colors mb-4 inline-flex items-center gap-1"
        >
          <.icon name="hero-arrow-left" class="w-3 h-3" /> Back to domains
        </.link>
      <% end %>

      <div class="flex items-center gap-3 mt-4">
        <div
          class={["w-3 h-3 rounded-full", lifecycle_color(@domain.lifecycle_state)]}
          title={@domain.lifecycle_state}
        >
        </div>
        <h1 class="text-2xl font-light tracking-tight">{@domain.name}</h1>
        <span class="text-xs font-light text-neutral-400 uppercase tracking-wide">
          {@domain.type}
        </span>
      </div>

      <div id="severity-badges" class="flex gap-1.5 items-center mt-3">
        <%= for {label, count, color} <- severity_badges(@severity_counts) do %>
          <span class={[
            "text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded-sm font-medium",
            if(count > 0, do: color, else: "bg-neutral-50 text-neutral-300")
          ]}>
            {count} {label}
          </span>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="card-line">
          <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Details</h2>
          <div class="grid grid-cols-2 gap-6 text-sm">
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                URL
              </span>
              <span :if={@domain.url} class="font-light">{@domain.url}</span>
              <span :if={!@domain.url} class="text-neutral-400 font-light">—</span>
            </div>
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                Status
              </span>
              <%= case @domain_class do %>
                <% {:ok, _} -> %>
                  <span class="inline-flex items-center gap-1.5 text-green-700 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500 shrink-0"></span>200 OK
                  </span>
                <% {:external_redirect, target} -> %>
                  <span class="inline-flex items-center gap-1.5 text-yellow-700 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 shrink-0"></span>
                    EXT → {target}
                  </span>
                <% {:redirect, target} -> %>
                  <span class="inline-flex items-center gap-1.5 text-yellow-600 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-yellow-400 shrink-0"></span>
                    Redirect → {target}
                  </span>
                <% {:client_error, code} -> %>
                  <span class="inline-flex items-center gap-1.5 text-orange-700 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-orange-500 shrink-0"></span>
                    {code} Client error
                  </span>
                <% {:server_error, code} -> %>
                  <span class="inline-flex items-center gap-1.5 text-red-700 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
                    {code} Server error
                  </span>
                <% {:other, code} -> %>
                  <span class="inline-flex items-center gap-1.5 text-neutral-500 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-neutral-400 shrink-0"></span>
                    HTTP {code}
                  </span>
                <% {:scan_error, _} -> %>
                  <span class="inline-flex items-center gap-1.5 text-red-600 font-light">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span> Scan error
                  </span>
                <% {:not_scanned, _} -> %>
                  <span class="text-neutral-400 font-light">not scanned</span>
              <% end %>
            </div>
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                Lifecycle
              </span>
              <div class="relative" id="lifecycle-menu-show">
                <button
                  phx-click="toggle_lifecycle_menu"
                  class="inline-flex items-center gap-2 font-light hover:opacity-70 transition-opacity cursor-pointer"
                >
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    lifecycle_color(@domain.lifecycle_state)
                  ]}>
                  </span>
                  <span class="capitalize">
                    {@domain.lifecycle_state |> Atom.to_string() |> String.replace("_", " ")}
                  </span>
                  <.icon name="hero-chevron-down" class="w-3 h-3 text-neutral-400" />
                </button>
                <%= if @lifecycle_menu_open do %>
                  <div
                    class="absolute left-0 top-7 z-50 bg-white border border-neutral-200 rounded-lg shadow-lg py-1 min-w-[170px]"
                    phx-click-away="close_lifecycle_menu"
                  >
                    <%= for {state, label, color} <- lifecycle_options() do %>
                      <button
                        phx-click="set_lifecycle"
                        phx-value-state={state}
                        class={[
                          "w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-neutral-50 transition-colors",
                          @domain.lifecycle_state == state && "font-medium"
                        ]}
                      >
                        <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
                        {label}
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                Brand
              </span>
              <form phx-change="set_brand" id="brand-select-form">
                <select
                  name="brand_id"
                  class="w-full px-2 py-1.5 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 focus:outline-none focus:border-neutral-500 transition-colors"
                >
                  <option value="">—</option>
                  <%= for b <- @brands do %>
                    <option value={b.id} selected={@domain.brand_id == b.id}>
                      {b.display_name || b.name}
                    </option>
                  <% end %>
                </select>
              </form>
            </div>
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                Organization
              </span>
              <form phx-change="set_organization" id="org-select-form">
                <select
                  name="organization_id"
                  class="w-full px-2 py-1.5 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 focus:outline-none focus:border-neutral-500 transition-colors"
                >
                  <option value="">—</option>
                  <%= for o <- @orgs do %>
                    <%= if !@domain.brand_id || o.brand_id == @domain.brand_id do %>
                      <option value={o.id} selected={@domain.organization_id == o.id}>
                        {o.display_name || o.name}
                      </option>
                    <% end %>
                  <% end %>
                </select>
              </form>
            </div>
            <% filtered_projects =
              Enum.filter(@projects, fn p ->
                !@domain.organization_id || p.organization_id == @domain.organization_id
              end) %>
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                Project
              </span>
              <form phx-change="set_project" id="project-select-form">
                <select
                  name="project_id"
                  class={[
                    "w-full px-2 py-1.5 border bg-transparent text-sm font-light focus:outline-none focus:border-neutral-500 transition-colors",
                    if(filtered_projects == [],
                      do: "border-neutral-100 text-neutral-300 cursor-not-allowed",
                      else: "border-neutral-200 text-neutral-900"
                    )
                  ]}
                  disabled={filtered_projects == []}
                >
                  <option value="">—</option>
                  <%= for p <- filtered_projects do %>
                    <option value={p.id} selected={@domain.project_id == p.id}>
                      {p.name}
                    </option>
                  <% end %>
                </select>
              </form>
              <%= if filtered_projects == [] do %>
                <p class="text-[10px] text-neutral-300 mt-0.5">No projects for selected org</p>
              <% end %>
            </div>
            <div>
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                Repository
              </span>
              <span :if={@domain.repository_url} class="font-light">
                {@domain.repository_url}
              </span>
              <span :if={!@domain.repository_url} class="text-neutral-400 font-light">—</span>
            </div>
          </div>
        </div>

        <%= if @domain.domain_metadata do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">HTTP</h2>
            <div class="grid grid-cols-2 gap-6 text-sm">
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Status
                </span>
                <span :if={@domain.domain_metadata.http_status} class="font-light">
                  {@domain.domain_metadata.http_status}
                </span>
                <span
                  :if={!@domain.domain_metadata.http_status}
                  class="text-neutral-400 font-light"
                >
                  —
                </span>
              </div>
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Server
                </span>
                <span :if={@domain.domain_metadata.server_header} class="font-light">
                  {@domain.domain_metadata.server_header}
                </span>
                <span
                  :if={!@domain.domain_metadata.server_header}
                  class="text-neutral-400 font-light"
                >
                  —
                </span>
              </div>
            </div>

            <div class="mt-4">
              <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                Final URL
              </span>
              <a
                :if={@domain.domain_metadata.final_url}
                href={@domain.domain_metadata.final_url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-light break-all hover:underline inline-flex items-start gap-1.5 group"
              >
                <span>{@domain.domain_metadata.final_url}</span>
                <.icon
                  name="hero-arrow-top-right-on-square"
                  class="w-3.5 h-3.5 shrink-0 mt-0.5 text-neutral-400 group-hover:text-neutral-700 transition-colors"
                />
              </a>
              <span
                :if={!@domain.domain_metadata.final_url}
                class="text-sm font-light text-neutral-400"
              >
                —
              </span>
            </div>

            <%= if @domain.domain_metadata.redirect_chain && @domain.domain_metadata.redirect_chain != [] do %>
              <div class="mt-6 border-t border-neutral-100 pt-4">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-3">
                  Redirect Chain
                </span>
                <div class="space-y-2">
                  <%= for {hop, idx} <- Enum.with_index(@domain.domain_metadata.redirect_chain) do %>
                    <% is_last = idx == length(@domain.domain_metadata.redirect_chain) - 1 %>
                    <div class="flex items-center gap-3 text-sm font-light">
                      <span class={[
                        "px-2 py-0.5 text-[10px] font-normal uppercase tracking-wide shrink-0",
                        if(hop["status"] >= 300 && hop["status"] < 400,
                          do: "text-yellow-700 bg-yellow-50 border border-yellow-200",
                          else: "text-neutral-500 bg-neutral-50 border border-neutral-200"
                        )
                      ]}>
                        {hop["status"]}
                      </span>
                      <%= if is_last do %>
                        <a
                          href={hop["url"]}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="truncate hover:underline inline-flex items-center gap-1 group"
                        >
                          <span class="truncate">{hop["url"]}</span>
                          <.icon
                            name="hero-arrow-top-right-on-square"
                            class="w-3 h-3 shrink-0 text-neutral-400 group-hover:text-neutral-700 transition-colors"
                          />
                        </a>
                      <% else %>
                        <span class="truncate text-neutral-500">{hop["url"]}</span>
                        <.icon
                          name="hero-arrow-down-right"
                          class="w-3 h-3 shrink-0 text-neutral-300"
                        />
                      <% end %>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.security_headers && @domain.domain_metadata.security_headers != %{} do %>
              <div class="mt-6 border-t border-neutral-100 pt-4">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-3">
                  Security Headers
                </span>
                <div class="space-y-1">
                  <%= for {key, val} <- @domain.domain_metadata.security_headers do %>
                    <div class="flex justify-between text-xs font-light">
                      <span class="text-neutral-500">{key}</span>
                      <span :if={val} class="text-green-700 ml-2">✓</span>
                      <span :if={!val} class="text-neutral-400 ml-2">—</span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div
              :if={@domain.domain_metadata.http_scanned_at}
              class="mt-4 pt-4 border-t border-neutral-100"
            >
              <span class="text-[10px] font-light text-neutral-400">
                Scanned {DateTime.to_iso8601(@domain.domain_metadata.http_scanned_at)}
              </span>
            </div>
          </div>

          <div :if={@domain.domain_metadata.ssl_valid_until} class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6 flex items-center justify-between">
              SSL Certificate <% expiring_soon =
                @domain.domain_metadata.ssl_days_remaining != nil &&
                  @domain.domain_metadata.ssl_days_remaining <= 14 %>
              <% expired =
                @domain.domain_metadata.ssl_days_remaining != nil &&
                  @domain.domain_metadata.ssl_days_remaining < 0 %>
              <span class={[
                "text-[10px] font-normal px-2 py-0.5 border uppercase tracking-wider",
                expired && "text-red-700 bg-red-50 border-red-200",
                expiring_soon && !expired && "text-amber-700 bg-amber-50 border-amber-200",
                !expiring_soon && "text-green-700 bg-green-50 border-green-200"
              ]}>
                <%= if expired do %>
                  Expired
                <% else %>
                  {@domain.domain_metadata.ssl_days_remaining} days left
                <% end %>
              </span>
            </h2>

            <div class="space-y-4 text-sm font-light">
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Subject
                </span>
                <span class="break-all font-mono text-xs">
                  {@domain.domain_metadata.ssl_subject}
                </span>
              </div>

              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Issuer
                </span>
                <span class="break-all">
                  {@domain.domain_metadata.ssl_issuer}
                </span>
              </div>

              <div class="grid grid-cols-2 gap-6">
                <div>
                  <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                    Valid From
                  </span>
                  <span :if={@domain.domain_metadata.ssl_valid_from}>
                    {Calendar.strftime(@domain.domain_metadata.ssl_valid_from, "%Y-%m-%d")}
                  </span>
                </div>
                <div>
                  <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                    Valid Until
                  </span>
                  <span :if={@domain.domain_metadata.ssl_valid_until}>
                    {Calendar.strftime(@domain.domain_metadata.ssl_valid_until, "%Y-%m-%d")}
                  </span>
                </div>
              </div>
            </div>
          </div>
        <% end %>

        <%= if @domain.domain_metadata && (@domain.domain_metadata.ip_v4 != [] || @domain.domain_metadata.ip_v6 != [] || @domain.domain_metadata.dns_records != []) do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">DNS</h2>

            <%= if @domain.domain_metadata.ip_v4 != [] do %>
              <div class="mb-4">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                  IPv4
                </span>
                <div class="flex flex-wrap gap-2">
                  <%= for ip <- @domain.domain_metadata.ip_v4 do %>
                    <span class="px-2 py-0.5 border border-neutral-200 text-xs font-mono font-light">
                      {ip}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.ip_v6 != [] do %>
              <div class="mb-4">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                  IPv6
                </span>
                <div class="flex flex-wrap gap-2">
                  <%= for ip <- @domain.domain_metadata.ip_v6 do %>
                    <span class="px-2 py-0.5 border border-neutral-200 text-xs font-mono font-light">
                      {ip}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.dns_records != [] do %>
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                  Records
                </span>
                <div class="divide-y divide-neutral-100">
                  <%= for rec <- @domain.domain_metadata.dns_records do %>
                    <div class="py-2 flex items-center gap-3 text-sm font-light">
                      <span class="px-1.5 py-0.5 border border-neutral-200 text-[10px] font-normal uppercase w-12 text-center">
                        {rec["type"]}
                      </span>
                      <span class="truncate">{rec["value"]}</span>
                      <span class="ml-auto text-[10px] text-neutral-400">TTL:{rec["ttl"]}</span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div
              :if={@domain.domain_metadata.dns_scanned_at}
              class="mt-4 pt-4 border-t border-neutral-100"
            >
              <span class="text-[10px] font-light text-neutral-400">
                Scanned {DateTime.to_iso8601(@domain.domain_metadata.dns_scanned_at)}
              </span>
            </div>
          </div>
        <% end %>

        <%= if infrastructure_metadata?(@domain.domain_metadata) do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Infrastructure</h2>
            <div class="grid grid-cols-2 gap-6 text-sm">
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Hosting
                </span>
                <span :if={@domain.domain_metadata.hosting_platform} class="font-light">
                  {@domain.domain_metadata.hosting_platform}
                </span>
                <span
                  :if={!@domain.domain_metadata.hosting_platform}
                  class="text-neutral-400 font-light"
                >
                  —
                </span>
              </div>
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  ASN
                </span>
                <%= if @domain.domain_metadata.asn_org || @domain.domain_metadata.asn_number do %>
                  <span class="font-light">
                    <%= if @domain.domain_metadata.asn_number do %>
                      <span class="font-mono text-xs text-neutral-500">
                        {@domain.domain_metadata.asn_number}
                      </span>
                      {" "}
                    <% end %>
                    {@domain.domain_metadata.asn_org}
                  </span>
                <% else %>
                  <span class="text-neutral-400 font-light">—</span>
                <% end %>
              </div>
            </div>

            <%= if @domain.domain_metadata.tech_stack && @domain.domain_metadata.tech_stack != [] do %>
              <div class="mt-4">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                  Tech Stack
                </span>
                <div class="flex flex-wrap gap-2">
                  <%= for tech <- @domain.domain_metadata.tech_stack do %>
                    <span class="px-2 py-0.5 border border-neutral-200 text-xs font-light">
                      {tech}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.tech_evidence && @domain.domain_metadata.tech_evidence != [] do %>
              <div class="mt-6 pt-5 border-t border-neutral-100">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-3">
                  Deep Tech Evidence
                </span>
                <div class="space-y-2">
                  <%= for item <- Enum.take(@domain.domain_metadata.tech_evidence, 12) do %>
                    <div class="flex items-center justify-between gap-3 text-xs">
                      <div class="min-w-0">
                        <span class="font-light text-neutral-900">{item["name"]}</span>
                        <span :if={item["version"]} class="font-mono text-[10px] text-neutral-400">
                          {item["version"]}
                        </span>
                        <p
                          :if={item["categories"] && item["categories"] != []}
                          class="text-[10px] text-neutral-400 truncate"
                        >
                          {Enum.join(item["categories"], ", ")}
                        </p>
                      </div>
                      <span class="shrink-0 text-[10px] uppercase tracking-wide text-neutral-400">
                        {item["source"] || "scan"}
                      </span>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.discovered_urls && @domain.domain_metadata.discovered_urls != [] do %>
              <div class="mt-6 pt-5 border-t border-neutral-100">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <span class="text-xs font-light tracking-wide uppercase text-neutral-500">
                    Crawled URLs
                  </span>
                  <span class="text-[10px] text-neutral-400">
                    {length(@domain.domain_metadata.discovered_urls)}
                  </span>
                </div>
                <div class="space-y-1.5">
                  <%= for item <- Enum.take(@domain.domain_metadata.discovered_urls, 10) do %>
                    <a
                      href={item["url"]}
                      target="_blank"
                      rel="noreferrer"
                      class="group flex items-center gap-2 text-xs font-light text-neutral-600 hover:text-neutral-950"
                    >
                      <span class="truncate">{item["url"]}</span>
                      <.icon
                        name="hero-arrow-top-right-on-square"
                        class="w-3 h-3 shrink-0 opacity-40 group-hover:opacity-100"
                      />
                    </a>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.js_assets && @domain.domain_metadata.js_assets != [] do %>
              <div class="mt-6 pt-5 border-t border-neutral-100">
                <div class="flex items-center justify-between gap-3 mb-3">
                  <span class="text-xs font-light tracking-wide uppercase text-neutral-500">
                    JavaScript Assets
                  </span>
                  <span class="text-[10px] text-neutral-400">
                    {length(@domain.domain_metadata.js_assets)}
                  </span>
                </div>
                <div class="space-y-1.5">
                  <%= for url <- Enum.take(@domain.domain_metadata.js_assets, 8) do %>
                    <a
                      href={url}
                      target="_blank"
                      rel="noreferrer"
                      class="group flex items-center gap-2 text-xs font-light text-neutral-600 hover:text-neutral-950"
                    >
                      <span class="truncate">{url}</span>
                      <.icon
                        name="hero-arrow-top-right-on-square"
                        class="w-3 h-3 shrink-0 opacity-40 group-hover:opacity-100"
                      />
                    </a>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.deep_scan_errors && @domain.domain_metadata.deep_scan_errors != [] do %>
              <div class="mt-6 pt-5 border-t border-neutral-100">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                  Tool Warnings
                </span>
                <div class="space-y-1">
                  <%= for warning <- @domain.domain_metadata.deep_scan_errors do %>
                    <p class="text-xs font-light text-amber-700">{warning}</p>
                  <% end %>
                </div>
              </div>
            <% end %>

            <%= if @domain.domain_metadata.open_ports && @domain.domain_metadata.open_ports != [] do %>
              <div class="mt-4">
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-2">
                  Open Ports
                </span>
                <div class="flex flex-wrap gap-1">
                  <%= for port <- @domain.domain_metadata.open_ports do %>
                    <span class="text-[11px] font-mono px-1.5 py-0.5 border border-neutral-200 text-neutral-600 rounded-sm">
                      {port}
                    </span>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div
              :if={@domain.domain_metadata.deep_tech_scanned_at}
              class="mt-4 pt-4 border-t border-neutral-100"
            >
              <span class="text-[10px] font-light text-neutral-400">
                Deep scanned {DateTime.to_iso8601(@domain.domain_metadata.deep_tech_scanned_at)}
              </span>
            </div>
          </div>
        <% end %>

        <%= if @domain.domain_metadata && (@domain.domain_metadata.registrar || @domain.domain_metadata.registration_date || @domain.domain_metadata.expiration_date || @domain.domain_metadata.registrant_org) do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Registration</h2>
            <div class="grid grid-cols-2 gap-6 text-sm">
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Registrar
                </span>
                <span :if={@domain.domain_metadata.registrar} class="font-light">
                  {@domain.domain_metadata.registrar}
                </span>
                <span :if={!@domain.domain_metadata.registrar} class="text-neutral-400 font-light">
                  —
                </span>
              </div>
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Registrant
                </span>
                <span :if={@domain.domain_metadata.registrant_org} class="font-light">
                  {@domain.domain_metadata.registrant_org}
                </span>
                <span
                  :if={!@domain.domain_metadata.registrant_org}
                  class="text-neutral-400 font-light"
                >
                  —
                </span>
              </div>
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Registered
                </span>
                <span
                  :if={@domain.domain_metadata.registration_date}
                  class="font-light font-mono text-xs"
                >
                  {DateTime.to_iso8601(@domain.domain_metadata.registration_date)}
                </span>
                <span
                  :if={!@domain.domain_metadata.registration_date}
                  class="text-neutral-400 font-light"
                >
                  —
                </span>
              </div>
              <div>
                <span class="text-xs font-light tracking-wide uppercase text-neutral-500 block mb-1">
                  Expires
                </span>
                <span
                  :if={@domain.domain_metadata.expiration_date}
                  class="font-light font-mono text-xs"
                >
                  {DateTime.to_iso8601(@domain.domain_metadata.expiration_date)}
                </span>
                <span
                  :if={!@domain.domain_metadata.expiration_date}
                  class="text-neutral-400 font-light"
                >
                  —
                </span>
              </div>
            </div>

            <%= if @domain.domain_metadata.contacts && map_size(@domain.domain_metadata.contacts) > 0 do %>
              <div class="mt-6 pt-6 border-t border-neutral-100">
                <h3 class="text-xs font-normal tracking-wide uppercase text-neutral-600 mb-4">
                  Contacts
                </h3>
                <div class="space-y-3">
                  <%= for {role, contact} <- @domain.domain_metadata.contacts do %>
                    <div class="text-sm">
                      <p class="text-xs uppercase tracking-wide text-neutral-400 mb-1">
                        {String.capitalize(role)}
                      </p>
                      <div class="space-y-0.5 text-xs font-light">
                        <%= if contact["name"] do %>
                          <p class="text-neutral-700">{contact["name"]}</p>
                        <% end %>
                        <%= if contact["email"] do %>
                          <p class="text-neutral-500">{contact["email"]}</p>
                        <% end %>
                        <%= if contact["phone"] do %>
                          <p class="text-neutral-500">{contact["phone"]}</p>
                        <% end %>
                        <%= if !contact["name"] && !contact["email"] && !contact["phone"] do %>
                          <p class="text-neutral-400">—</p>
                        <% end %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

            <div
              :if={@domain.domain_metadata.rdap_scanned_at}
              class="mt-4 pt-4 border-t border-neutral-100"
            >
              <span class="text-[10px] font-light text-neutral-400">
                Scanned {DateTime.to_iso8601(@domain.domain_metadata.rdap_scanned_at)}
              </span>
            </div>
          </div>
        <% end %>
      </div>

      <div class="space-y-6">
        <div class="card-line">
          <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Discovery</h2>
          <div class="space-y-4">
            <%!-- Primary Actions --%>
            <div class="space-y-2">
              <button
                phx-click="scan_all"
                disabled={@scanning || @running_security_scan}
                class={[
                  "w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-normal tracking-wide uppercase border transition-colors",
                  (@scanning || @running_security_scan) &&
                    "opacity-50 cursor-not-allowed border-neutral-200 text-neutral-400",
                  !(@scanning || @running_security_scan) &&
                    "border-neutral-900 text-neutral-900 hover:bg-neutral-900 hover:text-white"
                ]}
              >
                <%= if @scanning && @active_scan_kind == :all do %>
                  <span class="w-3.5 h-3.5 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                  </span>
                  Scanning<span class="animate-pulse">…</span>
                <% else %>
                  <.icon name="hero-bolt" class="w-3.5 h-3.5" /> Run all scans
                <% end %>
              </button>

              <button
                id="scan-deep-tech"
                phx-click="scan_deep_tech"
                disabled={@scanning || @running_security_scan}
                class={[
                  "w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-normal tracking-wide uppercase border transition-colors",
                  (@scanning || @running_security_scan) &&
                    "opacity-50 cursor-not-allowed border-neutral-200 text-neutral-400",
                  !(@scanning || @running_security_scan) &&
                    "border-neutral-300 text-neutral-600 hover:border-neutral-900 hover:text-neutral-900"
                ]}
              >
                <%= if @scanning && @active_scan_kind == :deep_tech do %>
                  <span class="w-3.5 h-3.5 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                  </span>
                  Scanning<span class="animate-pulse">…</span>
                <% else %>
                  <.icon name="hero-cpu-chip" class="w-3.5 h-3.5" /> Deep tech scan
                <% end %>
              </button>
              <%= if @domain.domain_metadata && @domain.domain_metadata.deep_tech_scanned_at do %>
                <p class="text-[10px] text-neutral-400 text-center -mt-1">
                  Last deep tech: {Calendar.strftime(
                    @domain.domain_metadata.deep_tech_scanned_at,
                    "%Y-%m-%d %H:%M"
                  )}
                </p>
              <% end %>

              <%= if @domain.subdomains != [] do %>
                <button
                  phx-click="scan_all_subdomains"
                  disabled={@scanning || @running_security_scan}
                  class={[
                    "w-full flex items-center justify-center gap-2 px-4 py-2.5 text-xs font-normal tracking-wide uppercase border transition-colors",
                    (@scanning || @running_security_scan) &&
                      "opacity-50 cursor-not-allowed border-neutral-200 text-neutral-400",
                    !(@scanning || @running_security_scan) &&
                      "border-neutral-300 text-neutral-600 hover:border-neutral-900 hover:text-neutral-900"
                  ]}
                >
                  <%= if @scanning && @active_scan_kind == :all_subdomains do %>
                    <span class="w-3.5 h-3.5 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                    </span>
                    Scanning subdomains<span class="animate-pulse">…</span>
                  <% else %>
                    <.icon name="hero-bolt" class="w-3.5 h-3.5" />
                    Scan {@domain.subdomains |> length()} subdomains
                  <% end %>
                </button>
              <% end %>
            </div>

            <%!-- Individual scans --%>
            <details class="group border-t border-neutral-100 pt-3">
              <summary class="flex justify-between items-center text-xs font-medium text-neutral-500 cursor-pointer list-none hover:text-neutral-900 transition-colors">
                <span>Individual Scans</span>
                <span class="transition group-open:rotate-180">
                  <.icon name="hero-chevron-down" class="w-4 h-4" />
                </span>
              </summary>

              <div class="mt-4 space-y-3">
                <button
                  phx-click="scan_subdomains"
                  disabled={@scanning || @running_security_scan}
                  class={[
                    "btn-line w-full justify-center text-xs",
                    (@scanning || @running_security_scan) && "opacity-50 cursor-not-allowed"
                  ]}
                >
                  <%= if @scanning && @active_scan_kind == :subdomains do %>
                    <span class="w-3 h-3 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                    </span>
                    Discovering<span class="animate-pulse">…</span>
                  <% else %>
                    <.icon name="hero-magnifying-glass" class="w-4 h-4" /> Discover subdomains
                  <% end %>
                </button>
                <%= if @domain.domain_metadata && @domain.domain_metadata.subdomains_scanned_at do %>
                  <p class="text-[10px] text-neutral-400 text-center -mt-1">
                    Last: {Calendar.strftime(
                      @domain.domain_metadata.subdomains_scanned_at,
                      "%Y-%m-%d %H:%M"
                    )}
                  </p>
                <% end %>

                <button
                  phx-click="scan_httpx"
                  disabled={@scanning || @running_security_scan}
                  class={[
                    "btn-line w-full justify-center text-xs",
                    (@scanning || @running_security_scan) && "opacity-50 cursor-not-allowed"
                  ]}
                >
                  <%= if @scanning && @active_scan_kind == :httpx do %>
                    <span class="w-3 h-3 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                    </span>
                    Scanning HTTP<span class="animate-pulse">…</span>
                  <% else %>
                    <.icon name="hero-globe-alt" class="w-4 h-4" /> HTTP scan
                  <% end %>
                </button>
                <%= if @domain.domain_metadata && @domain.domain_metadata.http_scanned_at do %>
                  <p class="text-[10px] text-neutral-400 text-center -mt-1">
                    Last: {Calendar.strftime(
                      @domain.domain_metadata.http_scanned_at,
                      "%Y-%m-%d %H:%M"
                    )}
                  </p>
                <% end %>

                <button
                  phx-click="scan_dnsx"
                  disabled={@scanning || @running_security_scan}
                  class={[
                    "btn-line w-full justify-center text-xs",
                    (@scanning || @running_security_scan) && "opacity-50 cursor-not-allowed"
                  ]}
                >
                  <%= if @scanning && @active_scan_kind == :dnsx do %>
                    <span class="w-3 h-3 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                    </span>
                    Scanning DNS<span class="animate-pulse">…</span>
                  <% else %>
                    <.icon name="hero-server-stack" class="w-4 h-4" /> DNS scan
                  <% end %>
                </button>
                <%= if @domain.domain_metadata && @domain.domain_metadata.dns_scanned_at do %>
                  <p class="text-[10px] text-neutral-400 text-center -mt-1">
                    Last: {Calendar.strftime(
                      @domain.domain_metadata.dns_scanned_at,
                      "%Y-%m-%d %H:%M"
                    )}
                  </p>
                <% end %>

                <button
                  phx-click="scan_rdap"
                  disabled={@scanning || @running_security_scan}
                  class={[
                    "btn-line w-full justify-center text-xs",
                    (@scanning || @running_security_scan) && "opacity-50 cursor-not-allowed"
                  ]}
                >
                  <%= if @scanning && @active_scan_kind == :rdap do %>
                    <span class="w-3 h-3 border border-current border-t-transparent rounded-full animate-spin shrink-0">
                    </span>
                    Scanning RDAP<span class="animate-pulse">…</span>
                  <% else %>
                    <.icon name="hero-identification" class="w-4 h-4" /> Registration scan
                  <% end %>
                </button>
                <%= if @domain.domain_metadata && @domain.domain_metadata.rdap_scanned_at do %>
                  <p class="text-[10px] text-neutral-400 text-center -mt-1">
                    Last: {Calendar.strftime(
                      @domain.domain_metadata.rdap_scanned_at,
                      "%Y-%m-%d %H:%M"
                    )}
                  </p>
                <% end %>
              </div>
            </details>
          </div>

          <%= if @scan_results do %>
            <div class="mt-4 pt-4 border-t border-neutral-100 text-sm font-light">
              <p class="text-neutral-500">
                Found: <span class="text-neutral-900">{@scan_results.found}</span>
              </p>
              <p class="text-neutral-500">
                New: <span class="text-neutral-900">{@scan_results.new}</span>
              </p>
            </div>
          <% end %>
        </div>

        <%!-- Security Posture --%>
        <div class="card-line">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-sm font-normal tracking-wide uppercase">Security Posture</h2>
            <%= if @running_security_scan && @current_scope && @current_scope.user.role == :admin do %>
              <button
                phx-click="clear_scans"
                class="text-neutral-400 hover:text-red-600 transition-colors"
                data-confirm="Force clear the running security scan for this domain?"
                title="Clear scan"
              >
                <.icon name="hero-x-circle" class="w-4 h-4" />
              </button>
            <% end %>
          </div>

          <div class="flex flex-col gap-3 mb-6">
            <%= if @current_scope && @current_scope.user.role in [:admin, :editor] do %>
              <button
                phx-click="run_security_scan"
                id="run-security-scan"
                class={[
                  "btn-line w-full justify-center text-xs",
                  (@running_security_scan || @scanning) && "opacity-50 cursor-not-allowed"
                ]}
                disabled={!is_nil(@running_security_scan) || @scanning}
              >
                <.icon name="hero-bolt" class="w-3.5 h-3.5" /> Run Security Scan
              </button>
            <% end %>
          </div>

          <div id="security-scan-card">
            <%= cond do %>
              <% @running_security_scan -> %>
                <div class="border border-neutral-100 rounded-lg p-4 bg-neutral-50/30">
                  <div class="flex items-center justify-between mb-4">
                    <span class="text-xs font-medium text-neutral-900">Security Scan</span>
                    <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded-sm bg-yellow-50 text-yellow-600">
                      running
                    </span>
                  </div>
                  <div class="space-y-3 py-2">
                    <div class="flex justify-between text-[10px] text-neutral-500 font-light">
                      <span>Phase: {scan_phase_label(@running_security_scan.progress)}</span>
                      <span>{@running_security_scan.progress}%</span>
                    </div>
                    <div class="w-full h-1.5 bg-neutral-200 rounded-full overflow-hidden">
                      <div
                        class="h-full bg-blue-500 transition-all duration-1000 ease-in-out"
                        style={"width: #{@running_security_scan.progress}%"}
                      >
                      </div>
                    </div>
                  </div>
                </div>
              <% @latest_security_scan -> %>
                <% findings =
                  if Ecto.assoc_loaded?(@latest_security_scan.findings),
                    do: @latest_security_scan.findings,
                    else: [] %>
                <div class="border border-neutral-100 rounded-lg p-4 bg-neutral-50/30">
                  <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-medium text-neutral-900">Security Scan</span>
                      <span class="text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded-sm bg-green-50 text-green-600">
                        completed
                      </span>
                    </div>
                    <span class="text-[10px] text-neutral-400 font-light">
                      Last scan {Calendar.strftime(
                        @latest_security_scan.completed_at || @latest_security_scan.inserted_at,
                        "%Y-%m-%d %H:%M"
                      )}
                    </span>
                  </div>

                  <%= if findings != [] do %>
                    <div class="space-y-2">
                      <div class="grid grid-cols-2 gap-2 text-sm">
                        <% critical_count = findings |> Enum.count(&(&1.severity == "critical")) %>
                        <% high_count = findings |> Enum.count(&(&1.severity == "high")) %>
                        <% medium_count = findings |> Enum.count(&(&1.severity == "medium")) %>
                        <% low_count = findings |> Enum.count(&(&1.severity == "low")) %>
                        <div class="flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-red-500"></span>
                          <span class="text-xs font-light text-neutral-600">
                            Critical:
                            <span class="font-medium text-neutral-900">{critical_count}</span>
                          </span>
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-orange-500"></span>
                          <span class="text-xs font-light text-neutral-600">
                            High: <span class="font-medium text-neutral-900">{high_count}</span>
                          </span>
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-yellow-500"></span>
                          <span class="text-xs font-light text-neutral-600">
                            Medium:
                            <span class="font-medium text-neutral-900">{medium_count}</span>
                          </span>
                        </div>
                        <div class="flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
                          <span class="text-xs font-light text-neutral-600">
                            Low: <span class="font-medium text-neutral-900">{low_count}</span>
                          </span>
                        </div>
                      </div>
                      <button
                        phx-click="toggle_findings_modal"
                        class="btn-line w-full justify-center text-xs mt-3"
                      >
                        <.icon name="hero-document-magnifying-glass" class="w-3.5 h-3.5" />
                        View findings
                      </button>
                    </div>
                  <% else %>
                    <div class="flex flex-col items-center justify-center py-6 opacity-40">
                      <.icon name="hero-check-badge" class="w-8 h-8 text-green-500 mb-1" />
                      <p class="text-xs font-light">No vulnerabilities found</p>
                    </div>
                  <% end %>
                </div>
              <% @latest_failed_security_scan -> %>
                <div class="p-3 bg-red-50 border border-red-100 rounded-md text-red-700 text-[11px] font-light">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="font-semibold mb-1">Last scan failed</p>
                      <p class="leading-relaxed text-red-600">
                        {@latest_failed_security_scan.error_message}
                      </p>
                    </div>
                    <%= if @current_scope && @current_scope.user.role == :admin do %>
                      <button
                        type="button"
                        phx-click="delete_scan"
                        phx-value-id={@latest_failed_security_scan.id}
                        data-confirm="Delete this failed scan?"
                        class="shrink-0 inline-flex items-center gap-1 text-[10px] uppercase tracking-wide text-red-500 hover:text-red-700 transition-colors"
                        aria-label="Delete failed scan"
                      >
                        <.icon name="hero-trash" class="w-3 h-3" /> Delete
                      </button>
                    <% end %>
                  </div>
                </div>
              <% true -> %>
                <div class="flex flex-col items-center justify-center py-8 text-neutral-400">
                  <.icon name="hero-shield-check" class="w-8 h-8 mb-2" />
                  <p class="text-xs font-light">No security scan yet</p>
                </div>
            <% end %>
          </div>
        </div>

        <%!-- Findings modal --%>
        <%= if @show_findings_modal && @latest_security_scan do %>
          <% findings =
            if Ecto.assoc_loaded?(@latest_security_scan.findings),
              do: @latest_security_scan.findings,
              else: [] %>
          <div class="fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
            <div class="bg-white rounded-lg max-w-3xl w-full max-h-[80vh] overflow-hidden flex flex-col">
              <div class="flex items-center justify-between p-6 border-b border-neutral-200">
                <h2 class="text-lg font-light">Security Findings</h2>
                <button
                  phx-click="toggle_findings_modal"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                  aria-label="Close"
                >
                  <.icon name="hero-x-mark" class="w-5 h-5" />
                </button>
              </div>
              <div class="overflow-y-auto flex-1 p-6">
                <%= if findings != [] do %>
                  <div class="space-y-3">
                    <%= for finding <- Enum.sort_by(findings, & &1.severity) do %>
                      <div class="border border-neutral-100 rounded-lg p-4 hover:border-neutral-200 transition-colors">
                        <div class="flex items-start gap-3">
                          <span class={[
                            "shrink-0 w-3 h-3 rounded-full mt-1",
                            finding.severity == "critical" && "bg-red-500",
                            finding.severity == "high" && "bg-orange-500",
                            finding.severity == "medium" && "bg-yellow-500",
                            finding.severity == "low" && "bg-blue-500",
                            finding.severity not in ["critical", "high", "medium", "low"] &&
                              "bg-neutral-300"
                          ]}>
                          </span>
                          <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2">
                              <p class="font-medium text-neutral-900">{finding.title}</p>
                              <span class={[
                                "text-[10px] uppercase tracking-wide px-1.5 py-0.5 rounded-sm font-medium",
                                finding.severity == "critical" && "bg-red-50 text-red-600",
                                finding.severity == "high" && "bg-orange-50 text-orange-600",
                                finding.severity == "medium" && "bg-yellow-50 text-yellow-600",
                                finding.severity == "low" && "bg-blue-50 text-blue-600"
                              ]}>
                                {finding.severity}
                              </span>
                            </div>
                            <p class="text-sm text-neutral-500 mt-1 font-light break-all">
                              {finding.target}
                            </p>
                            <%= if finding.detail && is_map(finding.detail) do %>
                              <div class="mt-2 text-xs text-neutral-400 space-y-0.5">
                                <%= for {key, value} <- Map.to_list(finding.detail) |> Enum.take(3) do %>
                                  <% display_value =
                                    if is_binary(value),
                                      do: String.slice(value, 0, 60),
                                      else: inspect(value) %>
                                  <p><span class="font-medium">{key}:</span> {display_value}</p>
                                <% end %>
                              </div>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% else %>
                  <div class="flex flex-col items-center justify-center py-8 text-neutral-400">
                    <.icon name="hero-check-badge" class="w-8 h-8 mb-2" />
                    <p class="text-sm font-light">No findings</p>
                  </div>
                <% end %>
              </div>
              <div class="flex items-center justify-end gap-2 p-6 border-t border-neutral-200">
                <button
                  phx-click="toggle_findings_modal"
                  class="btn-line text-xs"
                >
                  Close
                </button>
              </div>
            </div>
          </div>
        <% end %>

        <div class="card-line">
          <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Tags</h2>
          <%= if @domain.domain_tags == [] do %>
            <p class="text-sm font-light text-neutral-400">No tags</p>
          <% else %>
            <div class="flex flex-wrap gap-2">
              <%= for tag <- @domain.domain_tags do %>
                <span class="px-2 py-0.5 border border-neutral-200 text-neutral-500 text-[10px] uppercase tracking-wide">
                  {tag.tag}
                </span>
              <% end %>
            </div>
          <% end %>
        </div>

        <%= if @domain.subdomains != [] do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Subdomains</h2>
            <div class="space-y-2">
              <%= for sub <- @domain.subdomains do %>
                <.link
                  navigate={~p"/domains/#{sub.id}"}
                  class="text-sm font-light hover:underline block"
                >
                  {sub.name}
                </.link>
              <% end %>
            </div>

            <div
              :if={@domain.domain_metadata && @domain.domain_metadata.subdomains_scanned_at}
              class="mt-4 pt-4 border-t border-neutral-100"
            >
              <span class="text-[10px] font-light text-neutral-400">
                Scanned {DateTime.to_iso8601(@domain.domain_metadata.subdomains_scanned_at)}
              </span>
            </div>
          </div>
        <% end %>

        <%= if @domain.parent_domain do %>
          <div class="card-line">
            <h2 class="text-sm font-normal tracking-wide uppercase mb-6">Parent Domain</h2>
            <.link
              navigate={~p"/domains/#{@domain.parent_domain.id}"}
              class="text-sm font-light hover:underline"
            >
              {@domain.parent_domain.name}
            </.link>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
