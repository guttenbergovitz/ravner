<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1600px] mx-auto px-6 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-10 items-start">
      <%!-- Sidebar: Faceted Search & Navigation --%>
      <.domain_facets_sidebar
        total={@total}
        search={@search}
        lifecycle_filter={@lifecycle_filter}
        technical_status_filter={@technical_status_filter}
        brand_filter={@brand_filter}
        org_filter={@org_filter}
        project_filter={@project_filter}
        technology_filter={@technology_filter}
        include_subdomains={@include_subdomains}
        show_empty_facets={@show_empty_facets}
        monitored_only={@monitored_only}
        show_archived={@show_archived}
        hide_placeholders={@hide_placeholders}
        expanded_facets={@expanded_facets}
        facets={@facets}
      />

      <%!-- Main Content Area --%>
      <main class="min-w-0">
        <%!-- Search & IP (Moved from sidebar) --%>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
          <div class="relative" id="search-wrapper" phx-click-away="dismiss_suggestions">
            <form phx-submit="search" phx-change="suggest" id="search-form" class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
              />
              <input
                type="text"
                name="search"
                id="search-input"
                value={@search}
                placeholder={
                  if @include_subdomains,
                    do: "Search domain or subdomain name…",
                    else: "Search domain name…"
                }
                phx-debounce="150"
                phx-keydown="dismiss_suggestions"
                phx-key="Escape"
                autocomplete="off"
                class="w-full pl-9 pr-28 py-2.5 border border-neutral-200 bg-neutral-50 text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 focus:bg-white transition-all dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500 dark:focus:border-neutral-300 dark:focus:bg-neutral-900"
              />
              <div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
                <.toggle_badge
                  active={@include_subdomains}
                  phx-click="toggle_filter_subdomains"
                  aria-pressed={@include_subdomains}
                  title="Toggle search and filter across subdomains"
                  class="cursor-pointer font-mono"
                  id="search-subdomains-toggle"
                >
                  <.icon name="hero-square-2-stack" class="w-3 h-3" />
                  <span>Subdomains</span>
                </.toggle_badge>
              </div>
            </form>
            <%= if @suggestions != [] do %>
              <div class="absolute left-0 right-0 top-full z-30 bg-white border border-neutral-200 border-t-0 divide-y divide-neutral-100 shadow-xl dark:bg-neutral-800 dark:border-neutral-700 dark:divide-neutral-700">
                <%= for name <- @suggestions do %>
                  <button
                    type="button"
                    phx-click="select_suggestion"
                    phx-value-name={name}
                    class="w-full text-left px-4 py-2.5 text-sm font-light text-neutral-700 hover:bg-neutral-50 transition-colors flex items-center gap-2 cursor-pointer dark:text-neutral-200 dark:hover:bg-neutral-700"
                  >
                    <.icon name="hero-globe-alt" class="w-3.5 h-3.5 text-neutral-300 shrink-0" />
                    {name}
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="relative">
            <.icon
              name="hero-globe-europe-africa"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
            />
            <form phx-change="filter_ip" id="ip-filter-form">
              <input
                type="text"
                name="ip"
                value={@ip_filter}
                placeholder="Filter by IP address…"
                phx-debounce="300"
                autocomplete="off"
                class="w-full pl-9 pr-4 py-2.5 border border-neutral-200 bg-neutral-50 text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 focus:bg-white transition-all dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500 dark:focus:border-neutral-300 dark:focus:bg-neutral-900"
              />
            </form>
          </div>
        </div>

        <%!-- Always-Ready Selection Bar (appears when items selected) --%>
        <.selection_bar
          selected_count={MapSet.size(@selected_ids)}
          total={@total}
          visible_count={length(@domains)}
        >
          <:actions>
            <%!-- Quick Actions (flat, no nesting) --%>
            <div class="flex items-center gap-2">
              <button
                phx-click="bulk_action_confirm"
                phx-value-action="scan"
                class="flex items-center gap-1.5 px-3 py-1.5 text-xs border border-neutral-200 hover:border-neutral-400 transition-colors dark:border-neutral-700"
                title="Run scan on selected"
              >
                <.icon name="hero-bolt" class="w-3.5 h-3.5 text-amber-600" /> Scan
              </button>
              <button
                phx-click="bulk_action_confirm"
                phx-value-action="security_scan"
                class="flex items-center gap-1.5 px-3 py-1.5 text-xs border border-neutral-200 hover:border-neutral-400 transition-colors dark:border-neutral-700"
                title="Run security scan on selected"
              >
                <.icon name="hero-shield-check" class="w-3.5 h-3.5 text-emerald-600" /> Security
              </button>

              <%!-- Status dropdown --%>
              <div class="relative" id="bulk-status-dropdown">
                <button
                  phx-click="toggle_bulk_actions_menu"
                  class="flex items-center gap-1.5 px-3 py-1.5 text-xs border border-neutral-200 hover:border-neutral-400 transition-colors dark:border-neutral-700"
                >
                  Status <.icon name="hero-chevron-down" class="w-3 h-3" />
                </button>
                <div
                  :if={@bulk_actions_menu_open}
                  class="absolute right-0 top-full mt-1 z-50 bg-white border border-neutral-200 shadow-lg min-w-[140px] py-1 dark:bg-neutral-800 dark:border-neutral-700"
                  phx-click-away="close_bulk_actions_menu"
                >
                  <%= for {state, label, color} <- lifecycle_options() do %>
                    <button
                      phx-click="bulk_action_confirm"
                      phx-value-lifecycle={state}
                      class="w-full flex items-center gap-2 px-3 py-1.5 text-xs font-light hover:bg-neutral-50 text-left dark:hover:bg-neutral-700"
                    >
                      <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
                      {label}
                    </button>
                  <% end %>
                </div>
              </div>

              <%!-- More actions --%>
              <div class="relative" id="bulk-more-dropdown">
                <button
                  phx-click="toggle_more_menu"
                  class="flex items-center gap-1.5 px-3 py-1.5 text-xs border border-neutral-200 hover:border-neutral-400 transition-colors dark:border-neutral-700"
                >
                  More <.icon name="hero-ellipsis-horizontal" class="w-3.5 h-3.5" />
                </button>
                <div
                  :if={@more_menu_open}
                  class="absolute right-0 top-full mt-1 z-50 bg-white border border-neutral-200 shadow-lg min-w-[160px] py-1 dark:bg-neutral-800 dark:border-neutral-700"
                  phx-click-away="close_more_menu"
                >
                  <div class="px-3 py-1 text-[9px] uppercase tracking-widest text-neutral-400">
                    Assign to
                  </div>
                  <%= for b <- Enum.take(@brands, 5) do %>
                    <button
                      phx-click="bulk_action_confirm"
                      phx-value-brand_id={b.id}
                      class="w-full flex items-center gap-2 px-3 py-1.5 text-xs font-light hover:bg-neutral-50 text-left dark:hover:bg-neutral-700"
                    >
                      <.icon name="hero-bookmark" class="w-3 h-3 opacity-40" /> {b.display_name ||
                        b.name}
                    </button>
                  <% end %>
                  <div class="border-t border-neutral-100 my-1 dark:border-neutral-700"></div>
                  <button
                    phx-click="bulk_action_confirm"
                    phx-value-action="delete"
                    class="w-full flex items-center gap-2 px-3 py-1.5 text-xs text-red-600 hover:bg-red-50 text-left"
                  >
                    <.icon name="hero-trash" class="w-3.5 h-3.5" /> Delete
                  </button>
                </div>
              </div>
            </div>
          </:actions>
        </.selection_bar>

        <%!-- Regular Toolbar (always visible) --%>
        <div :if={MapSet.size(@selected_ids) == 0} class="flex items-center justify-between mb-6">
          <div class="text-[10px] font-normal uppercase tracking-wider text-neutral-400">
            Page {@page} of {@total_pages}
          </div>
          <div class="text-[10px] font-normal uppercase tracking-wider text-neutral-400">
            {@total} results
          </div>
        </div>

        <%!-- Active Filter Chips --%>
        <%= if @include_subdomains || @search != "" || @ip_filter != "" || @lifecycle_filter != [] || @technical_status_filter != [] || @project_filter != [] || @org_filter != [] || @brand_filter != [] do %>
          <div class="flex items-center gap-2 mb-6 flex-wrap animate-in fade-in duration-500">
            <span class="text-[10px] font-normal text-neutral-400 uppercase tracking-widest mr-1">
              Active:
            </span>

            <%= if @search != "" do %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                Search: "{@search}"
                <button
                  phx-click="clear_search"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if @include_subdomains do %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-900 text-white border border-neutral-900 text-[10px] font-normal uppercase tracking-wide dark:bg-neutral-100 dark:text-neutral-900 dark:border-neutral-100">
                <.icon name="hero-square-2-stack" class="w-3 h-3" />
                <span>+ Subdomains</span>
                <button
                  phx-click="toggle_filter_subdomains"
                  class="text-neutral-300 hover:text-white dark:text-neutral-600 dark:hover:text-black transition-colors"
                  title="Exclude subdomains"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if @ip_filter != "" do %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                IP: "{@ip_filter}"
                <button
                  phx-click="clear_ip"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= for state <- @lifecycle_filter do %>
              <% {_, label, color} =
                Enum.find(lifecycle_options(), fn {s, _, _} -> s == state end) %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                <span class={["w-1.5 h-1.5 rounded-full", color]}></span>
                {label}
                <button
                  phx-click="toggle_facet"
                  phx-value-type="lifecycle"
                  phx-value-id={state}
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= for status <- @technical_status_filter do %>
              <% {_, label, _icon} =
                Enum.find(technical_status_options(), fn {s, _, _} -> s == status end) %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                <.technical_status_indicator status={status} variant={:icon} class="size-3" />
                {label}
                <button
                  phx-click="toggle_facet"
                  phx-value-type="technical_status"
                  phx-value-id={status}
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= for id <- @brand_filter do %>
              <% {_, name, _} =
                Enum.find(@facets.brands, fn {bid, _, _} -> bid == id end) || {0, "Brand", 0} %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                Brand: {name}
                <button
                  phx-click="toggle_facet"
                  phx-value-type="brand"
                  phx-value-id={id}
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= for id <- @org_filter do %>
              <% {_, name, _} =
                Enum.find(@facets.organizations, fn {oid, _, _} -> oid == id end) || {0, "Org", 0} %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                Org: {name}
                <button
                  phx-click="toggle_facet"
                  phx-value-type="org"
                  phx-value-id={id}
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= for id <- @project_filter do %>
              <% {_, name, _} =
                Enum.find(@facets.projects, fn {pid, _, _} -> pid == id end) || {0, "Project", 0} %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                Project: {name}
                <button
                  phx-click="toggle_facet"
                  phx-value-type="project"
                  phx-value-id={id}
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <button
              phx-click="clear_filters"
              class="text-[10px] font-normal text-neutral-400 hover:text-neutral-900 transition-colors underline underline-offset-4 decoration-neutral-200 ml-2 dark:hover:text-neutral-100 dark:decoration-neutral-700"
            >
              Clear all
            </button>
          </div>
        <% end %>

        <%!-- Results List --%>
        <div class="border border-neutral-200 divide-y divide-neutral-100 dark:border-neutral-700 dark:divide-neutral-700">
          <%= if @domains_empty? do %>
            <div class="text-center py-32">
              <.icon name="hero-magnifying-glass" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 uppercase tracking-widest mb-1">
                No results
              </h3>
              <p class="text-xs text-neutral-400">Try adjusting your filters or search terms.</p>
            </div>
          <% end %>
          <div
            id="domains-list"
            phx-update="stream"
            class="divide-y divide-neutral-100 dark:divide-neutral-700"
          >
            <%= for {dom_id, domain} <- @streams.domains do %>
              <.domain_index_row
                dom_id={dom_id}
                domain={domain}
                current_scope={@current_scope}
                selected_ids={@selected_ids}
                scanning_ids={@scanning_ids}
                expanded_domains={@expanded_domains}
                lifecycle_menu_open={@lifecycle_menu_open}
                a11y_violations={@a11y_violations}
                lighthouse_scores={@lighthouse_scores}
              />
            <% end %>
          </div>
        </div>

        <%!-- Pagination --%>
        <%= if @total_pages > 1 do %>
          <div class="flex items-center justify-between mt-10">
            <button
              phx-click="paginate"
              phx-value-page={@page - 1}
              disabled={@page <= 1}
              class="btn-line text-xs disabled:opacity-40"
            >
              <.icon name="hero-chevron-left" class="w-3 h-3" /> Prev
            </button>

            <div class="flex items-center gap-1">
              <%= for n <- page_range(@page, @total_pages) do %>
                <%= if n == :ellipsis do %>
                  <span class="px-2 py-1 text-xs text-neutral-400">…</span>
                <% else %>
                  <button
                    phx-click="paginate"
                    phx-value-page={n}
                    class={[
                      "w-8 h-8 text-xs transition-colors rounded",
                      if(@page == n,
                        do:
                          "bg-neutral-900 text-white font-normal dark:bg-neutral-100 dark:text-neutral-900",
                        else:
                          "text-neutral-500 hover:bg-neutral-100 font-light dark:text-neutral-400 dark:hover:bg-neutral-800"
                      )
                    ]}
                  >
                    {n}
                  </button>
                <% end %>
              <% end %>
            </div>

            <button
              phx-click="paginate"
              phx-value-page={@page + 1}
              disabled={@page >= @total_pages}
              class="btn-line text-xs disabled:opacity-40"
            >
              Next <.icon name="hero-chevron-right" class="w-3 h-3" />
            </button>
          </div>
        <% end %>

        <%!-- Bottom Actions (simplified two-tier layout) --%>
        <div class="mt-12 pt-8 border-t border-neutral-100 dark:border-neutral-800">
          <%!-- Primary row: Add/Import + Export --%>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <.link
                :if={@current_scope && @current_scope.editor?}
                patch={~p"/domains/new"}
                class="btn-line text-xs flex items-center gap-1.5 py-2"
              >
                <.icon name="hero-plus" class="w-4 h-4" /> Add domain
              </.link>
              <.link
                :if={@current_scope && @current_scope.editor?}
                patch={~p"/domains/import"}
                class="btn-line text-xs flex items-center gap-1.5 py-2"
              >
                <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Import
              </.link>
            </div>

            <div class="flex items-center gap-3">
              <% export_q =
                [
                  search: @search,
                  ip: @ip_filter,
                  lifecycle: @lifecycle_filter |> Enum.map(&to_string/1) |> Enum.join(","),
                  brand_id: @brand_filter |> Enum.map(&to_string/1) |> Enum.join(","),
                  organization_id: @org_filter |> Enum.map(&to_string/1) |> Enum.join(","),
                  project_id: @project_filter |> Enum.map(&to_string/1) |> Enum.join(","),
                  include_subdomains: if(@export_include_subs, do: "true", else: "")
                ]
                |> Enum.reject(fn {_, v} -> v in ["", nil] end) %>
              <.toggle_badge
                active={@export_include_subs}
                phx-click="toggle_export_subs"
                title="Include subdomains in export"
              >
                <.checkbox_indicator active={@export_include_subs} size={:sm} /> Subs
              </.toggle_badge>
              <a
                href={~p"/domains/export?#{export_q}"}
                class="btn-line text-xs flex items-center gap-1.5 py-2"
              >
                <.icon name="hero-arrow-down-tray" class="w-4 h-4" /> Export CSV
              </a>
            </div>
          </div>

          <%!-- Secondary row: Bulk tools (less prominent) --%>
          <div
            :if={@current_scope && not @current_scope.viewer?}
            class="flex items-center justify-center gap-4 mt-4 pt-4 border-t border-neutral-50 dark:border-neutral-800"
          >
            <button
              phx-click="scan_visible"
              class="text-xs text-neutral-500 hover:text-neutral-900 flex items-center gap-1.5 transition-colors dark:hover:text-neutral-100"
              data-confirm={
                if @bulk_include_subdomains,
                  do: "Scan all visible domains AND their subdomains?",
                  else: "Scan all visible domains?"
              }
            >
              <.icon name="hero-bolt" class="w-3.5 h-3.5" /> Scan visible ({length(@domains)})
            </button>
            <span class="text-neutral-200 dark:text-neutral-700">·</span>
            <button
              phx-click="toggle_include_subdomains"
              class={[
                "text-xs flex items-center gap-1.5 transition-colors",
                if(@bulk_include_subdomains,
                  do: "text-neutral-900 dark:text-neutral-100",
                  else: "text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
                )
              ]}
            >
              <.checkbox_indicator active={@bulk_include_subdomains} size={:sm} />
              Include subdomains
            </button>
            <span class="text-neutral-200 dark:text-neutral-700">·</span>
            <span class="text-xs text-neutral-400">Click rows to select for bulk actions</span>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%!-- Modals --%>
  <.domain_index_modals
    bulk_action={@bulk_action}
    selected_ids={@selected_ids}
    facets={@facets}
    bulk_include_subdomains={@bulk_include_subdomains}
    live_action={@live_action}
    form={@form}
    import_results={@import_results}
  />

  <script :type={Phoenix.LiveView.ColocatedHook} name=".Copy">
    export default {
      mounted() {
        this.el.addEventListener("click", e => {
          e.preventDefault();
          e.stopPropagation();
          const text = this.el.getAttribute("data-copy");
          if (!text) return;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
              this.pushEvent("ip_copied", { ip: text });
            });
          }
        });
      }
    }
  </script>
</Layouts.app>
