<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1600px] mx-auto px-6 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-10 items-start">
      <%!-- Sidebar: Faceted Search & Navigation --%>
      <aside class="space-y-8 sticky top-8">
        <div>
          <h1 class="text-2xl font-light tracking-tight mb-1">Domains</h1>
          <p class="text-[10px] font-normal uppercase tracking-widest text-neutral-400">
            {if @total == 0 && @search == "" && is_nil(@lifecycle_filter),
              do: "No domains yet",
              else: "#{@total} domain#{if @total != 1, do: "s", else: ""}"}
          </p>
        </div>

        <%!-- Search & IP --%>
        <div class="space-y-4">
          <div class="relative" id="search-wrapper">
            <form phx-submit="search" phx-change="suggest" id="search-form">
              <.icon
                name="hero-magnifying-glass"
                class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
              />
              <input
                type="text"
                name="search"
                id="search-input"
                value={@search}
                placeholder="Search name…"
                phx-debounce="150"
                phx-blur="dismiss_suggestions"
                autocomplete="off"
                class="w-full pl-9 pr-4 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors"
              />
            </form>
            <%= if @suggestions != [] do %>
              <div class="absolute left-0 right-0 top-full z-30 bg-white border border-neutral-200 border-t-0 divide-y divide-neutral-100 shadow-xl">
                <%= for name <- @suggestions do %>
                  <button
                    phx-mousedown="select_suggestion"
                    phx-value-name={name}
                    class="w-full text-left px-4 py-2.5 text-sm font-light text-neutral-700 hover:bg-neutral-50 transition-colors flex items-center gap-2"
                  >
                    <.icon name="hero-globe-alt" class="w-3.5 h-3.5 text-neutral-300 shrink-0" />
                    {name}
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="relative">
            <.icon
              name="hero-globe-europe-africa"
              class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
            />
            <form phx-change="filter_ip" id="ip-filter-form">
              <input
                type="text"
                name="ip"
                value={@ip_filter}
                placeholder="Filter by IP…"
                phx-debounce="300"
                autocomplete="off"
                class="w-full pl-9 pr-4 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors"
              />
            </form>
          </div>
        </div>

        <%!-- Action Buttons --%>
        <div class="flex flex-col gap-2 pt-2">
          <.link patch={~p"/domains/new"} class="btn-line-filled text-xs justify-center py-2">
            <.icon name="hero-plus" class="w-4 h-4" /> Add domain
          </.link>
          <div class="grid grid-cols-2 gap-2">
            <button phx-click="enter_selection_mode" class="btn-line text-xs justify-center py-2">
              <.icon name="hero-square-2-stack" class="w-4 h-4" /> Select
            </button>
            <.link patch={~p"/domains/import"} class="btn-line text-xs justify-center py-2">
              <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Import
            </.link>
          </div>
        </div>

        <%!-- Facets --%>
        <nav class="space-y-8 pt-4">
          <%!-- Lifecycle Facet --%>
          <div>
            <h3 class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-4 border-b border-neutral-100 pb-2">
              Status
            </h3>
            <div class="space-y-1">
              <%= for {state, label, color} <- lifecycle_options() do %>
                <% count =
                  Enum.find_value(@facets.lifecycle, 0, fn {s, c} -> if s == state, do: c end) %>
                <button
                  phx-click="toggle_facet"
                  phx-value-type="lifecycle"
                  phx-value-id={state}
                  class={[
                    "w-full flex items-center justify-between px-2 py-1.5 text-xs transition-colors rounded",
                    if(@lifecycle_filter == state,
                      do: "bg-neutral-900 text-white font-normal",
                      else: "text-neutral-500 hover:bg-neutral-50 font-light"
                    ),
                    count == 0 && !(@lifecycle_filter == state) &&
                      "opacity-30 pointer-events-none"
                  ]}
                >
                  <div class="flex items-center gap-2">
                    <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
                    <span>{label}</span>
                  </div>
                  <span class="text-[10px] opacity-60">{count}</span>
                </button>
              <% end %>
            </div>
          </div>

          <%!-- Brands Facet --%>
          <%= if @facets.brands != [] do %>
            <div>
              <h3 class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-4 border-b border-neutral-100 pb-2">
                Brands
              </h3>
              <div class="space-y-1 max-h-48 overflow-y-auto pr-2 scrollbar-thin">
                <%= for {id, name, count} <- @facets.brands do %>
                  <button
                    phx-click="toggle_facet"
                    phx-value-type="brand"
                    phx-value-id={id}
                    class={[
                      "w-full flex items-center justify-between px-2 py-1.5 text-xs transition-colors rounded text-left",
                      if(@brand_filter == id,
                        do: "bg-neutral-900 text-white font-normal",
                        else: "text-neutral-500 hover:bg-neutral-50 font-light"
                      )
                    ]}
                  >
                    <span class="truncate pr-2">{name}</span>
                    <span class="text-[10px] opacity-60 shrink-0">{count}</span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <%!-- Organizations Facet --%>
          <%= if @facets.organizations != [] do %>
            <div>
              <h3 class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-4 border-b border-neutral-100 pb-2">
                Organizations
              </h3>
              <div class="space-y-1 max-h-48 overflow-y-auto pr-2 scrollbar-thin">
                <%= for {id, name, count} <- @facets.organizations do %>
                  <button
                    phx-click="toggle_facet"
                    phx-value-type="org"
                    phx-value-id={id}
                    class={[
                      "w-full flex items-center justify-between px-2 py-1.5 text-xs transition-colors rounded text-left",
                      if(@org_filter == id,
                        do: "bg-neutral-900 text-white font-normal",
                        else: "text-neutral-500 hover:bg-neutral-50 font-light"
                      )
                    ]}
                  >
                    <span class="truncate pr-2">{name}</span>
                    <span class="text-[10px] opacity-60 shrink-0">{count}</span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <%!-- Projects Facet --%>
          <%= if @facets.projects != [] do %>
            <div>
              <h3 class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-4 border-b border-neutral-100 pb-2">
                Projects
              </h3>
              <div class="space-y-1 max-h-64 overflow-y-auto pr-2 scrollbar-thin">
                <%= for {id, name, count} <- @facets.projects do %>
                  <button
                    phx-click="toggle_facet"
                    phx-value-type="project"
                    phx-value-id={id}
                    class={[
                      "w-full flex items-center justify-between px-2 py-1.5 text-xs transition-colors rounded text-left",
                      if(@project_filter == id,
                        do: "bg-neutral-900 text-white font-normal",
                        else: "text-neutral-500 hover:bg-neutral-50 font-light"
                      )
                    ]}
                  >
                    <span class="truncate pr-2">{name}</span>
                    <span class="text-[10px] opacity-60 shrink-0">{count}</span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>
        </nav>
      </aside>

      <%!-- Main Content Area --%>
      <main class="min-w-0">
        <%!-- Selection Mode Action Bar --%>
        <%= if @selection_mode do %>
          <div class="flex items-center justify-between p-4 bg-neutral-50 border border-neutral-200 mb-6 animate-in slide-in-from-top-4 duration-300">
            <div class="flex items-center gap-6">
              <div class="flex items-center gap-2">
                <button phx-click="select_all_matching" class="btn-line text-[10px] py-1">
                  All matching ({@total})
                </button>
                <button phx-click="select_visible" class="btn-line text-[10px] py-1">
                  Visible ({length(@domains)})
                </button>
              </div>
              <span class="text-sm font-normal text-neutral-900">
                {MapSet.size(@selected_ids)} selected
              </span>
            </div>

            <div class="flex items-center gap-3">
              <button
                phx-click="toggle_include_subdomains"
                class={[
                  "flex items-center gap-1.5 px-2.5 py-1.5 border text-xs font-light transition-colors",
                  if(@include_subdomains,
                    do: "border-neutral-900 text-neutral-900 bg-white",
                    else:
                      "border-neutral-200 text-neutral-400 bg-transparent hover:border-neutral-400"
                  )
                ]}
              >
                <span class={[
                  "w-3.5 h-3.5 border flex items-center justify-center shrink-0",
                  if(@include_subdomains,
                    do: "border-neutral-900 bg-neutral-900",
                    else: "border-neutral-300"
                  )
                ]}>
                  <%= if @include_subdomains do %>
                    <.icon name="hero-check" class="w-2.5 h-2.5 text-white" />
                  <% end %>
                </span>
                Incl. subdomains
              </button>

              <div class="h-4 w-px bg-neutral-200 mx-1"></div>

              <div class="relative" id="bulk-lifecycle-menu">
                <button
                  phx-click="toggle_bulk_lifecycle_menu"
                  disabled={MapSet.size(@selected_ids) == 0}
                  class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
                >
                  <.icon name="hero-tag" class="w-4 h-4" /> Set status
                </button>
                <%= if @bulk_lifecycle_menu_open do %>
                  <div
                    class="absolute right-0 top-full mt-1 z-30 bg-white border border-neutral-200 py-1 min-w-[170px] shadow-xl"
                    phx-click-away="close_bulk_lifecycle_menu"
                  >
                    <%= for {state, label, color} <- lifecycle_options() do %>
                      <button
                        phx-click="bulk_action_confirm"
                        phx-value-lifecycle={state}
                        class="w-full flex items-center gap-2 px-3 py-2 text-xs font-light text-left hover:bg-neutral-50 transition-colors"
                      >
                        <span class={["w-2 h-2 rounded-full shrink-0", color]}></span>
                        {label}
                      </button>
                    <% end %>
                  </div>
                <% end %>
              </div>

              <button
                phx-click="bulk_action_confirm"
                phx-value-action="scan"
                disabled={MapSet.size(@selected_ids) == 0}
                class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed"
              >
                <.icon name="hero-bolt" class="w-4 h-4" /> Scan
              </button>

              <%= if editor?(@current_scope) do %>
                <button
                  phx-click="bulk_action_confirm"
                  phx-value-action="delete"
                  disabled={MapSet.size(@selected_ids) == 0}
                  class="text-xs font-light border border-red-100 text-red-600 hover:bg-red-50 px-3 py-1.5 transition-colors flex items-center gap-1.5 disabled:opacity-40"
                >
                  <.icon name="hero-trash" class="w-4 h-4" /> Delete
                </button>
              <% end %>

              <button
                phx-click="exit_selection_mode"
                class="text-neutral-400 hover:text-neutral-900 transition-colors ml-2"
              >
                <.icon name="hero-x-mark" class="w-5 h-5" />
              </button>
            </div>
          </div>
        <% else %>
          <%!-- Regular Toolbar --%>
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-4">
              <button
                phx-click="scan_visible"
                class="btn-line text-xs flex items-center gap-1.5"
                data-confirm={
                  if @include_subdomains,
                    do: "Scan all visible domains AND their subdomains?",
                    else: "Scan all visible domains?"
                }
              >
                <.icon name="hero-bolt" class="w-4 h-4" /> Scan visible
                <%= if @include_subdomains do %>
                  <span class="text-[10px] bg-neutral-100 px-1 rounded text-neutral-500">
                    + subs
                  </span>
                <% end %>
              </button>

              <button
                phx-click="toggle_include_subdomains"
                class={[
                  "flex items-center gap-1.5 px-2.5 py-1.5 border text-xs font-light transition-colors",
                  if(@include_subdomains,
                    do: "border-neutral-900 text-neutral-900 bg-neutral-50",
                    else: "border-neutral-200 text-neutral-400 hover:border-neutral-400"
                  )
                ]}
              >
                <span class={[
                  "w-3.5 h-3.5 border flex items-center justify-center shrink-0",
                  if(@include_subdomains,
                    do: "border-neutral-900 bg-neutral-900",
                    else: "border-neutral-300"
                  )
                ]}>
                  <%= if @include_subdomains do %>
                    <.icon name="hero-check" class="w-2.5 h-2.5 text-white" />
                  <% end %>
                </span>
                Incl. subdomains
              </button>
            </div>

            <%!-- Results Info --%>
            <div class="text-[10px] font-normal uppercase tracking-wider text-neutral-400">
              Page {@page} of {@total_pages}
              <span class="text-neutral-200 mx-2">|</span>
              {@total} results
            </div>
          </div>
        <% end %>

        <%!-- Active Filter Chips --%>
        <%= if @search != "" || @ip_filter != "" || not is_nil(@lifecycle_filter) || @project_filter != nil || @org_filter != nil || @brand_filter != nil do %>
          <div class="flex items-center gap-2 mb-6 flex-wrap animate-in fade-in duration-500">
            <span class="text-[10px] font-normal text-neutral-400 uppercase tracking-widest mr-1">
              Active:
            </span>

            <%= if @search != "" do %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide">
                Search: "{@search}"
                <button
                  phx-click="clear_search"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if @ip_filter != "" do %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide">
                IP: "{@ip_filter}"
                <button
                  phx-click="clear_ip"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if not is_nil(@lifecycle_filter) do %>
              <% {_state, label, color} =
                Enum.find(lifecycle_options(), fn {s, _, _} -> s == @lifecycle_filter end) %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide">
                <span class={["w-1.5 h-1.5 rounded-full", color]}></span>
                {label}
                <button
                  phx-click="clear_filter"
                  phx-value-type="lifecycle"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if @brand_filter do %>
              <% {_, name, _} =
                Enum.find(@facets.brands, fn {id, _, _} -> id == @brand_filter end) ||
                  {0, "Brand", 0} %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide">
                Brand: {name}
                <button
                  phx-click="clear_filter"
                  phx-value-type="brand"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if @org_filter do %>
              <% {_, name, _} =
                Enum.find(@facets.organizations, fn {id, _, _} -> id == @org_filter end) ||
                  {0, "Org", 0} %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide">
                Org: {name}
                <button
                  phx-click="clear_filter"
                  phx-value-type="org"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <%= if @project_filter do %>
              <% {_, name, _} =
                Enum.find(@facets.projects, fn {id, _, _} -> id == @project_filter end) ||
                  {0, "Project", 0} %>
              <span class="inline-flex items-center gap-1.5 pl-2 pr-1 py-1 bg-neutral-50 border border-neutral-200 text-[10px] font-normal text-neutral-600 uppercase tracking-wide">
                Project: {name}
                <button
                  phx-click="clear_filter"
                  phx-value-type="project"
                  class="text-neutral-400 hover:text-neutral-900 transition-colors"
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
              </span>
            <% end %>

            <button
              phx-click="clear_filters"
              class="text-[10px] font-normal text-neutral-400 hover:text-neutral-900 transition-colors underline underline-offset-4 decoration-neutral-200 ml-2"
            >
              Clear all
            </button>
          </div>
        <% end %>

        <%!-- Results List --%>
        <div class="border border-neutral-200 divide-y divide-neutral-100">
          <%= if @domains == [] do %>
            <div class="text-center py-32">
              <.icon name="hero-magnifying-glass" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 uppercase tracking-widest mb-1">
                No results
              </h3>
              <p class="text-xs text-neutral-400">Try adjusting your filters or search terms.</p>
            </div>
          <% else %>
            <%= for domain <- @domains do %>
              <% selected = MapSet.member?(@selected_ids, "#{domain.id}") %>
              <% scanning = MapSet.member?(@scanning_ids, "#{domain.id}") %>
              <div
                id={"domain-#{domain.id}"}
                class={[
                  selected && "bg-neutral-50",
                  scanning && "opacity-50"
                ]}
              >
                <div
                  class="flex items-center justify-between py-4 px-6 hover:bg-neutral-50 transition-colors cursor-pointer"
                  phx-click="toggle_expand"
                  phx-value-id={domain.id}
                >
                  <div class="flex items-center gap-4">
                    <%= if @selection_mode do %>
                      <span
                        phx-click="toggle_select"
                        phx-value-id={domain.id}
                        phx-stop
                        class={[
                          "w-4 h-4 border flex items-center justify-center shrink-0 transition-colors cursor-pointer",
                          if(selected,
                            do: "border-neutral-900 bg-neutral-900",
                            else: "border-neutral-300 hover:border-neutral-600"
                          )
                        ]}
                      >
                        <%= if selected do %>
                          <.icon name="hero-check" class="w-3 h-3 text-white" />
                        <% end %>
                      </span>
                    <% end %>

                    <div class="relative" id={"lifecycle-menu-#{domain.id}"}>
                      <button
                        phx-click="open_lifecycle_menu"
                        phx-value-id={domain.id}
                        phx-stop
                        class={[
                          "w-2 h-2 rounded-full transition-transform hover:scale-150 cursor-pointer",
                          lifecycle_color(domain.lifecycle_state)
                        ]}
                        title={domain.lifecycle_state}
                      >
                      </button>
                      <%= if @lifecycle_menu_open == "#{domain.id}" do %>
                        <div
                          class="absolute left-0 top-5 z-50 bg-white border border-neutral-200 rounded-lg shadow-lg py-1 min-w-[160px]"
                          phx-click-away="close_lifecycle_menu"
                        >
                          <%= for {state, label, color} <- lifecycle_options() do %>
                            <button
                              phx-click="set_lifecycle"
                              phx-value-id={domain.id}
                              phx-value-state={state}
                              class={[
                                "w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-neutral-50 transition-colors",
                                domain.lifecycle_state == state && "font-medium"
                              ]}
                            >
                              <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
                              {label}
                            </button>
                          <% end %>
                        </div>
                      <% end %>
                    </div>

                    <div class="flex items-center gap-3">
                      <.link
                        navigate={~p"/domains/#{domain.id}"}
                        class="text-sm font-normal hover:underline"
                        phx-stop
                      >
                        {domain.name}
                      </.link>
                      <%= if domain.subdomains != [] do %>
                        <span class="text-xs font-light text-neutral-400">
                          {length(domain.subdomains)} sub
                        </span>
                      <% end %>
                    </div>
                  </div>

                  <div class="flex items-center gap-5 text-xs font-light text-neutral-500 shrink-0">
                    <%!-- HTTP status / redirect --%>
                    <%= if meta = domain.domain_metadata do %>
                      <%= cond do %>
                        <% meta.final_url && (meta.http_status in [301, 302, 303, 307, 308] || external_redirect?(domain.name, meta.final_url)) -> %>
                          <% target = URI.parse(meta.final_url).host || meta.final_url %>
                          <span class="flex items-center gap-1 text-amber-600">
                            <span class="font-normal">{meta.http_status}</span>
                            <.icon name="hero-arrow-right" class="w-3 h-3" />
                            <a
                              href={meta.final_url}
                              target="_blank"
                              rel="noopener noreferrer"
                              phx-stop
                              class="max-w-[120px] truncate hover:underline"
                            >
                              {target}
                            </a>
                          </span>
                        <% meta.http_status == 200 -> %>
                          <span class="text-green-600 font-normal">200 OK</span>
                        <% meta.http_status && meta.http_status > 0 -> %>
                          <span class="text-red-500 font-normal">{meta.http_status}</span>
                        <% meta.http_scanned_at != nil -> %>
                          <span class="text-neutral-300">timeout</span>
                        <% true -> %>
                          <span class="text-neutral-300">–</span>
                      <% end %>

                      <%!-- IP --%>
                      <%= if meta.ip_v4 && meta.ip_v4 != [] do %>
                        <span
                          class="hidden xl:inline text-neutral-400 font-mono text-[10px] tracking-tighter"
                          title={Enum.join(meta.ip_v4, ", ")}
                        >
                          {List.first(meta.ip_v4)}
                        </span>
                      <% end %>

                      <%!-- SSL --%>
                      <%= if meta.ssl_valid_until do %>
                        <% expiring_soon =
                          meta.ssl_days_remaining != nil && meta.ssl_days_remaining <= 14 %>
                        <% expired = meta.ssl_days_remaining != nil && meta.ssl_days_remaining < 0 %>
                        <span
                          class={[
                            "hidden md:flex items-center gap-1.5 shrink-0",
                            expired && "text-red-600 font-medium",
                            expiring_soon && !expired && "text-amber-600 font-medium",
                            !expiring_soon && "text-neutral-400"
                          ]}
                          title={"SSL by #{meta.ssl_issuer} expires on #{Calendar.strftime(meta.ssl_valid_until, "%Y-%m-%d")}"}
                        >
                          <.icon
                            name={
                              if expired or expiring_soon,
                                do: "hero-shield-exclamation",
                                else: "hero-shield-check"
                            }
                            class="w-3.5 h-3.5"
                          />
                          <span>{Calendar.strftime(meta.ssl_valid_until, "%y-%m-%d")}</span>
                        </span>
                      <% end %>

                      <%!-- Last scanned --%>
                      <%= if meta.scanned_at do %>
                        <span class="hidden 2xl:inline text-neutral-300 text-[10px]">
                          {Ravner.Formatting.time_ago(meta.scanned_at)}
                        </span>
                      <% end %>
                    <% else %>
                      <span class="text-neutral-300 italic text-[10px]">never scanned</span>
                    <% end %>

                    <%= if not @selection_mode do %>
                      <div class="flex items-center gap-2">
                        <button
                          phx-click="quick_scan"
                          phx-value-id={domain.id}
                          phx-stop
                          disabled={scanning}
                          class="text-neutral-400 hover:text-neutral-700 transition-colors disabled:cursor-not-allowed"
                          title={if scanning, do: "Scanning...", else: "Quick scan"}
                        >
                          <.icon
                            name="hero-arrow-path"
                            class={["w-4 h-4", scanning && "animate-spin"]}
                          />
                        </button>
                        <button
                          phx-click="delete"
                          phx-value-id={domain.id}
                          data-confirm="Delete this domain?"
                          class="text-neutral-400 hover:text-red-600 transition-colors"
                          phx-stop
                        >
                          <.icon name="hero-trash" class="w-4 h-4" />
                        </button>
                      </div>
                    <% end %>
                  </div>
                </div>

                <%!-- Subdomains --%>
                <%= if MapSet.member?(@expanded_domains, "#{domain.id}") && domain.subdomains != [] do %>
                  <div class="bg-neutral-50 border-t border-neutral-100 divide-y divide-neutral-100">
                    <%= for sub <- domain.subdomains do %>
                      <% sub_scanning = MapSet.member?(@scanning_ids, "#{sub.id}") %>
                      <div class={[
                        "flex items-center justify-between py-3 px-6 pl-12 hover:bg-neutral-100 transition-colors",
                        sub_scanning && "opacity-50"
                      ]}>
                        <div class="flex items-center gap-3">
                          <div class={[
                            "w-1.5 h-1.5 rounded-full",
                            lifecycle_color(sub.lifecycle_state)
                          ]}>
                          </div>
                          <.link
                            navigate={~p"/domains/#{sub.id}"}
                            class="text-sm font-light hover:underline"
                          >
                            {sub.name}
                          </.link>
                        </div>
                        <div class="flex items-center gap-3">
                          <%= if sub_meta = sub.domain_metadata do %>
                            <span class="text-[10px] text-neutral-400 font-mono tracking-tighter">
                              {sub_meta.http_status || "–"}
                            </span>
                          <% end %>
                          <button
                            phx-click="quick_scan"
                            phx-value-id={sub.id}
                            phx-stop
                            disabled={sub_scanning}
                            class="text-neutral-400 hover:text-neutral-700"
                          >
                            <.icon
                              name="hero-arrow-path"
                              class={["w-3 h-3", sub_scanning && "animate-spin"]}
                            />
                          </button>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <%!-- Pagination --%>
        <%= if @total_pages > 1 do %>
          <div class="flex items-center justify-between mt-10">
            <button
              phx-click="paginate"
              phx-value-page={@page - 1}
              disabled={@page <= 1}
              class="btn-line text-xs disabled:opacity-40"
            >
              <.icon name="hero-chevron-left" class="w-3 h-3" /> Prev
            </button>

            <div class="flex items-center gap-1">
              <%= for n <- page_range(@page, @total_pages) do %>
                <%= if n == :ellipsis do %>
                  <span class="px-2 py-1 text-xs text-neutral-400">…</span>
                <% else %>
                  <button
                    phx-click="paginate"
                    phx-value-page={n}
                    class={[
                      "w-8 h-8 text-xs transition-colors rounded",
                      if(@page == n,
                        do: "bg-neutral-900 text-white font-normal",
                        else: "text-neutral-500 hover:bg-neutral-100 font-light"
                      )
                    ]}
                  >
                    {n}
                  </button>
                <% end %>
              <% end %>
            </div>

            <button
              phx-click="paginate"
              phx-value-page={@page + 1}
              disabled={@page >= @total_pages}
              class="btn-line text-xs disabled:opacity-40"
            >
              Next <.icon name="hero-chevron-right" class="w-3 h-3" />
            </button>
          </div>
        <% end %>

        <%!-- Export Section --%>
        <% export_q =
          [
            search: @search,
            ip: @ip_filter,
            lifecycle: if(@lifecycle_filter, do: to_string(@lifecycle_filter), else: ""),
            brand_id: @brand_filter,
            organization_id: @org_filter,
            project_id: @project_filter,
            include_subdomains: if(@export_include_subs, do: "true", else: "")
          ]
          |> Enum.reject(fn {_, v} -> v in ["", nil] end) %>
        <div class="flex justify-end items-center gap-3 mt-12 pt-8 border-t border-neutral-100">
          <div class="flex items-center border border-neutral-200 rounded overflow-hidden">
            <button
              phx-click="toggle_export_subs"
              class={[
                "px-3 py-1.5 text-[10px] transition-colors uppercase tracking-wider",
                if(!@export_include_subs,
                  do: "bg-neutral-900 text-white",
                  else: "text-neutral-500 hover:bg-neutral-50"
                )
              ]}
            >
              Apex only
            </button>
            <button
              phx-click="toggle_export_subs"
              class={[
                "px-3 py-1.5 text-[10px] transition-colors uppercase tracking-wider",
                if(@export_include_subs,
                  do: "bg-neutral-900 text-white",
                  else: "text-neutral-500 hover:bg-neutral-50"
                )
              ]}
            >
              With Subs
            </button>
          </div>
          <a
            href={~p"/domains/export?#{export_q}"}
            class="btn-line text-xs flex items-center gap-1.5 py-2"
          >
            <.icon name="hero-arrow-down-tray" class="w-4 h-4" /> Export CSV
          </a>
        </div>
      </main>
    </div>
  </div>

  <%!-- Modals --%>
  <%= if @bulk_action != nil do %>
    <% selected_count = MapSet.size(@selected_ids) %>
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40" phx-click="bulk_action_cancel">
    </div>
    <div class="fixed inset-x-0 top-24 mx-auto max-w-md bg-white border border-neutral-200 z-50 p-8 shadow-2xl animate-in zoom-in-95 duration-200">
      <h2 class="text-xl font-light tracking-tight mb-4">
        {if @bulk_action == :delete, do: "Delete", else: "Scan"} {selected_count} domains?
      </h2>
      <p class="text-sm font-light text-neutral-500 mb-8">
        {if @bulk_action == :delete,
          do: "This action cannot be undone.",
          else: "All scans will run in parallel background tasks."}
        <%= if @include_subdomains do %>
          <br /><span class="text-neutral-900 font-normal">
            This will also include all their subdomains.
          </span>
        <% end %>
      </p>
      <div class="flex items-center gap-3">
        <button
          phx-click="bulk_action_execute"
          class={[
            "btn-line-filled flex-1 justify-center text-xs py-2.5",
            @bulk_action == :delete && "!bg-red-600 !border-red-600"
          ]}
        >
          Confirm {if @bulk_action == :delete, do: "Deletion", else: "Scanning"}
        </button>
        <button
          phx-click="bulk_action_cancel"
          class="btn-line flex-1 justify-center text-xs py-2.5"
        >
          Cancel
        </button>
      </div>
    </div>
  <% end %>

  <%= if @live_action in [:new, :import] do %>
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40" phx-click="close_modal"></div>
    <div class="fixed inset-x-0 top-20 bottom-8 mx-auto max-w-lg bg-white border border-neutral-200 z-50 p-10 overflow-y-auto shadow-2xl animate-in zoom-in-95 duration-200">
      <%= case @live_action do %>
        <% :new -> %>
          <h2 class="text-2xl font-light tracking-tight mb-8">Add Domain</h2>
          <.form
            for={@form}
            phx-change="validate"
            phx-submit="save"
            id="domain-form"
            class="space-y-6"
          >
            <.input field={@form[:type]} type="hidden" value="domain" />
            <.input
              field={@form[:name]}
              type="text"
              label="Domain name"
              placeholder="example.com"
              required
            />
            <div class="grid grid-cols-2 gap-4 pt-4">
              <button type="submit" class="btn-line-filled justify-center py-2.5 text-xs">
                Add domain
              </button>
              <.link patch={~p"/domains"} class="btn-line justify-center py-2.5 text-xs">
                Cancel
              </.link>
            </div>
          </.form>
        <% :import -> %>
          <h2 class="text-2xl font-light tracking-tight mb-1">Import Domains</h2>
          <p class="text-sm font-light text-neutral-400 mb-8">Apex domains only, one per line.</p>

          <%= if @import_results do %>
            <%!-- Simplified results view for brevity in this refactor --%>
            <div class="p-6 bg-neutral-50 border border-neutral-200 text-sm font-light mb-8">
              Added: {length(@import_results.added)} | Skipped: {length(@import_results.skipped)} | Ignored: {length(
                @import_results.ignored
              )}
            </div>
            <button
              phx-click="close_modal"
              class="btn-line-filled w-full justify-center py-2.5 text-xs"
            >
              Done
            </button>
          <% else %>
            <.form
              for={%{}}
              as={:import}
              phx-submit="import"
              id="import-paste-form"
              class="space-y-6"
            >
              <textarea
                name="import[domains]"
                rows="10"
                class="w-full p-4 border border-neutral-200 bg-transparent text-sm font-light font-mono resize-none focus:outline-none focus:border-neutral-900"
                placeholder="example.com\nexample.co.uk"
                required
              ></textarea>
              <button type="submit" class="btn-line-filled w-full justify-center py-2.5 text-xs">
                Import pasted
              </button>
            </.form>
            <.link patch={~p"/domains"} class="btn-line w-full justify-center py-2.5 text-xs mt-3">
              Cancel
            </.link>
          <% end %>
      <% end %>
    </div>
  <% end %>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".Copy">
    export default {
      mounted() {
        this.el.addEventListener("click", e => {
          e.preventDefault();
          e.stopPropagation();
          const text = this.el.getAttribute("data-copy");
          if (!text) return;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(() => {
              this.pushEvent("ip_copied", { ip: text });
            });
          }
        });
      }
    }
  </script>
</Layouts.app>
