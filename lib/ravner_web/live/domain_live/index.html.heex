<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <%!-- Header --%>
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Domains</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          <%= if @total == 0 && @search == "" && is_nil(@lifecycle_filter) do %>
            No domains yet
          <% else %>
            {@total} domain{if @total != 1, do: "s", else: ""}
            <%= if @total_pages > 1 do %>
              <span class="text-neutral-300 mx-1">·</span>page {@page} of {@total_pages}
            <% end %>
          <% end %>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <.link patch={~p"/domains/import"} class="btn-line text-xs">
          <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Import
        </.link>
        <.link patch={~p"/domains/new"} class="btn-line-filled text-xs">
          <.icon name="hero-plus" class="w-4 h-4" /> Add domain
        </.link>
      </div>
    </div>

    <%!-- Toolbar: search + lifecycle filters --%>
    <div class="flex flex-col sm:flex-row gap-3 mb-4">
      <%!-- Search with autocomplete --%>
      <div class="relative flex-1" id="search-wrapper">
        <form phx-submit="search" phx-change="suggest" id="search-form">
          <.icon
            name="hero-magnifying-glass"
            class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
          />
          <input
            type="text"
            name="search"
            id="search-input"
            value={@search}
            placeholder="Search domains…"
            phx-debounce="150"
            phx-blur="dismiss_suggestions"
            autocomplete="off"
            class="w-full pl-9 pr-4 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
          />
        </form>

        <%!-- Suggestions dropdown --%>
        <%= if @suggestions != [] do %>
          <div class="absolute left-0 right-0 top-full z-30 bg-white border border-neutral-200 border-t-0 divide-y divide-neutral-100">
            <%= for name <- @suggestions do %>
              <button
                phx-mousedown="select_suggestion"
                phx-value-name={name}
                class="w-full text-left px-4 py-2.5 text-sm font-light text-neutral-700 hover:bg-neutral-50 transition-colors flex items-center gap-2"
              >
                <.icon name="hero-globe-alt" class="w-3.5 h-3.5 text-neutral-300 shrink-0" />
                {name}
              </button>
            <% end %>
          </div>
        <% end %>
      </div>

      <div class="flex items-center gap-1 flex-wrap">
        <button
          phx-click="filter_lifecycle"
          phx-value-lifecycle=""
          class={[
            "px-3 py-1.5 text-xs font-light border transition-colors",
            if(is_nil(@lifecycle_filter),
              do: "border-neutral-900 text-neutral-900 bg-neutral-50",
              else: "border-neutral-200 text-neutral-500 hover:border-neutral-400"
            )
          ]}
        >
          All
        </button>
        <%= for {state, label, color} <- lifecycle_options() do %>
          <button
            phx-click="filter_lifecycle"
            phx-value-lifecycle={state}
            class={[
              "px-3 py-1.5 text-xs font-light border transition-colors flex items-center gap-1.5",
              if(@lifecycle_filter == state,
                do: "border-neutral-900 text-neutral-900 bg-neutral-50",
                else: "border-neutral-200 text-neutral-500 hover:border-neutral-400"
              )
            ]}
          >
            <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
            {label}
          </button>
        <% end %>
      </div>
    </div>

    <%!-- Applied filters chips --%>
    <%= if @search != "" || not is_nil(@lifecycle_filter) do %>
      <div class="flex items-center gap-2 mb-5 flex-wrap">
        <span class="text-xs font-light text-neutral-400 uppercase tracking-wide">Filters:</span>
        <%= if @search != "" do %>
          <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 border border-neutral-300 text-xs font-light text-neutral-700">
            <.icon name="hero-magnifying-glass" class="w-3 h-3 text-neutral-400" />
            {@search}
            <button
              phx-click="clear_search"
              class="ml-0.5 text-neutral-400 hover:text-neutral-700 transition-colors"
              aria-label="Remove search filter"
            >
              <.icon name="hero-x-mark" class="w-3.5 h-3.5" />
            </button>
          </span>
        <% end %>
        <%= if not is_nil(@lifecycle_filter) do %>
          <% {_state, label, color} =
            Enum.find(lifecycle_options(), fn {s, _, _} -> s == @lifecycle_filter end) %>
          <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 border border-neutral-300 text-xs font-light text-neutral-700">
            <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
            {label}
            <button
              phx-click="filter_lifecycle"
              phx-value-lifecycle=""
              class="ml-0.5 text-neutral-400 hover:text-neutral-700 transition-colors"
              aria-label="Remove lifecycle filter"
            >
              <.icon name="hero-x-mark" class="w-3.5 h-3.5" />
            </button>
          </span>
        <% end %>
        <button
          phx-click="clear_filters"
          class="text-xs font-light text-neutral-400 hover:text-neutral-700 transition-colors underline underline-offset-2"
        >
          Clear all
        </button>
      </div>
    <% end %>

    <%!-- Main content --%>
    <%= if @total == 0 && @search == "" && is_nil(@lifecycle_filter) do %>
      <%!-- Empty state: no domains at all --%>
      <div class="text-center py-20 border border-neutral-200">
        <.icon name="hero-globe-alt" class="w-8 h-8 text-neutral-300 mx-auto mb-4" />
        <h3 class="text-sm font-light tracking-wide uppercase text-neutral-500 mb-2">
          No domains yet
        </h3>
        <p class="text-sm font-light text-neutral-400 mb-6">
          Add your first domain or import a list
        </p>
        <div class="flex items-center justify-center gap-3">
          <.link patch={~p"/domains/import"} class="btn-line text-xs">Import list</.link>
          <.link patch={~p"/domains/new"} class="btn-line-filled text-xs">Add domain</.link>
        </div>
      </div>
    <% else %>
      <%= if @domains == [] do %>
        <%!-- No results for active filters --%>
        <div class="text-center py-20 border border-neutral-200">
          <.icon name="hero-magnifying-glass" class="w-8 h-8 text-neutral-300 mx-auto mb-4" />
          <h3 class="text-sm font-light tracking-wide uppercase text-neutral-500 mb-2">
            No results
          </h3>
          <p class="text-sm font-light text-neutral-400 mb-6">
            No domains match your current filters
          </p>
          <button phx-click="clear_filters" class="btn-line text-xs">
            Clear filters
          </button>
        </div>
      <% else %>
        <%!-- Domain list --%>
        <div class="border border-neutral-200 divide-y divide-neutral-100">
          <%= for domain <- @domains do %>
            <div id={"domain-#{domain.id}"}>
              <div
                class="flex items-center justify-between py-4 px-6 hover:bg-neutral-50 transition-colors cursor-pointer"
                phx-click="toggle_expand"
                phx-value-id={domain.id}
              >
                <div class="flex items-center gap-4">
                  <div class="relative" id={"lifecycle-menu-#{domain.id}"}>
                    <button
                      phx-click="open_lifecycle_menu"
                      phx-value-id={domain.id}
                      phx-stop
                      class={[
                        "w-2 h-2 rounded-full transition-transform hover:scale-150 cursor-pointer",
                        lifecycle_color(domain.lifecycle_state)
                      ]}
                      title={domain.lifecycle_state}
                    >
                    </button>
                    <%= if @lifecycle_menu_open == "#{domain.id}" do %>
                      <div
                        class="absolute left-0 top-5 z-50 bg-white border border-neutral-200 rounded-lg shadow-lg py-1 min-w-[160px]"
                        phx-click-away="close_lifecycle_menu"
                      >
                        <%= for {state, label, color} <- lifecycle_options() do %>
                          <button
                            phx-click="set_lifecycle"
                            phx-value-id={domain.id}
                            phx-value-state={state}
                            class={[
                              "w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-neutral-50 transition-colors",
                              domain.lifecycle_state == state && "font-medium"
                            ]}
                          >
                            <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
                            {label}
                          </button>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                  <div class="flex items-center gap-3">
                    <.link
                      navigate={~p"/domains/#{domain.id}"}
                      class="text-sm font-normal hover:underline"
                      phx-stop
                    >
                      {domain.name}
                    </.link>
                    <%= if domain.subdomains != [] do %>
                      <span class="text-xs font-light text-neutral-400">
                        {length(domain.subdomains)} subdomains
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="flex items-center gap-6 text-xs font-light text-neutral-500">
                  <span :if={domain.hosting_platform} class="hidden sm:inline">
                    {domain.hosting_platform}
                  </span>
                  <span :if={domain.domain_registrar} class="hidden md:inline">
                    {domain.domain_registrar}
                  </span>

                  <div class="flex items-center gap-2">
                    <%= for tag <- domain.domain_tags do %>
                      <span class="px-2 py-0.5 border border-neutral-200 text-neutral-500 text-[10px] uppercase tracking-wide">
                        {tag.tag}
                      </span>
                    <% end %>
                  </div>

                  <button
                    phx-click="delete"
                    phx-value-id={domain.id}
                    data-confirm="Delete this domain?"
                    class="text-neutral-400 hover:text-red-600 transition-colors"
                    phx-stop
                  >
                    <.icon name="hero-trash" class="w-4 h-4" />
                  </button>
                </div>
              </div>

              <%= if MapSet.member?(@expanded_domains, "#{domain.id}") && domain.subdomains != [] do %>
                <div class="bg-neutral-50 border-t border-neutral-100 divide-y divide-neutral-100">
                  <%= for sub <- domain.subdomains do %>
                    <div class="flex items-center justify-between py-3 px-6 pl-12 hover:bg-neutral-100 transition-colors">
                      <div class="flex items-center gap-3">
                        <div class="relative" id={"lifecycle-menu-#{sub.id}"}>
                          <button
                            phx-click="open_lifecycle_menu"
                            phx-value-id={sub.id}
                            class={[
                              "w-1.5 h-1.5 rounded-full transition-transform hover:scale-150 cursor-pointer",
                              lifecycle_color(sub.lifecycle_state)
                            ]}
                            title={sub.lifecycle_state}
                          >
                          </button>
                          <%= if @lifecycle_menu_open == "#{sub.id}" do %>
                            <div
                              class="absolute left-0 top-4 z-50 bg-white border border-neutral-200 rounded-lg shadow-lg py-1 min-w-[160px]"
                              phx-click-away="close_lifecycle_menu"
                            >
                              <%= for {state, label, color} <- lifecycle_options() do %>
                                <button
                                  phx-click="set_lifecycle"
                                  phx-value-id={sub.id}
                                  phx-value-state={state}
                                  class={[
                                    "w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-neutral-50 transition-colors",
                                    sub.lifecycle_state == state && "font-medium"
                                  ]}
                                >
                                  <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}>
                                  </span>
                                  {label}
                                </button>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                        <.link
                          navigate={~p"/domains/#{sub.id}"}
                          class="text-sm font-light hover:underline"
                        >
                          {sub.name}
                        </.link>
                      </div>
                      <button
                        phx-click="delete"
                        phx-value-id={sub.id}
                        data-confirm="Delete this subdomain?"
                        class="text-neutral-400 hover:text-red-600 transition-colors"
                      >
                        <.icon name="hero-trash" class="w-3 h-3" />
                      </button>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%!-- Pagination --%>
      <%= if @total_pages > 1 do %>
        <div class="flex items-center justify-between mt-6 pt-4 border-t border-neutral-100">
          <button
            phx-click="paginate"
            phx-value-page={@page - 1}
            disabled={@page <= 1}
            class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <.icon name="hero-chevron-left" class="w-3 h-3" /> Previous
          </button>

          <div class="flex items-center gap-1">
            <%= for n <- page_range(@page, @total_pages) do %>
              <%= if n == :ellipsis do %>
                <span class="px-2 py-1 text-xs text-neutral-400">…</span>
              <% else %>
                <button
                  phx-click="paginate"
                  phx-value-page={n}
                  class={[
                    "w-8 h-8 text-xs border transition-colors",
                    if(@page == n,
                      do: "border-neutral-900 text-neutral-900 bg-neutral-50",
                      else: "border-transparent text-neutral-500 hover:border-neutral-200"
                    )
                  ]}
                >
                  {n}
                </button>
              <% end %>
            <% end %>
          </div>

          <button
            phx-click="paginate"
            phx-value-page={@page + 1}
            disabled={@page >= @total_pages}
            class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Next <.icon name="hero-chevron-right" class="w-3 h-3" />
          </button>
        </div>
      <% end %>
    <% end %>
  </div>

  <%!-- Modals --%>
  <%= if @live_action in [:new, :import] do %>
    <div class="fixed inset-0 bg-black/20 z-40" phx-click="close_modal"></div>
    <div class="fixed inset-x-0 top-20 bottom-8 mx-auto max-w-lg bg-white border border-neutral-200 z-50 p-8 overflow-y-auto">
      <%= case @live_action do %>
        <% :new -> %>
          <h2 class="text-xl font-light tracking-tight mb-6">Add Domain</h2>

          <.form
            for={@form}
            phx-change="validate"
            phx-submit="save"
            id="domain-form"
            class="space-y-6"
          >
            <.input field={@form[:type]} type="hidden" value="domain" />
            <.input
              field={@form[:name]}
              type="text"
              label="Domain name"
              placeholder="example.com"
              required
            />

            <div class="flex items-center gap-3 pt-4">
              <button type="submit" class="btn-line-filled flex-1 justify-center text-xs">
                Add domain
              </button>
              <.link patch={~p"/domains"} class="btn-line flex-1 justify-center text-xs">
                Cancel
              </.link>
            </div>
          </.form>
        <% :import -> %>
          <h2 class="text-xl font-light tracking-tight mb-1">Import Domains</h2>
          <p class="text-sm font-light text-neutral-400 mb-6">
            Upload a .txt file or paste domain names — one per line, apex domains only.
          </p>

          <%= if @import_results do %>
            <%!-- Summary --%>
            <div class="mb-6 space-y-4 text-sm font-light">
              <%!-- Stats row --%>
              <div class="grid grid-cols-4 divide-x divide-neutral-200 border border-neutral-200">
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-neutral-900">
                    {length(@import_results.added) + length(@import_results.skipped) +
                      length(@import_results.ignored) + length(@import_results.file_dupes)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">total</div>
                </div>
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-green-700">
                    {length(@import_results.added)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">added</div>
                </div>
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-neutral-500">
                    {length(@import_results.skipped)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">
                    existed
                  </div>
                </div>
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-amber-600">
                    {length(@import_results.ignored) + length(@import_results.file_dupes)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">
                    ignored
                  </div>
                </div>
              </div>

              <%!-- Added --%>
              <%= if @import_results.added != [] do %>
                <details open class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-green-700 select-none">
                    Added ({length(@import_results.added)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-32 overflow-y-auto">
                    <%= for name <- @import_results.added do %>
                      <li class="px-4 py-1.5 font-mono text-xs text-neutral-700">{name}</li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <%!-- Skipped (already existed) --%>
              <%= if @import_results.skipped != [] do %>
                <details class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-neutral-500 select-none">
                    Already existed ({length(@import_results.skipped)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-32 overflow-y-auto">
                    <%= for name <- @import_results.skipped do %>
                      <li class="px-4 py-1.5 font-mono text-xs text-neutral-500">{name}</li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <%!-- Ignored (invalid/non-apex) --%>
              <%= if @import_results.ignored != [] do %>
                <details class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-amber-600 select-none">
                    Ignored — invalid or non-apex ({length(@import_results.ignored)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-40 overflow-y-auto">
                    <%= for {name, reason} <- @import_results.ignored do %>
                      <li class="px-4 py-1.5 flex items-baseline gap-3">
                        <span class="font-mono text-xs text-neutral-700">{name}</span>
                        <span class="text-xs text-amber-600">{reason}</span>
                      </li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <%!-- Duplicates within file --%>
              <%= if @import_results.file_dupes != [] do %>
                <details class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-amber-600 select-none">
                    Duplicates in file ({length(@import_results.file_dupes)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-32 overflow-y-auto">
                    <%= for name <- @import_results.file_dupes do %>
                      <li class="px-4 py-1.5 font-mono text-xs text-neutral-500">{name}</li>
                    <% end %>
                  </ul>
                </details>
              <% end %>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button
                phx-click="close_modal"
                class="btn-line-filled flex-1 justify-center text-xs"
              >
                Done
              </button>
              <button
                phx-click="clear_import_results"
                class="btn-line flex-1 justify-center text-xs"
              >
                Import more
              </button>
            </div>
          <% else %>
            <%!-- Loading overlay --%>
            <%= if @importing do %>
              <div class="py-12 flex flex-col items-center gap-4 text-sm font-light text-neutral-500">
                <svg class="w-6 h-6 animate-spin text-neutral-400" fill="none" viewBox="0 0 24 24">
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                </svg>
                <span>Processing domains…</span>
              </div>
            <% else %>
              <%!-- File upload form --%>
              <form
                phx-submit="import_file"
                phx-change="validate_upload"
                id="import-file-form"
                class="mb-4"
              >
                <%!-- Drop zone / file picker --%>
                <label class={[
                  "flex flex-col items-center gap-3 p-6 border text-center cursor-pointer transition-colors mb-4",
                  if(Enum.empty?(@uploads.domains_file.entries),
                    do:
                      "border-neutral-200 hover:border-neutral-400 text-neutral-400 hover:text-neutral-700",
                    else: "border-neutral-900 text-neutral-900"
                  )
                ]}>
                  <%= if Enum.empty?(@uploads.domains_file.entries) do %>
                    <.icon name="hero-arrow-up-tray" class="w-7 h-7 text-neutral-300" />
                    <div>
                      <p class="text-sm font-light">
                        Click to select a <span class="font-normal">.txt</span> file
                      </p>
                      <p class="text-xs text-neutral-400 mt-0.5">One domain per line, max 5 MB</p>
                    </div>
                  <% else %>
                    <% entry = hd(@uploads.domains_file.entries) %>
                    <.icon name="hero-document-text" class="w-7 h-7 text-neutral-500" />
                    <div class="w-full">
                      <p class="text-sm font-light text-neutral-700">{entry.client_name}</p>
                      <p class="text-xs text-neutral-400 mt-0.5">
                        {Float.round(entry.client_size / 1024, 1)} KB
                      </p>
                      <%!-- Progress bar --%>
                      <div class="mt-3 w-full bg-neutral-100 h-px">
                        <div
                          class="bg-neutral-900 h-px transition-all duration-300"
                          style={"width: #{entry.progress}%"}
                        >
                        </div>
                      </div>
                      <%= if entry.progress < 100 do %>
                        <p class="text-xs text-neutral-400 mt-1">Uploading… {entry.progress}%</p>
                      <% else %>
                        <p class="text-xs text-green-700 mt-1">Ready to import</p>
                      <% end %>
                    </div>
                    <%!-- Errors --%>
                    <%= for err <- upload_errors(@uploads.domains_file, entry) do %>
                      <p class="text-xs text-red-600">{Phoenix.Naming.humanize(err)}</p>
                    <% end %>
                  <% end %>
                  <.live_file_input upload={@uploads.domains_file} class="sr-only" />
                </label>

                <button
                  type="submit"
                  class={[
                    "btn-line-filled w-full justify-center text-xs",
                    "disabled:opacity-40 disabled:cursor-not-allowed"
                  ]}
                  disabled={
                    Enum.empty?(@uploads.domains_file.entries) or
                      (not Enum.empty?(@uploads.domains_file.entries) and
                         hd(@uploads.domains_file.entries).progress < 100)
                  }
                >
                  <%= if not Enum.empty?(@uploads.domains_file.entries) and hd(@uploads.domains_file.entries).progress < 100 do %>
                    Uploading…
                  <% else %>
                    Import file
                  <% end %>
                </button>
              </form>

              <div class="relative flex items-center my-4">
                <div class="flex-1 border-t border-neutral-200"></div>
                <span class="mx-3 text-xs text-neutral-400 uppercase tracking-wide">
                  or paste
                </span>
                <div class="flex-1 border-t border-neutral-200"></div>
              </div>

              <%!-- Paste form --%>
              <.form for={%{}} as={:import} phx-submit="import" id="import-paste-form">
                <textarea
                  name="import[domains]"
                  rows="7"
                  class="w-full px-0 py-3 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm font-light font-mono resize-none mb-4"
                  placeholder="example.com\nexample.co.uk\nmy-brand.de"
                  required
                ></textarea>
                <button type="submit" class="btn-line-filled w-full justify-center text-xs">
                  Import pasted
                </button>
              </.form>

              <.link patch={~p"/domains"} class="btn-line w-full justify-center text-xs mt-3">
                Cancel
              </.link>
            <% end %>
          <% end %>
      <% end %>
    </div>
  <% end %>
</Layouts.app>
