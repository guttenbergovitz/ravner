<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <%!-- Header --%>
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Domains</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          <%= if @total == 0 && @search == "" && is_nil(@lifecycle_filter) do %>
            No domains yet
          <% else %>
            {@total} domain{if @total != 1, do: "s", else: ""}
            <%= if @total_pages > 1 do %>
              <span class="text-neutral-300 mx-1">·</span>page {@page} of {@total_pages}
            <% end %>
          <% end %>
        </p>
      </div>

      <%= if @selection_mode do %>
        <%!-- Action bar (replaces header buttons in selection mode) --%>
        <div class="flex items-center gap-3 flex-wrap justify-end">
          <%!-- Select all controls --%>
          <div class="flex items-center gap-2 text-xs font-light text-neutral-500">
            <button
              phx-click="select_all_matching"
              class="flex items-center gap-1.5 px-2.5 py-1.5 border border-neutral-200 hover:border-neutral-400 transition-colors"
            >
              <.icon name="hero-check" class="w-3 h-3" /> All matching ({@total})
            </button>
            <button
              phx-click="select_visible"
              class="flex items-center gap-1.5 px-2.5 py-1.5 border border-neutral-200 hover:border-neutral-400 transition-colors"
            >
              <.icon name="hero-eye" class="w-3 h-3" /> Visible ({length(@domains)})
            </button>
          </div>

          <span class="text-xs text-neutral-300">·</span>
          <span class="text-xs font-light text-neutral-700">
            {MapSet.size(@selected_ids)} selected
          </span>

          <%!-- Include subdomains --%>
          <button
            phx-click="toggle_include_subdomains"
            class={[
              "flex items-center gap-1.5 px-2.5 py-1.5 border text-xs font-light transition-colors",
              if(@include_subdomains,
                do: "border-neutral-900 text-neutral-900 bg-neutral-50",
                else: "border-neutral-200 text-neutral-500 hover:border-neutral-400"
              )
            ]}
          >
            <span class={[
              "w-3.5 h-3.5 border flex items-center justify-center shrink-0",
              if(@include_subdomains,
                do: "border-neutral-900 bg-neutral-900",
                else: "border-neutral-400"
              )
            ]}>
              <%= if @include_subdomains do %>
                <.icon name="hero-check" class="w-2.5 h-2.5 text-white" />
              <% end %>
            </span>
            Incl. subdomains
          </button>

          <%!-- Set status --%>
          <div class="relative" id="bulk-lifecycle-menu">
            <button
              phx-click="toggle_bulk_lifecycle_menu"
              disabled={MapSet.size(@selected_ids) == 0}
              class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1.5"
            >
              <.icon name="hero-tag" class="w-4 h-4" /> Set status
              <.icon name="hero-chevron-down" class="w-3 h-3" />
            </button>
            <%= if @bulk_lifecycle_menu_open do %>
              <div
                class="absolute right-0 top-full mt-1 z-30 bg-white border border-neutral-200 py-1 min-w-[170px]"
                phx-click-away="close_bulk_lifecycle_menu"
              >
                <%= for {state, label, color} <- lifecycle_options() do %>
                  <button
                    phx-click="bulk_action_confirm"
                    phx-value-lifecycle={state}
                    class="w-full flex items-center gap-2 px-3 py-2 text-xs font-light text-left hover:bg-neutral-50 transition-colors"
                  >
                    <span class={["w-2 h-2 rounded-full shrink-0", color]}></span>
                    {label}
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>

          <%!-- Scan --%>
          <button
            phx-click="bulk_action_confirm"
            phx-value-action="scan"
            disabled={MapSet.size(@selected_ids) == 0}
            class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <.icon name="hero-magnifying-glass-circle" class="w-4 h-4" /> Scan
          </button>

          <%!-- Delete (editors/admins only) --%>
          <%= if editor?(@current_scope) do %>
            <button
              phx-click="bulk_action_confirm"
              phx-value-action="delete"
              disabled={MapSet.size(@selected_ids) == 0}
              class="text-xs font-light border border-red-200 text-red-600 hover:border-red-500 px-3 py-1.5 transition-colors flex items-center gap-1.5 disabled:opacity-40 disabled:cursor-not-allowed"
            >
              <.icon name="hero-trash" class="w-4 h-4" /> Delete
            </button>
          <% end %>

          <button phx-click="exit_selection_mode" class="btn-line text-xs">
            <.icon name="hero-x-mark" class="w-4 h-4" /> Cancel
          </button>
        </div>
      <% else %>
        <%!-- Normal header buttons --%>
        <div class="flex items-center gap-3">
          <button phx-click="enter_selection_mode" class="btn-line text-xs">
            <.icon name="hero-square-2-stack" class="w-4 h-4" /> Select
          </button>
          <.link patch={~p"/domains/import"} class="btn-line text-xs">
            <.icon name="hero-arrow-up-tray" class="w-4 h-4" /> Import
          </.link>
          <.link patch={~p"/domains/new"} class="btn-line-filled text-xs">
            <.icon name="hero-plus" class="w-4 h-4" /> Add domain
          </.link>
        </div>
      <% end %>
    </div>

    <%!-- Toolbar: search + IP on one row --%>
    <div class="flex flex-col sm:flex-row gap-3 mb-3">
      <%!-- Search with autocomplete --%>
      <div class="relative flex-1" id="search-wrapper">
        <form phx-submit="search" phx-change="suggest" id="search-form">
          <.icon
            name="hero-magnifying-glass"
            class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
          />
          <input
            type="text"
            name="search"
            id="search-input"
            value={@search}
            placeholder="Search domains…"
            phx-debounce="150"
            phx-blur="dismiss_suggestions"
            autocomplete="off"
            class="w-full pl-9 pr-4 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
          />
        </form>

        <%!-- Suggestions dropdown --%>
        <%= if @suggestions != [] do %>
          <div class="absolute left-0 right-0 top-full z-30 bg-white border border-neutral-200 border-t-0 divide-y divide-neutral-100">
            <%= for name <- @suggestions do %>
              <button
                phx-mousedown="select_suggestion"
                phx-value-name={name}
                class="w-full text-left px-4 py-2.5 text-sm font-light text-neutral-700 hover:bg-neutral-50 transition-colors flex items-center gap-2"
              >
                <.icon name="hero-globe-alt" class="w-3.5 h-3.5 text-neutral-300 shrink-0" />
                {name}
              </button>
            <% end %>
          </div>
        <% end %>
      </div>

      <%!-- IP filter --%>
      <div class="relative w-full sm:w-48">
        <.icon
          name="hero-globe-europe-africa"
          class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-neutral-400 pointer-events-none"
        />
        <input
          type="text"
          name="ip"
          value={@ip_filter}
          placeholder="Filter by IP…"
          phx-change="filter_ip"
          phx-debounce="300"
          autocomplete="off"
          class="w-full pl-9 pr-4 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
        />
      </div>
    </div>

    <%!-- Toolbar row 2: lifecycle filters --%>
    <div class="flex items-center gap-1 flex-wrap mb-4">
      <button
        phx-click="filter_lifecycle"
        phx-value-lifecycle=""
        class={[
          "px-3 py-1.5 text-xs font-light border transition-colors",
          if(is_nil(@lifecycle_filter),
            do: "border-neutral-900 text-neutral-900 bg-neutral-50",
            else: "border-neutral-200 text-neutral-500 hover:border-neutral-400"
          )
        ]}
      >
        All
      </button>
      <%= for {state, label, color} <- lifecycle_options() do %>
        <button
          phx-click="filter_lifecycle"
          phx-value-lifecycle={state}
          class={[
            "px-3 py-1.5 text-xs font-light border transition-colors flex items-center gap-1.5",
            if(@lifecycle_filter == state,
              do: "border-neutral-900 text-neutral-900 bg-neutral-50",
              else: "border-neutral-200 text-neutral-500 hover:border-neutral-400"
            )
          ]}
        >
          <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
          {label}
        </button>
      <% end %>
    </div>

    <%!-- Applied filters chips --%>
    <%= if @search != "" || @ip_filter != "" || not is_nil(@lifecycle_filter) do %>
      <div class="flex items-center gap-2 mb-5 flex-wrap">
        <span class="text-xs font-light text-neutral-400 uppercase tracking-wide">Filters:</span>
        <%= if @search != "" do %>
          <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 border border-neutral-300 text-xs font-light text-neutral-700">
            <.icon name="hero-magnifying-glass" class="w-3 h-3 text-neutral-400" />
            {@search}
            <button
              phx-click="clear_search"
              class="ml-0.5 text-neutral-400 hover:text-neutral-700 transition-colors"
              aria-label="Remove search filter"
            >
              <.icon name="hero-x-mark" class="w-3.5 h-3.5" />
            </button>
          </span>
        <% end %>
        <%= if @ip_filter != "" do %>
          <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 border border-neutral-300 text-xs font-light text-neutral-700">
            <.icon name="hero-globe-europe-africa" class="w-3 h-3 text-neutral-400" />
            {@ip_filter}
            <button
              phx-click="clear_ip"
              class="ml-0.5 text-neutral-400 hover:text-neutral-700 transition-colors"
              aria-label="Remove IP filter"
            >
              <.icon name="hero-x-mark" class="w-3.5 h-3.5" />
            </button>
          </span>
        <% end %>
        <%= if not is_nil(@lifecycle_filter) do %>
          <% {_state, label, color} =
            Enum.find(lifecycle_options(), fn {s, _, _} -> s == @lifecycle_filter end) %>
          <span class="inline-flex items-center gap-1.5 pl-2.5 pr-1.5 py-1 border border-neutral-300 text-xs font-light text-neutral-700">
            <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
            {label}
            <button
              phx-click="filter_lifecycle"
              phx-value-lifecycle=""
              class="ml-0.5 text-neutral-400 hover:text-neutral-700 transition-colors"
              aria-label="Remove lifecycle filter"
            >
              <.icon name="hero-x-mark" class="w-3.5 h-3.5" />
            </button>
          </span>
        <% end %>
        <button
          phx-click="clear_filters"
          class="text-xs font-light text-neutral-400 hover:text-neutral-700 transition-colors underline underline-offset-2"
        >
          Clear all
        </button>
      </div>
    <% end %>

    <%!-- Main content --%>
    <%= if @total == 0 && @search == "" && is_nil(@lifecycle_filter) do %>
      <%!-- Empty state: no domains at all --%>
      <div class="text-center py-20 border border-neutral-200">
        <.icon name="hero-globe-alt" class="w-8 h-8 text-neutral-300 mx-auto mb-4" />
        <h3 class="text-sm font-light tracking-wide uppercase text-neutral-500 mb-2">
          No domains yet
        </h3>
        <p class="text-sm font-light text-neutral-400 mb-6">
          Add your first domain or import a list
        </p>
        <div class="flex items-center justify-center gap-3">
          <.link patch={~p"/domains/import"} class="btn-line text-xs">Import list</.link>
          <.link patch={~p"/domains/new"} class="btn-line-filled text-xs">Add domain</.link>
        </div>
      </div>
    <% else %>
      <%= if @domains == [] do %>
        <%!-- No results for active filters --%>
        <div class="text-center py-20 border border-neutral-200">
          <.icon name="hero-magnifying-glass" class="w-8 h-8 text-neutral-300 mx-auto mb-4" />
          <h3 class="text-sm font-light tracking-wide uppercase text-neutral-500 mb-2">
            No results
          </h3>
          <p class="text-sm font-light text-neutral-400 mb-6">
            No domains match your current filters
          </p>
          <button phx-click="clear_filters" class="btn-line text-xs">
            Clear filters
          </button>
        </div>
      <% else %>
        <%!-- Domain list --%>
        <div class="border border-neutral-200 divide-y divide-neutral-100">
          <%= for domain <- @domains do %>
            <% selected = MapSet.member?(@selected_ids, "#{domain.id}") %>
            <% scanning = MapSet.member?(@scanning_ids, "#{domain.id}") %>
            <div
              id={"domain-#{domain.id}"}
              class={[
                selected && "bg-neutral-50",
                scanning && "opacity-50"
              ]}
            >
              <div
                class="flex items-center justify-between py-4 px-6 hover:bg-neutral-50 transition-colors cursor-pointer"
                phx-click="toggle_expand"
                phx-value-id={domain.id}
              >
                <div class="flex items-center gap-4">
                  <%!-- Checkbox (visible only in selection mode) --%>
                  <%= if @selection_mode do %>
                    <span
                      phx-click="toggle_select"
                      phx-value-id={domain.id}
                      phx-stop
                      class={[
                        "w-4 h-4 border flex items-center justify-center shrink-0 transition-colors cursor-pointer",
                        if(selected,
                          do: "border-neutral-900 bg-neutral-900",
                          else: "border-neutral-300 hover:border-neutral-600"
                        )
                      ]}
                    >
                      <%= if selected do %>
                        <.icon name="hero-check" class="w-3 h-3 text-white" />
                      <% end %>
                    </span>
                  <% end %>

                  <div class="relative" id={"lifecycle-menu-#{domain.id}"}>
                    <button
                      phx-click="open_lifecycle_menu"
                      phx-value-id={domain.id}
                      phx-stop
                      class={[
                        "w-2 h-2 rounded-full transition-transform hover:scale-150 cursor-pointer",
                        lifecycle_color(domain.lifecycle_state)
                      ]}
                      title={domain.lifecycle_state}
                    >
                    </button>
                    <%= if @lifecycle_menu_open == "#{domain.id}" do %>
                      <div
                        class="absolute left-0 top-5 z-50 bg-white border border-neutral-200 rounded-lg shadow-lg py-1 min-w-[160px]"
                        phx-click-away="close_lifecycle_menu"
                      >
                        <%= for {state, label, color} <- lifecycle_options() do %>
                          <button
                            phx-click="set_lifecycle"
                            phx-value-id={domain.id}
                            phx-value-state={state}
                            class={[
                              "w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-neutral-50 transition-colors",
                              domain.lifecycle_state == state && "font-medium"
                            ]}
                          >
                            <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}></span>
                            {label}
                          </button>
                        <% end %>
                      </div>
                    <% end %>
                  </div>

                  <div class="flex items-center gap-3">
                    <.link
                      navigate={~p"/domains/#{domain.id}"}
                      class="text-sm font-normal hover:underline"
                      phx-stop
                    >
                      {domain.name}
                    </.link>
                    <%= if domain.subdomains != [] do %>
                      <span class="text-xs font-light text-neutral-400">
                        {length(domain.subdomains)} subdomains
                      </span>
                    <% end %>
                  </div>
                </div>

                <div class="flex items-center gap-4 text-xs font-light text-neutral-500 shrink-0">
                  <%!-- HTTP status / redirect --%>
                  <%= if meta = domain.domain_metadata do %>
                    <%= cond do %>
                      <% meta.final_url && (meta.http_status in [301, 302, 303, 307, 308] || external_redirect?(domain.name, meta.final_url)) -> %>
                        <% target = URI.parse(meta.final_url).host || meta.final_url %>
                        <span class="flex items-center gap-1 text-amber-600">
                          <span class="font-normal">{meta.http_status}</span>
                          <.icon name="hero-arrow-right" class="w-3 h-3" />
                          <a
                            href={meta.final_url}
                            target="_blank"
                            rel="noopener noreferrer"
                            phx-stop
                            class="max-w-[140px] truncate hover:underline inline-flex items-center gap-1 group"
                          >
                            <span class="truncate">{target}</span>
                            <.icon
                              name="hero-arrow-top-right-on-square"
                              class="w-3 h-3 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                            />
                          </a>
                        </span>
                      <% meta.http_status == 200 -> %>
                        <a
                          href={meta.final_url || "https://#{domain.name}"}
                          target="_blank"
                          rel="noopener noreferrer"
                          phx-stop
                          class="text-green-600 font-normal hover:underline inline-flex items-center gap-1 group"
                        >
                          200 OK
                          <.icon
                            name="hero-arrow-top-right-on-square"
                            class="w-3 h-3 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                          />
                        </a>
                      <% meta.http_status && meta.http_status > 0 -> %>
                        <a
                          href={meta.final_url || "https://#{domain.name}"}
                          target="_blank"
                          rel="noopener noreferrer"
                          phx-stop
                          class="text-red-500 font-normal hover:underline inline-flex items-center gap-1 group"
                        >
                          {meta.http_status}
                          <.icon
                            name="hero-arrow-top-right-on-square"
                            class="w-3 h-3 shrink-0 opacity-0 group-hover:opacity-100 transition-opacity"
                          />
                        </a>
                      <% meta.http_scanned_at != nil -> %>
                        <span class="text-neutral-300">no response</span>
                      <% true -> %>
                        <span class="text-neutral-300">–</span>
                    <% end %>

                    <%!-- IP address --%>
                    <%= if meta.ip_v4 && meta.ip_v4 != [] do %>
                      <span
                        class="hidden md:inline text-neutral-400 font-mono text-[10px] tracking-tight"
                        title={Enum.join(meta.ip_v4, ", ")}
                      >
                        {List.first(meta.ip_v4)}
                      </span>
                      <button
                        id={"copy-ip-#{domain.id}"}
                        phx-hook="Copy"
                        data-copy={List.first(meta.ip_v4)}
                        class="hidden md:inline-flex text-neutral-400 hover:text-neutral-700 transition-colors"
                        title="Copy IP"
                      >
                        <.icon name="hero-clipboard" class="w-3 h-3" />
                      </button>
                      <script :type={Phoenix.LiveView.ColocatedHook} name=".Copy">
                        export default {
                          mounted() {
                            this.el.addEventListener("click", e => {
                              e.stopPropagation();
                              const text = this.el.getAttribute("data-copy");
                              navigator.clipboard.writeText(text).catch(() => {});
                            });
                          }
                        }
                      </script>
                    <% end %>

                    <%!-- Tech stack (first 2) --%>
                    <%= if meta.tech_stack && meta.tech_stack != [] do %>
                      <span class="hidden lg:inline text-neutral-400 max-w-[160px] truncate">
                        {meta.tech_stack |> Enum.take(2) |> Enum.join(", ")}
                      </span>
                    <% end %>

                    <%!-- Last scanned --%>
                    <%= if meta.scanned_at do %>
                      <span
                        class="hidden xl:inline text-neutral-300"
                        title={to_string(meta.scanned_at)}
                      >
                        {Ravner.Formatting.time_ago(meta.scanned_at)}
                      </span>
                    <% end %>
                  <% else %>
                    <span class="text-neutral-300">not scanned</span>
                  <% end %>

                  <%!-- Tags --%>
                  <div class="flex items-center gap-1">
                    <%= for tag <- domain.domain_tags do %>
                      <span class="px-1.5 py-0.5 border border-neutral-200 text-neutral-400 text-[10px] uppercase tracking-wide">
                        {tag.tag}
                      </span>
                    <% end %>
                  </div>

                  <%= if not @selection_mode do %>
                    <button
                      phx-click="quick_scan"
                      phx-value-id={domain.id}
                      phx-stop
                      disabled={scanning}
                      class="text-neutral-400 hover:text-neutral-700 transition-colors disabled:cursor-not-allowed"
                      title={if scanning, do: "Scanning...", else: "Quick scan"}
                    >
                      <.icon
                        name="hero-arrow-path"
                        class={["w-4 h-4", scanning && "animate-spin"]}
                      />
                    </button>
                    <button
                      phx-click="delete"
                      phx-value-id={domain.id}
                      data-confirm="Delete this domain?"
                      class="text-neutral-400 hover:text-red-600 transition-colors"
                      phx-stop
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  <% end %>
                </div>
              </div>

              <%= if MapSet.member?(@expanded_domains, "#{domain.id}") && domain.subdomains != [] do %>
                <div class="bg-neutral-50 border-t border-neutral-100 divide-y divide-neutral-100">
                  <%= for sub <- domain.subdomains do %>
                    <% sub_scanning = MapSet.member?(@scanning_ids, "#{sub.id}") %>
                    <div class={[
                      "flex items-center justify-between py-3 px-6 pl-12 hover:bg-neutral-100 transition-colors",
                      sub_scanning && "opacity-50"
                    ]}>
                      <div class="flex items-center gap-3">
                        <div class="relative" id={"lifecycle-menu-#{sub.id}"}>
                          <button
                            phx-click="open_lifecycle_menu"
                            phx-value-id={sub.id}
                            phx-stop
                            class={[
                              "w-1.5 h-1.5 rounded-full transition-transform hover:scale-150 cursor-pointer",
                              lifecycle_color(sub.lifecycle_state)
                            ]}
                            title={sub.lifecycle_state}
                          >
                          </button>
                          <%= if @lifecycle_menu_open == "#{sub.id}" do %>
                            <div
                              class="absolute left-0 top-4 z-50 bg-white border border-neutral-200 rounded-lg shadow-lg py-1 min-w-[160px]"
                              phx-click-away="close_lifecycle_menu"
                            >
                              <%= for {state, label, color} <- lifecycle_options() do %>
                                <button
                                  phx-click="set_lifecycle"
                                  phx-value-id={sub.id}
                                  phx-value-state={state}
                                  phx-stop
                                  class={[
                                    "w-full flex items-center gap-2 px-3 py-1.5 text-xs text-left hover:bg-neutral-50 transition-colors",
                                    sub.lifecycle_state == state && "font-medium"
                                  ]}
                                >
                                  <span class={["w-1.5 h-1.5 rounded-full shrink-0", color]}>
                                  </span>
                                  {label}
                                </button>
                              <% end %>
                            </div>
                          <% end %>
                        </div>
                        <.link
                          navigate={~p"/domains/#{sub.id}"}
                          class="text-sm font-light hover:underline"
                        >
                          {sub.name}
                        </.link>

                        <%!-- Subdomain metadata --%>
                        <%= if sub_meta = sub.domain_metadata do %>
                          <%= cond do %>
                            <% sub_meta.final_url && (sub_meta.http_status in [301, 302, 303, 307, 308] || external_redirect?(sub.name, sub_meta.final_url)) -> %>
                              <% target = URI.parse(sub_meta.final_url).host || sub_meta.final_url %>
                              <span class="hidden sm:flex items-center gap-1 text-xs text-amber-600">
                                <span class="font-normal">{sub_meta.http_status}</span>
                                <.icon name="hero-arrow-right" class="w-3 h-3" />
                                <span class="max-w-[100px] truncate">{target}</span>
                              </span>
                            <% sub_meta.http_status == 200 -> %>
                              <span class="hidden sm:inline text-xs text-green-600 font-normal">
                                200 OK
                              </span>
                            <% sub_meta.http_status && sub_meta.http_status > 0 -> %>
                              <span class="hidden sm:inline text-xs text-red-500 font-normal">
                                {sub_meta.http_status}
                              </span>
                            <% true -> %>
                              <span></span>
                          <% end %>

                          <%= if sub_meta.ip_v4 && sub_meta.ip_v4 != [] do %>
                            <span
                              class="hidden md:inline text-neutral-400 font-mono text-[10px] tracking-tight"
                              title={Enum.join(sub_meta.ip_v4, ", ")}
                            >
                              {List.first(sub_meta.ip_v4)}
                            </span>
                            <button
                              id={"copy-ip-sub-#{sub.id}"}
                              phx-hook="Copy"
                              data-copy={List.first(sub_meta.ip_v4)}
                              class="hidden md:inline-flex text-neutral-400 hover:text-neutral-700 transition-colors"
                              title="Copy IP"
                            >
                              <.icon name="hero-clipboard" class="w-3 h-3" />
                            </button>
                          <% end %>

                          <%= if sub_meta.tech_stack && sub_meta.tech_stack != [] do %>
                            <span class="hidden lg:inline text-neutral-400 text-xs max-w-[120px] truncate">
                              {sub_meta.tech_stack |> Enum.take(2) |> Enum.join(", ")}
                            </span>
                          <% end %>
                        <% end %>
                      </div>

                      <%= if not @selection_mode do %>
                        <div class="flex items-center gap-2">
                          <button
                            phx-click="quick_scan"
                            phx-value-id={sub.id}
                            phx-stop
                            disabled={sub_scanning}
                            class="text-neutral-400 hover:text-neutral-700 transition-colors disabled:cursor-not-allowed"
                            title={if sub_scanning, do: "Scanning...", else: "Quick scan"}
                          >
                            <.icon
                              name="hero-arrow-path"
                              class={["w-3 h-3", sub_scanning && "animate-spin"]}
                            />
                          </button>
                          <button
                            phx-click="delete"
                            phx-value-id={sub.id}
                            data-confirm="Delete this subdomain?"
                            class="text-neutral-400 hover:text-red-600 transition-colors"
                          >
                            <.icon name="hero-trash" class="w-3 h-3" />
                          </button>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>

      <%!-- Pagination --%>
      <%= if @total_pages > 1 do %>
        <div class="flex items-center justify-between mt-6 pt-4 border-t border-neutral-100">
          <button
            phx-click="paginate"
            phx-value-page={@page - 1}
            disabled={@page <= 1}
            class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed"
          >
            <.icon name="hero-chevron-left" class="w-3 h-3" /> Previous
          </button>

          <div class="flex items-center gap-1">
            <%= for n <- page_range(@page, @total_pages) do %>
              <%= if n == :ellipsis do %>
                <span class="px-2 py-1 text-xs text-neutral-400">…</span>
              <% else %>
                <button
                  phx-click="paginate"
                  phx-value-page={n}
                  class={[
                    "w-8 h-8 text-xs border transition-colors",
                    if(@page == n,
                      do: "border-neutral-900 text-neutral-900 bg-neutral-50",
                      else: "border-transparent text-neutral-500 hover:border-neutral-200"
                    )
                  ]}
                >
                  {n}
                </button>
              <% end %>
            <% end %>
          </div>

          <button
            phx-click="paginate"
            phx-value-page={@page + 1}
            disabled={@page >= @total_pages}
            class="btn-line text-xs disabled:opacity-40 disabled:cursor-not-allowed"
          >
            Next <.icon name="hero-chevron-right" class="w-3 h-3" />
          </button>
        </div>
      <% end %>
    <% end %>
  </div>

  <%!-- Bulk action confirmation modal --%>
  <%= if @bulk_action != nil do %>
    <% selected_count = MapSet.size(@selected_ids) %>
    <% selected_names =
      @domains
      |> Enum.filter(&MapSet.member?(@selected_ids, "#{&1.id}"))
      |> Enum.map(& &1.name) %>
    <% subdomain_count =
      if @include_subdomains do
        @domains
        |> Enum.filter(&MapSet.member?(@selected_ids, "#{&1.id}"))
        |> Enum.reduce(0, fn d, acc -> acc + length(d.subdomains) end)
      else
        0
      end %>
    <div class="fixed inset-0 bg-black/20 z-40" phx-click="bulk_action_cancel"></div>
    <div class="fixed inset-x-0 top-20 mx-auto max-w-md bg-white border border-neutral-200 z-50 p-8">
      <h2 class="text-xl font-light tracking-tight mb-1">
        <%= cond do %>
          <% @bulk_action == :delete -> %>
            Delete {selected_count} domain{if selected_count != 1, do: "s", else: ""}
          <% @bulk_action == :scan -> %>
            Scan {selected_count} domain{if selected_count != 1, do: "s", else: ""}
          <% match?({:lifecycle, _}, @bulk_action) -> %>
            <% {:lifecycle, state} = @bulk_action %>
            <% {_, label, color} = Enum.find(lifecycle_options(), fn {s, _, _} -> s == state end) %>
            <span class="flex items-center gap-2">
              Set {selected_count} domain{if selected_count != 1, do: "s", else: ""} to
              <span class="flex items-center gap-1.5">
                <span class={["w-2 h-2 rounded-full", color]}></span>
                {label}
              </span>
            </span>
          <% true -> %>
        <% end %>
        <%= if @include_subdomains && subdomain_count > 0 do %>
          <span class="text-neutral-400">
            + {subdomain_count} subdomain{if subdomain_count != 1, do: "s", else: ""}
          </span>
        <% end %>
      </h2>

      <%= cond do %>
        <% @bulk_action == :delete -> %>
          <p class="text-sm font-light text-neutral-500 mb-6">This action cannot be undone.</p>
        <% @bulk_action == :scan -> %>
          <p class="text-sm font-light text-neutral-500 mb-6">All scans will run in parallel.</p>
        <% true -> %>
          <p class="text-sm font-light text-neutral-500 mb-6">
            This will overwrite existing lifecycle states.
          </p>
      <% end %>

      <%!-- Domain names preview --%>
      <ul class="mb-6 divide-y divide-neutral-100 border border-neutral-200">
        <%= for name <- Enum.take(selected_names, 5) do %>
          <li class="px-3 py-2 text-sm font-light font-mono text-neutral-700">{name}</li>
        <% end %>
        <%= if length(selected_names) > 5 do %>
          <li class="px-3 py-2 text-xs font-light text-neutral-400">
            + {length(selected_names) - 5} more
          </li>
        <% end %>
      </ul>

      <div class="flex items-center gap-3">
        <button
          phx-click="bulk_action_execute"
          class={[
            "btn-line-filled flex-1 justify-center text-xs",
            @bulk_action == :delete && "!border-red-600 !bg-red-600 hover:!bg-red-700"
          ]}
        >
          {if @bulk_action == :delete, do: "Delete", else: "Scan"}
        </button>
        <button phx-click="bulk_action_cancel" class="btn-line flex-1 justify-center text-xs">
          Cancel
        </button>
      </div>
    </div>
  <% end %>

  <%!-- New / Import modals --%>
  <%= if @live_action in [:new, :import] do %>
    <div class="fixed inset-0 bg-black/20 z-40" phx-click="close_modal"></div>
    <div class="fixed inset-x-0 top-20 bottom-8 mx-auto max-w-lg bg-white border border-neutral-200 z-50 p-8 overflow-y-auto">
      <%= case @live_action do %>
        <% :new -> %>
          <h2 class="text-xl font-light tracking-tight mb-6">Add Domain</h2>

          <.form
            for={@form}
            phx-change="validate"
            phx-submit="save"
            id="domain-form"
            class="space-y-6"
          >
            <.input field={@form[:type]} type="hidden" value="domain" />
            <.input
              field={@form[:name]}
              type="text"
              label="Domain name"
              placeholder="example.com"
              required
            />

            <div class="flex items-center gap-3 pt-4">
              <button type="submit" class="btn-line-filled flex-1 justify-center text-xs">
                Add domain
              </button>
              <.link patch={~p"/domains"} class="btn-line flex-1 justify-center text-xs">
                Cancel
              </.link>
            </div>
          </.form>
        <% :import -> %>
          <h2 class="text-xl font-light tracking-tight mb-1">Import Domains</h2>
          <p class="text-sm font-light text-neutral-400 mb-6">
            Upload a .txt file or paste domain names — one per line, apex domains only.
          </p>

          <%= if @import_results do %>
            <%!-- Summary --%>
            <div class="mb-6 space-y-4 text-sm font-light">
              <div class="grid grid-cols-4 divide-x divide-neutral-200 border border-neutral-200">
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-neutral-900">
                    {length(@import_results.added) + length(@import_results.skipped) +
                      length(@import_results.ignored) + length(@import_results.file_dupes)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">total</div>
                </div>
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-green-700">
                    {length(@import_results.added)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">added</div>
                </div>
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-neutral-500">
                    {length(@import_results.skipped)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">
                    existed
                  </div>
                </div>
                <div class="px-4 py-3 text-center">
                  <div class="text-xl font-normal text-amber-600">
                    {length(@import_results.ignored) + length(@import_results.file_dupes)}
                  </div>
                  <div class="text-xs text-neutral-400 uppercase tracking-wide mt-0.5">
                    ignored
                  </div>
                </div>
              </div>

              <%= if @import_results.added != [] do %>
                <details open class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-green-700 select-none">
                    Added ({length(@import_results.added)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-32 overflow-y-auto">
                    <%= for name <- @import_results.added do %>
                      <li class="px-4 py-1.5 font-mono text-xs text-neutral-700">{name}</li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <%= if @import_results.skipped != [] do %>
                <details class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-neutral-500 select-none">
                    Already existed ({length(@import_results.skipped)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-32 overflow-y-auto">
                    <%= for name <- @import_results.skipped do %>
                      <li class="px-4 py-1.5 font-mono text-xs text-neutral-500">{name}</li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <%= if @import_results.ignored != [] do %>
                <details class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-amber-600 select-none">
                    Ignored — invalid or non-apex ({length(@import_results.ignored)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-40 overflow-y-auto">
                    <%= for {name, reason} <- @import_results.ignored do %>
                      <li class="px-4 py-1.5 flex items-baseline gap-3">
                        <span class="font-mono text-xs text-neutral-700">{name}</span>
                        <span class="text-xs text-amber-600">{reason}</span>
                      </li>
                    <% end %>
                  </ul>
                </details>
              <% end %>

              <%= if @import_results.file_dupes != [] do %>
                <details class="border border-neutral-200">
                  <summary class="px-4 py-2 cursor-pointer text-xs uppercase tracking-wide text-amber-600 select-none">
                    Duplicates in file ({length(@import_results.file_dupes)})
                  </summary>
                  <ul class="divide-y divide-neutral-100 max-h-32 overflow-y-auto">
                    <%= for name <- @import_results.file_dupes do %>
                      <li class="px-4 py-1.5 font-mono text-xs text-neutral-500">{name}</li>
                    <% end %>
                  </ul>
                </details>
              <% end %>
            </div>

            <div class="flex items-center gap-3 pt-2">
              <button
                phx-click="close_modal"
                class="btn-line-filled flex-1 justify-center text-xs"
              >
                Done
              </button>
              <button
                phx-click="clear_import_results"
                class="btn-line flex-1 justify-center text-xs"
              >
                Import more
              </button>
            </div>
          <% else %>
            <%= if @importing do %>
              <div class="py-12 flex flex-col items-center gap-4 text-sm font-light text-neutral-500">
                <svg class="w-6 h-6 animate-spin text-neutral-400" fill="none" viewBox="0 0 24 24">
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="2"
                  />
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z" />
                </svg>
                <span>Processing domains…</span>
              </div>
            <% else %>
              <form
                phx-submit="import_file"
                phx-change="validate_upload"
                id="import-file-form"
                class="mb-4"
              >
                <label class={[
                  "flex flex-col items-center gap-3 p-6 border text-center cursor-pointer transition-colors mb-4",
                  if(Enum.empty?(@uploads.domains_file.entries),
                    do:
                      "border-neutral-200 hover:border-neutral-400 text-neutral-400 hover:text-neutral-700",
                    else: "border-neutral-900 text-neutral-900"
                  )
                ]}>
                  <%= if Enum.empty?(@uploads.domains_file.entries) do %>
                    <.icon name="hero-arrow-up-tray" class="w-7 h-7 text-neutral-300" />
                    <div>
                      <p class="text-sm font-light">
                        Click to select a <span class="font-normal">.txt</span> file
                      </p>
                      <p class="text-xs text-neutral-400 mt-0.5">One domain per line, max 5 MB</p>
                    </div>
                  <% else %>
                    <% entry = hd(@uploads.domains_file.entries) %>
                    <.icon name="hero-document-text" class="w-7 h-7 text-neutral-500" />
                    <div class="w-full">
                      <p class="text-sm font-light text-neutral-700">{entry.client_name}</p>
                      <p class="text-xs text-neutral-400 mt-0.5">
                        {Float.round(entry.client_size / 1024, 1)} KB
                      </p>
                      <div class="mt-3 w-full bg-neutral-100 h-px">
                        <div
                          class="bg-neutral-900 h-px transition-all duration-300"
                          style={"width: #{entry.progress}%"}
                        >
                        </div>
                      </div>
                      <%= if entry.progress < 100 do %>
                        <p class="text-xs text-neutral-400 mt-1">Uploading… {entry.progress}%</p>
                      <% else %>
                        <p class="text-xs text-green-700 mt-1">Ready to import</p>
                      <% end %>
                    </div>
                    <%= for err <- upload_errors(@uploads.domains_file, entry) do %>
                      <p class="text-xs text-red-600">{Phoenix.Naming.humanize(err)}</p>
                    <% end %>
                  <% end %>
                  <.live_file_input upload={@uploads.domains_file} class="sr-only" />
                </label>

                <button
                  type="submit"
                  class={[
                    "btn-line-filled w-full justify-center text-xs",
                    "disabled:opacity-40 disabled:cursor-not-allowed"
                  ]}
                  disabled={
                    Enum.empty?(@uploads.domains_file.entries) or
                      (not Enum.empty?(@uploads.domains_file.entries) and
                         hd(@uploads.domains_file.entries).progress < 100)
                  }
                >
                  <%= if not Enum.empty?(@uploads.domains_file.entries) and
                           hd(@uploads.domains_file.entries).progress < 100 do %>
                    Uploading…
                  <% else %>
                    Import file
                  <% end %>
                </button>
              </form>

              <div class="relative flex items-center my-4">
                <div class="flex-1 border-t border-neutral-200"></div>
                <span class="mx-3 text-xs text-neutral-400 uppercase tracking-wide">
                  or paste
                </span>
                <div class="flex-1 border-t border-neutral-200"></div>
              </div>

              <.form for={%{}} as={:import} phx-submit="import" id="import-paste-form">
                <textarea
                  name="import[domains]"
                  rows="7"
                  class="w-full px-0 py-3 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm font-light font-mono resize-none mb-4"
                  placeholder="example.com\nexample.co.uk\nmy-brand.de"
                  required
                ></textarea>
                <button type="submit" class="btn-line-filled w-full justify-center text-xs">
                  Import pasted
                </button>
              </.form>

              <.link patch={~p"/domains"} class="btn-line w-full justify-center text-xs mt-3">
                Cancel
              </.link>
            <% end %>
          <% end %>
      <% end %>
    </div>
  <% end %>
</Layouts.app>
