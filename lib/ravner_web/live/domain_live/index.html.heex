<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Domains</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          <%= if @domains == [] do %>
            No domains yet
          <% else %>
            Manage your domain ecosystem
          <% end %>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <.link patch={~p"/domains/import"} class="btn-line text-xs">
          <.icon name="hero-arrow-up-tray" class="w-4 h-4" />
          Import
        </.link>
        <.link patch={~p"/domains/new"} class="btn-line-filled text-xs">
          <.icon name="hero-plus" class="w-4 h-4" />
          Add domain
        </.link>
      </div>
    </div>

    <%= if @domains == [] do %>
      <div class="text-center py-20 border border-neutral-200">
        <.icon name="hero-globe-alt" class="w-8 h-8 text-neutral-300 mx-auto mb-4" />
        <h3 class="text-sm font-light tracking-wide uppercase text-neutral-500 mb-2">No domains yet</h3>
        <p class="text-sm font-light text-neutral-400 mb-6">Add your first domain or import a list</p>
        <div class="flex items-center justify-center gap-3">
          <.link patch={~p"/domains/import"} class="btn-line text-xs">Import list</.link>
          <.link patch={~p"/domains/new"} class="btn-line-filled text-xs">Add domain</.link>
        </div>
      </div>
    <% else %>
      <div class="border border-neutral-200 divide-y divide-neutral-100">
        <%= for domain <- @domains do %>
          <div id={"domain-#{domain.id}"}>
            <div class="flex items-center justify-between py-4 px-6 hover:bg-neutral-50 transition-colors cursor-pointer"
                 phx-click="toggle_expand"
                 phx-value-id={domain.id}>
              <div class="flex items-center gap-4">
                <div class={["w-2 h-2 rounded-full", lifecycle_color(domain.lifecycle_state)]} title={domain.lifecycle_state}></div>
                <div class="flex items-center gap-3">
                  <.link navigate={~p"/domains/#{domain.id}"} class="text-sm font-normal hover:underline" phx-stop>
                    {domain.name}
                  </.link>
                  <%= if domain.subdomains != [] do %>
                    <span class="text-xs font-light text-neutral-400">
                      {length(domain.subdomains)} subdomains
                    </span>
                  <% end %>
                </div>
              </div>

              <div class="flex items-center gap-6 text-xs font-light text-neutral-500">
                <span :if={domain.hosting_platform} class="hidden sm:inline">{domain.hosting_platform}</span>
                <span :if={domain.domain_registrar} class="hidden md:inline">{domain.domain_registrar}</span>

                <div class="flex items-center gap-2">
                  <%= for tag <- domain.domain_tags do %>
                    <span class="px-2 py-0.5 border border-neutral-200 text-neutral-500 text-[10px] uppercase tracking-wide"><%= tag.tag %></span>
                  <% end %>
                </div>

                <button
                  phx-click="delete"
                  phx-value-id={domain.id}
                  data-confirm="Delete this domain?"
                  class="text-neutral-400 hover:text-red-600 transition-colors"
                  phx-stop
                >
                  <.icon name="hero-trash" class="w-4 h-4" />
                </button>
              </div>
            </div>

            <%= if MapSet.member?(@expanded_domains, "#{domain.id}") && domain.subdomains != [] do %>
              <div class="bg-neutral-50 border-t border-neutral-100 divide-y divide-neutral-100">
                <%= for sub <- domain.subdomains do %>
                  <div class="flex items-center justify-between py-3 px-6 pl-12 hover:bg-neutral-100 transition-colors">
                    <div class="flex items-center gap-3">
                      <div class={["w-1.5 h-1.5 rounded-full", lifecycle_color(sub.lifecycle_state)]}></div>
                      <.link navigate={~p"/domains/#{sub.id}"} class="text-sm font-light hover:underline">
                        {sub.name}
                      </.link>
                    </div>
                    <button
                      phx-click="delete"
                      phx-value-id={sub.id}
                      data-confirm="Delete this subdomain?"
                      class="text-neutral-400 hover:text-red-600 transition-colors"
                    >
                      <.icon name="hero-trash" class="w-3 h-3" />
                    </button>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= if @live_action in [:new, :import] do %>
    <div class="fixed inset-0 bg-black/20 z-40" phx-click="close_modal"></div>
    <div class="fixed inset-x-0 top-20 bottom-8 mx-auto max-w-lg bg-white border border-neutral-200 z-50 p-8 overflow-y-auto">
      <%= case @live_action do %>
        <% :new -> %>
          <h2 class="text-xl font-light tracking-tight mb-6">Add Domain</h2>

          <.form for={@form} phx-change="validate" phx-submit="save" id="domain-form" class="space-y-6">
            <.input field={@form[:type]} type="hidden" value="domain" />
            <.input field={@form[:name]} type="text" label="Domain name" placeholder="example.com" required />

            <div class="flex items-center gap-3 pt-4">
              <button type="submit" class="btn-line-filled flex-1 justify-center text-xs">Add domain</button>
              <.link patch={~p"/domains"} class="btn-line flex-1 justify-center text-xs">Cancel</.link>
            </div>
          </.form>

        <% :import -> %>
          <h2 class="text-xl font-light tracking-tight mb-2">Import Domains</h2>
          <p class="text-sm font-light text-neutral-500 mb-6">One domain per line</p>

          <%= if @import_results do %>
            <div class="mb-6 p-4 border border-neutral-200 bg-neutral-50 text-sm font-light">
              <p>Total: <%= @import_results.total %></p>
              <p class="text-green-700">Successful: <%= @import_results.successful %></p>
              <%= if @import_results.failed != [] do %>
                <div class="mt-2 text-red-700">
                  <p class="font-normal mb-1">Failed:</p>
                  <ul class="list-disc list-inside space-y-1">
                    <%= for {:error, line, reason} <- @import_results.failed do %>
                      <li><%= line %>: <%= inspect(reason) %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>
          <% end %>

          <form phx-submit="import" id="import-form">
            <textarea
              name="domains"
              rows="10"
              class="w-full px-0 py-3 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm font-light resize-none mb-6"
              placeholder="example.com&#10;www.example.com&#10;api.example.com"
              required
            ></textarea>
            <div class="flex items-center gap-3">
              <button type="submit" class="btn-line-filled flex-1 justify-center text-xs">Import</button>
              <.link patch={~p"/domains"} class="btn-line flex-1 justify-center text-xs">Cancel</.link>
            </div>
          </form>
      <% end %>
    </div>
  <% end %>
</Layouts.app>
