<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1400px] mx-auto px-6 py-10">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        Ownership
      </.link>
      <%= if @project.organization do %>
        <%= if @project.organization.brand do %>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/ownership/brands/#{@project.organization.brand.id}"}
            class="hover:text-neutral-600 transition-colors"
          >
            {@project.organization.brand.display_name || @project.organization.brand.name}
          </.link>
        <% end %>
        <.icon name="hero-chevron-right" class="w-3 h-3" />
        <.link
          navigate={~p"/ownership/organizations/#{@project.organization.id}"}
          class="hover:text-neutral-600 transition-colors"
        >
          {@project.organization.display_name || @project.organization.name}
        </.link>
      <% end %>
      <.icon name="hero-chevron-right" class="w-3 h-3" />
      <span class="text-neutral-600 dark:text-neutral-300">
        {@project.display_name || @project.name}
      </span>
    </nav>

    <%!-- Header --%>
    <div class="flex items-end justify-between mb-10 border-b border-neutral-100 pb-8 dark:border-neutral-800">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-light tracking-tight text-neutral-900 dark:text-neutral-100">
            {@project.display_name || @project.name}
          </h1>
          <%= if @can_manage? do %>
            <.link
              href={~p"/admin/projects/#{@project.id}/edit"}
              class="text-[10px] uppercase tracking-widest text-neutral-400 hover:text-neutral-600 border border-neutral-200 px-2 py-1 transition-colors dark:border-neutral-700 dark:hover:text-neutral-300"
            >
              Edit
            </.link>
          <% end %>
        </div>
        <%= if @project.organization do %>
          <p class="text-sm font-light text-neutral-500">
            {@project.organization.display_name || @project.organization.name}
          </p>
        <% end %>
        <%= if @project.description do %>
          <p class="text-xs font-light text-neutral-400 mt-2 max-w-xl">{@project.description}</p>
        <% end %>
      </div>
      <div class="flex gap-8">
        <div class="text-right">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Team Size
          </div>
          <div class="text-2xl font-light text-neutral-900 dark:text-neutral-100">
            {@stats.team_size}
          </div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8 dark:border-neutral-800">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Repositories
          </div>
          <div class="text-2xl font-light text-neutral-900 dark:text-neutral-100">
            {@stats.repos_count}
          </div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8 dark:border-neutral-800">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Domains
          </div>
          <div class="text-2xl font-light text-neutral-900 dark:text-neutral-100">
            {@stats.domains_count}
          </div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8 dark:border-neutral-800">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Risk Posture
          </div>
          <div class="flex items-center justify-end gap-1.5 mt-0.5">
            <span class={[
              "px-2 py-0.5 rounded text-xs font-mono font-bold border shrink-0",
              Ravner.Governance.RiskScore.badge_classes(@risk_posture.grade)
            ]}>
              {@risk_posture.grade}
            </span>
            <div class="text-2xl font-light font-mono text-neutral-900 dark:text-neutral-100">
              {@risk_posture.overall_score || "—"}
            </div>
            <span class="text-[11px] text-neutral-400 font-light">/100</span>
          </div>
        </div>
      </div>
    </div>

    <%!-- Context info --%>
    <div class={[
      "mb-8 border p-4",
      if(@stats.team_size == 0,
        do: "border-amber-200 bg-amber-50/30",
        else: "border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50"
      )
    ]}>
      <div class="flex items-start gap-3">
        <.icon
          name="hero-information-circle"
          class="w-4 h-4 text-neutral-400 flex-shrink-0 mt-0.5"
        />
        <div>
          <p class="text-xs font-light text-neutral-500 leading-relaxed">
            A <span class="font-normal text-neutral-700 dark:text-neutral-300">Project</span>
            represents a specific work effort — a website, an application, a migration, etc.
            Each project belongs to an Organization and has a
            <span class="font-normal text-neutral-700 dark:text-neutral-300">Team</span>
            with defined roles,
            linked <span class="font-normal text-neutral-700 dark:text-neutral-300">Repositories</span>, and assigned <span class="font-normal text-neutral-700 dark:text-neutral-300">Domains</span>.
            Domains without a project assignment appear as "unassigned" in the governance dashboard.
          </p>
          <%= if @stats.team_size == 0 do %>
            <p class="text-xs font-light text-amber-600 mt-2">
              No team members yet. Add people and assign roles to build your project team.
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Search & Filter --%>
    <div class="flex items-center gap-4 mb-6">
      <div class="relative flex-1 max-w-sm">
        <.icon
          name="hero-magnifying-glass"
          class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"
        />
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search across all tabs..."
          phx-change="search"
          class="w-full pl-10 pr-4 py-2.5 border border-neutral-200 bg-white text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500 dark:focus:border-neutral-300"
        />
      </div>
      <%= if @search_query != "" do %>
        <button
          phx-click="search"
          phx-value-query=""
          class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
        >
          Clear
        </button>
      <% end %>
    </div>

    <%!-- Tabs --%>
    <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px dark:border-neutral-800">
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=team"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "team",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        Team ({length(@team)})
      </.link>
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=repositories"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "repositories",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        Repositories ({length(@repositories)})
      </.link>
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=domains"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "domains",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        Domains ({length(@domains)})
      </.link>
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=landscape"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200 flex items-center gap-1.5",
          if(@current_tab == "landscape",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        <.icon name="hero-squares-plus" class="w-3.5 h-3.5" />
        Landscape ({length(@project.applications || [])})
      </.link>
    </div>

    <%!-- Tab Content --%>
    <%= cond do %>
      <% @current_tab == "team" -> %>
        <div class="mb-8">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
              Project Leadership
              <span class="h-px flex-1 bg-neutral-100 dark:bg-neutral-700"></span>
            </h2>
            <%= if @can_manage? do %>
              <.link
                href={~p"/admin/projects/#{@project.id}/edit"}
                class="text-xs font-light text-neutral-400 hover:text-neutral-900 underline dark:hover:text-neutral-200"
              >
                Change Leadership
              </.link>
            <% end %>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%!-- Project Manager (Delivery Lead) --%>
            <div class="border border-neutral-200 bg-white p-5 rounded-none dark:border-neutral-700 dark:bg-neutral-800">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-mono font-medium uppercase px-2 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-800">
                  Delivery Lead
                </span>
                <span class="text-xs text-neutral-400">Project Manager</span>
              </div>
              <%= if @project.project_manager do %>
                <.link
                  navigate={~p"/ownership/people/#{@project.project_manager.id}"}
                  class="flex items-center gap-3 group mt-2"
                >
                  <div class="w-10 h-10 rounded-full bg-blue-50 text-blue-700 flex items-center justify-center text-sm font-medium dark:bg-blue-900/40 dark:text-blue-300">
                    {String.first(@project.project_manager.first_name)}{String.first(
                      @project.project_manager.last_name
                    )}
                  </div>
                  <div>
                    <div class="text-sm font-medium text-neutral-900 group-hover:text-blue-600 dark:text-neutral-100 transition-colors">
                      {@project.project_manager.first_name} {@project.project_manager.last_name}
                    </div>
                    <div class="text-xs text-neutral-400 flex items-center gap-1.5 mt-0.5">
                      <%= if @project.project_manager.email do %>
                        <span>{@project.project_manager.email}</span>
                      <% end %>
                    </div>
                  </div>
                </.link>
              <% else %>
                <div class="py-3 text-neutral-400 text-xs italic font-light">
                  No Project Manager assigned
                </div>
              <% end %>
            </div>

            <%!-- Product Owner (Client Lead) --%>
            <div class="border border-neutral-200 bg-white p-5 rounded-none dark:border-neutral-700 dark:bg-neutral-800">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-mono font-medium uppercase px-2 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200 dark:bg-amber-950 dark:text-amber-300 dark:border-amber-800">
                  Client Lead
                </span>
                <span class="text-xs text-neutral-400">Product Owner</span>
              </div>
              <%= if @project.product_owner do %>
                <.link
                  navigate={~p"/ownership/people/#{@project.product_owner.id}"}
                  class="flex items-center gap-3 group mt-2"
                >
                  <div class="w-10 h-10 rounded-full bg-amber-50 text-amber-700 flex items-center justify-center text-sm font-medium dark:bg-amber-900/40 dark:text-amber-300">
                    {String.first(@project.product_owner.first_name)}{String.first(
                      @project.product_owner.last_name
                    )}
                  </div>
                  <div>
                    <div class="text-sm font-medium text-neutral-900 group-hover:text-amber-600 dark:text-neutral-100 transition-colors">
                      {@project.product_owner.first_name} {@project.product_owner.last_name}
                    </div>
                    <div class="text-xs text-neutral-400 flex items-center gap-1.5 mt-0.5">
                      <%= if @project.product_owner.email do %>
                        <span>{@project.product_owner.email}</span>
                      <% end %>
                    </div>
                  </div>
                </.link>
              <% else %>
                <div class="py-3 text-neutral-400 text-xs italic font-light">
                  No Product Owner assigned
                </div>
              <% end %>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-between mb-4">
          <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
            Technical Team Roster
            <span class="h-px flex-1 bg-neutral-100 dark:bg-neutral-700"></span>
          </h2>
          <%= if @can_manage? do %>
            <.link
              href={~p"/admin/projects/#{@project.id}/edit"}
              class="text-xs font-light text-neutral-400 hover:text-neutral-900 underline dark:hover:text-neutral-200"
            >
              Manage Roster
            </.link>
          <% end %>
        </div>

        <%= if @team == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <div class="text-sm font-light text-neutral-400 mb-4">
                No team members matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <.icon name="hero-users" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">
                No technical team members yet
              </h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                Assign technical specialists — Developers, QA, DevOps, Security, Designers — to the project roster.
              </p>
              <.link
                href={~p"/admin/projects/#{@project.id}/edit"}
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Manage roster
              </.link>
            </div>
          <% end %>
        <% else %>
          <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700">
            <%= for member <- @team do %>
              <.link
                navigate={~p"/ownership/people/#{member.person_id}"}
                class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group dark:hover:bg-neutral-700"
              >
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full bg-neutral-100 flex items-center justify-center text-sm font-light text-neutral-500 dark:bg-neutral-700 dark:text-neutral-400">
                    {String.first(member.first_name)}{String.first(member.last_name)}
                  </div>
                  <div>
                    <div class="text-sm font-normal text-neutral-900">
                      {member.first_name} {member.last_name}
                    </div>
                    <div class="text-xs font-light text-neutral-400 flex items-center gap-2">
                      <%= if member.title do %>
                        <span>{member.title}</span>
                        <span class="text-neutral-300">|</span>
                      <% end %>
                      <%= if member.email do %>
                        <span>{member.email}</span>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-[10px] uppercase tracking-widest text-neutral-600 bg-neutral-100 px-2 py-1">
                    {member.role}
                  </span>
                  <.icon
                    name="hero-chevron-right"
                    class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                  />
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      <% @current_tab == "repositories" -> %>
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
              Linked Repositories
              <span class="h-px flex-1 bg-neutral-100 dark:bg-neutral-700"></span>
            </h2>
            <div class="flex items-center gap-2">
              <%= if @repositories != [] and @can_manage? do %>
                <.link
                  href={~p"/admin/projects/#{@project.id}/sbom.cdx.json"}
                  id="btn-export-project-sbom"
                  title="Export Aggregated CycloneDX 1.5 SBOM for all project repositories"
                  class="btn-line text-[11px] py-1 px-2.5 inline-flex items-center gap-1.5 text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white"
                >
                  <.icon name="hero-arrow-down-tray" class="w-3.5 h-3.5" /> Export SBOM
                </.link>
              <% end %>
              <%= if @can_manage? do %>
                <button
                  type="button"
                  phx-click="open_link_repo"
                  id="open-link-repo-btn"
                  class="btn-line text-[11px] py-1 px-2.5 inline-flex items-center gap-1.5"
                >
                  <.icon name="hero-plus" class="w-3.5 h-3.5" /> Link Repository
                </button>
              <% end %>
            </div>
          </div>

          <%= if @repositories == [] do %>
            <%= if @search_query != "" do %>
              <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
                <div class="text-sm font-light text-neutral-400 mb-4">
                  No repositories matching "{@search_query}".
                </div>
                <button
                  phx-click="search"
                  phx-value-query=""
                  class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
                >
                  Clear search
                </button>
              </div>
            <% else %>
              <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
                <.icon name="hero-code-bracket" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
                <h3 class="text-sm font-light text-neutral-500 mb-2">No repositories linked</h3>
                <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                  Link your code repositories — Bitbucket, GitHub, GitLab — to this project
                  to monitor commits, tech stack, and asset synchronization in real time.
                </p>
                <%= if @can_manage? do %>
                  <button
                    type="button"
                    phx-click="open_link_repo"
                    id="empty-link-repo-btn"
                    class="btn-line text-xs py-1.5 px-3 inline-flex items-center gap-1.5"
                  >
                    <.icon name="hero-plus" class="w-3.5 h-3.5" /> Link your first repository
                  </button>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700">
              <%= for repo <- @repositories do %>
                <div
                  class="p-4 sm:p-5 hover:bg-neutral-50/50 transition-colors dark:hover:bg-neutral-800/50"
                  id={"repo-card-#{repo.id}"}
                >
                  <div class="flex items-start justify-between gap-4">
                    <div class="flex items-start gap-3.5 min-w-0 flex-1">
                      <div class="w-9 h-9 rounded bg-neutral-100 flex items-center justify-center shrink-0 dark:bg-neutral-700">
                        <%= case repo.provider do %>
                          <% "bitbucket" -> %>
                            <.icon
                              name="hero-code-bracket-square"
                              class="w-5 h-5 text-blue-600 dark:text-blue-400"
                            />
                          <% "github" -> %>
                            <.icon
                              name="hero-code-bracket-square"
                              class="w-5 h-5 text-neutral-900 dark:text-neutral-100"
                            />
                          <% "gitlab" -> %>
                            <.icon
                              name="hero-code-bracket-square"
                              class="w-5 h-5 text-orange-600 dark:text-orange-400"
                            />
                          <% _ -> %>
                            <.icon name="hero-code-bracket" class="w-5 h-5 text-neutral-400" />
                        <% end %>
                      </div>

                      <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2.5 flex-wrap">
                          <a
                            href={repo.url}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-sm font-medium text-neutral-900 hover:text-blue-600 dark:text-neutral-100 dark:hover:text-blue-400 transition-colors inline-flex items-center gap-1"
                          >
                            {repo.external_id || repo.url}
                            <.icon
                              name="hero-arrow-top-right-on-square"
                              class="w-3.5 h-3.5 opacity-60"
                            />
                          </a>

                          <span class={[
                            "text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono",
                            case repo.provider do
                              "bitbucket" ->
                                "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-800"

                              "github" ->
                                "bg-neutral-100 text-neutral-800 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-200 dark:border-neutral-700"

                              "gitlab" ->
                                "bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950 dark:text-orange-300 dark:border-orange-800"

                              _ ->
                                "bg-neutral-50 text-neutral-600 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700"
                            end
                          ]}>
                            {repo.provider || "git"}
                          </span>

                          <span class="text-[9px] uppercase tracking-widest text-neutral-500 border border-neutral-200 px-1.5 py-0.5 dark:text-neutral-400 dark:border-neutral-700">
                            {repo.kind}
                          </span>

                          <%= if repo.domain_id && match?(%Ravner.Domains.Domain{}, repo.domain) do %>
                            <.link
                              navigate={~p"/domains/#{repo.domain.id}"}
                              class={[
                                "text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border inline-flex items-center gap-1 transition-colors",
                                if(repo.is_primary,
                                  do:
                                    "bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100 dark:bg-emerald-950 dark:text-emerald-300 dark:border-emerald-800",
                                  else:
                                    "bg-cyan-50 text-cyan-700 border-cyan-200 hover:bg-cyan-100 dark:bg-cyan-950 dark:text-cyan-300 dark:border-cyan-800"
                                )
                              ]}
                              title={
                                if repo.is_primary,
                                  do: "Primary repository for domain #{repo.domain.name}",
                                  else: "Attached to domain #{repo.domain.name}"
                              }
                            >
                              <.icon name="hero-globe-alt" class="w-3 h-3" />
                              <span>{repo.domain.name}</span>
                              <%= if repo.is_primary do %>
                                <span class="font-semibold text-[8px] tracking-tight">
                                  (Primary)
                                </span>
                              <% end %>
                            </.link>
                          <% else %>
                            <span
                              class="text-[9px] uppercase tracking-wider text-neutral-600 bg-neutral-100 border border-neutral-200 px-1.5 py-0.5 rounded dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700 inline-flex items-center gap-1"
                              title="Direct project repository (shared across project domains)"
                            >
                              <.icon name="hero-folder" class="w-3 h-3 text-neutral-400" />
                              <span>Project-wide</span>
                            </span>
                          <% end %>

                          <%!-- Security / SCA status badge --%>
                          <%= case repo.scan_status do %>
                            <% "clean" -> %>
                              <span
                                class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950 dark:text-emerald-300 dark:border-emerald-800 inline-flex items-center gap-1"
                                title="0 known dependencies vulnerabilities discovered"
                              >
                                <.icon name="hero-shield-check" class="w-3 h-3 text-emerald-600" />
                                Clean
                              </span>
                            <% "vulnerable" -> %>
                              <button
                                type="button"
                                phx-click="view_repo_vulnerabilities"
                                phx-value-id={repo.id}
                                class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono bg-red-50 text-red-700 border-red-200 dark:bg-red-950 dark:text-red-300 dark:border-red-800 hover:bg-red-100 dark:hover:bg-red-900 inline-flex items-center gap-1 transition-colors"
                                title={"#{repo.vulnerability_count} vulnerabilities detected. Click to view details."}
                              >
                                <.icon
                                  name="hero-shield-exclamation"
                                  class="w-3 h-3 text-red-600"
                                />
                                <span>{repo.vulnerability_count} CVEs</span>
                                <%= if repo.critical_vuln_count > 0 do %>
                                  <span class="font-bold text-[8px]">
                                    ({repo.critical_vuln_count} crit)
                                  </span>
                                <% end %>
                              </button>
                            <% "scanning" -> %>
                              <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950 dark:text-amber-300 dark:border-amber-800 inline-flex items-center gap-1 animate-pulse">
                                <.icon
                                  name="hero-arrow-path"
                                  class="w-3 h-3 animate-spin text-amber-600"
                                /> Scanning...
                              </span>
                            <% _ -> %>
                              <span
                                class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono bg-neutral-100 text-neutral-500 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700 inline-flex items-center gap-1 opacity-70"
                                title="Dependencies not yet scanned for CVEs"
                              >
                                <.icon
                                  name="hero-shield-exclamation"
                                  class="w-3 h-3 text-neutral-400"
                                /> Unscanned
                              </span>
                          <% end %>

                          <%= if (repo.secrets_count || 0) > 0 do %>
                            <span
                              class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono bg-amber-50 text-amber-800 border-amber-300 dark:bg-amber-950 dark:text-amber-300 dark:border-amber-800 inline-flex items-center gap-1"
                              title={"#{repo.secrets_count} exposed credentials detected"}
                            >
                              <.icon name="hero-key" class="w-3 h-3 text-amber-600" />
                              <span>{repo.secrets_count} Secrets</span>
                            </span>
                          <% end %>
                        </div>

                        <%!-- Live commit pulse --%>
                        <%= if repo.last_commit_hash do %>
                          <div class="mt-2 flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-300 flex-wrap">
                            <span class="font-mono text-[10px] bg-neutral-100 dark:bg-neutral-700 px-1.5 py-0.2 rounded border border-neutral-200 dark:border-neutral-600">
                              {String.slice(repo.last_commit_hash, 0, 7)}
                            </span>
                            <span class="font-normal text-neutral-900 dark:text-neutral-100 truncate max-w-sm sm:max-w-md">
                              {repo.last_commit_message}
                            </span>
                            <span class="text-neutral-400 text-[11px] flex items-center gap-1">
                              by {repo.last_commit_author || "committer"}
                              <%= if repo.last_commit_at do %>
                                <span>• {format_relative_timestamp(repo.last_commit_at)}</span>
                              <% end %>
                            </span>
                          </div>
                        <% else %>
                          <div class="mt-1.5 text-xs text-neutral-400 italic flex items-center gap-1">
                            <.icon name="hero-clock" class="w-3 h-3" />
                            <span>No commit history synced yet</span>
                          </div>
                        <% end %>

                        <%!-- Tech Stack Chips --%>
                        <%= if repo.technology || repo.main_language do %>
                          <div class="mt-2.5 flex items-center gap-1.5 flex-wrap">
                            <span class="text-[9px] uppercase tracking-wider text-neutral-400 font-medium mr-1">
                              Tech:
                            </span>
                            <%= for tech <- String.split(repo.technology || repo.main_language || "", ",", trim: true) do %>
                              <span class="text-[10px] px-2 py-0.5 rounded border border-neutral-200 bg-neutral-50 text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 font-mono">
                                {String.trim(tech)}
                              </span>
                            <% end %>
                          </div>
                        <% end %>

                        <%= if repo.notes do %>
                          <p class="text-xs font-light text-neutral-400 mt-1.5 line-clamp-2">
                            {repo.notes}
                          </p>
                        <% end %>
                      </div>
                    </div>

                    <%!-- Actions --%>
                    <div class="flex items-center gap-1 shrink-0">
                      <%= if @can_manage? do %>
                        <button
                          type="button"
                          phx-click="scan_repo"
                          phx-value-id={repo.id}
                          id={"scan-repo-#{repo.id}"}
                          class="p-1.5 text-emerald-600 hover:text-emerald-800 dark:text-emerald-400 dark:hover:text-emerald-200 transition-colors"
                          title="Scan dependencies for CVEs via OSV.dev"
                        >
                          <.icon name="hero-shield-check" class="w-4 h-4" />
                        </button>
                        <button
                          type="button"
                          phx-click="sync_repo"
                          phx-value-id={repo.id}
                          class="p-1.5 text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors"
                          title="Sync commits and tech stack"
                        >
                          <.icon name="hero-arrow-path" class="w-4 h-4" />
                        </button>
                        <.link
                          href={~p"/admin/repositories/#{repo.id}/sbom.cdx.json"}
                          id={"export-sbom-repo-#{repo.id}"}
                          class="p-1.5 text-neutral-400 hover:text-neutral-800 dark:hover:text-neutral-200 transition-colors"
                          title="Download CycloneDX 1.5 SBOM"
                        >
                          <.icon name="hero-arrow-down-tray" class="w-4 h-4" />
                        </.link>
                        <button
                          type="button"
                          phx-click="unlink_repo"
                          phx-value-id={repo.id}
                          data-confirm="Are you sure you want to unlink this repository from the project?"
                          class="p-1.5 text-neutral-400 hover:text-red-600 transition-colors"
                          title="Unlink repository"
                        >
                          <.icon name="hero-trash" class="w-4 h-4" />
                        </button>
                      <% end %>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% @current_tab == "domains" -> %>
        <div class="space-y-6">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
              Assigned Domains
              <span class="h-px flex-1 bg-neutral-100 dark:bg-neutral-700"></span>
            </h2>
            <%= if @can_manage? do %>
              <button
                type="button"
                phx-click="open_assign_domain"
                id="open-assign-domain-btn"
                class="btn-line text-[11px] py-1 px-2.5 inline-flex items-center gap-1.5"
              >
                <.icon name="hero-plus" class="w-3.5 h-3.5" /> Assign Domain
              </button>
            <% end %>
          </div>

          <%= if @domains == [] do %>
            <%= if @search_query != "" do %>
              <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
                <div class="text-sm font-light text-neutral-400">
                  No domains matching "{@search_query}".
                </div>
                <button
                  phx-click="search"
                  phx-value-query=""
                  class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
                >
                  Clear search
                </button>
              </div>
            <% else %>
              <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
                <.icon name="hero-globe-alt" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
                <h3 class="text-sm font-light text-neutral-500 mb-2">No domains assigned</h3>
                <p class="text-xs font-light text-neutral-400 max-w-md mx-auto leading-relaxed">
                  Domains linked to this project will inherit governance policies and leadership roles (PM &amp; PO).
                </p>
                <%= if @can_manage? do %>
                  <button
                    type="button"
                    phx-click="open_assign_domain"
                    class="mt-4 btn-line text-xs py-1.5 px-3 inline-flex items-center gap-1.5"
                  >
                    <.icon name="hero-plus" class="w-3.5 h-3.5" /> Assign Domain
                  </button>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700">
              <%= for domain <- @domains do %>
                <div class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group dark:hover:bg-neutral-700">
                  <div class="flex-1 min-w-0 pr-4">
                    <.link
                      navigate={~p"/domains/#{domain.id}"}
                      class="text-sm font-medium text-neutral-900 hover:underline dark:text-neutral-100"
                    >
                      {domain.name}
                    </.link>
                    <div class="flex items-center gap-2 mt-1 text-[11px] text-neutral-500 dark:text-neutral-400">
                      <%= if not domain.has_custom_contacts? do %>
                        <span class="inline-flex items-center gap-1 text-[10px] text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 px-1.5 py-0.5 border border-emerald-200 dark:border-emerald-800 font-medium">
                          <.icon name="hero-shield-check" class="w-3 h-3" /> Inherits PM/PO
                        </span>
                      <% else %>
                        <span class="inline-flex items-center gap-1 text-[10px] text-neutral-600 bg-neutral-100 dark:bg-neutral-700 dark:text-neutral-300 px-1.5 py-0.5">
                          Custom Contacts
                        </span>
                      <% end %>
                      <%= if domain.lifecycle_state do %>
                        <span class="text-[9px] uppercase tracking-widest text-neutral-500 border border-neutral-200 px-1.5 py-0.5 dark:text-neutral-400 dark:border-neutral-700">
                          {domain.lifecycle_state}
                        </span>
                      <% end %>
                    </div>
                  </div>
                  <div class="flex items-center gap-3">
                    <%= if @can_manage? do %>
                      <button
                        type="button"
                        phx-click="unassign_domain"
                        phx-value-domain_id={domain.id}
                        data-confirm={"Are you sure you want to remove #{domain.name} from #{@project.name}?"}
                        class="text-neutral-400 hover:text-red-600 dark:hover:text-red-400 p-1 transition-colors"
                        title="Unassign Domain"
                      >
                        <.icon name="hero-x-mark" class="w-4 h-4" />
                      </button>
                    <% end %>
                    <.link
                      navigate={~p"/domains/#{domain.id}"}
                      class="text-neutral-300 hover:text-neutral-600 dark:hover:text-neutral-300"
                    >
                      <.icon name="hero-chevron-right" class="w-4 h-4" />
                    </.link>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% @current_tab == "landscape" -> %>
        <div class="space-y-8">
          <%!-- Landscape Header & Export Toolbar --%>
          <div class="flex items-center justify-between border-b border-neutral-100 pb-4 dark:border-neutral-800">
            <div>
              <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
                Digital Landscape Architecture (BDAT Metamodel)
              </h2>
              <p class="text-xs font-light text-neutral-400 mt-1">
                ArchiMate 3.1 view connecting Applications, Datastores, Ingress Boundaries, and Compliance Constraints.
              </p>
            </div>
            <div class="flex items-center gap-3">
              <%= if @can_manage? do %>
                <button
                  type="button"
                  phx-click="open_create_app"
                  id="project-add-app-btn"
                  class="btn-line text-[11px] py-1 px-3 inline-flex items-center gap-1.5 text-emerald-600 border-emerald-200 hover:bg-emerald-50 dark:border-emerald-800 dark:hover:bg-emerald-950/40 transition-colors"
                >
                  <.icon name="hero-plus" class="w-3.5 h-3.5" />
                  <span>Add Application</span>
                </button>
              <% end %>
              <a
                href={~p"/projects/#{@project.id}/export/archimate"}
                download
                id="export-archimate-btn"
                class="btn-line text-[11px] py-1 px-3 inline-flex items-center gap-1.5 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors"
                title="Download standard Open Group ArchiMate 3.1 Exchange XML (compatible with ADOIT, Archi, and enterprise GRC tools)"
              >
                <.icon name="hero-arrow-down-tray" class="w-3.5 h-3.5 text-neutral-500" />
                <span>Export ADOIT / ArchiMate XML</span>
              </a>
            </div>
          </div>

          <%!-- Applications Grid --%>
          <%= if (@project.applications || []) == [] do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <.icon name="hero-cube-transparent" class="w-10 h-10 text-neutral-300 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">
                No Applications Modeled Yet
              </h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto leading-relaxed mb-6">
                Applications represent functional software workloads (storefronts, APIs, hubs) that bind repositories, datastores, and domains under continuous architecture governance.
              </p>
              <%= if @can_manage? do %>
                <button
                  type="button"
                  phx-click="open_create_app"
                  class="btn-line text-xs py-2 px-4 inline-flex items-center gap-2"
                >
                  <.icon name="hero-plus" class="w-4 h-4" /> Add First Application
                </button>
              <% end %>
            </div>
          <% else %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <%= for app <- @project.applications do %>
                <div class="border border-neutral-200 bg-white p-5 dark:border-neutral-700 dark:bg-neutral-800 flex flex-col justify-between">
                  <div>
                    <div class="flex items-start justify-between gap-2 mb-3">
                      <div>
                        <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded border font-mono bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950 dark:text-amber-300 dark:border-amber-800">
                          {app.app_type}
                        </span>
                        <h4 class="text-base font-light text-neutral-900 mt-2 dark:text-neutral-100">
                          {app.name}
                        </h4>
                      </div>
                      <span class={[
                        "text-[9px] uppercase font-mono px-1.5 py-0.5 border rounded",
                        if(app.criticality == "mission_critical" or app.criticality == "tier_1",
                          do:
                            "bg-red-50 text-red-700 border-red-200 dark:bg-red-950 dark:text-red-300 dark:border-red-800",
                          else:
                            "bg-neutral-50 text-neutral-600 border-neutral-200 dark:bg-neutral-900 dark:text-neutral-300 dark:border-neutral-700"
                        )
                      ]}>
                        {app.criticality}
                      </span>
                    </div>

                    <%= if app.description do %>
                      <p class="text-xs font-light text-neutral-500 mb-4 line-clamp-2">
                        {app.description}
                      </p>
                    <% end %>

                    <div class="space-y-2 text-xs border-t border-neutral-100 pt-3 dark:border-neutral-700/60">
                      <div class="flex items-center justify-between text-neutral-500">
                        <span class="text-[10px] uppercase font-mono text-neutral-400">
                          Hosting
                        </span>
                        <span class="font-light text-neutral-700 dark:text-neutral-300">
                          {if app.hosting_environment,
                            do:
                              "#{app.hosting_environment.name} (#{app.hosting_environment.provider})",
                            else: "—"}
                        </span>
                      </div>
                      <div class="flex items-center justify-between text-neutral-500">
                        <span class="text-[10px] uppercase font-mono text-neutral-400">
                          Datastores
                        </span>
                        <span class="font-mono text-neutral-700 dark:text-neutral-300">
                          {length(app.datastores || [])}
                        </span>
                      </div>
                      <div class="flex items-center justify-between text-neutral-500">
                        <span class="text-[10px] uppercase font-mono text-neutral-400">
                          Assigned Domains
                        </span>
                        <span class="font-mono text-neutral-700 dark:text-neutral-300">
                          {length(app.domains || [])}
                        </span>
                      </div>
                      <div class="flex items-center justify-between text-neutral-500">
                        <span class="text-[10px] uppercase font-mono text-neutral-400">
                          Policy Constraints
                        </span>
                        <span class="font-mono text-neutral-700 dark:text-neutral-300">
                          {length(app.constraints || [])}
                        </span>
                      </div>
                    </div>
                  </div>

                  <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-700/60 flex items-center justify-between">
                    <span class="text-[10px] uppercase font-mono text-neutral-400">
                      Status: {app.lifecycle_state}
                    </span>
                    <.link
                      navigate={~p"/ownership/applications/#{app.id}"}
                      class="text-xs text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white inline-flex items-center gap-1 font-medium group"
                    >
                      Manage App
                      <.icon
                        name="hero-arrow-right"
                        class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform"
                      />
                    </.link>
                  </div>
                </div>
              <% end %>
            </div>

            <%!-- Mermaid UML-like Architecture Topology --%>
            <div class="border border-neutral-200 bg-white p-6 dark:border-neutral-700 dark:bg-neutral-800">
              <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-700">
                <h3 class="text-xs font-normal uppercase tracking-widest text-neutral-800 dark:text-neutral-200 flex items-center gap-2">
                  <.icon name="hero-chart-bar-square" class="w-4 h-4 text-neutral-400" />
                  Live Topology &amp; Line of Sight Diagram
                </h3>
                <span class="text-[10px] font-mono text-neutral-400 uppercase">
                  ArchiMate Flowchart (Mermaid)
                </span>
              </div>

              <div
                id="project-landscape-mermaid"
                class="w-full overflow-x-auto p-4 bg-neutral-50 dark:bg-neutral-900/60 rounded border border-neutral-100 dark:border-neutral-800"
                phx-hook=".MermaidRenderer"
                data-chart={@mermaid_chart}
              >
                <div class="mermaid-target flex justify-center min-h-[160px] items-center text-xs font-mono text-neutral-400">
                  Rendering architecture model...
                </div>
              </div>
            </div>
          <% end %>
        </div>
    <% end %>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".MermaidRenderer">
    export default {
      async mounted() {
        await this.renderChart()
      },
      async updated() {
        await this.renderChart()
      },
      async renderChart() {
        const chartCode = this.el.dataset.chart
        const target = this.el.querySelector(".mermaid-target")
        if (!chartCode || !target) return

        try {
          if (!window.mermaid) {
            const script = document.createElement("script")
            script.src = "https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"
            await new Promise((resolve, reject) => {
              script.onload = resolve
              script.onerror = reject
              document.head.appendChild(script)
            })
            window.mermaid.initialize({
              startOnLoad: false,
              theme: document.documentElement.classList.contains("dark") ? "dark" : "neutral",
              securityLevel: "loose"
            })
          }

          const id = "mermaid-svg-" + Math.random().toString(36).substring(2, 9)
          const { svg } = await window.mermaid.render(id, chartCode)
          target.innerHTML = svg
        } catch (err) {
          console.error("Failed to render Mermaid chart:", err)
          target.innerHTML = '<pre class="text-xs text-neutral-500 font-mono p-4 overflow-x-auto whitespace-pre">' + chartCode + '</pre>'
        }
      }
    }
  </script>

  <%!-- Modal: Create Application in Project --%>
  <%= if @creating_app? do %>
    <div class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs">
      <div
        class="relative w-full max-w-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl"
        phx-click-stop
      >
        <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800">
          <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
            Add Application to {@project.name}
          </h3>
          <button
            type="button"
            phx-click="close_create_app"
            class="text-neutral-400 hover:text-neutral-600"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <.form
          for={@app_form}
          phx-submit="save_app"
          id="project-create-app-form"
          class="space-y-4"
        >
          <div>
            <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1">
              Application Name
            </label>
            <.input
              field={@app_form[:name]}
              placeholder="e.g. Public Storefront, Checkout API"
              required
              class="w-full text-sm"
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1">
                Type
              </label>
              <.input
                field={@app_form[:app_type]}
                type="select"
                options={[
                  {"Storefront", "storefront"},
                  {"Website", "website"},
                  {"API / Backend", "api"},
                  {"CMS", "cms"},
                  {"CRM", "crm"},
                  {"PIM", "pim"},
                  {"ERP", "erp"},
                  {"Portal", "portal"},
                  {"Integration Hub", "integration_hub"}
                ]}
                class="w-full text-sm"
              />
            </div>
            <div>
              <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1">
                Criticality
              </label>
              <.input
                field={@app_form[:criticality]}
                type="select"
                options={[
                  {"Mission Critical", "mission_critical"},
                  {"Tier 1", "tier_1"},
                  {"Tier 2", "tier_2"},
                  {"Operational", "operational"},
                  {"Low", "low"}
                ]}
                class="w-full text-sm"
              />
            </div>
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1">
              Hosting Environment
            </label>
            <.input
              field={@app_form[:hosting_environment_id]}
              type="select"
              prompt="Select Hosting Node..."
              options={
                Enum.map(
                  @hosting_environments,
                  &{"#{&1.name} (#{to_string(&1.provider)})", &1.id}
                )
              }
              class="w-full text-sm"
            />
          </div>

          <div>
            <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1">
              Description
            </label>
            <.input
              field={@app_form[:description]}
              type="textarea"
              placeholder="Workload purpose and architectural role..."
              class="w-full text-sm"
            />
          </div>

          <div class="flex items-center justify-end gap-3 pt-4 border-t border-neutral-100 dark:border-neutral-800">
            <button
              type="button"
              phx-click="close_create_app"
              class="px-4 py-2 text-xs text-neutral-600 hover:text-neutral-900"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="px-4 py-2 text-xs bg-neutral-900 text-white dark:bg-neutral-100 dark:text-neutral-900 font-medium"
            >
              Create Application
            </button>
          </div>
        </.form>
      </div>
    </div>
  <% end %>

  <%!-- Link Repository Modal --%>
  <%= if @linking_repo? do %>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
      id="link-repo-modal"
    >
      <div
        class="fixed inset-0 bg-neutral-900/60 backdrop-blur-xs transition-opacity"
        phx-click="close_link_repo"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative w-full max-w-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl z-10 max-h-[90vh] flex flex-col"
        phx-click-stop
        id="link-repo-dialog"
      >
        <%!-- Modal Header --%>
        <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800 shrink-0">
          <div>
            <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
              Link Repository
            </h3>
            <p class="text-xs text-neutral-500 mt-0.5">
              Connect a code repository to {@project.name} to monitor commit activity and tech stack.
            </p>
          </div>
          <button
            type="button"
            phx-click="close_link_repo"
            class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 p-1"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <%!-- Modal Mode Tabs --%>
        <div class="flex border-b border-neutral-200 dark:border-neutral-800 mb-4 shrink-0">
          <%= if @active_vcs_list != [] do %>
            <button
              type="button"
              phx-click="switch_modal_mode"
              phx-value-mode="browse"
              class={[
                "px-4 py-2 text-xs font-normal border-b-2 transition-colors flex items-center gap-1.5",
                if(@modal_mode == "browse",
                  do:
                    "border-neutral-900 text-neutral-900 dark:border-neutral-100 dark:text-neutral-100",
                  else:
                    "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
                )
              ]}
            >
              <.icon name="hero-code-bracket-square" class="w-3.5 h-3.5" />
              Browse VCS ({String.capitalize(@browse_provider)})
            </button>
          <% end %>
          <button
            type="button"
            phx-click="switch_modal_mode"
            phx-value-mode="manual"
            class={[
              "px-4 py-2 text-xs font-normal border-b-2 transition-colors flex items-center gap-1.5",
              if(@modal_mode == "manual",
                do:
                  "border-neutral-900 text-neutral-900 dark:border-neutral-100 dark:text-neutral-100",
                else:
                  "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
              )
            ]}
          >
            <.icon name="hero-link" class="w-3.5 h-3.5" /> Manual URL
          </button>
          <button
            type="button"
            phx-click="switch_modal_mode"
            phx-value-mode="connect"
            class={[
              "px-4 py-2 text-xs font-normal border-b-2 transition-colors flex items-center gap-1.5",
              if(@modal_mode == "connect",
                do:
                  "border-neutral-900 text-neutral-900 dark:border-neutral-100 dark:text-neutral-100",
                else:
                  "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
              )
            ]}
          >
            <.icon name="hero-cog-6-tooth" class="w-3.5 h-3.5" /> Connect Provider
          </button>
        </div>

        <%!-- Modal Body --%>
        <div class="overflow-y-auto flex-1 pr-1">
          <%= case @modal_mode do %>
            <% "browse" -> %>
              <div class="space-y-4">
                <%!-- Search filter --%>
                <div>
                  <input
                    type="text"
                    name="query"
                    value={@vcs_search_query}
                    placeholder="Search repositories by name, language, or description..."
                    phx-change="search_vcs"
                    phx-keyup="search_vcs"
                    phx-debounce="200"
                    class="w-full px-3 py-2 border border-neutral-200 bg-white text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500"
                  />
                </div>

                <%= if @vcs_loading? do %>
                  <div class="py-12 text-center text-xs text-neutral-400 flex flex-col items-center gap-2">
                    <.icon name="hero-arrow-path" class="w-5 h-5 animate-spin text-neutral-400" />
                    <span>Fetching repositories from Bitbucket...</span>
                  </div>
                <% else %>
                  <%= if @vcs_error do %>
                    <div class="p-3 text-xs text-red-700 bg-red-50 border border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900 flex items-start gap-2">
                      <.icon name="hero-exclamation-triangle" class="w-4 h-4 shrink-0 mt-0.5" />
                      <div class="flex-1">
                        <p class="font-medium">Error loading repositories</p>
                        <p class="mt-0.5">{@vcs_error}</p>
                        <button
                          type="button"
                          phx-click="switch_modal_mode"
                          phx-value-mode="connect"
                          class="underline mt-1 block"
                        >
                          Update workspace credentials &rarr;
                        </button>
                      </div>
                    </div>
                  <% else %>
                    <%= if @vcs_filtered_repos == [] do %>
                      <div class="py-10 text-center text-xs text-neutral-400">
                        <%= if @vcs_search_query != "" do %>
                          No repositories matching "{@vcs_search_query}".
                        <% else %>
                          No repositories found in Bitbucket workspace.
                        <% end %>
                      </div>
                    <% else %>
                      <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700 rounded">
                        <%= for repo <- @vcs_filtered_repos do %>
                          <% is_linked =
                            Enum.any?(
                              @repositories,
                              &(&1.url == repo.url || &1.external_id == repo.name)
                            ) %>
                          <div class="p-3 hover:bg-neutral-50/50 transition-colors flex items-center justify-between gap-3 dark:hover:bg-neutral-700/50">
                            <div class="min-w-0 flex-1">
                              <div class="flex items-center gap-2">
                                <span class="text-xs font-medium text-neutral-900 dark:text-neutral-100 truncate">
                                  {repo.name}
                                </span>
                                <%= if repo.is_private do %>
                                  <span class="text-[9px] uppercase tracking-wider px-1 py-0.2 rounded border font-mono bg-neutral-100 text-neutral-600 border-neutral-200 dark:bg-neutral-700 dark:text-neutral-300 dark:border-neutral-600">
                                    private
                                  </span>
                                <% else %>
                                  <span class="text-[9px] uppercase tracking-wider px-1 py-0.2 rounded border font-mono bg-green-50 text-green-700 border-green-200 dark:bg-green-950 dark:text-green-300 dark:border-green-800">
                                    public
                                  </span>
                                <% end %>
                                <%= if repo.main_language do %>
                                  <span class="text-[9px] text-neutral-400 font-mono">
                                    {repo.main_language}
                                  </span>
                                <% end %>
                              </div>
                              <%= if repo.description && repo.description != "" do %>
                                <p class="text-[11px] text-neutral-400 truncate mt-0.5">
                                  {repo.description}
                                </p>
                              <% end %>
                            </div>

                            <div class="shrink-0">
                              <%= if is_linked do %>
                                <span class="text-[10px] text-neutral-400 border border-neutral-200 px-2 py-1 rounded dark:border-neutral-700">
                                  Linked
                                </span>
                              <% else %>
                                <form phx-submit="link_vcs_repo" class="flex items-center gap-1.5">
                                  <input type="hidden" name="url" value={repo.url} />
                                  <input type="hidden" name="name" value={repo.name} />
                                  <input
                                    type="hidden"
                                    name="main_language"
                                    value={repo.main_language || ""}
                                  />
                                  <input
                                    type="hidden"
                                    name="description"
                                    value={repo.description || ""}
                                  />
                                  <input
                                    type="hidden"
                                    name="default_branch"
                                    value={repo.default_branch || "main"}
                                  />
                                  <select
                                    name="kind"
                                    class="text-[11px] py-1 px-1.5 border border-neutral-200 bg-white text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 focus:outline-none"
                                  >
                                    <option value="website">Website</option>
                                    <option value="api">API</option>
                                    <option value="worker">Worker</option>
                                    <option value="library">Library</option>
                                    <option value="mobile">Mobile</option>
                                    <option value="infrastructure">Infrastructure</option>
                                    <option value="documentation">Docs</option>
                                  </select>
                                  <button
                                    type="submit"
                                    class="btn-line text-[11px] py-1 px-2 inline-flex items-center gap-1"
                                  >
                                    <.icon name="hero-plus" class="w-3 h-3" /> Link
                                  </button>
                                </form>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% "manual" -> %>
              <.form for={@manual_form} phx-submit="save_manual_repo" class="space-y-4">
                <.input
                  field={@manual_form[:url]}
                  label="Repository URL"
                  placeholder="https://bitbucket.org/workspace/repo or git@github.com:..."
                  required
                />
                <.input
                  field={@manual_form[:kind]}
                  type="select"
                  label="Component Kind"
                  options={[
                    {"Website", "website"},
                    {"API / Backend", "api"},
                    {"Worker / Background Job", "worker"},
                    {"Library / SDK", "library"},
                    {"Mobile App", "mobile"},
                    {"Infrastructure / IaC", "infrastructure"},
                    {"Documentation", "documentation"}
                  ]}
                />
                <.input
                  field={@manual_form[:notes]}
                  type="textarea"
                  label="Notes (Optional)"
                  placeholder="Component purpose, tech details, or architecture notes..."
                  rows={3}
                />
                <div class="flex justify-end pt-2">
                  <button type="submit" class="btn-line-filled text-xs py-2 px-4">
                    Link Repository
                  </button>
                </div>
              </.form>
            <% "connect" -> %>
              <div class="space-y-4">
                <.form
                  for={@connect_form}
                  phx-change="validate_connect"
                  phx-submit="save_vcs_connection"
                  class="space-y-3"
                >
                  <div class="grid grid-cols-1 gap-3">
                    <.input
                      field={@connect_form[:provider]}
                      type="select"
                      label="VCS Provider"
                      options={[
                        {"Bitbucket Cloud", "bitbucket"},
                        {"GitHub", "github"},
                        {"GitLab", "gitlab"}
                      ]}
                    />

                    <% current_provider = to_string(@connect_form[:provider].value || "bitbucket") %>

                    <%= case current_provider do %>
                      <% "bitbucket" -> %>
                        <div class="text-xs text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 p-3 border border-neutral-200 dark:border-neutral-700 leading-relaxed rounded">
                          <p class="font-medium text-neutral-800 dark:text-neutral-200 mb-1">
                            Bitbucket Cloud (Access Token recommended)
                          </p>
                          <ul class="list-disc pl-4 space-y-1 text-[11px]">
                            <li>
                              <strong>Access Token (Recommended):</strong>
                              Create a <em>Repository</em>
                              or <em>Workspace Access Token</em>
                              with <code>repository:read</code>
                              scope.
                              <span class="text-amber-700 dark:text-amber-400 font-medium">
                                Username is NOT needed (leave blank).
                              </span>
                            </li>
                            <li>
                              <strong>App Password (Legacy):</strong>
                              Create an App Password in Personal Settings with <code>Repositories: Read</code>. Username is required.
                            </li>
                          </ul>
                        </div>

                        <.input
                          field={@connect_form[:workspace]}
                          label="Workspace Slug / ID"
                          placeholder="e.g. my-workspace (from bitbucket.org/my-workspace)"
                          required
                        />
                        <.input
                          field={@connect_form[:username]}
                          label="Username (Optional — only for legacy App Passwords, leave blank for Access Tokens)"
                          placeholder="Leave blank for Access Tokens"
                        />
                        <.input
                          field={@connect_form[:token]}
                          type="password"
                          label="Access Token / App Password"
                          placeholder="Bitbucket Access Token or App Password"
                          required
                        />
                      <% "github" -> %>
                        <div class="text-xs text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 p-3 border border-neutral-200 dark:border-neutral-700 leading-relaxed rounded">
                          <p class="font-medium text-neutral-800 dark:text-neutral-200 mb-1">
                            GitHub (Personal Access Token)
                          </p>
                          <p class="text-[11px]">
                            Create a Personal Access Token (classic with <code>repo</code>
                            scope, or fine-grained token with Repository permissions &rarr; Contents: Read).
                            <span class="text-amber-700 dark:text-amber-400 font-medium">
                              Username is NOT needed.
                            </span>
                          </p>
                        </div>

                        <.input
                          field={@connect_form[:workspace]}
                          label="Organization or Account Username"
                          placeholder="e.g. my-org (or your GitHub username)"
                          required
                        />
                        <.input
                          field={@connect_form[:token]}
                          type="password"
                          label="Personal Access Token (PAT)"
                          placeholder="ghp_... or github_pat_..."
                          required
                        />
                      <% "gitlab" -> %>
                        <div class="text-xs text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 p-3 border border-neutral-200 dark:border-neutral-700 leading-relaxed rounded">
                          <p class="font-medium text-neutral-800 dark:text-neutral-200 mb-1">
                            GitLab (Project, Group, or Personal Access Token)
                          </p>
                          <p class="text-[11px]">
                            Create an Access Token with <code>read_api</code>
                            and <code>read_repository</code>
                            scopes.
                            Supports both gitlab.com and self-hosted instances.
                            <span class="text-amber-700 dark:text-amber-400 font-medium">
                              Username is NOT needed.
                            </span>
                          </p>
                        </div>

                        <.input
                          field={@connect_form[:workspace]}
                          label="Group Path or Project Namespace"
                          placeholder="e.g. my-group"
                          required
                        />
                        <.input
                          field={@connect_form[:token]}
                          type="password"
                          label="Access Token"
                          placeholder="glpat-..."
                          required
                        />
                        <.input
                          field={@connect_form[:base_url]}
                          label="Self-Hosted API URL (Optional)"
                          placeholder="https://gitlab.example.com/api/v4 (leave blank for gitlab.com)"
                        />
                    <% end %>
                  </div>

                  <%= if @vcs_error do %>
                    <div class="p-3 text-xs text-red-700 bg-red-50 border border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900">
                      {@vcs_error}
                    </div>
                  <% end %>

                  <div class="flex justify-end pt-2">
                    <button type="submit" class="btn-line-filled text-xs py-2 px-4">
                      Save Connection
                    </button>
                  </div>
                </.form>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Repository Vulnerabilities Modal --%>
  <%= if @viewing_repo_vulnerabilities do %>
    <div
      class="fixed inset-0 z-50 overflow-y-auto bg-black/60 flex items-center justify-center p-4 backdrop-blur-sm"
      id="repo-vulnerabilities-modal"
    >
      <div
        class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 w-full max-w-4xl p-6 shadow-2xl relative max-h-[90vh] flex flex-col"
        phx-click-away="close_repo_vulnerabilities"
      >
        <div class="flex items-center justify-between pb-4 border-b border-neutral-100 dark:border-neutral-800 shrink-0">
          <div>
            <div class="flex items-center gap-2">
              <.icon name="hero-shield-exclamation" class="w-5 h-5 text-red-500" />
              <h3 class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                {@viewing_repo_vulnerabilities.repository.external_id ||
                  @viewing_repo_vulnerabilities.repository.url}
              </h3>
            </div>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
              Software Composition Analysis (SCA) findings via Google OSV.dev
            </p>
          </div>
          <button
            type="button"
            id="close-repo-vulns-modal-x"
            phx-click="close_repo_vulnerabilities"
            class="p-1 text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <%!-- Vulnerability Counters Bar --%>
        <div class="grid grid-cols-4 gap-2 my-4 shrink-0">
          <div class="p-2.5 rounded border border-red-200 bg-red-50/60 dark:bg-red-950/40 dark:border-red-900 text-center">
            <div class="text-[10px] uppercase tracking-wider font-semibold text-red-700 dark:text-red-300">
              Critical
            </div>
            <div class="text-lg font-bold text-red-700 dark:text-red-200 font-mono">
              {@viewing_repo_vulnerabilities.repository.critical_vuln_count}
            </div>
          </div>
          <div class="p-2.5 rounded border border-orange-200 bg-orange-50/60 dark:bg-orange-950/40 dark:border-orange-900 text-center">
            <div class="text-[10px] uppercase tracking-wider font-semibold text-orange-700 dark:text-orange-300">
              High
            </div>
            <div class="text-lg font-bold text-orange-700 dark:text-orange-200 font-mono">
              {@viewing_repo_vulnerabilities.repository.high_vuln_count}
            </div>
          </div>
          <div class="p-2.5 rounded border border-yellow-200 bg-yellow-50/60 dark:bg-yellow-950/40 dark:border-yellow-900 text-center">
            <div class="text-[10px] uppercase tracking-wider font-semibold text-yellow-700 dark:text-yellow-300">
              Medium
            </div>
            <div class="text-lg font-bold text-yellow-700 dark:text-yellow-200 font-mono">
              {@viewing_repo_vulnerabilities.repository.medium_vuln_count}
            </div>
          </div>
          <div class="p-2.5 rounded border border-neutral-200 bg-neutral-50 dark:bg-neutral-800 dark:border-neutral-700 text-center">
            <div class="text-[10px] uppercase tracking-wider text-neutral-500">Low / Info</div>
            <div class="text-lg font-bold text-neutral-700 dark:text-neutral-300 font-mono">
              {@viewing_repo_vulnerabilities.repository.low_vuln_count}
            </div>
          </div>
        </div>

        <%!-- Vulnerabilities List --%>
        <div class="overflow-y-auto flex-1 divide-y divide-neutral-100 dark:divide-neutral-800 pr-1">
          <%= if @viewing_repo_vulnerabilities.vulnerabilities == [] do %>
            <div class="py-12 text-center text-neutral-400 text-xs font-light">
              <.icon name="hero-shield-check" class="w-8 h-8 text-emerald-500 mx-auto mb-2" />
              No known vulnerabilities detected for this repository.
            </div>
          <% else %>
            <%= for v <- @viewing_repo_vulnerabilities.vulnerabilities do %>
              <div class="py-3.5 space-y-1.5">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <div class="flex items-center gap-2">
                    <span class={[
                      "text-[9px] uppercase tracking-wider px-1.5 py-0.5 rounded font-mono font-bold border",
                      case v.severity do
                        "critical" ->
                          "bg-red-50 text-red-700 border-red-300 dark:bg-red-950 dark:text-red-300"

                        "high" ->
                          "bg-orange-50 text-orange-700 border-orange-300 dark:bg-orange-950 dark:text-orange-300"

                        "medium" ->
                          "bg-yellow-50 text-yellow-700 border-yellow-300 dark:bg-yellow-950 dark:text-yellow-300"

                        _ ->
                          "bg-neutral-100 text-neutral-700 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-300"
                      end
                    ]}>
                      {v.severity}
                    </span>
                    <a
                      href={"https://osv.dev/vulnerability/#{v.osv_id || v.cve_id}"}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs font-mono font-semibold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center gap-1"
                    >
                      {v.cve_id}
                      <.icon name="hero-arrow-top-right-on-square" class="w-3 h-3" />
                    </a>
                  </div>

                  <div class="flex items-center gap-2 text-xs">
                    <span class="font-mono text-neutral-800 dark:text-neutral-200 font-medium">
                      {v.package_name} <span class="text-neutral-400">v{v.package_version}</span>
                    </span>
                    <span class="text-[10px] px-1.5 py-0.2 rounded bg-neutral-100 dark:bg-neutral-800 font-mono text-neutral-600 dark:text-neutral-400">
                      {v.ecosystem}
                    </span>
                    <%= if v.manifest_file do %>
                      <span class="text-[10px] text-neutral-400 font-mono">
                        via {v.manifest_file}
                      </span>
                    <% end %>
                  </div>
                </div>

                <p class="text-xs text-neutral-700 dark:text-neutral-300 leading-relaxed font-light">
                  {v.summary}
                </p>

                <%= if v.fixed_version do %>
                  <div class="text-[11px] text-emerald-700 dark:text-emerald-400 font-mono flex items-center gap-1">
                    <.icon name="hero-check-circle" class="w-3.5 h-3.5" />
                    <span>Fixed in: <strong>{v.fixed_version}</strong></span>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>

        <%!-- Footer --%>
        <div class="pt-4 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between shrink-0">
          <div class="text-[11px] text-neutral-400 font-light">
            <%= if @viewing_repo_vulnerabilities.repository.last_scanned_at do %>
              Last scanned {format_relative_timestamp(
                @viewing_repo_vulnerabilities.repository.last_scanned_at
              )}
            <% end %>
          </div>
          <div class="flex items-center gap-2">
            <button
              type="button"
              phx-click="scan_repo"
              phx-value-id={@viewing_repo_vulnerabilities.repository.id}
              class="btn-line text-xs py-1 px-3 inline-flex items-center gap-1.5"
            >
              <.icon name="hero-arrow-path" class="w-3.5 h-3.5" /> Rescan Now
            </button>
            <button
              type="button"
              id="close-repo-vulns-modal-btn"
              phx-click="close_repo_vulnerabilities"
              class="btn-line-filled text-xs py-1 px-3"
            >
              Close
            </button>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Assign Domain Modal --%>
  <%= if @assigning_domain? do %>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs"
      id="assign-domain-modal"
    >
      <div class="fixed inset-0" phx-click="close_assign_domain"></div>
      <div class="relative w-full max-w-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl z-10 max-h-[85vh] flex flex-col">
        <%!-- Modal Header --%>
        <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800 shrink-0">
          <div>
            <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
              Assign Domain to {@project.name}
            </h3>
            <p class="text-xs text-neutral-500 mt-0.5">
              Assigned domains inherit project leadership (PM &amp; PO) and governance policies.
            </p>
          </div>
          <button
            type="button"
            phx-click="close_assign_domain"
            class="text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 text-lg leading-none"
          >
            &times;
          </button>
        </div>

        <%!-- Search Input --%>
        <div class="mb-4 shrink-0">
          <form phx-change="search_candidate_domains" phx-submit="search_candidate_domains">
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
              />
              <input
                type="text"
                name="query"
                value={@domain_search_query}
                placeholder="Search domain by name..."
                autocomplete="off"
                phx-debounce="250"
                class="w-full text-xs pl-9 pr-3 py-2 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800 text-neutral-900 dark:text-neutral-100 rounded-none focus:outline-hidden focus:border-neutral-900 dark:focus:border-neutral-100"
              />
            </div>
          </form>
        </div>

        <%!-- Candidates List --%>
        <div class="flex-1 overflow-y-auto min-h-0 border border-neutral-100 dark:border-neutral-800 divide-y divide-neutral-100 dark:divide-neutral-800">
          <%= if @candidate_domains == [] do %>
            <div class="py-12 text-center text-xs text-neutral-400">
              <%= if @domain_search_query != "" do %>
                No domains matching "{@domain_search_query}" found.
              <% else %>
                No available domains found to assign.
              <% end %>
            </div>
          <% else %>
            <%= for candidate <- @candidate_domains do %>
              <div class="flex items-center justify-between p-3 hover:bg-neutral-50 dark:hover:bg-neutral-800 transition-colors">
                <div class="min-w-0 pr-3">
                  <div class="text-xs font-medium text-neutral-900 dark:text-neutral-100 truncate">
                    {candidate.name}
                  </div>
                  <%= if candidate.project_id do %>
                    <div class="text-[10px] text-amber-600 dark:text-amber-400 mt-0.5">
                      Currently assigned to another project (will be reassigned)
                    </div>
                  <% else %>
                    <div class="text-[10px] text-neutral-400 mt-0.5">
                      Unassigned domain
                    </div>
                  <% end %>
                </div>
                <button
                  type="button"
                  phx-click="assign_domain"
                  phx-value-domain_id={candidate.id}
                  class="btn-line text-xs py-1 px-2.5 shrink-0 inline-flex items-center gap-1 hover:bg-primary-50 hover:text-primary-700 dark:hover:bg-primary-950/50"
                >
                  <.icon name="hero-plus" class="w-3.5 h-3.5" /> Assign
                </button>
              </div>
            <% end %>
          <% end %>
        </div>

        <%!-- Footer --%>
        <div class="mt-4 pt-3 border-t border-neutral-100 dark:border-neutral-800 flex justify-end shrink-0">
          <button
            type="button"
            phx-click="close_assign_domain"
            class="btn-line text-xs py-1 px-3"
          >
            Done
          </button>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
