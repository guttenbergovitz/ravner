<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1400px] mx-auto px-6 py-10">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        Ownership
      </.link>
      <%= if @project.organization do %>
        <%= if @project.organization.brand do %>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/ownership/brands/#{@project.organization.brand.id}"}
            class="hover:text-neutral-600 transition-colors"
          >
            {@project.organization.brand.display_name || @project.organization.brand.name}
          </.link>
        <% end %>
        <.icon name="hero-chevron-right" class="w-3 h-3" />
        <.link
          navigate={~p"/ownership/organizations/#{@project.organization.id}"}
          class="hover:text-neutral-600 transition-colors"
        >
          {@project.organization.display_name || @project.organization.name}
        </.link>
      <% end %>
      <.icon name="hero-chevron-right" class="w-3 h-3" />
      <span class="text-neutral-600">{@project.display_name || @project.name}</span>
    </nav>

    <%!-- Header --%>
    <div class="flex items-end justify-between mb-10 border-b border-neutral-100 pb-8">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-light tracking-tight text-neutral-900">
            {@project.display_name || @project.name}
          </h1>
          <%= if @current_scope.user.role in [:admin, :editor] do %>
            <.link
              href={~p"/admin/projects/#{@project.id}/edit"}
              class="text-[10px] uppercase tracking-widest text-neutral-400 hover:text-neutral-600 border border-neutral-200 px-2 py-1 transition-colors"
            >
              Edit
            </.link>
          <% end %>
        </div>
        <%= if @project.organization do %>
          <p class="text-sm font-light text-neutral-500">
            {@project.organization.display_name || @project.organization.name}
          </p>
        <% end %>
        <%= if @project.description do %>
          <p class="text-xs font-light text-neutral-400 mt-2 max-w-xl">{@project.description}</p>
        <% end %>
      </div>
      <div class="flex gap-8">
        <div class="text-right">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Team Size
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.team_size}</div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Repositories
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.repos_count}</div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Domains
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.domains_count}</div>
        </div>
      </div>
    </div>

    <%!-- Context info --%>
    <div class={[
      "mb-8 border p-4",
      if(@stats.team_size == 0,
        do: "border-amber-200 bg-amber-50/30",
        else: "border-neutral-200 bg-neutral-50/50"
      )
    ]}>
      <div class="flex items-start gap-3">
        <.icon
          name="hero-information-circle"
          class="w-4 h-4 text-neutral-400 flex-shrink-0 mt-0.5"
        />
        <div>
          <p class="text-xs font-light text-neutral-500 leading-relaxed">
            A <span class="font-normal text-neutral-700">Project</span>
            represents a specific work effort — a website, an application, a migration, etc.
            Each project belongs to an Organization and has a
            <span class="font-normal text-neutral-700">Team</span>
            with defined roles,
            linked <span class="font-normal text-neutral-700">Repositories</span>, and assigned <span class="font-normal text-neutral-700">Domains</span>.
            Domains without a project assignment appear as "unassigned" in the governance dashboard.
          </p>
          <%= if @stats.team_size == 0 do %>
            <p class="text-xs font-light text-amber-600 mt-2">
              No team members yet. Add people and assign roles to build your project team.
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Search & Filter --%>
    <div class="flex items-center gap-4 mb-6">
      <div class="relative flex-1 max-w-sm">
        <.icon
          name="hero-magnifying-glass"
          class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"
        />
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search across all tabs..."
          phx-change="search"
          class="w-full pl-10 pr-4 py-2.5 border border-neutral-200 bg-white text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors"
        />
      </div>
      <%= if @search_query != "" do %>
        <button
          phx-click="search"
          phx-value-query=""
          class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
        >
          Clear
        </button>
      <% end %>
    </div>

    <%!-- Tabs --%>
    <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px">
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=team"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "team",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        Team ({length(@team)})
      </.link>
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=repositories"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "repositories",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        Repositories ({length(@repositories)})
      </.link>
      <.link
        patch={~p"/ownership/projects/#{@project.id}?tab=domains"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "domains",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        Domains ({length(@domains)})
      </.link>
    </div>

    <%!-- Tab Content --%>
    <%= cond do %>
      <% @current_tab == "team" -> %>
        <%= if @team == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <div class="text-sm font-light text-neutral-400 mb-4">
                No team members matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <.icon name="hero-users" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">No team members yet</h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                Every project needs a team. Assign people with specific roles — Owner, Manager,
                Developer, and more — to define who is responsible for this work.
              </p>
              <.link
                href={~p"/admin/projects/#{@project.id}/edit"}
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Manage team
              </.link>
            </div>
          <% end %>
        <% else %>
          <div class="border border-neutral-200 bg-white divide-y divide-neutral-100">
            <%= for member <- @team do %>
              <.link
                navigate={~p"/ownership/people/#{member.person_id}"}
                class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group"
              >
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full bg-neutral-100 flex items-center justify-center text-sm font-light text-neutral-500">
                    {String.first(member.first_name)}{String.first(member.last_name)}
                  </div>
                  <div>
                    <div class="text-sm font-normal text-neutral-900">
                      {member.first_name} {member.last_name}
                    </div>
                    <div class="text-xs font-light text-neutral-400 flex items-center gap-2">
                      <%= if member.title do %>
                        <span>{member.title}</span>
                        <span class="text-neutral-300">|</span>
                      <% end %>
                      <%= if member.email do %>
                        <span>{member.email}</span>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <span class="text-[10px] uppercase tracking-widest text-neutral-600 bg-neutral-100 px-2 py-1">
                    {member.role}
                  </span>
                  <.icon
                    name="hero-chevron-right"
                    class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                  />
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      <% @current_tab == "repositories" -> %>
        <%= if @repositories == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <div class="text-sm font-light text-neutral-400 mb-4">
                No repositories matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <.icon name="hero-code-bracket" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">No repositories linked</h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                Link your code repositories — GitHub, GitLab, Bitbucket — to this project
                for a complete picture of your technical assets.
              </p>
              <.link
                href={~p"/admin/projects/#{@project.id}/edit"}
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Add repositories
              </.link>
            </div>
          <% end %>
        <% else %>
          <div class="border border-neutral-200 bg-white divide-y divide-neutral-100">
            <%= for repo <- @repositories do %>
              <div class="flex items-center justify-between p-4">
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded bg-neutral-100 flex items-center justify-center">
                    <.icon name="hero-code-bracket" class="w-5 h-5 text-neutral-400" />
                  </div>
                  <div>
                    <a
                      href={repo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-sm font-normal text-neutral-900 hover:text-blue-600 transition-colors"
                    >
                      {repo.url}
                      <.icon name="hero-arrow-top-right-on-square" class="w-3 h-3 inline ml-1" />
                    </a>
                    <%= if repo.notes do %>
                      <div class="text-xs font-light text-neutral-400 mt-0.5">{repo.notes}</div>
                    <% end %>
                  </div>
                </div>
                <span class="text-[10px] uppercase tracking-widest text-neutral-500 border border-neutral-200 px-2 py-1">
                  {repo.kind}
                </span>
              </div>
            <% end %>
          </div>
        <% end %>
      <% @current_tab == "domains" -> %>
        <%= if @domains == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <div class="text-sm font-light text-neutral-400">
                No domains matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <.icon name="hero-globe-alt" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">No domains assigned</h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto leading-relaxed">
                Domains linked to this project will appear here. Assign domains from the
                Domain detail page to connect them to your project.
              </p>
            </div>
          <% end %>
        <% else %>
          <div class="border border-neutral-200 bg-white divide-y divide-neutral-100">
            <%= for domain <- @domains do %>
              <.link
                navigate={~p"/domains/#{domain.id}"}
                class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group"
              >
                <div class="text-sm font-normal text-neutral-900">{domain.name}</div>
                <div class="flex items-center gap-4">
                  <%= if domain.lifecycle_state do %>
                    <span class="text-[9px] uppercase tracking-widest text-neutral-500 border border-neutral-200 px-2 py-0.5">
                      {domain.lifecycle_state}
                    </span>
                  <% end %>
                  <.icon
                    name="hero-chevron-right"
                    class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                  />
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
    <% end %>
  </div>
</Layouts.app>
