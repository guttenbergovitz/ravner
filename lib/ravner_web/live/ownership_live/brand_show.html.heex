<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1400px] mx-auto px-6 py-10">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        Ownership
      </.link>
      <.icon name="hero-chevron-right" class="w-3 h-3" />
      <span class="text-neutral-600">{@brand.display_name || @brand.name}</span>
    </nav>

    <%!-- Header --%>
    <div class="flex items-end justify-between mb-10 border-b border-neutral-100 pb-8">
      <div>
        <div class="flex items-center gap-3 mb-2">
          <h1 class="text-3xl font-light tracking-tight text-neutral-900">
            {@brand.display_name || @brand.name}
          </h1>
          <%= if @current_scope.user.role in [:admin, :editor] do %>
            <.link
              href={~p"/admin/brands/#{@brand.id}/edit"}
              class="text-[10px] uppercase tracking-widest text-neutral-400 hover:text-neutral-600 border border-neutral-200 px-2 py-1 transition-colors"
            >
              Edit
            </.link>
          <% end %>
        </div>
        <%= if @brand.display_name && @brand.display_name != @brand.name do %>
          <p class="text-sm font-light text-neutral-500">{@brand.name}</p>
        <% end %>
        <%= if @brand.notes do %>
          <p class="text-xs font-light text-neutral-400 mt-2 max-w-xl">{@brand.notes}</p>
        <% end %>
      </div>
      <div class="flex gap-8">
        <div class="text-right">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Organizations
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.orgs_count}</div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Projects
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.projects_count}</div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            People
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.people_count}</div>
        </div>
        <div class="text-right border-l border-neutral-100 pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Domains
          </div>
          <div class="text-2xl font-light text-neutral-900">{@stats.domains_count}</div>
        </div>
      </div>
    </div>

    <%!-- Context info --%>
    <div class={[
      "mb-8 border p-4",
      if(@stats.orgs_count == 0,
        do: "border-amber-200 bg-amber-50/30",
        else: "border-neutral-200 bg-neutral-50/50"
      )
    ]}>
      <div class="flex items-start gap-3">
        <.icon
          name="hero-information-circle"
          class="w-4 h-4 text-neutral-400 flex-shrink-0 mt-0.5"
        />
        <div>
          <p class="text-xs font-light text-neutral-500 leading-relaxed">
            A <span class="font-normal text-neutral-700">Brand</span>
            is the top-level container for your corporate structure.
            Under each brand you add
            <span class="font-normal text-neutral-700">Organizations</span>
            — these can be
            internal departments, regional offices, client companies, or contractor teams.
          </p>
          <%= if @stats.orgs_count == 0 do %>
            <p class="text-xs font-light text-amber-600 mt-2">
              This brand has no organizations yet. Add one to start tracking projects and people.
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Search --%>
    <div class="flex items-center gap-4 mb-6">
      <div class="relative flex-1 max-w-sm">
        <.icon
          name="hero-magnifying-glass"
          class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"
        />
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search organizations..."
          phx-change="search"
          class="w-full pl-10 pr-4 py-2.5 border border-neutral-200 bg-white text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors"
        />
      </div>
      <%= if @search_query != "" do %>
        <span class="text-xs font-light text-neutral-400">
          {length(@organizations)} of {length(@all_organizations)} results
        </span>
        <button
          phx-click="search"
          phx-value-query=""
          class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
        >
          Clear
        </button>
      <% end %>
    </div>

    <%!-- Tabs --%>
    <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px">
      <.link
        patch={~p"/ownership/brands/#{@brand.id}?tab=organizations"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "organizations",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        Organizations ({length(@organizations)})
      </.link>
      <.link
        patch={~p"/ownership/brands/#{@brand.id}?tab=projects"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "projects",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        Projects ({@stats.projects_count})
      </.link>
      <.link
        patch={~p"/ownership/brands/#{@brand.id}?tab=people"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "people",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        People ({@stats.people_count})
      </.link>
      <.link
        patch={~p"/ownership/brands/#{@brand.id}?tab=domains"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "domains",
            do: "border-neutral-900 text-neutral-900 font-medium",
            else: "border-transparent text-neutral-400 hover:text-neutral-600"
          )
        ]}
      >
        Domains ({@stats.domains_count})
      </.link>
    </div>

    <%!-- Tab Content loaded lazily via handle_params --%>
    <%= cond do %>
      <% @current_tab == "organizations" -> %>
        <div class="space-y-6">
          <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3">
            Organizations <span class="h-px flex-1 bg-neutral-100"></span>
          </h2>
          <%= if @organizations == [] do %>
            <%= if @search_query != "" do %>
              <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
                <div class="text-sm font-light text-neutral-400 mb-4">
                  No organizations matching "{@search_query}".
                </div>
                <button
                  phx-click="search"
                  phx-value-query=""
                  class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
                >
                  Clear search
                </button>
              </div>
            <% else %>
              <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
                <.icon
                  name="hero-building-office"
                  class="w-10 h-10 text-neutral-200 mx-auto mb-4"
                />
                <h3 class="text-sm font-light text-neutral-500 mb-2">No organizations yet</h3>
                <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                  Organizations represent departments, regional offices, or client companies within this brand.
                  Add one to start tracking projects and team members.
                </p>
                <.link
                  href={~p"/admin/organizations/new"}
                  class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
                >
                  Add an organization
                </.link>
              </div>
            <% end %>
          <% else %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
              <%= for org <- @organizations do %>
                <.link
                  navigate={~p"/ownership/organizations/#{org.id}"}
                  class={[
                    "block border bg-white p-6 hover:border-neutral-400 transition-colors group",
                    if(org.projects_count == 0 && org.people_count == 0,
                      do: "border-amber-200/50 bg-amber-50/20",
                      else: "border-neutral-200"
                    )
                  ]}
                >
                  <div class="flex items-start justify-between mb-4">
                    <div>
                      <h3 class="text-lg font-light text-neutral-900 group-hover:text-neutral-700">
                        {org.display_name || org.name}
                      </h3>
                      <div class="flex items-center gap-2 mt-1">
                        <span class={[
                          "text-[9px] uppercase tracking-widest px-1.5 py-0.5 border",
                          case org.type do
                            :internal -> "text-blue-600 bg-blue-50 border-blue-100"
                            :client -> "text-emerald-600 bg-emerald-50 border-emerald-100"
                            :contractor -> "text-amber-600 bg-amber-50 border-amber-100"
                            :partner -> "text-purple-600 bg-purple-50 border-purple-100"
                            _ -> "text-neutral-600 bg-neutral-50 border-neutral-100"
                          end
                        ]}>
                          {org.type}
                        </span>
                        <%= if org.country do %>
                          <span class="text-[10px] text-neutral-400">{org.country}</span>
                        <% end %>
                      </div>
                    </div>
                    <.icon
                      name="hero-chevron-right"
                      class="w-5 h-5 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                    />
                  </div>
                  <div class="grid grid-cols-3 gap-4 text-center border-t border-neutral-100 pt-4">
                    <div>
                      <div class="text-lg font-light text-neutral-900">{org.projects_count}</div>
                      <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
                        Projects
                      </div>
                    </div>
                    <div class="border-l border-neutral-100">
                      <div class="text-lg font-light text-neutral-900">{org.people_count}</div>
                      <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
                        People
                      </div>
                    </div>
                    <div class="border-l border-neutral-100">
                      <div class="text-lg font-light text-neutral-900">{org.domains_count}</div>
                      <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
                        Domains
                      </div>
                    </div>
                  </div>
                </.link>
              <% end %>
            </div>
          <% end %>
        </div>
      <% @current_tab == "projects" -> %>
        <div class="space-y-6">
          <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3">
            All Projects <span class="h-px flex-1 bg-neutral-100"></span>
          </h2>
          <%= if @stats.projects_count == 0 do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <div class="text-sm font-light text-neutral-400">
                No projects in this brand yet.
              </div>
            </div>
          <% else %>
            <div class="border border-neutral-200 bg-white divide-y divide-neutral-100">
              <%= for project <- @projects do %>
                <.link
                  navigate={~p"/ownership/projects/#{project.id}"}
                  class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group"
                >
                  <div>
                    <div class="text-sm font-normal text-neutral-900 group-hover:text-neutral-700">
                      {project.display_name || project.name}
                    </div>
                    <div class="text-xs font-light text-neutral-400 flex items-center gap-2 mt-0.5">
                      <.link
                        navigate={~p"/ownership/organizations/#{project.organization_id}"}
                        class="hover:text-neutral-500 transition-colors"
                      >
                        {project.organization_name}
                      </.link>
                      <%= if project.description do %>
                        <span class="text-neutral-300">|</span>
                        <span class="truncate max-w-xs">{project.description}</span>
                      <% end %>
                    </div>
                  </div>
                  <div class="flex items-center gap-6 text-xs text-neutral-400">
                    <span class="tabular-nums">{project.team_size} team</span>
                    <span class="tabular-nums">{project.repos_count} repos</span>
                    <span class="tabular-nums">{project.domains_count} domains</span>
                    <.icon
                      name="hero-chevron-right"
                      class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                    />
                  </div>
                </.link>
              <% end %>
            </div>
          <% end %>
        </div>
      <% @current_tab == "people" -> %>
        <div class="space-y-6">
          <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3">
            All People <span class="h-px flex-1 bg-neutral-100"></span>
          </h2>
          <%= if @stats.people_count == 0 do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <div class="text-sm font-light text-neutral-400">No people in this brand yet.</div>
            </div>
          <% else %>
            <div class="border border-neutral-200 bg-white divide-y divide-neutral-100">
              <%= for person <- @people do %>
                <.link
                  navigate={~p"/ownership/people/#{person.id}"}
                  class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group"
                >
                  <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-neutral-100 flex items-center justify-center text-sm font-light text-neutral-500">
                      {String.first(person.first_name)}{String.first(person.last_name)}
                    </div>
                    <div>
                      <div class="text-sm font-normal text-neutral-900 group-hover:text-neutral-700">
                        {person.first_name} {person.last_name}
                      </div>
                      <div class="text-xs font-light text-neutral-400 flex items-center gap-2">
                        <%= if person.title do %>
                          <span>{person.title}</span>
                          <span class="text-neutral-300">|</span>
                        <% end %>
                        <span>{person.organization_name}</span>
                        <%= if person.email do %>
                          <span class="text-neutral-300">|</span>
                          <span>{person.email}</span>
                        <% end %>
                      </div>
                    </div>
                  </div>
                  <div class="flex items-center gap-4">
                    <div class="text-xs text-neutral-400">{person.roles_count} project(s)</div>
                    <.icon
                      name="hero-chevron-right"
                      class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                    />
                  </div>
                </.link>
              <% end %>
            </div>
          <% end %>
        </div>
      <% @current_tab == "domains" -> %>
        <div class="space-y-6">
          <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3">
            Direct Domains <span class="h-px flex-1 bg-neutral-100"></span>
          </h2>
          <%= if @stats.domains_count == 0 do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50">
              <div class="text-sm font-light text-neutral-400">
                No domains assigned to this brand yet.
              </div>
            </div>
          <% else %>
            <div class="border border-neutral-200 bg-white divide-y divide-neutral-100">
              <%= for domain <- @domains do %>
                <.link
                  navigate={~p"/domains/#{domain.id}"}
                  class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group"
                >
                  <div>
                    <div class="text-sm font-normal text-neutral-900">{domain.name}</div>
                    <%= if domain.organization_id do %>
                      <div class="text-xs font-light text-neutral-400">
                        Assigned to organization
                      </div>
                    <% end %>
                  </div>
                  <div class="flex items-center gap-4">
                    <%= if domain.lifecycle_state do %>
                      <span class="text-[9px] uppercase tracking-widest text-neutral-500 border border-neutral-200 px-2 py-0.5">
                        {domain.lifecycle_state}
                      </span>
                    <% end %>
                    <.icon
                      name="hero-chevron-right"
                      class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                    />
                  </div>
                </.link>
              <% end %>
            </div>
          <% end %>
        </div>
    <% end %>
  </div>
</Layouts.app>
