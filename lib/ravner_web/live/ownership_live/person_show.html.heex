<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1400px] mx-auto px-6 py-10">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        Ownership
      </.link>
      <%= if @person.organization do %>
        <%= if @person.organization.brand do %>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/ownership/brands/#{@person.organization.brand.id}"}
            class="hover:text-neutral-600 transition-colors"
          >
            {@person.organization.brand.display_name || @person.organization.brand.name}
          </.link>
        <% end %>
        <.icon name="hero-chevron-right" class="w-3 h-3" />
        <.link
          navigate={~p"/ownership/organizations/#{@person.organization.id}"}
          class="hover:text-neutral-600 transition-colors"
        >
          {@person.organization.display_name || @person.organization.name}
        </.link>
      <% end %>
      <.icon name="hero-chevron-right" class="w-3 h-3" />
      <span class="text-neutral-600">{@person.first_name} {@person.last_name}</span>
    </nav>

    <%!-- Header --%>
    <div class="flex items-start justify-between mb-10 border-b border-neutral-100 pb-8">
      <div class="flex items-start gap-6">
        <div class="w-20 h-20 rounded-full bg-neutral-100 flex items-center justify-center text-2xl font-light text-neutral-500 dark:bg-neutral-700 dark:text-neutral-400">
          {String.first(@person.first_name)}{String.first(@person.last_name)}
        </div>
        <div>
          <div class="flex items-center gap-3 mb-2">
            <h1 class="text-3xl font-light tracking-tight text-neutral-900 dark:text-neutral-100">
              {@person.first_name} {@person.last_name}
            </h1>
            <%= if @current_scope.user.role in [:admin, :editor] do %>
              <.link
                href={~p"/admin/people/#{@person.id}/edit"}
                class="text-[10px] uppercase tracking-widest text-neutral-400 hover:text-neutral-600 border border-neutral-200 px-2 py-1 transition-colors"
              >
                Edit
              </.link>
            <% end %>
          </div>
          <%= if @person.title do %>
            <p class="text-sm font-light text-neutral-500">{@person.title}</p>
          <% end %>
          <div class="flex items-center gap-4 mt-3 text-xs font-light text-neutral-400">
            <%= if @person.email do %>
              <a
                href={"mailto:#{@person.email}"}
                class="hover:text-neutral-600 transition-colors flex items-center gap-1"
              >
                <.icon name="hero-envelope" class="w-4 h-4" />
                {@person.email}
              </a>
            <% end %>
            <%= if @person.phone do %>
              <a
                href={"tel:#{@person.phone}"}
                class="hover:text-neutral-600 transition-colors flex items-center gap-1"
              >
                <.icon name="hero-phone" class="w-4 h-4" />
                {@person.phone}
              </a>
            <% end %>
            <%= if @person.mobile do %>
              <a
                href={"tel:#{@person.mobile}"}
                class="hover:text-neutral-600 transition-colors flex items-center gap-1"
              >
                <.icon name="hero-device-phone-mobile" class="w-4 h-4" />
                {@person.mobile}
              </a>
            <% end %>
          </div>
          <%= if @person.organization do %>
            <div class="mt-3 text-xs font-light text-neutral-400">
              <.link
                navigate={~p"/ownership/organizations/#{@person.organization.id}"}
                class="hover:text-neutral-600 transition-colors"
              >
                {@person.organization.display_name || @person.organization.name}
              </.link>
            </div>
          <% end %>
        </div>
      </div>
      <div class="text-right">
        <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
          Project Roles
        </div>
        <div class="text-2xl font-light text-neutral-900">{@stats.roles_count}</div>
      </div>
    </div>

    <%!-- Context info --%>
    <div class={[
      "mb-8 border p-4",
      if(@stats.roles_count == 0,
        do: "border-amber-200 bg-amber-50/30",
        else: "border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50"
      )
    ]}>
      <div class="flex items-start gap-3">
        <.icon
          name="hero-information-circle"
          class="w-4 h-4 text-neutral-400 flex-shrink-0 mt-0.5"
        />
        <div>
          <p class="text-xs font-light text-neutral-500 leading-relaxed">
            A <span class="font-normal text-neutral-700 dark:text-neutral-300">Person</span>
            is someone who contributes to projects.
            They can be assigned to multiple projects with different roles — for example, someone might be the
            <span class="font-normal text-neutral-700 dark:text-neutral-300">Owner</span>
            of one project and a
            <span class="font-normal text-neutral-700 dark:text-neutral-300">Developer</span>
            on another.
            Each person belongs to one <span class="font-normal text-neutral-700 dark:text-neutral-300">Organization</span>.
          </p>
          <%= if @stats.roles_count == 0 do %>
            <p class="text-xs font-light text-amber-600 mt-2">
              This person is not assigned to any projects yet. Assign them to a project to define their role.
            </p>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Notes --%>
    <%= if @person.notes do %>
      <div class="mb-8 p-4 bg-neutral-50 border border-neutral-100 dark:bg-neutral-800 dark:border-neutral-700">
        <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-2">
          Notes
        </div>
        <p class="text-sm font-light text-neutral-600">{@person.notes}</p>
      </div>
    <% end %>

    <%!-- Search & Filter --%>
    <div class="flex items-center gap-4 mb-6">
      <div class="relative flex-1 max-w-sm">
        <.icon
          name="hero-magnifying-glass"
          class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"
        />
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search project assignments..."
          phx-change="search"
          class="w-full pl-10 pr-4 py-2.5 border border-neutral-200 bg-white text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500 dark:focus:border-neutral-300"
        />
      </div>
      <%= if @search_query != "" do %>
        <span class="text-xs font-light text-neutral-400">
          {length(@roles)} of {length(@all_roles)} results
        </span>
        <button
          phx-click="search"
          phx-value-query=""
          class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
        >
          Clear
        </button>
      <% end %>
    </div>

    <%!-- Project Roles --%>
    <div class="space-y-6">
      <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
        Project Assignments <span class="h-px flex-1 bg-neutral-100 dark:bg-neutral-700"></span>
      </h2>

      <%= if @roles == [] do %>
        <%= if @search_query != "" do %>
          <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
            <div class="text-sm font-light text-neutral-400 mb-4">
              No assignments matching "{@search_query}".
            </div>
            <button
              phx-click="search"
              phx-value-query=""
              class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
            >
              Clear search
            </button>
          </div>
        <% else %>
          <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
            <.icon name="hero-folder" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
            <h3 class="text-sm font-light text-neutral-500 mb-2">Not assigned to any projects</h3>
            <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
              This person exists in the system but hasn't been assigned to any project yet.
              Go to a project's edit page to add them to a team with a specific role.
            </p>
            <.link
              navigate={~p"/ownership"}
              class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
            >
              Browse projects
            </.link>
          </div>
        <% end %>
      <% else %>
        <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700">
          <%= for role <- @roles do %>
            <.link
              navigate={~p"/ownership/projects/#{role.project_id}"}
              class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group dark:hover:bg-neutral-700"
            >
              <div>
                <div class="text-sm font-normal text-neutral-900">{role.project_name}</div>
                <div class="text-xs font-light text-neutral-400">{role.organization_name}</div>
              </div>
              <div class="flex items-center gap-4">
                <span class="text-[10px] uppercase tracking-widest text-neutral-600 bg-neutral-100 px-2 py-1">
                  {role.role}
                </span>
                <.icon
                  name="hero-chevron-right"
                  class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                />
              </div>
            </.link>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
