<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1400px] mx-auto px-6 py-10">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        Ownership
      </.link>
      <.icon name="hero-chevron-right" class="w-3 h-3" />
      <%= if @org.brand do %>
        <.link
          navigate={~p"/ownership/brands/#{@org.brand.id}"}
          class="hover:text-neutral-600 transition-colors"
        >
          {@org.brand.display_name || @org.brand.name}
        </.link>
        <.icon name="hero-chevron-right" class="w-3 h-3" />
      <% end %>
      <span class="text-neutral-600">{@org.display_name || @org.name}</span>
    </nav>

    <%!-- Header --%>
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-8 border-b border-neutral-100 pb-8 dark:border-neutral-800">
      <div>
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          <h1 class="text-3xl font-light tracking-tight text-neutral-900 dark:text-neutral-100">
            {@org.display_name || @org.name}
          </h1>
          <span class={[
            "text-[9px] uppercase tracking-widest px-2 py-1 border",
            case @org.type do
              :internal ->
                "text-blue-600 bg-blue-50 border-blue-100"

              :client ->
                "text-emerald-600 bg-emerald-50 border-emerald-100"

              :contractor ->
                "text-amber-600 bg-amber-50 border-amber-100"

              :partner ->
                "text-purple-600 bg-purple-50 border-purple-100"

              _ ->
                "text-neutral-600 bg-neutral-50 border-neutral-100 dark:text-neutral-300 dark:bg-neutral-800 dark:border-neutral-700"
            end
          ]}>
            {@org.type}
          </span>
          <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded border border-neutral-200 bg-neutral-50 text-neutral-600 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400">
            {@org.slug}
          </span>
          <%= if @can_manage? do %>
            <div class="flex items-center gap-2">
              <.link
                href={~p"/admin/organizations/#{@org.id}/edit"}
                class="text-[10px] uppercase tracking-widest text-neutral-500 hover:text-neutral-800 border border-neutral-200 px-2 py-1 transition-colors dark:border-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
              >
                Edit Details
              </.link>
              <%= if @can_delegate_po? do %>
                <button
                  type="button"
                  phx-click="open_invite_owner"
                  id="invite-product-owner-btn"
                  class="text-[10px] uppercase tracking-widest text-emerald-600 hover:text-emerald-800 border border-emerald-200 px-2 py-1 transition-colors dark:border-emerald-800 dark:text-emerald-400"
                >
                  + Invite Product Owner
                </button>
              <% end %>
              <.link
                href={~p"/admin/projects/new"}
                class="text-[10px] uppercase tracking-widest text-neutral-500 hover:text-neutral-800 border border-neutral-200 px-2 py-1 transition-colors dark:border-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
              >
                + Add Project
              </.link>
            </div>
          <% end %>
        </div>
        <div class="flex items-center gap-4 text-xs font-light text-neutral-500 flex-wrap">
          <%= if @org.country do %>
            <span>
              Country:
              <strong class="font-medium text-neutral-700 dark:text-neutral-300">
                {@org.country}
              </strong>
            </span>
          <% end %>
          <%= if @org.brand do %>
            <span class="text-neutral-300">|</span>
            <span>
              Parent Brand:
              <.link
                navigate={~p"/ownership/brands/#{@org.brand.id}"}
                class="text-neutral-700 dark:text-neutral-300 hover:underline font-medium"
              >
                {@org.brand.display_name || @org.brand.name}
              </.link>
            </span>
          <% end %>
        </div>
        <%= if @org.notes do %>
          <p class="text-xs font-light text-neutral-400 mt-2 max-w-2xl leading-relaxed">
            {@org.notes}
          </p>
        <% end %>
      </div>

      <%!-- Stats counters --%>
      <div class="flex gap-6 sm:gap-8 shrink-0">
        <div>
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Projects
          </div>
          <div class="text-2xl font-light text-neutral-900 dark:text-neutral-100">
            {@stats.projects_count}
          </div>
        </div>
        <div class="border-l border-neutral-100 dark:border-neutral-800 pl-6 sm:pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            People
          </div>
          <div class="text-2xl font-light text-neutral-900 dark:text-neutral-100">
            {@stats.people_count}
          </div>
        </div>
        <div class="border-l border-neutral-100 dark:border-neutral-800 pl-6 sm:pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Domains
          </div>
          <div class="text-2xl font-light text-neutral-900 dark:text-neutral-100">
            {@stats.domains_count}
          </div>
        </div>
        <div class="border-l border-neutral-100 dark:border-neutral-800 pl-6 sm:pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Risk Posture
          </div>
          <div class="flex items-baseline gap-2">
            <div class={[
              "text-2xl font-light",
              if(@stats.domains_at_risk_count > 0,
                do: "text-amber-600 dark:text-amber-400 font-normal",
                else: "text-neutral-900 dark:text-neutral-100"
              )
            ]}>
              {@stats.domains_at_risk_count}
            </div>
            <%= if @stats.critical_count > 0 || @stats.high_count > 0 do %>
              <span class="text-[10px] font-mono text-red-600 dark:text-red-400">
                ({@stats.critical_count}C / {@stats.high_count}H)
              </span>
            <% end %>
          </div>
          <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
            {if @stats.domains_at_risk_count == 1, do: "Domain at risk", else: "Domains at risk"}
          </div>
        </div>
      </div>
    </div>

    <%!-- Executive Leadership & Escalation Path Card --%>
    <div
      class="mb-8 border border-neutral-200 bg-white dark:border-neutral-800 dark:bg-neutral-900 p-6 shadow-xs"
      id="org-governance-card"
    >
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <%!-- Left Column: Organization Manager --%>
        <div class="lg:col-span-6 border-b lg:border-b-0 lg:border-r border-neutral-100 dark:border-neutral-800 pb-6 lg:pb-0 lg:pr-8">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-blue-500"></span>
              <span class="text-xs font-medium uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
                Company Leadership (Level 1 Escalation)
              </span>
            </div>
            <%= if @can_manage? do %>
              <div class="flex items-center gap-2">
                <button
                  type="button"
                  phx-click="open_assign_manager"
                  id="assign-company-manager-btn"
                  class="btn-line text-[11px] py-1 px-2.5 inline-flex items-center gap-1"
                >
                  <.icon name="hero-user-plus" class="w-3.5 h-3.5" />
                  {if @org.manager, do: "Change Manager", else: "Assign Manager"}
                </button>
                <%= if @org.manager do %>
                  <button
                    type="button"
                    phx-click="quick_unassign_company_manager"
                    data-confirm="Are you sure you want to unassign this company manager?"
                    class="text-[11px] text-neutral-400 hover:text-red-600 transition-colors px-1"
                    title="Unassign Manager"
                  >
                    Unassign
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>

          <%= if @org.manager do %>
            <div class="flex items-start gap-4 mt-2">
              <div class="w-12 h-12 rounded-full bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300 font-medium text-sm flex items-center justify-center shrink-0 border border-blue-200 dark:border-blue-800">
                {String.first(@org.manager.first_name || "")}{String.first(
                  @org.manager.last_name || ""
                )}
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <.link
                    navigate={~p"/ownership/people/#{@org.manager.id}"}
                    class="text-base font-medium text-neutral-900 dark:text-neutral-100 hover:underline"
                  >
                    {@org.manager.first_name} {@org.manager.last_name}
                  </.link>
                  <span class="text-[10px] font-mono uppercase px-1.5 py-0.5 rounded bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950 dark:text-blue-300 dark:border-blue-800">
                    Organization Manager
                  </span>
                </div>
                <%= if @org.manager.title do %>
                  <p class="text-xs text-neutral-500 mt-0.5">{@org.manager.title}</p>
                <% end %>
                <div class="mt-2 flex items-center gap-4 text-xs text-neutral-500">
                  <%= if @org.manager.email do %>
                    <a
                      href={"mailto:#{@org.manager.email}"}
                      class="hover:text-neutral-900 dark:hover:text-neutral-100 inline-flex items-center gap-1.5 transition-colors"
                    >
                      <.icon name="hero-envelope" class="w-3.5 h-3.5 text-neutral-400" />
                      {@org.manager.email}
                    </a>
                  <% end %>
                  <%= if @org.manager.phone do %>
                    <span class="inline-flex items-center gap-1.5 text-neutral-400">
                      <.icon name="hero-phone" class="w-3.5 h-3.5" />
                      {@org.manager.phone}
                    </span>
                  <% end %>
                </div>
              </div>
            </div>
          <% else %>
            <div class="p-4 rounded border border-amber-200/80 bg-amber-50/40 dark:border-amber-900/50 dark:bg-amber-950/20 mt-2">
              <div class="flex items-start gap-3.5">
                <div class="w-10 h-10 rounded-full bg-amber-100 text-amber-600 dark:bg-amber-900/50 dark:text-amber-400 flex items-center justify-center shrink-0">
                  <.icon name="hero-user" class="w-5 h-5" />
                </div>
                <div class="flex-1">
                  <div class="flex items-center justify-between">
                    <p class="text-xs font-medium text-amber-900 dark:text-amber-200">
                      No Company Manager Designated
                    </p>
                    <%= if @can_manage? do %>
                      <button
                        type="button"
                        phx-click="open_assign_manager"
                        class="btn-line text-[11px] py-1 px-2.5 inline-flex items-center gap-1 text-amber-900 border-amber-300 hover:bg-amber-100 dark:text-amber-200 dark:border-amber-700"
                      >
                        <.icon name="hero-user-plus" class="w-3.5 h-3.5" /> Assign Now
                      </button>
                    <% end %>
                  </div>
                  <p class="text-xs font-light text-neutral-500 dark:text-neutral-400 mt-1 leading-relaxed">
                    Designating an Organization Manager establishes local authority for project ownership, domain lifecycle approvals, and team management.
                  </p>
                </div>
              </div>
            </div>
          <% end %>
        </div>

        <%!-- Right Column: Escalation Hierarchy --%>
        <div class="lg:col-span-6">
          <div class="flex items-center gap-2 mb-3">
            <.icon name="hero-shield-check" class="w-4 h-4 text-neutral-400" />
            <span class="text-xs font-medium uppercase tracking-wider text-neutral-700 dark:text-neutral-300">
              Escalation Chain
            </span>
          </div>

          <div class="space-y-2.5 text-xs">
            <div class="p-2.5 rounded border border-blue-200 bg-blue-50/50 dark:border-blue-900/50 dark:bg-blue-950/20 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-5 h-5 rounded-full bg-blue-600 text-white text-[10px] font-mono flex items-center justify-center font-bold">
                  1
                </span>
                <div>
                  <span class="font-medium text-blue-900 dark:text-blue-200">
                    Direct Company Oversight (Level 1)
                  </span>
                  <p class="text-[11px] text-blue-700/70 dark:text-blue-300/70">
                    <%= if @org.manager do %>
                      Led by {@org.manager.first_name} {@org.manager.last_name}
                    <% else %>
                      Currently unassigned
                    <% end %>
                  </p>
                </div>
              </div>
            </div>

            <div class="p-2.5 rounded border border-neutral-100 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-800/40 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-5 h-5 rounded-full bg-purple-100 text-purple-700 dark:bg-purple-950 dark:text-purple-300 text-[10px] font-mono flex items-center justify-center font-bold">
                  2
                </span>
                <div>
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">
                    Parent Brand Escalation (Level 2)
                  </span>
                  <p class="text-[11px] text-neutral-400">
                    <%= if @org.brand do %>
                      <.link
                        navigate={~p"/ownership/brands/#{@org.brand.id}"}
                        class="hover:underline font-medium text-neutral-700 dark:text-neutral-300"
                      >
                        {@org.brand.display_name || @org.brand.name}
                      </.link>
                      <%= if @org.brand.brand_manager do %>
                        — Brand Manager: {@org.brand.brand_manager.first_name} {@org.brand.brand_manager.last_name}
                      <% else %>
                        (Brand Manager unassigned)
                      <% end %>
                    <% else %>
                      Independent organization without parent brand
                    <% end %>
                  </p>
                </div>
              </div>
            </div>

            <div class="p-2.5 rounded border border-neutral-100 bg-neutral-50/70 dark:border-neutral-800 dark:bg-neutral-800/40 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <span class="w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 text-[10px] font-mono flex items-center justify-center font-bold">
                  3
                </span>
                <div>
                  <span class="font-medium text-neutral-800 dark:text-neutral-200">
                    Technical Execution Layer
                  </span>
                  <p class="text-[11px] text-neutral-400">
                    {@stats.projects_count} Projects & {@stats.domains_count} Domains overseen by assigned technical PM/PO contacts
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%!-- Search & Filter --%>
    <div class="flex items-center gap-4 mb-6">
      <div class="relative flex-1 max-w-sm">
        <.icon
          name="hero-magnifying-glass"
          class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"
        />
        <input
          type="text"
          name="query"
          value={@search_query}
          placeholder="Search across all tabs..."
          phx-change="search"
          class="w-full pl-10 pr-4 py-2.5 border border-neutral-200 bg-white text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500 dark:focus:border-neutral-300"
        />
      </div>
      <%= if @search_query != "" do %>
        <button
          phx-click="search"
          phx-value-query=""
          class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
        >
          Clear
        </button>
      <% end %>
    </div>

    <%!-- Tabs --%>
    <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px dark:border-neutral-800">
      <.link
        patch={~p"/ownership/organizations/#{@org.id}?tab=projects"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "projects",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        Projects ({length(@projects)})
      </.link>
      <.link
        patch={~p"/ownership/organizations/#{@org.id}?tab=people"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "people",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        People ({length(@people)})
      </.link>
      <.link
        patch={~p"/ownership/organizations/#{@org.id}?tab=domains"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "domains",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        Domains ({length(@domains)})
      </.link>
      <.link
        patch={~p"/ownership/organizations/#{@org.id}?tab=audit"}
        class={[
          "text-xs font-normal uppercase tracking-widest pb-4 border-b-2 transition-all duration-200",
          if(@current_tab == "audit",
            do:
              "border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100",
            else:
              "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
          )
        ]}
      >
        Audit Trail ({length(@versions)})
      </.link>
    </div>

    <%!-- Tab Content --%>
    <%= cond do %>
      <% @current_tab == "projects" -> %>
        <%= if @projects == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <div class="text-sm font-light text-neutral-400 mb-4">
                No projects matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <.icon name="hero-folder" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">No projects yet</h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                Projects are specific work efforts — websites, apps, migrations — that belong to this organization.
                Create a project to start assigning team members, repositories, and domains.
              </p>
              <.link
                href={~p"/admin/projects/new"}
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Create a project
              </.link>
            </div>
          <% end %>
        <% else %>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <%= for project <- @projects do %>
              <.link
                navigate={~p"/ownership/projects/#{project.id}"}
                class={[
                  "block border bg-white p-6 hover:border-neutral-400 transition-colors group",
                  if(project.team_size == 0,
                    do: "border-amber-200/50 bg-amber-50/20",
                    else: "border-neutral-200"
                  )
                ]}
              >
                <div class="flex items-start justify-between mb-4">
                  <div>
                    <h3 class="text-lg font-light text-neutral-900 group-hover:text-neutral-700">
                      {project.display_name || project.name}
                    </h3>
                    <%= if project.description do %>
                      <p class="text-xs font-light text-neutral-400 mt-1 line-clamp-2">
                        {project.description}
                      </p>
                    <% end %>
                  </div>
                  <.icon
                    name="hero-chevron-right"
                    class="w-5 h-5 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                  />
                </div>

                <div class="grid grid-cols-3 gap-4 text-center border-t border-neutral-100 pt-4">
                  <div>
                    <div class="text-lg font-light text-neutral-900">{project.team_size}</div>
                    <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
                      Team
                    </div>
                  </div>
                  <div class="border-l border-neutral-100">
                    <div class="text-lg font-light text-neutral-900">{project.repos_count}</div>
                    <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
                      Repos
                    </div>
                  </div>
                  <div class="border-l border-neutral-100">
                    <div class="text-lg font-light text-neutral-900">{project.domains_count}</div>
                    <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-0.5">
                      Domains
                    </div>
                  </div>
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      <% @current_tab == "people" -> %>
        <%= if @people == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <div class="text-sm font-light text-neutral-400 mb-4">
                No people matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <.icon name="hero-users" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">No people yet</h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto mb-4 leading-relaxed">
                People are the individuals who work on projects. Add team members here, then assign them
                to projects with specific roles like Owner, Developer, or Manager.
              </p>
              <.link
                href={~p"/admin/people/new"}
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Add a person
              </.link>
            </div>
          <% end %>
        <% else %>
          <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700">
            <%= for person <- @people do %>
              <.link
                navigate={~p"/ownership/people/#{person.id}"}
                class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group dark:hover:bg-neutral-700"
              >
                <div class="flex items-center gap-4">
                  <div class="w-10 h-10 rounded-full bg-neutral-100 flex items-center justify-center text-sm font-light text-neutral-500 dark:bg-neutral-700 dark:text-neutral-400">
                    {String.first(person.first_name)}{String.first(person.last_name)}
                  </div>
                  <div>
                    <div class="text-sm font-normal text-neutral-900">
                      {person.first_name} {person.last_name}
                    </div>
                    <div class="text-xs font-light text-neutral-400 flex items-center gap-2">
                      <%= if person.title do %>
                        <span>{person.title}</span>
                      <% end %>
                      <%= if person.email do %>
                        <span class="text-neutral-300">|</span>
                        <span>{person.email}</span>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <div class="text-xs text-neutral-400">
                    {person.roles_count} project(s)
                  </div>
                  <.icon
                    name="hero-chevron-right"
                    class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                  />
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      <% @current_tab == "domains" -> %>
        <%= if @domains == [] do %>
          <%= if @search_query != "" do %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <div class="text-sm font-light text-neutral-400">
                No domains matching "{@search_query}".
              </div>
              <button
                phx-click="search"
                phx-value-query=""
                class="text-xs font-normal text-neutral-600 hover:text-neutral-900 underline"
              >
                Clear search
              </button>
            </div>
          <% else %>
            <div class="py-16 text-center border border-dashed border-neutral-200 bg-neutral-50/50 dark:border-neutral-700 dark:bg-neutral-800/50">
              <.icon name="hero-globe-alt" class="w-10 h-10 text-neutral-200 mx-auto mb-4" />
              <h3 class="text-sm font-light text-neutral-500 mb-2">No domains assigned</h3>
              <p class="text-xs font-light text-neutral-400 max-w-md mx-auto leading-relaxed">
                Domains linked to this organization will appear here. Assign domains from the
                Domain detail page to connect them to your organizational structure.
              </p>
            </div>
          <% end %>
        <% else %>
          <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700">
            <%= for domain <- @domains do %>
              <.link
                navigate={~p"/domains/#{domain.id}"}
                class="flex items-center justify-between p-4 hover:bg-neutral-50 transition-colors group dark:hover:bg-neutral-700"
              >
                <div class="flex items-center gap-3">
                  <span class={
                    RavnerWeb.DomainComponents.lifecycle_dot_class(domain.lifecycle_state, :sm)
                  }>
                  </span>
                  <div>
                    <div class="text-sm font-normal text-neutral-900 group-hover:text-neutral-700 dark:text-neutral-100 dark:group-hover:text-neutral-300">
                      {domain.name}
                    </div>
                    <div class="text-xs font-light text-neutral-400 flex items-center gap-2 mt-0.5">
                      <%= if domain.project_name do %>
                        <span>Project: {domain.project_name}</span>
                      <% else %>
                        <span class="text-amber-600 dark:text-amber-400">
                          No project assigned
                        </span>
                      <% end %>
                    </div>
                  </div>
                </div>
                <div class="flex items-center gap-4">
                  <%= if domain.technical_status do %>
                    <RavnerWeb.DomainComponents.technical_status_indicator
                      status={domain.technical_status}
                      variant={:label}
                    />
                  <% end %>
                  <%= if domain.lifecycle_state do %>
                    <span class="text-[9px] uppercase tracking-widest text-neutral-500 border border-neutral-200 px-2 py-0.5 dark:text-neutral-400 dark:border-neutral-700">
                      {domain.lifecycle_state}
                    </span>
                  <% end %>
                  <.icon
                    name="hero-chevron-right"
                    class="w-4 h-4 text-neutral-300 group-hover:text-neutral-500 transition-colors"
                  />
                </div>
              </.link>
            <% end %>
          </div>
        <% end %>
      <% @current_tab == "audit" -> %>
        <div class="space-y-6">
          <h2 class="text-xs font-normal uppercase tracking-widest text-neutral-800 flex items-center gap-3 dark:text-neutral-200">
            Company Governance History
            <span class="h-px flex-1 bg-neutral-100 dark:bg-neutral-700"></span>
          </h2>
          <.governance_audit_trail
            versions={@versions}
            brands={if @org.brand, do: [@org.brand], else: []}
            orgs={[@org]}
            projects={@all_projects}
          />
        </div>
    <% end %>

    <%!-- Company Manager Assignment Modal --%>
    <%= if @assigning_manager? do %>
      <div
        class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-neutral-900/60 backdrop-blur-xs"
        id="assign-company-manager-modal"
      >
        <div class="fixed inset-0" phx-click="close_assign_manager"></div>
        <div class="relative w-full max-w-lg bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl z-10">
          <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800">
            <div>
              <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
                Assign Company Manager
              </h3>
              <p class="text-xs text-neutral-500 mt-0.5">
                Designate the primary authority for organizational operations and domain governance for {@org.display_name ||
                  @org.name}.
              </p>
            </div>
            <button
              type="button"
              phx-click="close_assign_manager"
              class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 p-1"
            >
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>

          <div class="space-y-4">
            <%!-- Quick Search --%>
            <div>
              <label class="block text-xs font-medium uppercase tracking-wider text-neutral-500 mb-1.5">
                Find Candidate
              </label>
              <div class="relative">
                <.icon
                  name="hero-magnifying-glass"
                  class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"
                />
                <input
                  type="text"
                  name="query"
                  value={@people_search_query}
                  placeholder="Search by name, title, or email..."
                  phx-change="search_people"
                  phx-keyup="search_people"
                  class="w-full pl-9 pr-3 py-2 border border-neutral-200 bg-white text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500"
                />
              </div>
            </div>

            <%!-- Quick Pick List --%>
            <div class="max-h-48 overflow-y-auto border border-neutral-100 divide-y divide-neutral-100 dark:border-neutral-800 dark:divide-neutral-800 rounded">
              <%= if @filtered_people == [] do %>
                <div class="py-6 text-center text-xs text-neutral-400">
                  No matching candidates found.
                </div>
              <% else %>
                <%= for person <- @filtered_people do %>
                  <div class={[
                    "flex items-center justify-between p-2.5 transition-colors",
                    if(@org.manager_id == person.id,
                      do: "bg-blue-50/50 dark:bg-blue-950/20",
                      else: "hover:bg-neutral-50 dark:hover:bg-neutral-800/60"
                    )
                  ]}>
                    <div class="flex items-center gap-2.5 min-w-0">
                      <div class="w-7 h-7 rounded-full bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300 text-[10px] font-medium flex items-center justify-center shrink-0">
                        {String.first(person.first_name || "")}{String.first(
                          person.last_name || ""
                        )}
                      </div>
                      <div class="min-w-0">
                        <div class="text-xs font-medium text-neutral-900 dark:text-neutral-100 truncate">
                          {person.first_name} {person.last_name}
                          <%= if @org.manager_id == person.id do %>
                            <span class="text-[9px] text-blue-600 dark:text-blue-400 font-normal ml-1">
                              (Current)
                            </span>
                          <% end %>
                        </div>
                        <div class="text-[11px] text-neutral-400 truncate">
                          {person.title || person.email || "No details"}
                        </div>
                      </div>
                    </div>
                    <button
                      type="button"
                      phx-click="assign_company_manager"
                      phx-value-manager_id={person.id}
                      class={[
                        "text-[10px] px-2.5 py-1 rounded border transition-colors shrink-0",
                        if(@org.manager_id == person.id,
                          do:
                            "border-blue-300 text-blue-700 bg-blue-100 dark:border-blue-700 dark:bg-blue-900 dark:text-blue-200",
                          else:
                            "border-neutral-200 hover:border-neutral-900 text-neutral-700 dark:border-neutral-700 dark:text-neutral-300 dark:hover:border-neutral-400"
                        )
                      ]}
                    >
                      {if @org.manager_id == person.id, do: "Selected", else: "Select"}
                    </button>
                  </div>
                <% end %>
              <% end %>
            </div>

            <%!-- Fallback standard form with select (supports testing & unassigning) --%>
            <form
              phx-submit="assign_company_manager"
              class="space-y-4 pt-2 border-t border-neutral-100 dark:border-neutral-800"
            >
              <div>
                <label class="block text-xs font-medium uppercase tracking-wider text-neutral-500 mb-1.5">
                  Or select from dropdown
                </label>
                <select
                  name="manager_id"
                  id="company-manager-select"
                  class="w-full px-3 py-2 border border-neutral-200 bg-white text-sm text-neutral-900 focus:outline-none focus:border-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100"
                >
                  <option value="">-- None (Unassign Manager) --</option>
                  <%= for person <- @people_options do %>
                    <option
                      value={person.id}
                      selected={@org.manager_id == person.id}
                    >
                      {person.first_name} {person.last_name} ({person.email || "no email"})
                    </option>
                  <% end %>
                </select>
                <p class="text-[11px] text-neutral-400 mt-1.5 flex items-center justify-between">
                  <span>Need someone not in the list?</span>
                  <.link
                    navigate={~p"/admin/people/new"}
                    class="text-neutral-700 dark:text-neutral-300 underline hover:text-black"
                  >
                    + Create new person
                  </.link>
                </p>
              </div>

              <div class="flex items-center justify-end gap-3 pt-3 border-t border-neutral-100 dark:border-neutral-800">
                <button
                  type="button"
                  phx-click="close_assign_manager"
                  class="btn-line text-xs py-2 px-4"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  id="save-company-manager-btn"
                  class="btn-line-filled text-xs py-2 px-4"
                >
                  Save Company Manager
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    <% end %>

    <%= if @inviting_owner? do %>
      <div
        class="fixed inset-0 bg-black/40 z-50 backdrop-blur-xs flex items-center justify-center p-4"
        phx-click="close_invite_owner"
        id="invite-product-owner-modal"
      >
        <div
          class="bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 max-w-lg w-full p-6 shadow-xl"
          phx-click-stop
        >
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-2">
              <span class="w-8 h-8 rounded-full bg-emerald-50 dark:bg-emerald-950/40 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
                <.icon name="hero-envelope" class="w-4 h-4" />
              </span>
              <div>
                <h3 class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                  Invite Product Owner
                </h3>
                <p class="text-xs text-neutral-500">
                  Send an invitation to appoint a Product Owner for a project in this organization.
                </p>
              </div>
            </div>
            <button
              type="button"
              phx-click="close_invite_owner"
              class="text-neutral-400 hover:text-neutral-600"
            >
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>

          <%= if @generated_invite_link do %>
            <div class="mb-4 p-4 border border-emerald-200 bg-emerald-50/50 dark:border-emerald-800 dark:bg-emerald-950/30">
              <p class="text-xs font-medium text-emerald-900 dark:text-emerald-200 mb-2">
                Invitation link created successfully!
              </p>
              <input
                type="text"
                id="generated-owner-invite-url"
                value={@generated_invite_link}
                readonly
                class="w-full text-xs font-mono px-3 py-2 border border-emerald-300 dark:border-emerald-700 bg-white dark:bg-neutral-900 rounded select-all"
              />
            </div>
            <div class="flex justify-end pt-2">
              <button
                type="button"
                phx-click="close_invite_owner"
                class="btn-line text-xs py-2 px-4"
              >
                Done
              </button>
            </div>
          <% else %>
            <.form
              for={@invite_form}
              id="invite-owner-form"
              phx-submit="send_owner_invite"
              class="space-y-4"
            >
              <.input
                field={@invite_form[:email]}
                type="email"
                label="Email Address"
                required
                placeholder="owner@client.com"
              />
              <.input
                field={@invite_form[:name]}
                type="text"
                label="Full Name (Optional)"
                placeholder="Alex Smith"
              />
              <.input
                field={@invite_form[:project_id]}
                type="select"
                label="Assign to Project (Optional)"
                prompt="Select project"
                options={
                  Enum.map(@all_projects, fn proj ->
                    {proj.display_name || proj.name, proj.id}
                  end)
                }
              />
              <div class="flex justify-end gap-3 pt-4 border-t border-neutral-100 dark:border-neutral-700">
                <button
                  type="button"
                  phx-click="close_invite_owner"
                  class="btn-line text-xs py-2 px-4"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  class="btn-line-filled text-xs py-2 px-4 bg-emerald-600 hover:bg-emerald-700 text-white"
                >
                  Send Invitation
                </button>
              </div>
            </.form>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
