<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Invites</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">Invite team members by email</p>
      </div>
      <.link patch={~p"/admin/invites/new"} class="btn-line-filled text-xs">
        <.icon name="hero-envelope" class="w-4 h-4" /> New invite
      </.link>
    </div>

    <%!-- Identity Sub-Navigation Tabs --%>
    <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px dark:border-neutral-800">
      <.link
        navigate={~p"/admin/users"}
        class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200"
      >
        System Users
      </.link>
      <.link
        navigate={~p"/admin/people"}
        class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200"
      >
        People (Governance)
      </.link>
      <.link
        navigate={~p"/admin/invites"}
        class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100 transition-all duration-200"
      >
        Invites
      </.link>
    </div>

    <%= if @invites == [] do %>
      <div class="text-center py-20 border border-neutral-200">
        <.icon name="hero-envelope" class="w-8 h-8 text-neutral-300 mx-auto mb-4" />
        <p class="text-sm font-light text-neutral-400">No invites yet</p>
      </div>
    <% else %>
      <div class="border border-neutral-200 divide-y divide-neutral-100">
        <div class="grid grid-cols-[1fr_auto_auto_auto_auto_auto] gap-4 px-6 py-3 text-xs font-light tracking-wide uppercase text-neutral-400">
          <span>Email</span>
          <span>Role</span>
          <span>Status</span>
          <span>Invited by</span>
          <span>Expires</span>
          <span></span>
        </div>

        <%= for invite <- @invites do %>
          <div
            id={"invite-#{invite.id}"}
            class="grid grid-cols-[1fr_auto_auto_auto_auto_auto] gap-4 items-center px-6 py-4 hover:bg-neutral-50 transition-colors dark:hover:bg-neutral-800"
          >
            <div>
              <div class="text-sm font-normal">{invite.email}</div>
              <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                <%= if invite.name do %>
                  <span class="text-xs font-light text-neutral-500">{invite.name}</span>
                <% end %>
                <%= if invite.target_project_id && @project_names[invite.target_project_id] do %>
                  <span class="inline-flex items-center gap-1 text-[10px] text-primary-700 bg-primary-50 dark:bg-primary-950/40 dark:text-primary-300 px-1.5 py-0.5 border border-primary-200 dark:border-primary-800">
                    Project: {@project_names[invite.target_project_id]}
                  </span>
                <% end %>
                <%= if invite.target_brand_id && @brand_names[invite.target_brand_id] do %>
                  <span class="inline-flex items-center gap-1 text-[10px] text-primary-700 bg-primary-50 dark:bg-primary-950/40 dark:text-primary-300 px-1.5 py-0.5 border border-primary-200 dark:border-primary-800">
                    Brand: {@brand_names[invite.target_brand_id]}
                  </span>
                <% end %>
                <%= if invite.target_organization_id && @org_names[invite.target_organization_id] do %>
                  <span class="inline-flex items-center gap-1 text-[10px] text-primary-700 bg-primary-50 dark:bg-primary-950/40 dark:text-primary-300 px-1.5 py-0.5 border border-primary-200 dark:border-primary-800">
                    Company: {@org_names[invite.target_organization_id]}
                  </span>
                <% end %>
              </div>
            </div>
            <div class="text-xs font-light text-neutral-600 w-28 text-center">
              {Ravner.Accounts.User.role_label(invite.role)}
            </div>
            <div class="w-16 text-center">
              <%= if invite.accepted_at do %>
                <span class="text-xs font-light text-emerald-600">accepted</span>
              <% else %>
                <span class="text-xs font-light text-neutral-400">pending</span>
              <% end %>
            </div>
            <div class="text-xs font-light text-neutral-400 w-36 truncate">
              {invite.invited_by && invite.invited_by.email}
            </div>
            <div class="text-xs font-light text-neutral-400 w-24">
              {Calendar.strftime(invite.expires_at, "%b %d, %Y")}
            </div>
            <div class="flex items-center justify-end">
              <%= if is_nil(invite.accepted_at) do %>
                <button
                  type="button"
                  phx-click="show_invite_link"
                  phx-value-token={invite.token}
                  class="text-neutral-400 hover:text-neutral-700 transition-colors p-1"
                  title="View / Copy Invite Link"
                >
                  <.icon name="hero-link" class="w-4 h-4" />
                </button>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <%= if @live_action == :new do %>
    <div class="fixed inset-0 bg-black/20 z-40" phx-click="cancel"></div>
    <div class="fixed inset-x-0 top-20 bottom-8 mx-auto max-w-lg bg-white border border-neutral-200 z-50 p-8 overflow-y-auto dark:bg-neutral-800 dark:border-neutral-700">
      <h2 class="text-xl font-light tracking-tight mb-6">Send invite</h2>

      <.form
        for={@form}
        id="invite-form"
        phx-change="validate"
        phx-submit="send_invite"
        class="space-y-6"
      >
        <.input
          field={@form[:email]}
          type="email"
          label="Email"
          placeholder="colleague@example.com"
          required
        />
        <.input field={@form[:name]} type="text" label="Name (optional)" placeholder="Full name" />
        <.input
          field={@form[:role]}
          type="select"
          label="Role"
          options={@role_options}
        />

        <%= if to_string(@form[:role].value) in ["project_manager", "product_owner"] do %>
          <.input
            field={@form[:target_project_id]}
            type="select"
            label="Assigned Project"
            options={@project_options}
          />
          <p class="text-[11px] text-neutral-500 -mt-4">
            Upon activation, the user will be automatically assigned as the {if to_string(
                                                                                  @form[:role].value
                                                                                ) ==
                                                                                  "project_manager",
                                                                                do:
                                                                                  "Project Manager",
                                                                                else:
                                                                                  "Product Owner"} for this project.
          </p>
        <% end %>

        <%= if to_string(@form[:role].value) == "brand_manager" do %>
          <.input
            field={@form[:target_brand_id]}
            type="select"
            label="Assigned Brand"
            options={@brand_options}
          />
          <p class="text-[11px] text-neutral-500 -mt-4">
            Upon activation, the user will be assigned as the Brand Manager.
          </p>
        <% end %>

        <%= if to_string(@form[:role].value) == "organization_manager" do %>
          <.input
            field={@form[:target_organization_id]}
            type="select"
            label="Assigned Company / Organization"
            options={@org_options}
          />
          <p class="text-[11px] text-neutral-500 -mt-4">
            Upon activation, the user will be assigned as the Company Manager.
          </p>
        <% end %>

        <%= if to_string(@form[:role].value) in ["project_manager", "pm_supervisor"] do %>
          <.input
            field={@form[:supervisor_id]}
            type="select"
            label="Supervisor (Optional)"
            options={@supervisor_options}
          />
        <% end %>

        <div class="flex items-center gap-3 pt-4">
          <button type="submit" class="btn-line-filled flex-1 justify-center text-xs">
            Send invite
          </button>
          <button type="button" phx-click="cancel" class="btn-line flex-1 justify-center text-xs">
            Cancel
          </button>
        </div>
      </.form>
    </div>
  <% end %>

  <%!-- Modal showing generated / selected invite link --%>
  <%= if @selected_invite_link do %>
    <div class="fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
      <div class="bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 rounded-lg p-6 max-w-lg w-full shadow-xl">
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-2">
            <.icon name="hero-envelope" class="w-5 h-5 text-neutral-700 dark:text-neutral-300" />
            <h3 class="text-base font-medium">Invite Link Generated</h3>
          </div>
          <button
            type="button"
            phx-click="close_invite_link"
            class="text-neutral-400 hover:text-neutral-600 transition-colors"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <p class="text-xs text-neutral-500 dark:text-neutral-400 mb-4">
          Share this invitation link with the user. It is valid for 48 hours and allows them to activate their account and set a password.
        </p>

        <div class="mb-4">
          <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1.5 font-mono">
            Invitation URL
          </label>
          <input
            type="text"
            id="invite-url-input"
            value={@selected_invite_link}
            readonly
            class="w-full text-xs font-mono px-3 py-2 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 rounded select-all"
          />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button
            type="button"
            phx-click="close_invite_link"
            class="btn-line text-xs"
          >
            Done
          </button>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
