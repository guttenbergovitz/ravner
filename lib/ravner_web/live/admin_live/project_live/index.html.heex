<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        <.icon name="hero-arrow-left" class="w-3 h-3 inline" /> Ownership
      </.link>
      <%= if @live_action == :edit && @project do %>
        <%= if @project.organization do %>
          <%= if @project.organization.brand do %>
            <.icon name="hero-chevron-right" class="w-3 h-3" />
            <.link
              navigate={~p"/ownership/brands/#{@project.organization.brand.id}"}
              class="hover:text-neutral-600 transition-colors"
            >
              {@project.organization.brand.display_name || @project.organization.brand.name}
            </.link>
          <% end %>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/ownership/organizations/#{@project.organization.id}"}
            class="hover:text-neutral-600 transition-colors"
          >
            {@project.organization.display_name || @project.organization.name}
          </.link>
        <% end %>
        <.icon name="hero-chevron-right" class="w-3 h-3" />
        <span class="text-neutral-600">{@project.display_name || @project.name}</span>
      <% end %>
    </nav>

    <div class="border border-neutral-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h1 class="text-xl font-light tracking-tight">
          {if @live_action == :edit, do: "Edit Project", else: "New Project"}
        </h1>
        <%= if @live_action == :edit do %>
          <.link
            navigate={~p"/ownership/projects/#{@project.id}"}
            class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors flex items-center gap-1"
          >
            View in Ownership <.icon name="hero-arrow-right" class="w-3 h-3" />
          </.link>
        <% end %>
      </div>

      <%= if @form do %>
        <.form
          for={@form}
          phx-change="validate"
          phx-submit="save"
          id="project-form"
          class="space-y-4 max-w-md"
        >
          <.input field={@form[:name]} type="text" label="Name" />
          <.input
            field={@form[:slug]}
            type="text"
            label="Slug"
            placeholder="e.g. website-relaunch"
          />
          <.input field={@form[:description]} type="textarea" label="Description" />
          <.input
            field={@form[:display_name]}
            type="text"
            label="Display name"
            placeholder="Short name for lists"
          />
          <.input
            field={@form[:organization_id]}
            type="select"
            label="Organization"
            options={Enum.map(@orgs, &{&1.name, &1.id})}
            prompt="Select organization"
          />
          <.input field={@form[:notes]} type="textarea" label="Notes" />

          <div class="flex items-center gap-3 pt-4">
            <button type="submit" class="btn-line-filled text-xs">Save</button>
            <.link
              navigate={
                if @live_action == :edit && @project,
                  do: ~p"/ownership/projects/#{@project.id}",
                  else: ~p"/ownership"
              }
              class="btn-line text-xs"
            >
              Cancel
            </.link>
          </div>
        </.form>
      <% end %>

      <%= if @live_action == :edit && @project.id do %>
        <%!-- Contextual stats --%>
        <%= if @stats do %>
          <div class="mt-8 pt-6 border-t border-neutral-100">
            <div class="grid grid-cols-3 gap-4 text-center mb-6">
              <.link
                navigate={~p"/ownership/projects/#{@project.id}?tab=team"}
                class="border border-neutral-200 p-4 hover:border-neutral-400 transition-colors"
              >
                <div class="text-xl font-light text-neutral-900">{@stats.team_size}</div>
                <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                  Team
                </div>
              </.link>
              <.link
                navigate={~p"/ownership/projects/#{@project.id}?tab=repositories"}
                class="border border-neutral-200 p-4 hover:border-neutral-400 transition-colors"
              >
                <div class="text-xl font-light text-neutral-900">{@stats.repos_count}</div>
                <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                  Repos
                </div>
              </.link>
              <.link
                navigate={~p"/ownership/projects/#{@project.id}?tab=domains"}
                class="border border-neutral-200 p-4 hover:border-neutral-400 transition-colors"
              >
                <div class="text-xl font-light text-neutral-900">{@stats.domains_count}</div>
                <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                  Domains
                </div>
              </.link>
            </div>
          </div>
        <% end %>

        <div class="mt-8 pt-6 border-t border-neutral-200">
          <h3 class="text-base font-light tracking-tight mb-4">Project roles</h3>

          <.form
            for={to_form(%{}, as: :project_role)}
            phx-submit="add_role"
            id="add-role-form"
            class="flex items-end gap-3 mb-6"
          >
            <div class="flex-1">
              <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
                Person
              </label>
              <select
                name="project_role[person_id]"
                class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light focus:outline-none focus:border-neutral-500 transition-colors"
              >
                <option value="">Select person…</option>
                <%= for p <- @people do %>
                  <option value={p.id}>{p.first_name} {p.last_name}</option>
                <% end %>
              </select>
            </div>
            <div class="w-40">
              <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
                Role
              </label>
              <select
                name="project_role[role]"
                class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light focus:outline-none focus:border-neutral-500 transition-colors"
              >
                <option value="">Select role…</option>
                <option value="owner">Owner</option>
                <option value="manager">Manager</option>
                <option value="technician">Technician</option>
                <option value="developer">Developer</option>
                <option value="security">Security</option>
                <option value="devops">DevOps</option>
                <option value="qa">QA</option>
                <option value="design">Design</option>
                <option value="admin">Admin</option>
              </select>
            </div>
            <div class="flex-1">
              <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
                Notes
              </label>
              <input
                type="text"
                name="project_role[notes]"
                placeholder="Optional…"
                class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
              />
            </div>
            <button type="submit" class="btn-line text-xs whitespace-nowrap">Add</button>
          </.form>

          <%= if @roles == [] do %>
            <p class="text-sm font-light text-neutral-500">No roles assigned yet.</p>
          <% else %>
            <div class="space-y-2">
              <%= for r <- @roles do %>
                <div class="flex items-center gap-3 text-sm border border-neutral-100 px-4 py-3">
                  <span class="text-xs px-2 py-0.5 border border-neutral-200">{r.role}</span>
                  <.link
                    navigate={~p"/ownership/people/#{r.person.id}"}
                    class="hover:text-neutral-500 transition-colors"
                  >
                    {r.person.first_name} {r.person.last_name}
                  </.link>
                  <%= if r.notes do %>
                    <span class="text-neutral-400">— {r.notes}</span>
                  <% end %>
                  <button
                    phx-click="delete_role"
                    phx-value-id={r.id}
                    class="ml-auto text-neutral-400 hover:text-red-600 transition-colors"
                  >
                    <.icon name="hero-x-mark" class="w-4 h-4" />
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="mt-8 pt-6 border-t border-neutral-200">
          <h3 class="text-base font-light tracking-tight mb-4">Repositories</h3>

          <.form
            for={to_form(%{}, as: :project_repository)}
            phx-submit="add_repo"
            id="add-repo-form"
            class="flex items-end gap-3 mb-6"
          >
            <div class="flex-[2]">
              <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
                URL
              </label>
              <input
                type="url"
                name="project_repository[url]"
                placeholder="https://github.com/org/repo"
                class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
              />
            </div>
            <div class="w-36">
              <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
                Kind
              </label>
              <select
                name="project_repository[kind]"
                class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light focus:outline-none focus:border-neutral-500 transition-colors"
              >
                <option value="website">Website</option>
                <option value="portal">Portal</option>
                <option value="ecommerce">Ecommerce</option>
                <option value="cms">CMS</option>
                <option value="landing">Landing</option>
                <option value="app">App</option>
                <option value="api">API</option>
                <option value="library">Library</option>
                <option value="tool">Tool</option>
                <option value="documentation">Documentation</option>
                <option value="config">Config</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="flex-1">
              <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
                Language / Tech
              </label>
              <input
                type="text"
                name="project_repository[main_language]"
                placeholder="e.g. Elixir"
                class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
              />
            </div>
            <button type="submit" class="btn-line text-xs whitespace-nowrap">Add</button>
          </.form>

          <%= if @repos == [] do %>
            <p class="text-sm font-light text-neutral-500">No repositories linked yet.</p>
          <% else %>
            <div class="space-y-2">
              <%= for r <- @repos do %>
                <div class="flex items-center gap-3 text-sm border border-neutral-100 px-4 py-3">
                  <span class="text-xs px-2 py-0.5 border border-neutral-200">{r.kind}</span>
                  <a
                    href={r.url}
                    target="_blank"
                    class="font-mono text-xs hover:text-neutral-500 transition-colors"
                  >
                    {r.url}
                  </a>
                  <%= if r.main_language do %>
                    <span class="text-neutral-400 text-xs">{r.main_language}</span>
                  <% end %>
                  <%= if r.notes do %>
                    <span class="text-neutral-400">— {r.notes}</span>
                  <% end %>
                  <button
                    phx-click="delete_repo"
                    phx-value-id={r.id}
                    class="ml-auto text-neutral-400 hover:text-red-600 transition-colors"
                  >
                    <.icon name="hero-x-mark" class="w-4 h-4" />
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>

        <div class="mt-8 pt-6 border-t border-neutral-200 flex justify-end">
          <button
            phx-click="delete"
            data-confirm="Delete this project and all its roles, repositories and domain assignments?"
            class="text-xs font-normal text-red-500 hover:text-red-700 transition-colors"
          >
            Delete Project
          </button>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
