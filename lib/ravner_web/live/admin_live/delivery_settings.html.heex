<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-4xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Delivery Settings</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          Configure email and SMS providers for notifications.
        </p>
      </div>
      <.link
        navigate={~p"/admin/settings"}
        class="text-xs text-neutral-400 hover:text-neutral-600 transition-colors"
      >
        &larr; Settings
      </.link>
    </div>

    <%!-- Tabs --%>
    <div class="flex bg-neutral-100 p-1 rounded-lg dark:bg-neutral-800 mb-8 w-fit">
      <button
        :for={tab <- [:email, :sms]}
        phx-click="set_tab"
        phx-value-tab={tab}
        class={[
          "px-5 py-2 text-xs font-medium rounded-md transition-colors cursor-pointer uppercase tracking-wide",
          @active_tab == tab &&
            "bg-white text-neutral-900 shadow-sm dark:bg-neutral-700 dark:text-neutral-100",
          @active_tab != tab && "text-neutral-500 hover:text-neutral-700 dark:text-neutral-400"
        ]}
      >
        {tab}
      </button>
    </div>

    <%!-- Test result banner --%>
    <%= if @test_result do %>
      <div class={[
        "mb-6 px-4 py-3 rounded-lg text-sm",
        elem(@test_result, 0) == :ok &&
          "bg-green-50 text-green-800 border border-green-200 dark:bg-green-900/10 dark:text-green-300 dark:border-green-800",
        elem(@test_result, 0) == :error &&
          "bg-red-50 text-red-800 border border-red-200 dark:bg-red-900/10 dark:text-red-300 dark:border-red-800"
      ]}>
        {elem(@test_result, 1)}
      </div>
    <% end %>

    <%!-- EMAIL TAB --%>
    <%= if @active_tab == :email do %>
      <form phx-submit="save_email" class="space-y-6">
        <%!-- Provider selector --%>
        <div class="border border-neutral-200 p-6 dark:border-neutral-700">
          <h2 class="text-sm font-medium mb-4">Email Provider</h2>

          <div class="grid grid-cols-5 gap-2 mb-6">
            <% current_email = Map.get(@settings, "email_provider", "smtp") %>
            <label
              :for={{id, provider} <- DeliverySettings.email_providers()}
              class={[
                "border rounded-lg p-3 text-center cursor-pointer transition-colors",
                current_email == id &&
                  "border-neutral-900 bg-neutral-50 dark:border-neutral-300 dark:bg-neutral-800",
                current_email != id &&
                  "border-neutral-200 hover:border-neutral-400 dark:border-neutral-700 dark:hover:border-neutral-500"
              ]}
            >
              <input
                type="radio"
                name="provider"
                value={id}
                checked={current_email == id}
                class="sr-only"
                onchange="this.form.querySelector('[data-provider-fields]').dataset.active = this.value"
              />
              <span class="text-xs font-medium">{provider.label}</span>
            </label>
          </div>

          <%!-- Common fields --%>
          <div class="grid grid-cols-2 gap-4 mb-6">
            <div>
              <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                From Name
              </label>
              <input
                type="text"
                name="from_name"
                value={Map.get(@settings, "email_from_name", "Ravner")}
                class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
              />
            </div>
            <div>
              <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                From Address
              </label>
              <input
                type="email"
                name="from_address"
                value={Map.get(@settings, "email_from_address", "")}
                placeholder="noreply@yourdomain.com"
                class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
              />
            </div>
          </div>

          <%!-- Provider-specific fields --%>
          <div data-provider-fields>
            <% current_email = Map.get(@settings, "email_provider", "smtp") %>

            <%!-- SMTP --%>
            <%= if current_email == "smtp" do %>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                    SMTP Host
                  </label>
                  <input
                    type="text"
                    name="smtp_host"
                    value={Map.get(@settings, "email_smtp_host", "")}
                    placeholder="smtp.example.com"
                    class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                  />
                </div>
                <div>
                  <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                    SMTP Port
                  </label>
                  <input
                    type="number"
                    name="smtp_port"
                    value={Map.get(@settings, "email_smtp_port", "587")}
                    placeholder="587"
                    class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                  />
                </div>
                <div>
                  <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                    Username
                  </label>
                  <input
                    type="text"
                    name="smtp_username"
                    value={Map.get(@settings, "email_smtp_username", "")}
                    class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                  />
                </div>
                <div>
                  <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                    Password
                  </label>
                  <input
                    type="password"
                    name="smtp_password"
                    placeholder="••••••••"
                    class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                  />
                </div>
              </div>
            <% end %>

            <%!-- SendGrid --%>
            <%= if current_email == "sendgrid" do %>
              <div>
                <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                  API Key
                </label>
                <input
                  type="password"
                  name="sendgrid_api_key"
                  placeholder="SG.xxxx..."
                  class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                />
              </div>
            <% end %>

            <%!-- Mailgun --%>
            <%= if current_email == "mailgun" do %>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                    API Key
                  </label>
                  <input
                    type="password"
                    name="mailgun_api_key"
                    placeholder="key-xxxx..."
                    class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                  />
                </div>
                <div>
                  <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                    Domain
                  </label>
                  <input
                    type="text"
                    name="mailgun_domain"
                    value={Map.get(@settings, "email_mailgun_domain", "")}
                    placeholder="mg.yourdomain.com"
                    class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                  />
                </div>
              </div>
            <% end %>

            <%!-- Postmark --%>
            <%= if current_email == "postmark" do %>
              <div>
                <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                  Server Token
                </label>
                <input
                  type="password"
                  name="postmark_api_key"
                  placeholder="xxxx-xxxx-xxxx..."
                  class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                />
              </div>
            <% end %>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <button
            type="submit"
            class="px-5 py-2 text-xs font-medium bg-neutral-900 text-white rounded-lg hover:bg-neutral-800 transition-colors dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200 cursor-pointer"
          >
            Save Email Settings
          </button>
        </div>
      </form>

      <%!-- Test email --%>
      <div class="border border-neutral-200 p-6 mt-6 dark:border-neutral-700">
        <h3 class="text-sm font-medium mb-3">Send Test Email</h3>
        <form phx-submit="test_email" class="flex gap-3">
          <input
            type="email"
            name="to"
            placeholder="recipient@example.com"
            required
            class="flex-1 text-sm border border-neutral-200 rounded px-3 py-2 dark:border-neutral-700 dark:bg-neutral-800"
          />
          <button
            type="submit"
            class="px-4 py-2 text-xs font-medium border border-neutral-200 rounded-lg hover:bg-neutral-50 transition-colors dark:border-neutral-700 dark:hover:bg-neutral-800 cursor-pointer"
          >
            Send Test
          </button>
        </form>
      </div>
    <% end %>

    <%!-- SMS TAB --%>
    <%= if @active_tab == :sms do %>
      <form phx-submit="save_sms" class="space-y-6">
        <div class="border border-neutral-200 p-6 dark:border-neutral-700">
          <h2 class="text-sm font-medium mb-4">SMS Provider</h2>

          <div class="grid grid-cols-3 gap-3 mb-6">
            <% current_sms = Map.get(@settings, "sms_provider", "log") %>
            <label
              :for={{id, provider} <- DeliverySettings.sms_providers()}
              class={[
                "border rounded-lg p-4 text-center cursor-pointer transition-colors",
                current_sms == id &&
                  "border-neutral-900 bg-neutral-50 dark:border-neutral-300 dark:bg-neutral-800",
                current_sms != id &&
                  "border-neutral-200 hover:border-neutral-400 dark:border-neutral-700 dark:hover:border-neutral-500"
              ]}
            >
              <input
                type="radio"
                name="provider"
                value={id}
                checked={current_sms == id}
                class="sr-only"
              />
              <span class="text-xs font-medium">{provider.label}</span>
            </label>
          </div>

          <%!-- Provider-specific fields --%>
          <% current_sms = Map.get(@settings, "sms_provider", "log") %>

          <%!-- Twilio --%>
          <%= if current_sms == "twilio" do %>
            <div class="grid grid-cols-3 gap-4">
              <div>
                <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                  Account SID
                </label>
                <input
                  type="text"
                  name="twilio_account_sid"
                  value={Map.get(@settings, "sms_twilio_account_sid", "")}
                  class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                />
              </div>
              <div>
                <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                  Auth Token
                </label>
                <input
                  type="password"
                  name="twilio_auth_token"
                  placeholder="••••••••"
                  class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                />
              </div>
              <div>
                <label class="text-[10px] uppercase tracking-wide text-neutral-500">
                  From Number
                </label>
                <input
                  type="tel"
                  name="twilio_from_number"
                  value={Map.get(@settings, "sms_twilio_from_number", "")}
                  placeholder="+1234567890"
                  class="block w-full text-sm border border-neutral-200 rounded px-3 py-2 mt-1 dark:border-neutral-700 dark:bg-neutral-800"
                />
              </div>
            </div>
          <% end %>

          <%!-- Log (no fields) --%>
          <%= if current_sms == "log" do %>
            <p class="text-sm text-neutral-500">
              Log adapter prints SMS messages to the console. No configuration needed. Use for development/testing.
            </p>
          <% end %>
        </div>

        <button
          type="submit"
          class="px-5 py-2 text-xs font-medium bg-neutral-900 text-white rounded-lg hover:bg-neutral-800 transition-colors dark:bg-neutral-100 dark:text-neutral-900 dark:hover:bg-neutral-200 cursor-pointer"
        >
          Save SMS Settings
        </button>
      </form>

      <%!-- Test SMS --%>
      <div class="border border-neutral-200 p-6 mt-6 dark:border-neutral-700">
        <h3 class="text-sm font-medium mb-3">Send Test SMS</h3>
        <form phx-submit="test_sms" class="flex gap-3">
          <input
            type="tel"
            name="to"
            placeholder="+48123456789"
            required
            class="flex-1 text-sm border border-neutral-200 rounded px-3 py-2 dark:border-neutral-700 dark:bg-neutral-800"
          />
          <button
            type="submit"
            class="px-4 py-2 text-xs font-medium border border-neutral-200 rounded-lg hover:bg-neutral-50 transition-colors dark:border-neutral-700 dark:hover:bg-neutral-800 cursor-pointer"
          >
            Send Test
          </button>
        </form>
      </div>
    <% end %>
  </div>
</Layouts.app>
