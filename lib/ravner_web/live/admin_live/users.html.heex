<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-semibold text-zinc-900">User Management</h1>
        <p class="text-sm text-zinc-500 mt-1">Manage accounts, roles, and access</p>
      </div>
      <div class="flex gap-3">
        <.link
          navigate={~p"/admin/invites/new"}
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 transition-colors"
        >
          <.icon name="hero-envelope" class="w-4 h-4" /> Send Invite
        </.link>
        <.link
          patch={~p"/admin/users/new"}
          class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-zinc-900 rounded-lg hover:bg-zinc-700 transition-colors"
        >
          <.icon name="hero-plus" class="w-4 h-4" /> New User
        </.link>
      </div>
    </div>

    <%!-- Modal for new/edit --%>
    <%= if @live_action in [:new, :edit] do %>
      <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/40 backdrop-blur-sm">
        <div class="bg-white rounded-2xl shadow-xl w-full max-w-md mx-4 p-6">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-lg font-semibold text-zinc-900">
              {if @live_action == :new, do: "Create User", else: "Edit User"}
            </h2>
            <button phx-click="cancel" class="text-zinc-400 hover:text-zinc-600 transition-colors">
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>

          <.form
            for={@form}
            id="user-form"
            phx-change="validate"
            phx-submit="save"
            class="space-y-4"
          >
            <%= if @live_action == :new do %>
              <.input
                field={@form[:email]}
                type="email"
                label="Email"
                placeholder="user@example.com"
              />
              <.input field={@form[:name]} type="text" label="Name" placeholder="Full name" />
              <.input
                field={@form[:password]}
                type="password"
                label="Password"
                placeholder="Min. 12 characters"
              />
            <% else %>
              <div class="p-3 bg-zinc-50 rounded-lg text-sm text-zinc-600">
                {@user.email}
              </div>
              <.input field={@form[:name]} type="text" label="Name" />
            <% end %>

            <.input
              field={@form[:role]}
              type="select"
              label="Role"
              options={[{"Viewer", "viewer"}, {"Editor", "editor"}, {"Admin", "admin"}]}
            />

            <%= if @live_action == :edit do %>
              <.input field={@form[:active]} type="checkbox" label="Active" />
            <% end %>

            <div class="flex gap-3 pt-2">
              <button
                type="submit"
                class="flex-1 py-2 px-4 text-sm font-medium text-white bg-zinc-900 rounded-lg hover:bg-zinc-700 transition-colors"
              >
                {if @live_action == :new, do: "Create User", else: "Save Changes"}
              </button>
              <button
                type="button"
                phx-click="cancel"
                class="flex-1 py-2 px-4 text-sm font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 transition-colors"
              >
                Cancel
              </button>
            </div>
          </.form>
        </div>
      </div>
    <% end %>

    <%!-- Users table --%>
    <div class="bg-white border border-zinc-200 rounded-2xl overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-100 bg-zinc-50">
            <th class="text-left px-5 py-3 font-medium text-zinc-500">User</th>
            <th class="text-left px-5 py-3 font-medium text-zinc-500">Role</th>
            <th class="text-left px-5 py-3 font-medium text-zinc-500">Status</th>
            <th class="text-left px-5 py-3 font-medium text-zinc-500">Joined</th>
            <th class="px-5 py-3"></th>
          </tr>
        </thead>
        <tbody id="users" phx-update="replace">
          <%= for user <- @users do %>
            <tr
              id={"user-#{user.id}"}
              class="border-b border-zinc-100 last:border-0 hover:bg-zinc-50 transition-colors"
            >
              <td class="px-5 py-4">
                <div class="font-medium text-zinc-900">{user.name || "—"}</div>
                <div class="text-zinc-500 text-xs">{user.email}</div>
              </td>
              <td class="px-5 py-4">
                <span class={[
                  "inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium",
                  user.role == :admin && "bg-purple-100 text-purple-700",
                  user.role == :editor && "bg-blue-100 text-blue-700",
                  user.role == :viewer && "bg-zinc-100 text-zinc-600"
                ]}>
                  {user.role}
                </span>
              </td>
              <td class="px-5 py-4">
                <%= if user.active do %>
                  <span class="inline-flex items-center gap-1 text-xs text-emerald-700">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 inline-block"></span>
                    Active
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1 text-xs text-zinc-400">
                    <span class="w-1.5 h-1.5 rounded-full bg-zinc-300 inline-block"></span>
                    Inactive
                  </span>
                <% end %>
              </td>
              <td class="px-5 py-4 text-zinc-400 text-xs">
                {Calendar.strftime(user.inserted_at, "%b %d, %Y")}
              </td>
              <td class="px-5 py-4">
                <div class="flex items-center justify-end gap-2">
                  <.link
                    patch={~p"/admin/users/#{user.id}/edit"}
                    class="text-zinc-400 hover:text-zinc-700 transition-colors p-1 rounded"
                  >
                    <.icon name="hero-pencil-square" class="w-4 h-4" />
                  </.link>
                  <%= if user.active do %>
                    <button
                      phx-click="deactivate"
                      phx-value-id={user.id}
                      data-confirm="Deactivate this user?"
                      class="text-zinc-400 hover:text-red-500 transition-colors p-1 rounded"
                    >
                      <.icon name="hero-no-symbol" class="w-4 h-4" />
                    </button>
                  <% else %>
                    <button
                      phx-click="activate"
                      phx-value-id={user.id}
                      class="text-zinc-400 hover:text-emerald-600 transition-colors p-1 rounded"
                    >
                      <.icon name="hero-check-circle" class="w-4 h-4" />
                    </button>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</Layouts.app>
