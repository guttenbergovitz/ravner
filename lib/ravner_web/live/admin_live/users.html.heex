<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Users</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">Manage accounts, roles and access</p>
      </div>
      <div class="flex items-center gap-3">
        <.link navigate={~p"/admin/invites/new"} class="btn-line text-xs">
          <.icon name="hero-envelope" class="w-4 h-4" /> Send invite
        </.link>
        <.link patch={~p"/admin/users/new"} class="btn-line-filled text-xs">
          <.icon name="hero-plus" class="w-4 h-4" /> New user
        </.link>
      </div>
    </div>

    <%!-- Identity Sub-Navigation Tabs --%>
    <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px dark:border-neutral-800">
      <.link
        navigate={~p"/admin/users"}
        class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100 transition-all duration-200"
      >
        System Users
      </.link>
      <.link
        navigate={~p"/admin/people"}
        class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200"
      >
        People (Governance)
      </.link>
      <.link
        navigate={~p"/admin/invites"}
        class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200"
      >
        Invites
      </.link>
    </div>

    <%!-- Quick Masquerade Card with Autocomplete --%>
    <div
      id="masquerade"
      class="mb-8 p-5 bg-neutral-50/70 border border-neutral-200 rounded-lg dark:bg-neutral-800/40 dark:border-neutral-700"
    >
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="p-1 rounded bg-amber-100 text-amber-800 dark:bg-amber-900/50 dark:text-amber-300">
              <.icon name="hero-identification" class="w-4 h-4" />
            </span>
            <h2 class="text-sm font-medium tracking-tight text-neutral-900 dark:text-neutral-100">
              Masquerade Persona Switcher
            </h2>
          </div>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">
            Switch persona to test domain scoping, governance permissions, and view pages exactly as any user sees them.
          </p>
        </div>
        <span class="text-[11px] text-neutral-400 font-mono">
          Persistent "Switch back to Admin" bar will remain visible
        </span>
      </div>

      <.form for={%{}} action={~p"/admin/masquerade"} method="post" class="space-y-3">
        <div class="relative flex items-center gap-2">
          <div class="relative flex-1">
            <input
              type="text"
              name="user_email"
              id="masquerade-search-input"
              list="masquerade-users-datalist"
              value={@masquerade_query}
              phx-keyup="search_masquerade"
              phx-debounce="120"
              placeholder="Search by name, email, or role to masquerade as user..."
              autocomplete="off"
              class="w-full pl-9 pr-9 py-2 text-sm border border-neutral-200 dark:border-neutral-700 rounded bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-amber-500 transition-colors"
            />
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-neutral-400">
              <.icon name="hero-magnifying-glass" class="w-4 h-4" />
            </div>
            <%= if @masquerade_query != "" do %>
              <button
                type="button"
                phx-click="clear_masquerade_search"
                class="absolute inset-y-0 right-0 pr-3 flex items-center text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200"
                title="Clear search"
              >
                <.icon name="hero-x-mark" class="w-4 h-4" />
              </button>
            <% end %>
          </div>
          <button
            type="submit"
            class="px-4 py-2 bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 rounded text-xs font-semibold hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shrink-0"
          >
            Masquerade
          </button>
        </div>

        <datalist id="masquerade-users-datalist">
          <%= for user <- @users do %>
            <option value={user.email}>
              {user.name || "—"} ({user.role})
            </option>
          <% end %>
        </datalist>

        <%!-- Rich autocomplete results dropdown / cards --%>
        <%= if @masquerade_matches != [] do %>
          <div
            id="masquerade-matches"
            class="mt-2 p-2 bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 rounded shadow-lg max-h-64 overflow-y-auto divide-y divide-neutral-100 dark:divide-neutral-800"
          >
            <%= for match <- @masquerade_matches do %>
              <div
                id={"masquerade-match-#{match.id}"}
                class="py-2 px-2 flex items-center justify-between hover:bg-neutral-50 dark:hover:bg-neutral-800/60 rounded transition-colors"
              >
                <div class="flex items-center gap-3">
                  <div class="w-7 h-7 rounded-full bg-neutral-200 dark:bg-neutral-700 flex items-center justify-center text-xs font-bold text-neutral-700 dark:text-neutral-300">
                    {String.first(match.name || match.email || "?")}
                  </div>
                  <div>
                    <div class="text-xs font-medium text-neutral-900 dark:text-neutral-100 flex items-center gap-2">
                      <span>{match.name || "—"}</span>
                      <span class="text-[10px] font-mono px-1.5 py-0.2 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-400">
                        {match.role}
                      </span>
                      <%= if !match.active do %>
                        <span class="text-[10px] text-red-500 font-normal">(inactive)</span>
                      <% end %>
                    </div>
                    <div class="text-[11px] text-neutral-500 font-light">
                      {match.email}
                    </div>
                  </div>
                </div>

                <div>
                  <%= if match.active do %>
                    <.link
                      href={~p"/admin/masquerade/#{match.id}"}
                      method="post"
                      id={"masquerade-match-btn-#{match.id}"}
                      class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-amber-500 hover:bg-amber-600 text-neutral-950 text-xs font-semibold transition-colors shadow-xs"
                    >
                      <.icon name="hero-eye" class="w-3.5 h-3.5" />
                      <span>Masquerade</span>
                    </.link>
                  <% else %>
                    <span class="text-xs text-neutral-400 italic">Inactive</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </.form>
    </div>

    <div class="border border-neutral-200 divide-y divide-neutral-100 dark:border-neutral-700 dark:divide-neutral-700">
      <div class="grid grid-cols-[1fr_auto_auto_auto_auto] gap-4 px-6 py-3 text-xs font-light tracking-wide uppercase text-neutral-400">
        <span>User</span>
        <span>Role</span>
        <span>Status</span>
        <span>Joined</span>
        <span></span>
      </div>

      <%= for user <- @users do %>
        <div
          id={"user-#{user.id}"}
          class="grid grid-cols-[1fr_auto_auto_auto_auto] gap-4 items-center px-6 py-4 hover:bg-neutral-50 transition-colors dark:hover:bg-neutral-800"
        >
          <div>
            <div class="text-sm font-normal">{user.name || "—"}</div>
            <div class="text-xs font-light text-neutral-500">{user.email}</div>
            <%= if user.person do %>
              <div class="mt-1">
                <.link
                  navigate={~p"/admin/people/#{user.person.id}/edit"}
                  class="inline-flex items-center gap-1 text-[11px] font-normal text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 px-1.5 py-0.5 border border-emerald-200 dark:border-emerald-800 rounded hover:bg-emerald-100 dark:hover:bg-emerald-900/60 transition-colors"
                  title="View linked Person profile in Governance"
                >
                  <.icon name="hero-user" class="w-3 h-3 text-emerald-600" />
                  <span>{user.person.first_name} {user.person.last_name}</span>
                  <%= if match?(%Ravner.Inventory.Organization{}, user.person.organization) do %>
                    <span class="text-emerald-600/70 font-light">
                      ({user.person.organization.name})
                    </span>
                  <% end %>
                </.link>
              </div>
            <% else %>
              <div class="mt-1">
                <.link
                  navigate={~p"/admin/people/new?user_id=#{user.id}"}
                  id={"create-person-user-#{user.id}"}
                  class="inline-flex items-center gap-1 text-[10px] text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors"
                  title="Create Governance Person profile for this user"
                >
                  <.icon name="hero-user-plus" class="w-3 h-3 text-neutral-400" />
                  <span>+ Create Person profile</span>
                </.link>
              </div>
            <% end %>
          </div>
          <div class="text-xs font-light text-neutral-600 w-16 text-center">
            {user.role}
          </div>
          <div class="w-16 text-center">
            <%= if user.active do %>
              <span class="text-xs font-light text-neutral-500">active</span>
            <% else %>
              <span class="text-xs font-light text-neutral-300">inactive</span>
            <% end %>
          </div>
          <div class="text-xs font-light text-neutral-400 w-24">
            {Calendar.strftime(user.inserted_at, "%b %d, %Y")}
          </div>
          <div class="flex items-center gap-3">
            <%= if user.active and user.id != @current_scope.user.id do %>
              <.link
                href={~p"/admin/masquerade/#{user.id}"}
                method="post"
                title={"Masquerade as #{user.name || user.email}"}
                id={"masquerade-user-#{user.id}"}
                class="text-neutral-400 hover:text-amber-600 transition-colors"
              >
                <.icon name="hero-identification" class="w-4 h-4" />
              </.link>
            <% end %>
            <.link
              patch={~p"/admin/users/#{user.id}/edit"}
              class="text-neutral-400 hover:text-neutral-700 transition-colors"
            >
              <.icon name="hero-pencil-square" class="w-4 h-4" />
            </.link>
            <button
              type="button"
              phx-click="generate_one_time_login"
              phx-value-id={user.id}
              title="Generate One-Time Login Link (48h)"
              class="text-neutral-400 hover:text-amber-600 transition-colors"
            >
              <.icon name="hero-key" class="w-4 h-4" />
            </button>
            <%= if user.active do %>
              <button
                phx-click="deactivate"
                phx-value-id={user.id}
                data-confirm="Deactivate this user?"
                class="text-neutral-400 hover:text-red-600 transition-colors"
              >
                <.icon name="hero-no-symbol" class="w-4 h-4" />
              </button>
            <% else %>
              <button
                phx-click="activate"
                phx-value-id={user.id}
                class="text-neutral-400 hover:text-neutral-700 transition-colors"
              >
                <.icon name="hero-check-circle" class="w-4 h-4" />
              </button>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <%= if @live_action in [:new, :edit] do %>
    <div class="fixed inset-0 bg-black/20 z-40" phx-click="cancel"></div>
    <div class="fixed inset-x-0 top-20 bottom-8 mx-auto max-w-lg bg-white border border-neutral-200 z-50 p-8 overflow-y-auto dark:bg-neutral-800 dark:border-neutral-700">
      <h2 class="text-xl font-light tracking-tight mb-6">
        {if @live_action == :new, do: "New user", else: "Edit user"}
      </h2>

      <.form for={@form} id="user-form" phx-change="validate" phx-submit="save" class="space-y-6">
        <%= if @live_action == :new do %>
          <.input field={@form[:email]} type="email" label="Email" placeholder="user@example.com" />
          <.input field={@form[:name]} type="text" label="Name" placeholder="Full name" />
          <.input
            field={@form[:password]}
            type="password"
            label="Password"
            placeholder="Min. 12 characters"
          />
          <.input
            field={@form[:password_confirmation]}
            type="password"
            label="Confirm password"
            placeholder="Repeat password"
          />
        <% else %>
          <div class="text-sm font-light text-neutral-500 border-b border-neutral-200 pb-4">
            {@user.email}
          </div>
          <.input field={@form[:name]} type="text" label="Name" />
        <% end %>

        <.input
          field={@form[:role]}
          type="select"
          label="Role"
          options={[
            {"Viewer", "viewer"},
            {"Editor", "editor"},
            {"Admin", "admin"},
            {"Brand Manager", "brand_manager"},
            {"Company Manager", "organization_manager"},
            {"Product Owner", "product_owner"},
            {"Delivery Head", "delivery_head"},
            {"PM Supervisor", "pm_supervisor"},
            {"Project Manager", "project_manager"}
          ]}
        />

        <.input
          field={@form[:supervisor_id]}
          type="select"
          label="Supervisor (Optional)"
          prompt="No Supervisor"
          options={Enum.map(@supervisors, fn s -> {s.name || s.email, s.id} end)}
        />

        <%= if @live_action == :edit do %>
          <.input field={@form[:active]} type="checkbox" label="Active" />
        <% end %>

        <div class="flex items-center gap-3 pt-4">
          <button type="submit" class="btn-line-filled flex-1 justify-center text-xs">
            {if @live_action == :new, do: "Create user", else: "Save changes"}
          </button>
          <button type="button" phx-click="cancel" class="btn-line flex-1 justify-center text-xs">
            Cancel
          </button>
        </div>
      </.form>

      <%= if @live_action == :edit do %>
        <div class="border-t border-neutral-200 pt-6 mt-6 space-y-4">
          <h3 class="text-sm font-light tracking-wide uppercase text-neutral-500">
            Password & Access Management
          </h3>

          <button
            type="button"
            phx-click="generate_one_time_login"
            phx-value-id={@user.id}
            id="generate-one-time-login-btn"
            class="w-full px-4 py-2 border border-neutral-200 text-xs font-light tracking-wide uppercase transition-all hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-700 text-amber-700 dark:text-amber-400"
          >
            Generate One-Time Login Link (48h)
          </button>

          <button
            type="button"
            phx-click="reset_password_token"
            phx-value-id={@user.id}
            data-confirm={"Send password reset link to #{@user.email}?"}
            class="w-full px-4 py-2 border border-neutral-200 text-xs font-light tracking-wide uppercase transition-all hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-700"
          >
            Send reset link via email
          </button>

          <button
            type="button"
            phx-click="reset_password_random"
            phx-value-id={@user.id}
            data-confirm={"Generate and send a random password to #{@user.email}?"}
            class="w-full px-4 py-2 border border-neutral-200 text-xs font-light tracking-wide uppercase transition-all hover:bg-neutral-50 dark:border-neutral-700 dark:hover:bg-neutral-700"
          >
            Generate random password
          </button>

          <div class="border-t border-neutral-100 pt-4">
            <p class="text-xs font-light text-neutral-500 mb-3">Set password manually</p>

            <.form
              for={@manual_password_form}
              id="manual-password-form"
              phx-submit="reset_password_manual"
              class="space-y-3"
            >
              <.input
                field={@manual_password_form[:password]}
                type="password"
                label="New password"
                placeholder="Min. 12 characters"
              />
              <.input
                field={@manual_password_form[:password_confirmation]}
                type="password"
                label="Confirm password"
              />
              <button type="submit" class="btn-line-filled w-full justify-center text-xs">
                Set password
              </button>
            </.form>
          </div>
        </div>

        <div class="border-t border-red-100 pt-6 mt-6">
          <button
            type="button"
            phx-click="delete_user"
            phx-value-id={@user.id}
            data-confirm={"Are you sure you want to delete #{@user.email}? This cannot be undone."}
            class="w-full px-4 py-2 border border-red-200 text-red-600 text-xs font-light tracking-wide uppercase transition-all hover:bg-red-50 cursor-pointer"
          >
            Delete user
          </button>
        </div>
      <% end %>
    </div>
  <% end %>

  <%= if @one_time_login_link do %>
    <div
      class="fixed inset-0 bg-black/40 z-50 backdrop-blur-xs flex items-center justify-center p-4"
      phx-click="close_one_time_login"
      id="one-time-login-modal"
    >
      <div
        class="bg-white dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 max-w-lg w-full p-6 shadow-xl"
        phx-click-stop
      >
        <div class="flex items-start justify-between mb-4">
          <div class="flex items-center gap-2">
            <span class="w-8 h-8 rounded-full bg-amber-50 dark:bg-amber-950/40 text-amber-600 dark:text-amber-400 flex items-center justify-center">
              <.icon name="hero-key" class="w-4 h-4" />
            </span>
            <div>
              <h3 class="text-base font-medium text-neutral-900 dark:text-neutral-100">
                One-Time Login Link Generated
              </h3>
              <p class="text-xs text-neutral-500">
                Valid for 48 hours. Allows single login to update password.
              </p>
            </div>
          </div>
          <button
            type="button"
            phx-click="close_one_time_login"
            class="text-neutral-400 hover:text-neutral-600"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <div class="mb-4">
          <label class="block text-xs uppercase tracking-wider text-neutral-500 mb-1.5 font-mono">
            Login URL for {@one_time_login_user.email}
          </label>
          <input
            type="text"
            id="one-time-login-url-input"
            value={@one_time_login_link}
            readonly
            class="w-full text-xs font-mono px-3 py-2 border border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-900 rounded select-all"
          />
        </div>

        <div class="flex justify-end gap-3 pt-2">
          <button
            type="button"
            phx-click="close_one_time_login"
            class="btn-line text-xs"
          >
            Done
          </button>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
