<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-5xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Background Jobs</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          Oban queue inspection and automation schedules.
        </p>
      </div>
      <div class="flex bg-neutral-100 p-1 rounded-lg dark:bg-neutral-800">
        <button
          phx-click="set_tab"
          phx-value-tab="queue"
          class={[
            "px-4 py-1.5 text-xs font-medium rounded-md transition-colors",
            @active_tab == :queue &&
              "bg-white text-neutral-900 shadow-sm dark:bg-neutral-700 dark:text-neutral-100",
            @active_tab != :queue &&
              "text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
          ]}
        >
          Queue History
        </button>
        <button
          phx-click="set_tab"
          phx-value-tab="schedules"
          class={[
            "px-4 py-1.5 text-xs font-medium rounded-md transition-colors",
            @active_tab == :schedules &&
              "bg-white text-neutral-900 shadow-sm dark:bg-neutral-700 dark:text-neutral-100",
            @active_tab != :schedules &&
              "text-neutral-500 hover:text-neutral-700 dark:text-neutral-400 dark:hover:text-neutral-200"
          ]}
        >
          Active Schedules
        </button>
      </div>
    </div>

    <%= if @active_tab == :queue do %>
      <div class="grid grid-cols-4 gap-4 mb-6">
        <div class="card-line p-4">
          <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Executing</p>
          <p class="text-2xl font-light text-blue-600">{@stats["executing"] || 0}</p>
        </div>
        <div class="card-line p-4">
          <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Available</p>
          <p class="text-2xl font-light text-green-600">{@stats["available"] || 0}</p>
        </div>
        <div class="card-line p-4">
          <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">Scheduled / Pending</p>
          <p class="text-2xl font-light text-yellow-600">{@stats["scheduled"] || 0}</p>
        </div>
        <div class="card-line p-4">
          <p class="text-xs uppercase tracking-wide text-neutral-500 mb-1">
            Retryable / Discarded
          </p>
          <p class="text-2xl font-light text-red-600">
            {@stats["retryable"] || 0} / {@stats["discarded"] || 0}
          </p>
        </div>
      </div>

      <%!-- Executing breakdown by worker --%>
      <%= if map_size(@executing_by_worker) > 0 do %>
        <div class="card-line p-4 mb-6">
          <p class="text-xs uppercase tracking-wide text-neutral-500 mb-3">Currently Executing</p>
          <div class="flex flex-wrap gap-2">
            <%= for {worker, count} <- Enum.sort_by(@executing_by_worker, fn {_, c} -> -c end) do %>
              <% short_name = worker |> String.split(".") |> List.last() %>
              <span class="inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium bg-blue-50 text-blue-700 rounded">
                <span class="w-2 h-2 bg-blue-500 rounded-full animate-pulse"></span>
                {short_name}: {count}
              </span>
            <% end %>
          </div>
          <%= if (@stats["executing"] || 0) > 0 do %>
            <button
              phx-click="cancel_all_executing"
              data-confirm={"Cancel all #{@stats["executing"]} executing jobs?"}
              class="mt-3 text-xs text-red-500 hover:text-red-700 transition-colors"
            >
              Cancel All Executing
            </button>
          <% end %>
        </div>
      <% end %>

      <div class="card-line">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-sm font-normal tracking-wide uppercase">Recent Jobs</h2>
          <div class="flex items-center gap-4">
            <select
              phx-change="set_worker_filter"
              name="filter"
              class="text-xs border-neutral-200 rounded px-2 py-1 focus:ring-0 focus:border-neutral-400"
            >
              <option value="all" selected={@worker_filter == "all"}>All Workers</option>
              <option value="domain_scan" selected={@worker_filter == "domain_scan"}>
                Domain Scan
              </option>
              <option value="a11y" selected={@worker_filter == "a11y"}>A11y</option>
              <option value="lighthouse" selected={@worker_filter == "lighthouse"}>
                Lighthouse
              </option>
              <option value="uptime" selected={@worker_filter == "uptime"}>Uptime</option>
              <option value="ssl" selected={@worker_filter == "ssl"}>SSL</option>
              <option value="dispatcher" selected={@worker_filter == "dispatcher"}>
                Dispatchers
              </option>
            </select>
            <label class="flex items-center gap-2 text-xs font-light text-neutral-500 cursor-pointer">
              <input
                type="checkbox"
                checked={@show_dispatchers}
                phx-click="toggle_dispatchers"
                class="w-3.5 h-3.5 border-neutral-300 rounded text-neutral-900 focus:ring-0"
              /> Show Dispatchers
            </label>
          </div>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="text-xs text-neutral-500 font-light border-b border-neutral-100 dark:border-neutral-700">
              <tr>
                <th class="px-4 py-3 font-normal">ID</th>
                <th class="px-4 py-3 font-normal">Queue</th>
                <th class="px-4 py-3 font-normal">Worker</th>
                <th class="px-4 py-3 font-normal">Args</th>
                <th class="px-4 py-3 font-normal">State</th>
                <th class="px-4 py-3 font-normal text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-50 text-neutral-600 font-light dark:divide-neutral-800 dark:text-neutral-300">
              <%= for job <- @jobs do %>
                <% domain_id = job.args["domain_id"] %>
                <% domain_name = @domain_names[domain_id] %>
                <% short_worker = job.worker |> String.split(".") |> List.last() %>
                <tr class={[
                  "hover:bg-neutral-50/50 transition-colors dark:hover:bg-neutral-800/50",
                  job.state == "executing" && "bg-blue-50/30"
                ]}>
                  <td class="px-4 py-3 font-mono text-xs">{job.id}</td>
                  <td class="px-4 py-3">{job.queue}</td>
                  <td class="px-4 py-3 font-mono text-[10px]">{short_worker}</td>
                  <td class="px-4 py-3 text-xs">
                    <%= if domain_name do %>
                      <.link
                        navigate={~p"/domains/#{domain_id}"}
                        class="text-blue-600 hover:underline"
                      >
                        {domain_name}
                      </.link>
                    <% else %>
                      <span class="font-mono text-[10px] text-neutral-400">
                        {inspect(job.args)}
                      </span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <span class={[
                      "inline-flex px-1.5 py-0.5 text-[10px] uppercase tracking-wide rounded-sm font-medium",
                      job.state == "completed" && "bg-green-50 text-green-700",
                      job.state == "executing" && "bg-blue-50 text-blue-700",
                      job.state in ["retryable", "discarded", "cancelled"] &&
                        "bg-red-50 text-red-700",
                      job.state in ["available", "scheduled"] && "bg-yellow-50 text-yellow-700"
                    ]}>
                      {job.state}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right flex items-center justify-end gap-2">
                    <%= if job.state in ["executing", "available", "scheduled"] do %>
                      <button
                        phx-click="cancel_job"
                        phx-value-id={job.id}
                        data-confirm="Cancel this job?"
                        class="text-neutral-400 hover:text-orange-600 transition-colors"
                        title="Cancel"
                      >
                        <.icon name="hero-stop" class="w-4 h-4" />
                      </button>
                    <% end %>
                    <button
                      phx-click="delete_job"
                      phx-value-id={job.id}
                      data-confirm="Delete this job?"
                      class="text-neutral-400 hover:text-red-600 transition-colors"
                      title="Delete"
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </td>
                </tr>
              <% end %>
              <%= if @jobs == [] do %>
                <tr>
                  <td colspan="6" class="px-4 py-8 text-center text-neutral-400">
                    No jobs found.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>

    <%= if @active_tab == :schedules do %>
      <div class="card-line">
        <h2 class="text-sm font-normal tracking-wide uppercase mb-4">
          Domains with Active Schedules
        </h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="text-xs text-neutral-500 font-light border-b border-neutral-100 dark:border-neutral-700">
              <tr>
                <th class="px-4 py-3 font-normal">Domain</th>
                <th class="px-4 py-3 font-normal">Heartbeat</th>
                <th class="px-4 py-3 font-normal">HTTP</th>
                <th class="px-4 py-3 font-normal">DNS</th>
                <th class="px-4 py-3 font-normal">Security Scan</th>
                <th class="px-4 py-3 font-normal text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-neutral-50 text-neutral-600 font-light dark:divide-neutral-800 dark:text-neutral-300">
              <%= for meta <- @schedules do %>
                <tr class="hover:bg-neutral-50/50 transition-colors dark:hover:bg-neutral-800/50">
                  <td class="px-4 py-3">
                    <.link
                      navigate={~p"/domains/#{meta.domain.id}"}
                      class="font-medium text-neutral-900 hover:underline dark:text-neutral-100"
                    >
                      {meta.domain.name}
                    </.link>
                  </td>
                  <td class="px-4 py-3">
                    <%= if meta.heartbeat_interval_minutes do %>
                      <span class="inline-flex px-1.5 py-0.5 text-[10px] uppercase tracking-wide rounded-sm font-medium bg-blue-50 text-blue-700">
                        {meta.heartbeat_interval_minutes} min
                      </span>
                    <% else %>
                      <span class="text-neutral-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <%= if meta.http_scan_interval_days do %>
                      <span class="inline-flex px-1.5 py-0.5 text-[10px] uppercase tracking-wide rounded-sm font-medium bg-emerald-50 text-emerald-700">
                        {meta.http_scan_interval_days} d
                      </span>
                    <% else %>
                      <span class="text-neutral-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <%= if meta.dns_scan_interval_days do %>
                      <span class="inline-flex px-1.5 py-0.5 text-[10px] uppercase tracking-wide rounded-sm font-medium bg-indigo-50 text-indigo-700">
                        {meta.dns_scan_interval_days} d
                      </span>
                    <% else %>
                      <span class="text-neutral-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <%= if meta.scan_interval_days do %>
                      <span class="inline-flex px-1.5 py-0.5 text-[10px] uppercase tracking-wide rounded-sm font-medium bg-purple-50 text-purple-700">
                        {meta.scan_interval_days} d
                      </span>
                    <% else %>
                      <span class="text-neutral-400">—</span>
                    <% end %>
                  </td>
                  <td class="px-4 py-3 text-right">
                    <button
                      phx-click="disable_schedule"
                      phx-value-domain_id={meta.domain.id}
                      data-confirm={"Disable all automation schedules for #{meta.domain.name}?"}
                      class="text-xs text-red-500 hover:text-red-700 transition-colors"
                    >
                      Disable
                    </button>
                  </td>
                </tr>
              <% end %>
              <%= if @schedules == [] do %>
                <tr>
                  <td colspan="4" class="px-4 py-8 text-center text-neutral-400">
                    No active domain schedules found. Use the domain details page to configure them.
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    <% end %>
  </div>
</Layouts.app>
