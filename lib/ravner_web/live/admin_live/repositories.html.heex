<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-[1400px] mx-auto px-6 py-10">
    <%!-- Header --%>
    <div class="flex items-end justify-between mb-8 border-b border-neutral-100 pb-6 dark:border-neutral-800">
      <div>
        <div class="flex items-center gap-3">
          <h1 class="text-3xl font-light tracking-tight text-neutral-900 dark:text-neutral-100">
            Repositories
          </h1>
          <button
            type="button"
            phx-click="open_link_repo"
            id="btn-link-repository-header"
            class="text-[10px] uppercase tracking-widest text-neutral-900 border border-neutral-900 bg-neutral-50 px-2.5 py-1 hover:bg-neutral-900 hover:text-white transition-colors dark:border-neutral-100 dark:bg-neutral-800 dark:text-neutral-100 dark:hover:bg-neutral-100 dark:hover:text-neutral-900"
          >
            + Link Repository
          </button>
        </div>
        <p class="text-xs font-light text-neutral-500 mt-2 uppercase tracking-widest">
          Central inventory of connected code repositories, commit pulse, and dependency security
        </p>
      </div>

      <%!-- Stats counter badges --%>
      <div class="flex gap-6 sm:gap-8">
        <div class="text-right">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Total Repos
          </div>
          <div
            class="text-2xl font-light text-neutral-900 dark:text-neutral-100"
            id="stat-total-repos"
          >
            {@stats.total}
          </div>
        </div>

        <div class="text-right border-l border-neutral-100 dark:border-neutral-800 pl-6 sm:pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Vulnerable
          </div>
          <div
            class={[
              "text-2xl font-light",
              if(@stats.vulnerable > 0,
                do: "text-red-600 dark:text-red-400",
                else: "text-neutral-900 dark:text-neutral-100"
              )
            ]}
            id="stat-vulnerable-repos"
          >
            {@stats.vulnerable}
          </div>
        </div>

        <div class="text-right border-l border-neutral-100 dark:border-neutral-800 pl-6 sm:pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Known CVEs
          </div>
          <div
            class="text-2xl font-light text-neutral-900 dark:text-neutral-100"
            id="stat-cve-count"
          >
            {@stats.cve_count}
          </div>
          <%= if @stats.critical_count > 0 or @stats.high_count > 0 do %>
            <div class="text-[9px] font-mono text-red-600 dark:text-red-400">
              {@stats.critical_count} crit / {@stats.high_count} high
            </div>
          <% end %>
        </div>

        <div class="text-right border-l border-neutral-100 dark:border-neutral-800 pl-6 sm:pl-8">
          <div class="text-[10px] font-normal uppercase tracking-widest text-neutral-400 mb-1">
            Secrets Leaks
          </div>
          <div
            class={[
              "text-2xl font-light",
              if((@stats[:secrets_count] || 0) > 0,
                do: "text-red-600 dark:text-red-400 font-normal",
                else: "text-neutral-900 dark:text-neutral-100"
              )
            ]}
            id="stat-secrets-count"
          >
            {@stats[:secrets_count] || 0}
          </div>
          <%= if (@stats[:leaking_repos_count] || 0) > 0 do %>
            <div class="text-[9px] font-mono text-red-600 dark:text-red-400">
              {@stats[:leaking_repos_count]} repos exposed
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- Sub-navigation: Identity & System Context --%>
    <div class="flex items-center justify-between border-b border-neutral-100 mb-8 pb-px dark:border-neutral-800">
      <div class="flex items-center gap-6">
        <.link
          navigate={~p"/admin/repositories"}
          class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100 transition-all duration-200"
        >
          All Repositories
        </.link>
        <.link
          navigate={~p"/admin/settings"}
          class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200 flex items-center gap-1.5"
        >
          <.icon name="hero-cog-6-tooth" class="w-3.5 h-3.5" />
          VCS Integrations ({length(@active_vcs_list)} Active)
        </.link>
      </div>

      <%!-- VCS Integration Status Widget --%>
      <div id="vcs-status-widget" class="pb-6">
        <div class="p-4 bg-neutral-50/70 border border-neutral-200 dark:bg-neutral-800/40 dark:border-neutral-700">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2">
              <span class="text-xs font-medium uppercase tracking-wider text-neutral-500">
                VCS Integrations & Token Health
              </span>
              <span class="text-[11px] text-neutral-400">
                (Provides authentication for SCA manifests & OSV vulnerability scans)
              </span>
            </div>
            <.link
              navigate={~p"/admin/settings"}
              class="text-xs text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100 underline decoration-neutral-300"
            >
              Settings &rarr;
            </.link>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            <%= for p <- @providers_status do %>
              <div
                id={"vcs-provider-card-#{p.provider}"}
                class={[
                  "flex items-center justify-between p-3 border text-xs transition-colors",
                  if(p.active,
                    do:
                      "bg-white dark:bg-neutral-800/90 border-emerald-200 dark:border-emerald-800/60 shadow-xs",
                    else:
                      "bg-neutral-50 dark:bg-neutral-800/30 border-neutral-200 dark:border-neutral-700/60"
                  )
                ]}
              >
                <div class="flex items-center gap-2.5">
                  <span class={[
                    "w-2 h-2 rounded-full shrink-0",
                    if(p.active, do: "bg-emerald-500", else: "bg-neutral-300 dark:bg-neutral-600")
                  ]}>
                  </span>
                  <div>
                    <span class="font-medium text-neutral-800 dark:text-neutral-100">
                      {p.name}
                    </span>
                    <%= if p.active do %>
                      <p class="text-[10px] text-emerald-700 dark:text-emerald-400 font-mono mt-0.5 truncate max-w-[140px]">
                        {p.active.workspace || "Configured"}
                      </p>
                    <% else %>
                      <p class="text-[10px] text-neutral-400 font-light mt-0.5">Not configured</p>
                    <% end %>
                  </div>
                </div>

                <%= if p.active do %>
                  <span class="text-[10px] font-medium text-emerald-700 dark:text-emerald-300 uppercase px-2 py-0.5 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 dark:border-emerald-800 rounded">
                    Active
                  </span>
                <% else %>
                  <button
                    type="button"
                    id={"btn-connect-#{p.provider}"}
                    phx-click="open_connect_provider"
                    phx-value-provider={p.provider}
                    class="text-[11px] font-medium text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100 px-2 py-0.5 border border-neutral-300 dark:border-neutral-600 rounded hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-colors"
                  >
                    + Connect
                  </button>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%!-- Search & Filter Toolbar --%>
    <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-neutral-50/50 p-4 border border-neutral-200 dark:bg-neutral-800/40 dark:border-neutral-700">
      <%!-- Search Input --%>
      <form
        id="repository-search-form"
        phx-change="search"
        phx-submit="search"
        class="flex-1 max-w-md"
      >
        <input
          type="text"
          name="query"
          id="repository-search-input"
          value={@search_query}
          placeholder="Search by repo name, URL, technology, project, or domain..."
          phx-debounce="200"
          class="w-full px-3 py-2 border border-neutral-200 bg-white text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500"
        />
      </form>

      <%!-- Filter Pills --%>
      <div class="flex flex-wrap items-center gap-3 text-xs">
        <%!-- Provider Filter --%>
        <div class="flex items-center gap-1">
          <span class="text-[11px] text-neutral-400 uppercase tracking-wider font-mono">
            Provider:
          </span>
          <select
            name="provider"
            id="filter-provider-select"
            phx-change="filter_provider"
            class="text-xs py-1.5 px-2 border border-neutral-200 bg-white text-neutral-800 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 focus:outline-none"
          >
            <option value="all" selected={@filter_provider == "all"}>All Providers</option>
            <option value="bitbucket" selected={@filter_provider == "bitbucket"}>
              Bitbucket
            </option>
            <option value="github" selected={@filter_provider == "github"}>GitHub</option>
            <option value="gitlab" selected={@filter_provider == "gitlab"}>GitLab</option>
            <option value="other" selected={@filter_provider == "other"}>Other / Custom</option>
          </select>
        </div>

        <%!-- Status Filter --%>
        <div class="flex items-center gap-1">
          <span class="text-[11px] text-neutral-400 uppercase tracking-wider font-mono">
            Status:
          </span>
          <select
            name="status"
            id="filter-status-select"
            phx-change="filter_status"
            class="text-xs py-1.5 px-2 border border-neutral-200 bg-white text-neutral-800 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 focus:outline-none"
          >
            <option value="all" selected={@filter_status == "all"}>All Statuses</option>
            <option value="vulnerable" selected={@filter_status == "vulnerable"}>
              Vulnerable
            </option>
            <option value="clean" selected={@filter_status == "clean"}>Clean</option>
            <option value="unscanned" selected={@filter_status == "unscanned"}>Unscanned</option>
          </select>
        </div>

        <%!-- Kind Filter --%>
        <div class="flex items-center gap-1">
          <span class="text-[11px] text-neutral-400 uppercase tracking-wider font-mono">
            Kind:
          </span>
          <select
            name="kind"
            id="filter-kind-select"
            phx-change="filter_kind"
            class="text-xs py-1.5 px-2 border border-neutral-200 bg-white text-neutral-800 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200 focus:outline-none"
          >
            <option value="all" selected={@filter_kind == "all"}>All Kinds</option>
            <option value="website" selected={@filter_kind == "website"}>Website</option>
            <option value="api" selected={@filter_kind == "api"}>API</option>
            <option value="worker" selected={@filter_kind == "worker"}>Worker</option>
            <option value="library" selected={@filter_kind == "library"}>Library</option>
            <option value="mobile" selected={@filter_kind == "mobile"}>Mobile</option>
            <option value="infrastructure" selected={@filter_kind == "infrastructure"}>
              Infrastructure
            </option>
          </select>
        </div>
      </div>
    </div>

    <%!-- Repositories Table --%>
    <%= if @repositories == [] do %>
      <div
        class="border border-neutral-200 p-12 text-center bg-white dark:border-neutral-800 dark:bg-neutral-900"
        id="empty-repositories-state"
      >
        <.icon
          name="hero-code-bracket"
          class="w-10 h-10 text-neutral-300 mx-auto mb-3 dark:text-neutral-600"
        />
        <p class="text-sm font-medium text-neutral-800 dark:text-neutral-200">
          No repositories found
        </p>
        <p class="text-xs text-neutral-400 mt-1 max-w-sm mx-auto">
          <%= if @search_query != "" or @filter_provider != "all" or @filter_status != "all" do %>
            No repositories match your active filter criteria. Try resetting search or filters.
          <% else %>
            You have not linked any source code repositories yet. Connect Bitbucket, GitHub, or GitLab to start scanning.
          <% end %>
        </p>
        <div class="mt-4">
          <button
            type="button"
            phx-click="open_link_repo"
            id="btn-empty-link-repo"
            class="btn-line text-xs py-1.5 px-3 inline-flex items-center gap-1.5"
          >
            <.icon name="hero-plus" class="w-3.5 h-3.5" /> Link Repository
          </button>
        </div>
      </div>
    <% else %>
      <div
        class="border border-neutral-200 bg-white overflow-x-auto dark:border-neutral-800 dark:bg-neutral-900"
        id="repositories-table-container"
      >
        <table class="w-full text-left text-xs" id="repositories-table">
          <thead class="border-b border-neutral-100 bg-neutral-50/50 text-[10px] uppercase font-mono tracking-wider text-neutral-400 dark:border-neutral-800 dark:bg-neutral-800/40">
            <tr>
              <th class="py-3 px-4">Repository</th>
              <th class="py-3 px-4">Governance Association</th>
              <th class="py-3 px-4">Tech & Language</th>
              <th class="py-3 px-4">Latest Commit</th>
              <th class="py-3 px-4">Security / CVEs</th>
              <th class="py-3 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
            <%= for repo <- @repositories do %>
              <tr
                class="hover:bg-neutral-50/50 transition-colors dark:hover:bg-neutral-800/50"
                id={"repo-row-#{repo.id}"}
              >
                <%!-- Repo name, url, provider, kind --%>
                <td class="py-3.5 px-4">
                  <div class="flex items-center gap-2">
                    <span class="font-medium text-neutral-900 dark:text-neutral-100 font-mono text-[13px]">
                      {repo.external_id || repo.url}
                    </span>
                    <a
                      href={repo.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-neutral-400 hover:text-neutral-600 transition-colors dark:hover:text-neutral-200"
                      title="Open in VCS"
                    >
                      <.icon name="hero-arrow-top-right-on-square" class="w-3.5 h-3.5" />
                    </a>
                  </div>

                  <div class="flex items-center gap-1.5 mt-1">
                    <% provider_badge_class =
                      case repo.provider do
                        "bitbucket" ->
                          "bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/60 dark:text-blue-300 dark:border-blue-800"

                        "github" ->
                          "bg-neutral-100 text-neutral-700 border-neutral-300 dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700"

                        "gitlab" ->
                          "bg-orange-50 text-orange-700 border-orange-200 dark:bg-orange-950/60 dark:text-orange-300 dark:border-orange-800"

                        _ ->
                          "bg-neutral-50 text-neutral-500 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700"
                      end %>
                    <span class={"text-[9px] uppercase tracking-wider px-1.5 py-0.2 rounded border font-mono #{provider_badge_class}"}>
                      {repo.provider || "other"}
                    </span>
                    <span class="text-[9px] uppercase tracking-wider px-1.5 py-0.2 rounded border font-mono bg-neutral-50 text-neutral-600 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700">
                      {repo.kind}
                    </span>
                    <%= if repo.default_branch do %>
                      <span class="text-[10px] text-neutral-400 font-mono">
                        ({repo.default_branch})
                      </span>
                    <% end %>
                  </div>
                </td>

                <%!-- Association: Project, Domain --%>
                <td class="py-3.5 px-4">
                  <div class="space-y-1">
                    <%= if repo.project do %>
                      <div class="flex items-center gap-1 text-neutral-800 dark:text-neutral-200">
                        <.icon name="hero-folder" class="w-3.5 h-3.5 text-neutral-400" />
                        <.link
                          navigate={~p"/ownership/projects/#{repo.project.id}"}
                          class="hover:underline font-medium"
                        >
                          {repo.project.name}
                        </.link>
                      </div>
                    <% else %>
                      <span class="text-[11px] text-neutral-400 italic">No project</span>
                    <% end %>

                    <%= if repo.domain do %>
                      <div class="flex items-center gap-1 text-neutral-600 dark:text-neutral-400">
                        <.icon name="hero-globe-alt" class="w-3.5 h-3.5 text-neutral-400" />
                        <.link
                          navigate={~p"/domains/#{repo.domain.id}"}
                          class="hover:underline font-mono text-[11px]"
                        >
                          {repo.domain.name}
                        </.link>
                        <%= if repo.is_primary do %>
                          <span class="text-[8px] uppercase tracking-wider px-1 py-0.2 rounded bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
                            Primary
                          </span>
                        <% end %>
                      </div>
                    <% end %>
                  </div>
                </td>

                <%!-- Tech stack & Language --%>
                <td class="py-3.5 px-4">
                  <div class="space-y-1 max-w-[200px]">
                    <%= if repo.main_language do %>
                      <div class="font-medium text-neutral-800 dark:text-neutral-200 font-mono text-[11px]">
                        {repo.main_language}
                      </div>
                    <% end %>
                    <%= if repo.technology && repo.technology != "" do %>
                      <div class="flex flex-wrap gap-1">
                        <%= for tech <- String.split(repo.technology, ",", trim: true) |> Enum.take(3) do %>
                          <span class="text-[9px] px-1.5 py-0.2 rounded bg-neutral-100 text-neutral-600 font-mono border border-neutral-200 dark:bg-neutral-800 dark:text-neutral-400 dark:border-neutral-700">
                            {String.trim(tech)}
                          </span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-[11px] text-neutral-400 italic">Not detected</span>
                    <% end %>
                  </div>
                </td>

                <%!-- Latest Commit --%>
                <td class="py-3.5 px-4">
                  <%= if repo.last_commit_hash do %>
                    <div class="space-y-0.5 max-w-[220px]">
                      <div class="flex items-center gap-1.5">
                        <span class="font-mono text-[11px] font-medium text-neutral-700 dark:text-neutral-300">
                          {String.slice(repo.last_commit_hash, 0, 7)}
                        </span>
                        <%= if repo.last_commit_author do %>
                          <span class="text-[10px] text-neutral-400 truncate">
                            by {repo.last_commit_author}
                          </span>
                        <% end %>
                      </div>
                      <%= if repo.last_commit_message do %>
                        <p
                          class="text-[11px] text-neutral-500 truncate dark:text-neutral-400"
                          title={repo.last_commit_message}
                        >
                          {repo.last_commit_message}
                        </p>
                      <% end %>
                      <%= if repo.last_commit_at do %>
                        <p class="text-[9px] text-neutral-400 font-mono">
                          {Calendar.strftime(repo.last_commit_at, "%Y-%m-%d %H:%M")}
                        </p>
                      <% end %>
                    </div>
                  <% else %>
                    <span class="text-[11px] text-neutral-400 italic">No commits synced</span>
                  <% end %>
                </td>

                <%!-- Vulnerabilities / CVEs --%>
                <td class="py-3.5 px-4">
                  <%= case repo.scan_status do %>
                    <% "scanned" -> %>
                      <%= if repo.vulnerability_count > 0 do %>
                        <button
                          type="button"
                          phx-click="view_vulns"
                          phx-value-id={repo.id}
                          id={"btn-vulns-#{repo.id}"}
                          class="inline-flex items-center gap-1.5 px-2 py-1 rounded border border-red-200 bg-red-50 text-red-700 font-medium hover:bg-red-100 transition-colors dark:border-red-800 dark:bg-red-950/60 dark:text-red-300 dark:hover:bg-red-900/60"
                        >
                          <.icon
                            name="hero-exclamation-triangle"
                            class="w-3.5 h-3.5 text-red-600"
                          />
                          <span>{repo.vulnerability_count} CVEs</span>
                          <span class="text-[9px] font-mono opacity-80">
                            ({repo.critical_vuln_count}C / {repo.high_vuln_count}H)
                          </span>
                        </button>
                      <% else %>
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-green-200 bg-green-50 text-green-700 text-[11px] dark:border-green-800 dark:bg-green-950/60 dark:text-green-300">
                          <.icon name="hero-check-circle" class="w-3.5 h-3.5 text-green-600" />
                          Clean (0 CVEs)
                        </span>
                      <% end %>
                    <% _ -> %>
                      <span class="inline-flex items-center gap-1 text-[11px] text-neutral-400 font-mono">
                        <.icon name="hero-clock" class="w-3.5 h-3.5" /> Unscanned
                      </span>
                  <% end %>

                  <%= if (repo.secrets_count || 0) > 0 do %>
                    <div class="mt-1">
                      <button
                        type="button"
                        phx-click="view_secrets"
                        phx-value-id={repo.id}
                        id={"btn-view-secrets-#{repo.id}"}
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-amber-300 bg-amber-50 text-amber-800 text-[10px] font-mono hover:bg-amber-100 transition-colors dark:border-amber-800 dark:bg-amber-950/60 dark:text-amber-300"
                        title="Leaked credentials detected! Click to view details."
                      >
                        <.icon name="hero-key" class="w-3 h-3 text-amber-600" />
                        <span>{repo.secrets_count} Secrets</span>
                      </button>
                    </div>
                  <% end %>
                </td>

                <%!-- Actions --%>
                <td class="py-3.5 px-4 text-right">
                  <div class="flex items-center justify-end gap-1.5">
                    <button
                      type="button"
                      phx-click="scan_repo"
                      phx-value-id={repo.id}
                      id={"btn-scan-repo-#{repo.id}"}
                      title="Run dependency vulnerability scan"
                      class="btn-line text-[11px] py-1 px-2 flex items-center gap-1"
                    >
                      <.icon name="hero-shield-check" class="w-3 h-3" /> Scan
                    </button>

                    <button
                      type="button"
                      phx-click="sync_repo"
                      phx-value-id={repo.id}
                      id={"btn-sync-repo-#{repo.id}"}
                      title="Fetch latest commit and detect tech stack"
                      class="btn-line text-[11px] py-1 px-2 flex items-center gap-1"
                    >
                      <.icon name="hero-arrow-path" class="w-3 h-3" /> Sync
                    </button>

                    <.link
                      href={~p"/admin/repositories/#{repo.id}/sbom.cdx.json"}
                      id={"btn-sbom-repo-#{repo.id}"}
                      title="Download CycloneDX 1.5 SBOM (JSON)"
                      class="btn-line text-[11px] py-1 px-2 flex items-center gap-1 text-neutral-600 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-white"
                    >
                      <.icon name="hero-arrow-down-tray" class="w-3 h-3" /> SBOM
                    </.link>

                    <button
                      type="button"
                      phx-click="delete_repo"
                      phx-value-id={repo.id}
                      id={"btn-delete-repo-#{repo.id}"}
                      data-confirm={"Are you sure you want to remove '#{repo.external_id || repo.url}' from inventory?"}
                      title="Delete repository"
                      class="text-neutral-400 hover:text-red-600 transition-colors p-1"
                    >
                      <.icon name="hero-trash" class="w-3.5 h-3.5" />
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <%!-- Vulnerability Details Modal --%>
  <%= if @viewing_vulns do %>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
      id="vulns-modal"
    >
      <div
        class="fixed inset-0 bg-neutral-900/60 backdrop-blur-xs transition-opacity"
        phx-click="close_vulns"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative w-full max-w-3xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl z-10 max-h-[90vh] flex flex-col"
        phx-click-stop
        id="vulns-dialog"
      >
        <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800 shrink-0">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 font-mono">
                {@viewing_vulns.repository.external_id || @viewing_vulns.repository.url}
              </h3>
              <span class="text-xs px-2 py-0.5 rounded bg-red-100 text-red-700 font-medium dark:bg-red-950 dark:text-red-300">
                {length(@viewing_vulns.vulnerabilities)} Vulnerabilities
              </span>
            </div>
            <p class="text-xs text-neutral-400 mt-0.5 font-mono">
              Scanned: {if @viewing_vulns.repository.last_scanned_at,
                do:
                  Calendar.strftime(
                    @viewing_vulns.repository.last_scanned_at,
                    "%Y-%m-%d %H:%M UTC"
                  ),
                else: "Never"}
            </p>
          </div>
          <div class="flex items-center gap-2">
            <.link
              href={~p"/admin/repositories/#{@viewing_vulns.repository.id}/sbom.cdx.json"}
              id={"btn-modal-sbom-#{@viewing_vulns.repository.id}"}
              class="text-xs uppercase tracking-widest text-neutral-700 dark:text-neutral-300 border border-neutral-300 dark:border-neutral-700 px-2.5 py-1 hover:border-neutral-900 dark:hover:border-neutral-100 flex items-center gap-1.5 transition-colors"
              title="Download CycloneDX 1.5 SBOM (JSON)"
            >
              <.icon name="hero-arrow-down-tray" class="w-3.5 h-3.5" /> Export SBOM
            </.link>
            <button
              type="button"
              phx-click="close_vulns"
              class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 p-1"
            >
              <.icon name="hero-x-mark" class="w-5 h-5" />
            </button>
          </div>
        </div>

        <div class="overflow-y-auto flex-1 pr-1 space-y-3">
          <%= if @viewing_vulns.vulnerabilities == [] do %>
            <div class="py-8 text-center text-xs text-green-600 flex items-center justify-center gap-2">
              <.icon name="hero-check-circle" class="w-5 h-5" />
              <span>No dependencies vulnerabilities detected in this repository.</span>
            </div>
          <% else %>
            <%= for v <- @viewing_vulns.vulnerabilities do %>
              <% sev_badge =
                case String.downcase(v.severity || "medium") do
                  "critical" ->
                    "bg-red-100 text-red-800 border-red-200 dark:bg-red-950 dark:text-red-200 dark:border-red-800"

                  "high" ->
                    "bg-orange-100 text-orange-800 border-orange-200 dark:bg-orange-950 dark:text-orange-200 dark:border-orange-800"

                  "medium" ->
                    "bg-yellow-100 text-yellow-800 border-yellow-200 dark:bg-yellow-950 dark:text-yellow-200 dark:border-yellow-800"

                  _ ->
                    "bg-neutral-100 text-neutral-800 border-neutral-200 dark:bg-neutral-800 dark:text-neutral-200 dark:border-neutral-700"
                end %>
              <div class="p-4 border border-neutral-200 dark:border-neutral-700 rounded bg-neutral-50/50 dark:bg-neutral-800/40 space-y-2">
                <div class="flex items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class={"text-[10px] uppercase font-mono px-2 py-0.5 rounded border font-bold #{sev_badge}"}>
                      {v.severity || "UNKNOWN"}
                    </span>
                    <span class="font-mono text-xs font-semibold text-neutral-900 dark:text-neutral-100">
                      {v.package_name} {if v.installed_version, do: "@ #{v.installed_version}"}
                    </span>
                  </div>
                  <%= if v.advisory_id do %>
                    <span class="text-[10px] font-mono text-neutral-500 bg-neutral-200/60 dark:bg-neutral-700 px-1.5 py-0.5 rounded">
                      {v.advisory_id}
                    </span>
                  <% end %>
                </div>

                <%= if v.title do %>
                  <p class="text-xs font-medium text-neutral-800 dark:text-neutral-200">
                    {v.title}
                  </p>
                <% end %>

                <%= if v.description do %>
                  <p class="text-[11px] text-neutral-500 dark:text-neutral-400 leading-relaxed">
                    {v.description}
                  </p>
                <% end %>

                <div class="pt-2 border-t border-neutral-200/60 dark:border-neutral-700/60 flex items-center justify-between text-[10px] text-neutral-500">
                  <span>
                    Ecosystem: <strong class="font-mono">{v.ecosystem || "Generic"}</strong>
                  </span>
                  <%= if v.fixed_version do %>
                    <span class="text-green-600 dark:text-green-400 font-mono">
                      Fix available: upgrade to &gt;= {v.fixed_version}
                    </span>
                  <% else %>
                    <span class="text-neutral-400">No fix version published</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Secrets Findings Modal --%>
  <%= if @viewing_secrets do %>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
      id="secrets-modal"
    >
      <div
        class="fixed inset-0 bg-neutral-900/60 backdrop-blur-xs transition-opacity"
        phx-click="close_secrets"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative w-full max-w-4xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl z-10 max-h-[90vh] flex flex-col"
        phx-click-stop
        id="secrets-dialog"
      >
        <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800 shrink-0">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100 font-mono">
                {@viewing_secrets.repository.external_id || @viewing_secrets.repository.url}
              </h3>
              <span class={[
                "text-xs px-2 py-0.5 rounded font-medium",
                if(length(@viewing_secrets.secrets) > 0,
                  do: "bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300",
                  else: "bg-green-100 text-green-700 dark:bg-green-950 dark:text-green-300"
                )
              ]}>
                {length(@viewing_secrets.secrets)} Discovered Secrets
              </span>
            </div>
            <p class="text-xs text-neutral-400 mt-0.5 font-mono">
              In-process pattern matching & Shannon entropy detection
            </p>
          </div>
          <button
            type="button"
            phx-click="close_secrets"
            class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 p-1"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <div class="overflow-y-auto flex-1 pr-1 space-y-3">
          <%= if @viewing_secrets.secrets == [] do %>
            <div class="py-8 text-center text-xs text-green-600 flex items-center justify-center gap-2">
              <.icon name="hero-check-circle" class="w-5 h-5" />
              <span>
                No exposed secrets or credentials detected in repository configuration files.
              </span>
            </div>
          <% else %>
            <%= for s <- @viewing_secrets.secrets do %>
              <div
                class="p-4 rounded border border-neutral-200 bg-neutral-50/50 dark:border-neutral-800 dark:bg-neutral-800/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4"
                id={"secret-finding-#{s.id}"}
              >
                <div class="space-y-1.5 flex-1 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="text-xs font-semibold text-neutral-900 dark:text-neutral-100">
                      {s.rule_name}
                    </span>
                    <span class={[
                      "text-[9px] uppercase font-mono px-1.5 py-0.5 rounded",
                      case s.severity do
                        "critical" ->
                          "bg-red-100 text-red-800 dark:bg-red-950 dark:text-red-300"

                        "high" ->
                          "bg-orange-100 text-orange-800 dark:bg-orange-950 dark:text-orange-300"

                        _ ->
                          "bg-neutral-100 text-neutral-800 dark:bg-neutral-800 dark:text-neutral-300"
                      end
                    ]}>
                      {s.severity}
                    </span>
                    <span class={[
                      "text-[9px] uppercase font-mono px-1.5 py-0.5 rounded border",
                      case s.status do
                        "active" ->
                          "border-red-300 text-red-600 dark:border-red-800"

                        "resolved" ->
                          "border-green-300 text-green-600 dark:border-green-800"

                        "false_positive" ->
                          "border-neutral-300 text-neutral-500 dark:border-neutral-700"
                      end
                    ]}>
                      {s.status}
                    </span>
                  </div>

                  <div class="text-xs font-mono text-neutral-600 dark:text-neutral-400 truncate">
                    <span>{s.file_path}:{s.line_number}</span>
                  </div>

                  <div class="mt-1">
                    <code class="text-xs font-mono bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-700 px-2 py-0.5 rounded text-neutral-800 dark:text-neutral-200">
                      {s.masked_value}
                    </code>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  <%= if s.status == "active" do %>
                    <button
                      type="button"
                      phx-click="mark_secret_status"
                      phx-value-id={s.id}
                      phx-value-status="false_positive"
                      id={"btn-fp-secret-#{s.id}"}
                      class="text-[10px] uppercase tracking-wider px-2 py-1 border border-neutral-300 hover:border-neutral-900 text-neutral-700 dark:border-neutral-700 dark:hover:border-neutral-300 dark:text-neutral-300 transition-colors"
                    >
                      False Positive
                    </button>
                    <button
                      type="button"
                      phx-click="mark_secret_status"
                      phx-value-id={s.id}
                      phx-value-status="resolved"
                      id={"btn-resolve-secret-#{s.id}"}
                      class="text-[10px] uppercase tracking-wider px-2 py-1 bg-green-600 hover:bg-green-700 text-white transition-colors"
                    >
                      Resolve
                    </button>
                  <% else %>
                    <button
                      type="button"
                      phx-click="mark_secret_status"
                      phx-value-id={s.id}
                      phx-value-status="active"
                      id={"btn-reactivate-secret-#{s.id}"}
                      class="text-[10px] uppercase tracking-wider px-2 py-1 border border-neutral-300 hover:border-neutral-900 text-neutral-700 dark:border-neutral-700 dark:hover:border-neutral-300 dark:text-neutral-300 transition-colors"
                    >
                      Reactivate
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%!-- Link Repository Modal --%>
  <%= if @linking_repo? do %>
    <div
      class="fixed inset-0 z-50 flex items-center justify-center p-4"
      id="link-repo-modal"
    >
      <div
        class="fixed inset-0 bg-neutral-900/60 backdrop-blur-xs transition-opacity"
        phx-click="close_link_repo"
        aria-hidden="true"
      >
      </div>
      <div
        class="relative w-full max-w-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 p-6 shadow-xl z-10 max-h-[90vh] flex flex-col"
        phx-click-stop
        id="link-repo-dialog"
      >
        <%!-- Modal Header --%>
        <div class="flex items-center justify-between mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800 shrink-0">
          <div>
            <h3 class="text-lg font-medium text-neutral-900 dark:text-neutral-100">
              Link Repository
            </h3>
            <p class="text-xs text-neutral-500 mt-0.5">
              Connect a code repository to monitor commit activity, tech stack, and dependency CVEs.
            </p>
          </div>
          <button
            type="button"
            phx-click="close_link_repo"
            class="text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-200 p-1"
          >
            <.icon name="hero-x-mark" class="w-5 h-5" />
          </button>
        </div>

        <%!-- Modal Mode Tabs --%>
        <div class="flex border-b border-neutral-200 dark:border-neutral-800 mb-4 shrink-0">
          <%= if @active_vcs_list != [] do %>
            <button
              type="button"
              phx-click="switch_modal_mode"
              phx-value-mode="browse"
              class={[
                "px-4 py-2 text-xs font-normal border-b-2 transition-colors flex items-center gap-1.5",
                if(@modal_mode == "browse",
                  do:
                    "border-neutral-900 text-neutral-900 dark:border-neutral-100 dark:text-neutral-100 font-medium",
                  else:
                    "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
                )
              ]}
            >
              <.icon name="hero-code-bracket-square" class="w-3.5 h-3.5" />
              Browse VCS ({String.capitalize(@browse_provider)})
            </button>
          <% end %>
          <button
            type="button"
            phx-click="switch_modal_mode"
            phx-value-mode="manual"
            class={[
              "px-4 py-2 text-xs font-normal border-b-2 transition-colors flex items-center gap-1.5",
              if(@modal_mode == "manual",
                do:
                  "border-neutral-900 text-neutral-900 dark:border-neutral-100 dark:text-neutral-100 font-medium",
                else:
                  "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
              )
            ]}
          >
            <.icon name="hero-link" class="w-3.5 h-3.5" /> Manual URL
          </button>
          <button
            type="button"
            phx-click="switch_modal_mode"
            phx-value-mode="connect"
            class={[
              "px-4 py-2 text-xs font-normal border-b-2 transition-colors flex items-center gap-1.5",
              if(@modal_mode == "connect",
                do:
                  "border-neutral-900 text-neutral-900 dark:border-neutral-100 dark:text-neutral-100 font-medium",
                else:
                  "border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300"
              )
            ]}
          >
            <.icon name="hero-cog-6-tooth" class="w-3.5 h-3.5" /> Connect Provider
          </button>
        </div>

        <%!-- Modal Body --%>
        <div class="overflow-y-auto flex-1 pr-1">
          <%= case @modal_mode do %>
            <% "browse" -> %>
              <div class="space-y-4">
                <%= if length(@active_vcs_list) > 1 do %>
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-[11px] text-neutral-400 font-mono">Provider:</span>
                    <%= for vcs <- @active_vcs_list do %>
                      <button
                        type="button"
                        phx-click="select_browse_provider"
                        phx-value-provider={vcs.provider}
                        class={[
                          "px-2.5 py-1 text-xs rounded border transition-colors",
                          if(@browse_provider == vcs.provider,
                            do:
                              "bg-neutral-900 text-white border-neutral-900 dark:bg-neutral-100 dark:text-neutral-900",
                            else:
                              "bg-neutral-50 text-neutral-600 border-neutral-200 hover:bg-neutral-100 dark:bg-neutral-800 dark:text-neutral-300 dark:border-neutral-700"
                          )
                        ]}
                      >
                        {String.capitalize(vcs.provider)} ({vcs.workspace})
                      </button>
                    <% end %>
                  </div>
                <% end %>

                <%!-- Search filter --%>
                <div>
                  <input
                    type="text"
                    name="query"
                    value={@vcs_search_query}
                    placeholder={"Search #{@browse_provider} repositories..."}
                    phx-change="search_vcs"
                    phx-keyup="search_vcs"
                    phx-debounce="200"
                    class="w-full px-3 py-2 border border-neutral-200 bg-white text-xs text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-100 dark:placeholder-neutral-500"
                  />
                </div>

                <%= if @vcs_loading? do %>
                  <div class="py-12 text-center text-xs text-neutral-400 flex flex-col items-center gap-2">
                    <.icon name="hero-arrow-path" class="w-5 h-5 animate-spin text-neutral-400" />
                    <span>
                      Fetching repositories from {String.capitalize(@browse_provider)}...
                    </span>
                  </div>
                <% else %>
                  <%= if @vcs_error do %>
                    <div class="p-3 text-xs text-red-700 bg-red-50 border border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900 flex items-start gap-2">
                      <.icon name="hero-exclamation-triangle" class="w-4 h-4 shrink-0 mt-0.5" />
                      <div class="flex-1">
                        <p class="font-medium">Error loading repositories</p>
                        <p class="mt-0.5">{@vcs_error}</p>
                        <button
                          type="button"
                          phx-click="switch_modal_mode"
                          phx-value-mode="connect"
                          class="underline mt-1 block"
                        >
                          Update workspace credentials &rarr;
                        </button>
                      </div>
                    </div>
                  <% else %>
                    <%= if @vcs_filtered_repos == [] do %>
                      <div class="py-10 text-center text-xs text-neutral-400">
                        <%= if @vcs_search_query != "" do %>
                          No repositories matching "{@vcs_search_query}".
                        <% else %>
                          No repositories found in connected {String.capitalize(@browse_provider)} workspace.
                        <% end %>
                      </div>
                    <% else %>
                      <div class="border border-neutral-200 bg-white divide-y divide-neutral-100 dark:border-neutral-700 dark:bg-neutral-800 dark:divide-neutral-700 rounded">
                        <%= for repo <- @vcs_filtered_repos do %>
                          <% is_linked =
                            Enum.any?(
                              @all_repositories,
                              &(&1.url == repo.url || &1.external_id == repo.name)
                            ) %>
                          <div class="p-3 hover:bg-neutral-50/50 transition-colors flex items-center justify-between gap-3 dark:hover:bg-neutral-700/50">
                            <div class="min-w-0 flex-1">
                              <div class="flex items-center gap-2">
                                <span class="text-xs font-medium text-neutral-900 dark:text-neutral-100 truncate">
                                  {repo.name}
                                </span>
                                <%= if repo.is_private do %>
                                  <span class="text-[9px] uppercase tracking-wider px-1 py-0.2 rounded border font-mono bg-neutral-100 text-neutral-600 border-neutral-200 dark:bg-neutral-700 dark:text-neutral-300 dark:border-neutral-600">
                                    private
                                  </span>
                                <% else %>
                                  <span class="text-[9px] uppercase tracking-wider px-1 py-0.2 rounded border font-mono bg-green-50 text-green-700 border-green-200 dark:bg-green-950 dark:text-green-300 dark:border-green-800">
                                    public
                                  </span>
                                <% end %>
                                <%= if repo.main_language do %>
                                  <span class="text-[9px] text-neutral-400 font-mono">
                                    {repo.main_language}
                                  </span>
                                <% end %>
                              </div>
                              <%= if repo.description && repo.description != "" do %>
                                <p class="text-[11px] text-neutral-400 truncate mt-0.5">
                                  {repo.description}
                                </p>
                              <% end %>
                            </div>

                            <div class="shrink-0">
                              <%= if is_linked do %>
                                <span class="text-[10px] text-neutral-400 border border-neutral-200 px-2 py-1 rounded dark:border-neutral-700">
                                  Linked
                                </span>
                              <% else %>
                                <form phx-submit="link_vcs_repo" class="flex items-center gap-1.5">
                                  <input type="hidden" name="url" value={repo.url} />
                                  <input type="hidden" name="name" value={repo.name} />
                                  <input
                                    type="hidden"
                                    name="provider"
                                    value={to_string(repo.provider)}
                                  />
                                  <input
                                    type="hidden"
                                    name="main_language"
                                    value={repo.main_language || ""}
                                  />
                                  <input
                                    type="hidden"
                                    name="description"
                                    value={repo.description || ""}
                                  />
                                  <input
                                    type="hidden"
                                    name="default_branch"
                                    value={repo.default_branch || "main"}
                                  />

                                  <select
                                    name="project_id"
                                    class="text-[11px] py-1 px-1.5 border border-neutral-200 bg-white text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 focus:outline-none"
                                  >
                                    <option value="">No Project</option>
                                    <%= for p <- @projects do %>
                                      <option value={p.id}>{p.name}</option>
                                    <% end %>
                                  </select>

                                  <select
                                    name="kind"
                                    class="text-[11px] py-1 px-1.5 border border-neutral-200 bg-white text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 focus:outline-none"
                                  >
                                    <option value="website">Website</option>
                                    <option value="api">API</option>
                                    <option value="worker">Worker</option>
                                    <option value="library">Library</option>
                                    <option value="mobile">Mobile</option>
                                    <option value="infrastructure">Infrastructure</option>
                                  </select>

                                  <button
                                    type="submit"
                                    class="btn-line text-[11px] py-1 px-2 inline-flex items-center gap-1"
                                  >
                                    <.icon name="hero-plus" class="w-3 h-3" /> Link
                                  </button>
                                </form>
                              <% end %>
                            </div>
                          </div>
                        <% end %>
                      </div>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% "manual" -> %>
              <.form for={@manual_form} phx-submit="save_manual_repo" class="space-y-4">
                <.input
                  field={@manual_form[:url]}
                  label="Repository URL"
                  placeholder="https://bitbucket.org/workspace/repo or git@github.com:..."
                  required
                />
                <.input
                  field={@manual_form[:project_id]}
                  type="select"
                  label="Assign to Project (Optional)"
                  options={[{"-- No Project --", ""} | Enum.map(@projects, &{&1.name, &1.id})]}
                />
                <.input
                  field={@manual_form[:kind]}
                  type="select"
                  label="Component Kind"
                  options={[
                    {"Website", "website"},
                    {"API / Backend", "api"},
                    {"Worker / Background Job", "worker"},
                    {"Library / SDK", "library"},
                    {"Mobile App", "mobile"},
                    {"Infrastructure / IaC", "infrastructure"},
                    {"Documentation", "documentation"}
                  ]}
                />
                <.input
                  field={@manual_form[:notes]}
                  type="textarea"
                  label="Notes (Optional)"
                  placeholder="Component purpose, tech details, or architecture notes..."
                  rows={3}
                />
                <div class="flex justify-end pt-2">
                  <button type="submit" class="btn-line-filled text-xs py-2 px-4">
                    Link Repository
                  </button>
                </div>
              </.form>
            <% "connect" -> %>
              <div class="space-y-4">
                <.form
                  for={@connect_form}
                  phx-change="validate_connect"
                  phx-submit="save_vcs_connection"
                  class="space-y-3"
                >
                  <div class="grid grid-cols-1 gap-3">
                    <.input
                      field={@connect_form[:provider]}
                      type="select"
                      label="VCS Provider"
                      options={[
                        {"Bitbucket Cloud", "bitbucket"},
                        {"GitHub", "github"},
                        {"GitLab", "gitlab"}
                      ]}
                    />

                    <% current_provider = to_string(@connect_form[:provider].value || "bitbucket") %>

                    <%= case current_provider do %>
                      <% "bitbucket" -> %>
                        <div class="text-xs text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 p-3 border border-neutral-200 dark:border-neutral-700 leading-relaxed rounded">
                          <p class="font-medium text-neutral-800 dark:text-neutral-200 mb-1">
                            Bitbucket Cloud (Access Token recommended)
                          </p>
                          <ul class="list-disc pl-4 space-y-1 text-[11px]">
                            <li>
                              <strong>Access Token (Recommended):</strong>
                              Create a <em>Repository</em>
                              or <em>Workspace Access Token</em>
                              with <code>repository:read</code>
                              scope.
                              <span class="text-amber-700 dark:text-amber-400 font-medium">
                                Username is NOT needed (leave blank).
                              </span>
                            </li>
                            <li>
                              <strong>App Password (Legacy):</strong>
                              Create an App Password in Personal Settings with <code>Repositories: Read</code>. Username is required.
                            </li>
                          </ul>
                        </div>

                        <.input
                          field={@connect_form[:workspace]}
                          label="Workspace Slug / ID"
                          placeholder="e.g. my-workspace (from bitbucket.org/my-workspace)"
                          required
                        />
                        <.input
                          field={@connect_form[:username]}
                          label="Username (Optional — only for legacy App Passwords, leave blank for Access Tokens)"
                          placeholder="Leave blank for Access Tokens"
                        />
                        <.input
                          field={@connect_form[:token]}
                          type="password"
                          label="Access Token / App Password"
                          placeholder="Bitbucket Access Token or App Password"
                          required
                        />
                      <% "github" -> %>
                        <div class="text-xs text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 p-3 border border-neutral-200 dark:border-neutral-700 leading-relaxed rounded">
                          <p class="font-medium text-neutral-800 dark:text-neutral-200 mb-1">
                            GitHub (Personal Access Token)
                          </p>
                          <p class="text-[11px]">
                            Create a Personal Access Token (classic with <code>repo</code>
                            scope, or fine-grained token with Repository permissions &rarr; Contents: Read).
                            <span class="text-amber-700 dark:text-amber-400 font-medium">
                              Username is NOT needed.
                            </span>
                          </p>
                        </div>

                        <.input
                          field={@connect_form[:workspace]}
                          label="Organization or Account Username"
                          placeholder="e.g. my-org (or your GitHub username)"
                          required
                        />
                        <.input
                          field={@connect_form[:token]}
                          type="password"
                          label="Personal Access Token (PAT)"
                          placeholder="ghp_... or github_pat_..."
                          required
                        />
                      <% "gitlab" -> %>
                        <div class="text-xs text-neutral-600 dark:text-neutral-400 bg-neutral-50 dark:bg-neutral-800/50 p-3 border border-neutral-200 dark:border-neutral-700 leading-relaxed rounded">
                          <p class="font-medium text-neutral-800 dark:text-neutral-200 mb-1">
                            GitLab (Project, Group, or Personal Access Token)
                          </p>
                          <p class="text-[11px]">
                            Create an Access Token with <code>read_api</code>
                            and <code>read_repository</code>
                            scopes.
                            Supports both gitlab.com and self-hosted instances.
                            <span class="text-amber-700 dark:text-amber-400 font-medium">
                              Username is NOT needed.
                            </span>
                          </p>
                        </div>

                        <.input
                          field={@connect_form[:workspace]}
                          label="Group Path or Project Namespace"
                          placeholder="e.g. my-group"
                          required
                        />
                        <.input
                          field={@connect_form[:token]}
                          type="password"
                          label="Access Token"
                          placeholder="glpat-..."
                          required
                        />
                        <.input
                          field={@connect_form[:base_url]}
                          label="Self-Hosted API URL (Optional)"
                          placeholder="https://gitlab.example.com/api/v4 (leave blank for gitlab.com)"
                        />
                    <% end %>
                  </div>

                  <%= if @vcs_error do %>
                    <div class="p-3 text-xs text-red-700 bg-red-50 border border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900">
                      {@vcs_error}
                    </div>
                  <% end %>

                  <div class="flex justify-end pt-2">
                    <button type="submit" class="btn-line-filled text-xs py-2 px-4">
                      Save Connection
                    </button>
                  </div>
                </.form>
              </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</Layouts.app>
