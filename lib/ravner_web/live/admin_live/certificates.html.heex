<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">SSL Certificates</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          Global overview of monitored encryption certificates
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2">
          <button
            phx-click="scan_expired"
            id="scan-expired-certs"
            class={[
              "inline-flex items-center gap-1.5 text-xs font-light uppercase tracking-wider px-3 py-2 border transition-colors",
              @expired_count > 0 &&
                "border-red-300 text-red-700 bg-red-50 hover:bg-red-100 hover:border-red-400 cursor-pointer",
              @expired_count == 0 &&
                "border-neutral-200 text-neutral-400 opacity-60 cursor-not-allowed"
            ]}
            disabled={@expired_count == 0}
            title={
              if @expired_count > 0,
                do: "Queue SSL check for all expired certificates",
                else: "No expired certificates"
            }
          >
            <.icon name="hero-arrow-path" class="w-3.5 h-3.5" />
            <span>Scan Expired</span>
            <span class="ml-0.5 px-1.5 py-0.2 rounded-full bg-red-100 text-red-800 text-[10px] font-medium">
              {@expired_count}
            </span>
          </button>

          <button
            phx-click="scan_expiring_30d"
            id="scan-expiring-30d-certs"
            class={[
              "inline-flex items-center gap-1.5 text-xs font-light uppercase tracking-wider px-3 py-2 border transition-colors",
              @expiring_30d_count > 0 &&
                "border-amber-300 text-amber-800 bg-amber-50 hover:bg-amber-100 hover:border-amber-400 cursor-pointer",
              @expiring_30d_count == 0 &&
                "border-neutral-200 text-neutral-400 opacity-60 cursor-not-allowed"
            ]}
            disabled={@expiring_30d_count == 0}
            title={
              if @expiring_30d_count > 0,
                do: "Queue SSL check for certificates expiring within 30 days",
                else: "No certificates expiring within 30 days"
            }
          >
            <.icon name="hero-arrow-path" class="w-3.5 h-3.5" />
            <span>Scan Expiring ≤ 30d</span>
            <span class="ml-0.5 px-1.5 py-0.2 rounded-full bg-amber-100 text-amber-800 text-[10px] font-medium">
              {@expiring_30d_count}
            </span>
          </button>
        </div>

        <div class="flex items-center gap-1">
          <button
            phx-click="bulk_scan"
            phx-value-limit="10"
            class="text-xs font-light uppercase tracking-wider px-3 py-2 border border-neutral-200 hover:border-neutral-900 hover:text-neutral-900 text-neutral-500 transition-colors"
          >
            Scan top 10
          </button>
          <button
            phx-click="bulk_scan"
            phx-value-limit="50"
            class="text-xs font-light uppercase tracking-wider px-3 py-2 border border-neutral-200 hover:border-neutral-900 hover:text-neutral-900 text-neutral-500 transition-colors"
          >
            50
          </button>
          <button
            phx-click="bulk_scan"
            phx-value-limit="100"
            class="text-xs font-light uppercase tracking-wider px-3 py-2 border border-neutral-200 hover:border-neutral-900 hover:text-neutral-900 text-neutral-500 transition-colors"
          >
            100
          </button>
        </div>
        <button
          phx-click="export_csv"
          phx-hook="CsvDownload"
          id="cert-csv-export"
          class="text-xs font-light uppercase tracking-wider px-4 py-2 border border-neutral-200 hover:border-neutral-900 hover:text-neutral-900 text-neutral-500 transition-colors"
        >
          Export CSV
        </button>
      </div>
    </div>

    <div class="border border-neutral-200">
      <%= if @certificates == [] do %>
        <div class="p-12 text-center text-sm font-light text-neutral-400">
          No SSL certificates captured yet.
        </div>
      <% else %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-200 text-left text-[10px] font-normal text-neutral-400 uppercase tracking-wider">
              <th class="px-6 py-4">Domain</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4">Expires</th>
              <th class="px-6 py-4">Issuer</th>
              <th class="px-6 py-4">Valid From</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            <%= for cert <- @certificates do %>
              <% expiring_soon = cert.days_remaining != nil && cert.days_remaining <= 14 %>
              <% expired = cert.days_remaining != nil && cert.days_remaining < 0 %>
              <tr class="hover:bg-neutral-50 transition-colors group dark:hover:bg-neutral-800">
                <td class="px-6 py-4">
                  <.link
                    navigate={~p"/domains/#{cert.id}"}
                    class="font-normal text-neutral-700 hover:underline"
                  >
                    {cert.name}
                  </.link>
                </td>
                <td class="px-6 py-4">
                  <span class={[
                    "text-[10px] font-normal px-2 py-0.5 border uppercase tracking-wider",
                    expired && "text-red-700 bg-red-50 border-red-200",
                    expiring_soon && !expired && "text-amber-700 bg-amber-50 border-amber-200",
                    !expiring_soon && "text-green-700 bg-green-50 border-green-200"
                  ]}>
                    <%= if expired do %>
                      Expired
                    <% else %>
                      {cert.days_remaining} days
                    <% end %>
                  </span>
                </td>
                <td class={[
                  "px-6 py-4 font-light whitespace-nowrap",
                  expired && "text-red-600",
                  expiring_soon && !expired && "text-amber-600",
                  !expiring_soon && "text-neutral-500"
                ]}>
                  {if cert.valid_until,
                    do: Calendar.strftime(cert.valid_until, "%Y-%m-%d"),
                    else: "—"}
                </td>
                <td
                  class="px-6 py-4 text-neutral-500 font-light truncate max-w-[250px]"
                  title={cert.issuer}
                >
                  {cert.issuer || "—"}
                </td>
                <td class="px-6 py-4 text-neutral-400 font-light whitespace-nowrap">
                  {if cert.valid_from,
                    do: Calendar.strftime(cert.valid_from, "%Y-%m-%d"),
                    else: "—"}
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</Layouts.app>
