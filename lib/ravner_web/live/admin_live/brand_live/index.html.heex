<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-light tracking-tight">Brands</h1>
      <.link patch={~p"/admin/brands/new"} class="btn-line text-xs flex items-center gap-1.5">
        <.icon name="hero-plus" class="w-4 h-4" /> Add brand
      </.link>
    </div>

    <%= if @live_action in [:new, :edit] do %>
      <div class="border border-neutral-200 p-6 mb-8">
        <h2 class="text-lg font-light tracking-tight mb-4">
          {if @brand.id, do: "Edit Brand", else: "New Brand"}
        </h2>

        <.form
          for={@form}
          phx-change="validate"
          phx-submit="save"
          id="brand-form"
          class="space-y-4 max-w-md"
        >
          <.input field={@form[:name]} type="text" label="Name" />
          <.input field={@form[:slug]} type="text" label="Slug" placeholder="e.g. acme-corp" />
          <.input
            field={@form[:display_name]}
            type="text"
            label="Display name"
            placeholder="Short name for lists"
          />

          <.input field={@form[:notes]} type="textarea" label="Notes" />

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-line-filled text-xs">Save</button>
            <.link patch={~p"/admin/brands"} class="btn-line text-xs">Cancel</.link>
          </div>
        </.form>
      </div>
    <% end %>

    <div class="border border-neutral-200">
      <%= if @brands == [] do %>
        <div class="p-6 text-sm font-light text-neutral-500">No brands yet.</div>
      <% else %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-200 text-left text-xs font-normal text-neutral-500 uppercase tracking-wider">
              <th class="px-4 py-3">Name</th>
              <th class="px-4 py-3">Slug</th>
              <th class="px-4 py-3">Notes</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            <%= for brand <- @brands do %>
              <tr class="border-b border-neutral-100">
                <td class="px-4 py-3">{brand.name}</td>
                <td class="px-4 py-3 text-neutral-500">{brand.slug}</td>
                <td class="px-4 py-3 text-neutral-500">{brand.notes}</td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <.link
                      patch={~p"/admin/brands/#{brand.id}/edit"}
                      class="text-neutral-400 hover:text-neutral-900 transition-colors"
                    >
                      <.icon name="hero-pencil" class="w-4 h-4" />
                    </.link>
                    <button
                      phx-click="delete"
                      phx-value-id={brand.id}
                      data-confirm="Delete this brand?"
                      class="text-neutral-400 hover:text-red-600 transition-colors"
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</Layouts.app>
