<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-2xl font-light tracking-tight">Organizations</h1>
      <.link
        patch={~p"/admin/organizations/new"}
        class="btn-line text-xs flex items-center gap-1.5"
      >
        <.icon name="hero-plus" class="w-4 h-4" /> Add organization
      </.link>
    </div>

    <%= if @live_action in [:new, :edit] do %>
      <div class="border border-neutral-200 p-6 mb-8">
        <h2 class="text-lg font-light tracking-tight mb-4">
          {if @org.id, do: "Edit Organization", else: "New Organization"}
        </h2>

        <.form
          for={@form}
          phx-change="validate"
          phx-submit="save"
          id="organization-form"
          class="space-y-4 max-w-md"
        >
          <div>
            <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
              Name
            </label>
            <input
              type="text"
              name="organization[name]"
              id="org_name"
              value={@form[:name].value}
              class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
            />
            <%= for err <- @form[:name].errors do %>
              <p class="text-xs text-red-500 mt-1">{elem(err, 0)}</p>
            <% end %>
          </div>
          <.input
            field={@form[:display_name]}
            type="text"
            label="Display name"
            placeholder="Short name for lists, falls back to Name"
          />
          <div>
            <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
              Slug
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                name="organization[slug]"
                id="org_slug"
                value={@form[:slug].value}
                placeholder="e.g. acme-de"
                class="flex-1 px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
              />
              <button
                type="button"
                id="auto-slug-btn"
                phx-hook=".AutoSlug"
                data-target="org_slug"
                data-source="org_name"
                class="btn-line text-xs whitespace-nowrap"
              >
                Auto
              </button>
            </div>
          </div>
          <.input
            field={@form[:type]}
            type="select"
            label="Type"
            options={[
              {"Internal", "internal"},
              {"Client", "client"},
              {"Contractor", "contractor"},
              {"Partner", "partner"}
            ]}
          />
          <.input
            field={@form[:country]}
            type="text"
            label="Country"
            placeholder="e.g. DE, PL, ES"
          />
          <.input
            field={@form[:brand_id]}
            type="select"
            label="Brand"
            options={Enum.map(@brands, &{&1.name, &1.id})}
            prompt="None"
          />
          <.input field={@form[:notes]} type="textarea" label="Notes" />

          <div class="flex items-center gap-3">
            <button type="submit" class="btn-line-filled text-xs">Save</button>
            <.link patch={~p"/admin/organizations"} class="btn-line text-xs">Cancel</.link>
          </div>
        </.form>
      </div>
    <% end %>

    <div class="border border-neutral-200">
      <%= if @orgs == [] do %>
        <div class="p-6 text-sm font-light text-neutral-500">No organizations yet.</div>
      <% else %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-200 text-left text-xs font-normal text-neutral-500 uppercase tracking-wider">
              <th class="px-4 py-3">Name</th>
              <th class="px-4 py-3">Type</th>
              <th class="px-4 py-3">Country</th>
              <th class="px-4 py-3">Brand</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody>
            <%= for org <- @orgs do %>
              <tr class="border-b border-neutral-100">
                <td class="px-4 py-3">{org.display_name || org.name}</td>
                <td class="px-4 py-3">
                  <span class="text-xs px-2 py-0.5 border border-neutral-200">{org.type}</span>
                </td>
                <td class="px-4 py-3 text-neutral-500">{org.country}</td>
                <td class="px-4 py-3 text-neutral-500">
                  {org.brand && (org.brand.display_name || org.brand.name)}
                </td>
                <td class="px-4 py-3 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <.link
                      patch={~p"/admin/organizations/#{org.id}/edit"}
                      class="text-neutral-400 hover:text-neutral-900 transition-colors"
                    >
                      <.icon name="hero-pencil" class="w-4 h-4" />
                    </.link>
                    <button
                      phx-click="delete"
                      phx-value-id={org.id}
                      data-confirm="Delete this organization?"
                      class="text-neutral-400 hover:text-red-600 transition-colors"
                    >
                      <.icon name="hero-trash" class="w-4 h-4" />
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".AutoSlug">
    export default {
      mounted() {
        this.el.addEventListener("click", () => {
          const targetId = this.el.getAttribute("data-target");
          const sourceId = this.el.getAttribute("data-source");
          const source = document.getElementById(sourceId);
          const target = document.getElementById(targetId);
          if (source && target) {
            target.value = source.value
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-+|-+$/g, "");
            target.dispatchEvent(new Event("input", { bubbles: true }));
          }
        });
      }
    }
  </script>
</Layouts.app>
