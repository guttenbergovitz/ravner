<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <%!-- Breadcrumb --%>
    <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
      <.link navigate={~p"/ownership"} class="hover:text-neutral-600 transition-colors">
        <.icon name="hero-arrow-left" class="w-3 h-3 inline" /> Ownership
      </.link>
      <%= if @live_action == :edit && @org do %>
        <%= if @org.brand do %>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <.link
            navigate={~p"/ownership/brands/#{@org.brand.id}"}
            class="hover:text-neutral-600 transition-colors"
          >
            {@org.brand.display_name || @org.brand.name}
          </.link>
        <% end %>
        <.icon name="hero-chevron-right" class="w-3 h-3" />
        <span class="text-neutral-600">{@org.display_name || @org.name}</span>
      <% end %>
    </nav>

    <div class="border border-neutral-200 p-6">
      <div class="flex items-center justify-between mb-4">
        <h1 class="text-xl font-light tracking-tight">
          {if @live_action == :edit, do: "Edit Organization", else: "New Organization"}
        </h1>
        <%= if @live_action == :edit do %>
          <.link
            navigate={~p"/ownership/organizations/#{@org.id}"}
            class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors flex items-center gap-1"
          >
            View in Ownership <.icon name="hero-arrow-right" class="w-3 h-3" />
          </.link>
        <% end %>
      </div>

      <%= if @form do %>
        <.form
          for={@form}
          phx-change="validate"
          phx-submit="save"
          id="organization-form"
          class="space-y-4 max-w-md"
        >
          <div>
            <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
              Name
            </label>
            <input
              type="text"
              name="organization[name]"
              id="org_name"
              value={@form[:name].value}
              class="w-full px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
            />
            <%= for err <- @form[:name].errors do %>
              <p class="text-xs text-red-500 mt-1">{elem(err, 0)}</p>
            <% end %>
          </div>
          <.input
            field={@form[:display_name]}
            type="text"
            label="Display name"
            placeholder="Short name for lists, falls back to Name"
          />
          <div>
            <label class="block text-xs font-light text-neutral-500 uppercase tracking-wide mb-1">
              Slug
            </label>
            <div class="flex gap-2">
              <input
                type="text"
                name="organization[slug]"
                id="org_slug"
                value={@form[:slug].value}
                placeholder="e.g. acme-de"
                class="flex-1 px-3 py-2 border border-neutral-200 bg-transparent text-sm font-light text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-500 transition-colors"
              />
              <button
                type="button"
                id="auto-slug-btn"
                phx-hook=".AutoSlug"
                data-target="org_slug"
                data-source="org_name"
                class="btn-line text-xs whitespace-nowrap"
              >
                Auto
              </button>
            </div>
          </div>
          <.input
            field={@form[:type]}
            type="select"
            label="Type"
            options={[
              {"Internal", "internal"},
              {"Client", "client"},
              {"Contractor", "contractor"},
              {"Partner", "partner"}
            ]}
          />
          <.input
            field={@form[:country]}
            type="text"
            label="Country"
            placeholder="e.g. DE, PL, ES"
          />
          <.input
            field={@form[:brand_id]}
            type="select"
            label="Brand"
            options={Enum.map(@brands, &{&1.name, &1.id})}
            prompt="None"
          />
          <.input
            field={@form[:manager_id]}
            type="select"
            label="Organization Manager"
            options={
              Enum.map(
                @people,
                &{"#{&1.first_name} #{&1.last_name} (#{&1.email || "no email"})", &1.id}
              )
            }
            prompt="None (Unassigned)"
          />
          <.input field={@form[:notes]} type="textarea" label="Notes" />

          <div class="flex items-center gap-3 pt-4">
            <button type="submit" class="btn-line-filled text-xs">Save</button>
            <.link
              navigate={
                if @live_action == :edit && @org,
                  do: ~p"/ownership/organizations/#{@org.id}",
                  else: ~p"/ownership"
              }
              class="btn-line text-xs"
            >
              Cancel
            </.link>
          </div>
        </.form>
      <% end %>

      <%!-- Contextual panel for edit --%>
      <%= if @live_action == :edit && @stats do %>
        <div class="mt-8 pt-6 border-t border-neutral-100">
          <h3 class="text-xs font-normal uppercase tracking-widest text-neutral-500 mb-4">
            Related
          </h3>
          <div class="grid grid-cols-3 gap-4 text-center">
            <.link
              navigate={~p"/ownership/organizations/#{@org.id}?tab=projects"}
              class="border border-neutral-200 p-4 hover:border-neutral-400 transition-colors"
            >
              <div class="text-xl font-light text-neutral-900">{@stats.projects_count}</div>
              <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                Projects
              </div>
            </.link>
            <.link
              navigate={~p"/ownership/organizations/#{@org.id}?tab=people"}
              class="border border-neutral-200 p-4 hover:border-neutral-400 transition-colors"
            >
              <div class="text-xl font-light text-neutral-900">{@stats.people_count}</div>
              <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                People
              </div>
            </.link>
            <.link
              navigate={~p"/ownership/organizations/#{@org.id}?tab=domains"}
              class="border border-neutral-200 p-4 hover:border-neutral-400 transition-colors"
            >
              <div class="text-xl font-light text-neutral-900">{@stats.domains_count}</div>
              <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                Domains
              </div>
            </.link>
          </div>
          <div class="flex items-center justify-between mt-4">
            <div class="flex items-center gap-3">
              <.link
                href={~p"/admin/projects/new"}
                class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
              >
                + Add Project
              </.link>
              <.link
                href={~p"/admin/people/new"}
                class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
              >
                + Add Person
              </.link>
            </div>
            <button
              phx-click="delete"
              data-confirm="Delete this organization and all its projects, people and roles?"
              class="text-xs font-normal text-red-500 hover:text-red-700 transition-colors"
            >
              Delete Organization
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <script :type={Phoenix.LiveView.ColocatedHook} name=".AutoSlug">
    export default {
      mounted() {
        this.el.addEventListener("click", () => {
          const targetId = this.el.getAttribute("data-target");
          const sourceId = this.el.getAttribute("data-source");
          const source = document.getElementById(sourceId);
          const target = document.getElementById(targetId);
          if (source && target) {
            target.value = source.value
              .toLowerCase()
              .replace(/[^a-z0-9]+/g, "-")
              .replace(/^-+|-+$/g, "");
            target.dispatchEvent(new Event("input", { bubbles: true }));
          }
        });
      }
    }
  </script>
</Layouts.app>
