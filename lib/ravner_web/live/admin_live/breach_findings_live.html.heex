<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl font-light tracking-tight">Breach Findings</h1>
        <p class="text-sm font-light text-neutral-500 mt-1">
          Dark-web breach detections from infostealer reports
        </p>
      </div>
    </div>

    <div class="border border-neutral-200">
      <%= if @findings == [] do %>
        <div class="p-12 text-center text-sm font-light text-neutral-400">
          No breach findings detected yet.
        </div>
      <% else %>
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-neutral-200 text-left text-[10px] font-normal text-neutral-400 uppercase tracking-wider">
              <th class="px-6 py-4">Domain</th>
              <th class="px-6 py-4">Title</th>
              <th class="px-6 py-4">Severity</th>
              <th class="px-6 py-4">Status</th>
              <th class="px-6 py-4">Source</th>
              <th class="px-6 py-4">Detected</th>
              <th class="px-6 py-4">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-neutral-100">
            <%= for finding <- @findings do %>
              <tr class="hover:bg-neutral-50 transition-colors group">
                <td class="px-6 py-4 font-normal text-neutral-700">
                  {finding.domain}
                </td>
                <td
                  class="px-6 py-4 text-neutral-600 font-light max-w-[200px] truncate"
                  title={finding.title}
                >
                  {finding.title}
                </td>
                <td class="px-6 py-4">
                  <span class={[
                    "text-[10px] font-normal px-2 py-0.5 border uppercase tracking-wider",
                    finding.severity == "critical" && "text-red-700 bg-red-50 border-red-200",
                    finding.severity == "high" && "text-orange-700 bg-orange-50 border-orange-200",
                    finding.severity == "medium" && "text-amber-700 bg-amber-50 border-amber-200",
                    finding.severity == "low" && "text-green-700 bg-green-50 border-green-200"
                  ]}>
                    {finding.severity}
                  </span>
                </td>
                <td class="px-6 py-4">
                  <span class={[
                    "text-[10px] font-normal px-2 py-0.5 border uppercase tracking-wider",
                    finding.status == "new" && "text-blue-700 bg-blue-50 border-blue-200",
                    finding.status == "resolved" && "text-green-700 bg-green-50 border-green-200",
                    finding.status == "false_positive" &&
                      "text-neutral-500 bg-neutral-50 border-neutral-200",
                    finding.status == "ignored" &&
                      "text-neutral-400 bg-neutral-50 border-neutral-200"
                  ]}>
                    {finding.status}
                  </span>
                </td>
                <td class="px-6 py-4 text-neutral-500 font-light">
                  {finding.source || "—"}
                </td>
                <td class="px-6 py-4 text-neutral-400 font-light whitespace-nowrap">
                  {Calendar.strftime(finding.inserted_at, "%Y-%m-%d %H:%M")}
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-1">
                    <%= if finding.status != "resolved" do %>
                      <button
                        phx-click="set_status"
                        phx-value-id={finding.id}
                        phx-value-status="resolved"
                        class="text-[10px] px-2 py-1 border border-green-200 text-green-700 hover:bg-green-50 transition-colors"
                        title="Mark as resolved"
                      >
                        Resolve
                      </button>
                    <% end %>
                    <%= if finding.status != "false_positive" do %>
                      <button
                        phx-click="set_status"
                        phx-value-id={finding.id}
                        phx-value-status="false_positive"
                        class="text-[10px] px-2 py-1 border border-neutral-200 text-neutral-500 hover:bg-neutral-50 transition-colors"
                        title="Mark as false positive"
                      >
                        FP
                      </button>
                    <% end %>
                    <%= if finding.status != "ignored" do %>
                      <button
                        phx-click="set_status"
                        phx-value-id={finding.id}
                        phx-value-status="ignored"
                        class="text-[10px] px-2 py-1 border border-neutral-200 text-neutral-400 hover:bg-neutral-50 transition-colors"
                        title="Ignore"
                      >
                        Ignore
                      </button>
                    <% end %>
                    <%= if finding.status != "new" do %>
                      <button
                        phx-click="set_status"
                        phx-value-id={finding.id}
                        phx-value-status="new"
                        class="text-[10px] px-2 py-1 border border-blue-200 text-blue-600 hover:bg-blue-50 transition-colors"
                        title="Reopen"
                      >
                        Reopen
                      </button>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      <% end %>
    </div>
  </div>
</Layouts.app>
