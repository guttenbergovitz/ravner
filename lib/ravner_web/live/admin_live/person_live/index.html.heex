<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <%= if @live_action == :index do %>
      <div class="flex items-center justify-between mb-6">
        <div>
          <h1 class="text-2xl font-light tracking-tight">People</h1>
          <p class="text-sm font-light text-neutral-500 mt-1">
            Governance directory of stakeholders, team members, and role holders
          </p>
        </div>
        <div class="flex items-center gap-3">
          <.link navigate={~p"/ownership"} class="btn-line text-xs">
            <.icon name="hero-building-office-2" class="w-4 h-4" /> Ownership Directory
          </.link>
          <.link navigate={~p"/admin/people/new"} class="btn-line-filled text-xs">
            <.icon name="hero-plus" class="w-4 h-4" /> New person
          </.link>
        </div>
      </div>

      <%!-- Identity Sub-Navigation Tabs --%>
      <div class="flex items-center gap-6 border-b border-neutral-100 mb-8 pb-px dark:border-neutral-800">
        <%= if @current_scope.user && @current_scope.user.role == :admin do %>
          <.link
            navigate={~p"/admin/users"}
            class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200"
          >
            System Users
          </.link>
        <% end %>
        <.link
          navigate={~p"/admin/people"}
          class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-neutral-900 text-neutral-900 font-medium dark:border-neutral-100 dark:text-neutral-100 transition-all duration-200"
        >
          People (Governance)
        </.link>
        <%= if @current_scope.user && @current_scope.user.role == :admin do %>
          <.link
            navigate={~p"/admin/invites"}
            class="text-xs font-normal uppercase tracking-widest pb-4 border-b-2 border-transparent text-neutral-400 hover:text-neutral-600 dark:hover:text-neutral-300 transition-all duration-200"
          >
            Invites
          </.link>
        <% end %>
      </div>

      <%!-- Search and Filters --%>
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <form phx-change="search" phx-submit="search" class="flex-1 max-w-md">
          <div class="relative">
            <input
              type="text"
              name="q"
              id="people-search-input"
              value={@search_query}
              phx-debounce="150"
              placeholder="Search by name, email, or title..."
              autocomplete="off"
              class="w-full pl-9 pr-4 py-2 text-sm border border-neutral-200 dark:border-neutral-700 rounded bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-neutral-400 transition-colors"
            />
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-neutral-400">
              <.icon name="hero-magnifying-glass" class="w-4 h-4" />
            </div>
          </div>
        </form>

        <form phx-change="filter_org" class="sm:w-64">
          <select
            name="org_id"
            id="people-org-filter"
            class="w-full px-3 py-2 text-xs border border-neutral-200 dark:border-neutral-700 rounded bg-white dark:bg-neutral-900 text-neutral-900 dark:text-neutral-100 focus:outline-none focus:border-neutral-400 transition-colors"
          >
            <option value="" selected={is_nil(@selected_org_id) or @selected_org_id == ""}>
              All Organizations
            </option>
            <%= for org <- @orgs do %>
              <option value={org.id} selected={to_string(org.id) == to_string(@selected_org_id)}>
                {org.name}
              </option>
            <% end %>
          </select>
        </form>
      </div>

      <%!-- People listing table --%>
      <%= if @people == [] do %>
        <div class="text-center py-20 border border-neutral-200 dark:border-neutral-700">
          <.icon
            name="hero-user-group"
            class="w-8 h-8 text-neutral-300 dark:text-neutral-600 mx-auto mb-4"
          />
          <p class="text-sm font-light text-neutral-400">
            <%= if @search_query != "" or (@selected_org_id && @selected_org_id != "") do %>
              No people match your search or filter.
            <% else %>
              No people registered yet.
            <% end %>
          </p>
        </div>
      <% else %>
        <div class="border border-neutral-200 divide-y divide-neutral-100 dark:border-neutral-700 dark:divide-neutral-700">
          <div class="grid grid-cols-[1.2fr_1fr_1fr_1fr_auto] gap-4 px-6 py-3 text-xs font-light tracking-wide uppercase text-neutral-400">
            <span>Person</span>
            <span>Contact</span>
            <span>Organization</span>
            <span>User Account</span>
            <span></span>
          </div>

          <%= for person <- @people do %>
            <div
              id={"person-#{person.id}"}
              class="grid grid-cols-[1.2fr_1fr_1fr_1fr_auto] gap-4 items-center px-6 py-4 hover:bg-neutral-50 transition-colors dark:hover:bg-neutral-800"
            >
              <div>
                <div class="text-sm font-normal text-neutral-900 dark:text-neutral-100">
                  {person.first_name} {person.last_name}
                </div>
                <%= if person.title do %>
                  <div class="text-xs font-light text-neutral-500">{person.title}</div>
                <% end %>
              </div>

              <div>
                <%= if person.email do %>
                  <div class="text-xs font-light text-neutral-600 dark:text-neutral-300">
                    {person.email}
                  </div>
                <% end %>
                <%= if person.phone || person.mobile do %>
                  <div class="text-[11px] font-light text-neutral-400">
                    {person.phone || person.mobile}
                  </div>
                <% end %>
                <%= if is_nil(person.email) and is_nil(person.phone) and is_nil(person.mobile) do %>
                  <span class="text-xs font-light text-neutral-400">—</span>
                <% end %>
              </div>

              <div>
                <%= if person.organization do %>
                  <.link
                    navigate={~p"/ownership/organizations/#{person.organization.id}"}
                    class="text-xs font-normal text-neutral-700 hover:text-neutral-900 dark:text-neutral-300 dark:hover:text-neutral-100 underline decoration-neutral-300"
                  >
                    {person.organization.name}
                  </.link>
                <% else %>
                  <span class="text-xs font-light text-neutral-400">—</span>
                <% end %>
              </div>

              <div>
                <%= if person.user do %>
                  <div class="flex items-center gap-1.5 flex-wrap">
                    <span class="inline-flex items-center gap-1 text-[11px] font-normal text-emerald-700 bg-emerald-50 dark:bg-emerald-950/40 dark:text-emerald-300 px-1.5 py-0.5 border border-emerald-200 dark:border-emerald-800 rounded">
                      <.icon name="hero-check-circle" class="w-3 h-3 text-emerald-600" />
                      <span>{person.user.email}</span>
                      <span class="text-neutral-400">({person.user.role})</span>
                    </span>
                    <%= if !person.user.active do %>
                      <span class="text-[10px] text-red-500 font-normal">(inactive)</span>
                    <% end %>
                  </div>
                <% else %>
                  <span class="text-xs font-light text-neutral-400">
                    No login account
                  </span>
                <% end %>
              </div>

              <div class="flex items-center gap-2 justify-end">
                <%= if person.user && person.user.active && @current_scope.user && @current_scope.user.role == :admin && person.user.id != @current_scope.user.id do %>
                  <.link
                    href={~p"/admin/masquerade/#{person.user.id}"}
                    method="post"
                    title={"Masquerade as #{person.user.email}"}
                    id={"masquerade-person-user-#{person.id}"}
                    class="text-neutral-400 hover:text-amber-600 transition-colors p-1"
                  >
                    <.icon name="hero-identification" class="w-4 h-4" />
                  </.link>
                <% end %>
                <.link
                  navigate={~p"/ownership/people/#{person.id}"}
                  class="text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors p-1"
                  title="View in Ownership"
                >
                  <.icon name="hero-eye" class="w-4 h-4" />
                </.link>
                <.link
                  navigate={~p"/admin/people/#{person.id}/edit"}
                  class="text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors p-1"
                  title="Edit person"
                >
                  <.icon name="hero-pencil-square" class="w-4 h-4" />
                </.link>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% else %>
      <%!-- Breadcrumb for New / Edit --%>
      <nav class="text-xs font-light text-neutral-400 mb-6 flex items-center gap-2">
        <.link navigate={~p"/admin/people"} class="hover:text-neutral-600 transition-colors">
          <.icon name="hero-arrow-left" class="w-3 h-3 inline" /> People
        </.link>
        <%= if @live_action == :edit && @person do %>
          <%= if @person.organization do %>
            <%= if @person.organization.brand do %>
              <.icon name="hero-chevron-right" class="w-3 h-3" />
              <.link
                navigate={~p"/ownership/brands/#{@person.organization.brand.id}"}
                class="hover:text-neutral-600 transition-colors"
              >
                {@person.organization.brand.display_name || @person.organization.brand.name}
              </.link>
            <% end %>
            <.icon name="hero-chevron-right" class="w-3 h-3" />
            <.link
              navigate={~p"/ownership/organizations/#{@person.organization.id}"}
              class="hover:text-neutral-600 transition-colors"
            >
              {@person.organization.display_name || @person.organization.name}
            </.link>
          <% end %>
          <.icon name="hero-chevron-right" class="w-3 h-3" />
          <span class="text-neutral-600">{@person.first_name} {@person.last_name}</span>
        <% end %>
      </nav>

      <div class="border border-neutral-200 dark:border-neutral-700 p-6">
        <div class="flex items-center justify-between mb-4">
          <h1 class="text-xl font-light tracking-tight">
            {if @live_action == :edit, do: "Edit Person", else: "New Person"}
          </h1>
          <%= if @live_action == :edit do %>
            <.link
              navigate={~p"/ownership/people/#{@person.id}"}
              class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors flex items-center gap-1"
            >
              View in Ownership <.icon name="hero-arrow-right" class="w-3 h-3" />
            </.link>
          <% end %>
        </div>

        <%= if @form do %>
          <.form
            for={@form}
            phx-change="validate"
            phx-submit="save"
            id="person-form"
            class="space-y-4 max-w-md"
          >
            <.input field={@form[:first_name]} type="text" label="First name" />
            <.input field={@form[:last_name]} type="text" label="Last name" />
            <.input
              field={@form[:title]}
              type="text"
              label="Title"
              placeholder="e.g. Senior DevOps Engineer"
            />
            <.input field={@form[:email]} type="email" label="Email" />
            <.input field={@form[:phone]} type="text" label="Phone" />
            <.input field={@form[:mobile]} type="text" label="Mobile" />
            <.input
              field={@form[:default_role]}
              type="select"
              label="Default role"
              options={[
                {"None", ""},
                {"Developer", "developer"},
                {"DevOps", "devops"},
                {"QA", "qa"},
                {"Security", "security"},
                {"Architect / Tech Lead", "architect"},
                {"Design / UX", "design"},
                {"Technician", "technician"},
                {"Manager", "manager"},
                {"Owner", "owner"}
              ]}
            />
            <.input
              field={@form[:organization_id]}
              type="select"
              label="Organization"
              options={Enum.map(@orgs, &{&1.name, &1.id})}
              prompt="None"
            />
            <.input
              field={@form[:user_id]}
              type="select"
              label="Linked System User Account"
              options={
                Enum.map(@users, &{"#{&1.name || &1.email} (#{&1.email} — #{&1.role})", &1.id})
              }
              prompt="None (External stakeholder / No login account)"
            />
            <p class="text-[11px] text-neutral-400 -mt-2">
              Linking a system account connects this person's organizational governance roles with login access and scoped permissions.
            </p>
            <.input field={@form[:notes]} type="textarea" label="Notes" />

            <div class="flex items-center gap-3 pt-4">
              <button type="submit" class="btn-line-filled text-xs">Save</button>
              <.link
                navigate={
                  if @live_action == :edit && @person,
                    do: ~p"/admin/people",
                    else: ~p"/admin/people"
                }
                class="btn-line text-xs"
              >
                Cancel
              </.link>
            </div>
          </.form>
        <% end %>

        <%!-- Contextual panel for edit --%>
        <%= if @live_action == :edit && @stats do %>
          <div class="mt-8 pt-6 border-t border-neutral-100 dark:border-neutral-800">
            <h3 class="text-xs font-normal uppercase tracking-widest text-neutral-500 mb-4">
              Related
            </h3>
            <div class="grid grid-cols-2 gap-4 text-center">
              <.link
                navigate={~p"/ownership/people/#{@person.id}"}
                class="border border-neutral-200 dark:border-neutral-700 p-4 hover:border-neutral-400 transition-colors"
              >
                <div class="text-xl font-light text-neutral-900 dark:text-neutral-100">
                  {@stats.roles_count}
                </div>
                <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                  Project Roles
                </div>
              </.link>
              <%= if @person.organization do %>
                <.link
                  navigate={~p"/ownership/organizations/#{@person.organization.id}"}
                  class="border border-neutral-200 dark:border-neutral-700 p-4 hover:border-neutral-400 transition-colors"
                >
                  <div class="text-xl font-light text-neutral-900 dark:text-neutral-100">—</div>
                  <div class="text-[9px] uppercase tracking-tighter text-neutral-400 mt-1">
                    {@person.organization.name}
                  </div>
                </.link>
              <% end %>
            </div>
            <div class="flex items-center justify-between mt-4">
              <%= if @person.organization do %>
                <.link
                  href={~p"/admin/people/new"}
                  class="text-xs font-normal text-neutral-500 hover:text-neutral-900 transition-colors"
                >
                  + Add Another Person
                </.link>
              <% end %>
              <button
                phx-click="delete"
                data-confirm="Delete this person and all their project role assignments?"
                class="text-xs font-normal text-red-500 hover:text-red-700 transition-colors"
              >
                Delete Person
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</Layouts.app>
