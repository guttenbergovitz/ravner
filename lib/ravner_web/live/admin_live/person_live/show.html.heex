<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-6xl mx-auto px-6 py-8">
    <div class="flex items-center gap-4 mb-8">
      <.link
        patch={~p"/admin/people"}
        class="text-neutral-400 hover:text-neutral-600 transition-colors"
      >
        <.icon name="hero-arrow-left" class="w-4 h-4" />
      </.link>
      <h1 class="text-2xl font-light tracking-tight">{@person.first_name} {@person.last_name}</h1>
    </div>

    <div class="border border-neutral-200 p-6 mb-8">
      <h2 class="text-lg font-light tracking-tight mb-4">Details</h2>
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Title</dt>
          <dd class="font-light">{@person.title || "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Email</dt>
          <dd class="font-light">{@person.email || "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Phone</dt>
          <dd class="font-light">{@person.phone || "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Mobile</dt>
          <dd class="font-light">{@person.mobile || "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Default role</dt>
          <dd class="font-light">{@person.default_role || "—"}</dd>
        </div>
        <div>
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Organization</dt>
          <dd class="font-light">{(@person.organization && @person.organization.name) || "—"}</dd>
        </div>
      </dl>
      <%= if @person.notes do %>
        <div class="mt-4 pt-4 border-t border-neutral-100">
          <dt class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Notes</dt>
          <dd class="text-sm font-light">{@person.notes}</dd>
        </div>
      <% end %>
    </div>

    <div class="border border-neutral-200 p-6">
      <h2 class="text-lg font-light tracking-tight mb-4">Project roles</h2>
      <%= if @roles == [] do %>
        <p class="text-sm font-light text-neutral-500">No project roles assigned.</p>
      <% else %>
        <div class="space-y-2">
          <%= for r <- @roles do %>
            <div class="flex items-center gap-3 text-sm border border-neutral-100 px-4 py-3">
              <span class="text-xs px-2 py-0.5 border border-neutral-200">{r.role}</span>
              <span>{r.project.display_name || r.project.name}</span>
              <%= if r.notes do %>
                <span class="text-neutral-400 text-xs">— {r.notes}</span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</Layouts.app>
