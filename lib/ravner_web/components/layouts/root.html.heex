<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="ravner">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script>
      (function(){
        var t = localStorage.getItem("theme");
        if (t === "dark" || (!t && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body class="h-full flex flex-col">
    <%= if assigns[:masquerading?] && assigns[:current_scope] && @current_scope.user do %>
      <aside
        id="masquerade-banner"
        class="sticky top-0 z-50 bg-amber-500 text-neutral-950 px-4 sm:px-6 py-2 border-b border-amber-600 flex items-center justify-between text-xs sm:text-sm shadow-md"
        role="status"
        aria-label="Masquerade Mode Active"
      >
        <div class="flex items-center gap-2.5">
          <span class="p-1 rounded bg-neutral-950/10 text-neutral-950">
            <.icon name="hero-eye" class="w-4 h-4 shrink-0" />
          </span>
          <div class="leading-tight">
            <span>
              Masquerading as
              <strong class="font-bold underline decoration-neutral-950/30">
                {@current_scope.user.email}
              </strong>
            </span>
            <%= if @current_scope.user.role do %>
              <span class="inline-block px-1.5 py-0.5 rounded text-[10px] uppercase font-mono font-semibold bg-neutral-950 text-amber-300 ml-1.5">
                {@current_scope.user.role}
              </span>
            <% end %>
            <%= if assigns[:masquerading_admin_email] do %>
              <span class="text-neutral-800 text-xs hidden md:inline ml-1 opacity-80">
                (Logged in as {@masquerading_admin_email})
              </span>
            <% end %>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <.link
            href={~p"/admin/unmasquerade"}
            method="post"
            id="btn-switch-back-to-admin"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-neutral-950 text-white text-xs font-semibold hover:bg-neutral-800 active:scale-95 transition-all shadow-sm cursor-pointer whitespace-nowrap"
          >
            <.icon name="hero-arrow-uturn-left" class="w-3.5 h-3.5" />
            <span>Switch back to Admin</span>
          </.link>
        </div>
      </aside>
    <% end %>
    <header class="border-b border-neutral-200 dark:border-neutral-700 dark:bg-neutral-900">
      <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-10">
          <.link href={~p"/"} class="text-lg font-light tracking-[0.2em] uppercase shrink-0">
            ravner
          </.link>

          <%= if @current_scope do %>
            <ul class="flex items-center gap-6 text-sm font-light tracking-wide">
              <li>
                <.link
                  href={~p"/dashboard"}
                  class={[
                    "hover:text-neutral-500 transition-colors",
                    (@conn.request_path == "/dashboard" &&
                       "text-neutral-900 dark:text-neutral-100 font-normal") ||
                      "text-neutral-600 dark:text-neutral-400"
                  ]}
                >
                  Dashboard
                </.link>
              </li>

              <%!-- Assets & Inventory dropdown --%>
              <li class="relative" id="inventory-dropdown" phx-hook=".Dropdown">
                <button
                  type="button"
                  class={[
                    "hover:text-neutral-500 transition-colors cursor-pointer flex items-center gap-1",
                    ((String.starts_with?(@conn.request_path, "/domains") ||
                        String.starts_with?(@conn.request_path, "/admin/repositories") ||
                        String.starts_with?(@conn.request_path, "/ownership/applications")) &&
                       "text-neutral-900 dark:text-neutral-100 font-normal") ||
                      "text-neutral-600 dark:text-neutral-400"
                  ]}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="inventory-dropdown-menu"
                >
                  Inventory <.icon name="hero-chevron-down" class="w-3 h-3" />
                </button>
                <div
                  id="inventory-dropdown-menu"
                  class="absolute top-full left-0 mt-1 w-48 border border-neutral-200 bg-white opacity-0 invisible transition-all duration-150 z-50 dark:border-neutral-700 dark:bg-neutral-800 shadow-md"
                  role="menu"
                >
                  <.link
                    href={~p"/domains"}
                    role="menuitem"
                    tabindex="-1"
                    class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                  >
                    <.icon name="hero-globe-alt" class="w-3.5 h-3.5 inline mr-1 text-neutral-400" />
                    Domains
                  </.link>
                  <.link
                    href={~p"/ownership/landscape"}
                    role="menuitem"
                    tabindex="-1"
                    class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                  >
                    <.icon
                      name="hero-cube-transparent"
                      class="w-3.5 h-3.5 inline mr-1 text-neutral-400"
                    /> Applications
                  </.link>
                  <%= if @current_scope.user.role in [:admin, :editor] do %>
                    <.link
                      href={~p"/admin/repositories"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors dark:hover:bg-neutral-700"
                    >
                      <.icon
                        name="hero-code-bracket"
                        class="w-3.5 h-3.5 inline mr-1 text-neutral-400"
                      /> Repositories
                    </.link>
                  <% end %>
                </div>
              </li>

              <%!-- Governance & Architecture dropdown --%>
              <li class="relative" id="governance-dropdown" phx-hook=".Dropdown">
                <button
                  type="button"
                  class={[
                    "hover:text-neutral-500 transition-colors cursor-pointer flex items-center gap-1",
                    (String.starts_with?(@conn.request_path, "/ownership") &&
                       not String.starts_with?(@conn.request_path, "/ownership/applications") &&
                       "text-neutral-900 dark:text-neutral-100 font-normal") ||
                      "text-neutral-600 dark:text-neutral-400"
                  ]}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="governance-dropdown-menu"
                >
                  Governance <.icon name="hero-chevron-down" class="w-3 h-3" />
                </button>
                <div
                  id="governance-dropdown-menu"
                  class="absolute top-full left-0 mt-1 w-52 border border-neutral-200 bg-white opacity-0 invisible transition-all duration-150 z-50 dark:border-neutral-700 dark:bg-neutral-800 shadow-md"
                  role="menu"
                >
                  <.link
                    href={~p"/ownership/landscape"}
                    role="menuitem"
                    tabindex="-1"
                    class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                  >
                    <.icon
                      name="hero-squares-plus"
                      class="w-3.5 h-3.5 inline mr-1 text-neutral-400"
                    /> Digital Landscape (BDAT)
                  </.link>
                  <.link
                    href={~p"/ownership"}
                    role="menuitem"
                    tabindex="-1"
                    class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                  >
                    <.icon
                      name="hero-building-office"
                      class="w-3.5 h-3.5 inline mr-1 text-neutral-400"
                    /> Brands & Organizations
                  </.link>
                  <.link
                    href={~p"/ownership/delivery"}
                    role="menuitem"
                    tabindex="-1"
                    class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors dark:hover:bg-neutral-700"
                  >
                    <.icon name="hero-briefcase" class="w-3.5 h-3.5 inline mr-1 text-neutral-400" />
                    Delivery Hierarchy & Projects
                  </.link>
                </div>
              </li>

              <li>
                <.link
                  href={~p"/uptime"}
                  class={[
                    "hover:text-neutral-500 transition-colors",
                    (String.starts_with?(@conn.request_path, "/uptime") &&
                       "text-neutral-900 dark:text-neutral-100 font-normal") ||
                      "text-neutral-600 dark:text-neutral-400"
                  ]}
                >
                  Uptime
                </.link>
              </li>

              <%= if @current_scope.user.role == :admin do %>
                <li class="relative" id="admin-dropdown" phx-hook=".Dropdown">
                  <button
                    type="button"
                    class="hover:text-neutral-500 transition-colors cursor-pointer flex items-center gap-1"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="admin-dropdown-menu"
                  >
                    Admin <.icon name="hero-chevron-down" class="w-3 h-3" />
                  </button>
                  <div
                    id="admin-dropdown-menu"
                    class="absolute top-full left-0 mt-1 w-48 border border-neutral-200 bg-white opacity-0 invisible transition-all duration-150 z-50 dark:border-neutral-700 dark:bg-neutral-800 shadow-md"
                    role="menu"
                  >
                    <.link
                      href={~p"/admin/breach-findings"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Breach Findings
                    </.link>
                    <.link
                      href={~p"/admin/certificates"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      SSL Certificates
                    </.link>
                    <.link
                      href={~p"/admin/domain-registrations"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Domain Registrations
                    </.link>
                    <.link
                      href={~p"/admin/repositories"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Repositories
                    </.link>
                    <.link
                      href={~p"/admin/users"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Users
                    </.link>
                    <.link
                      href={~p"/admin/people"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      People (Governance)
                    </.link>
                    <.link
                      href={~p"/admin/invites"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Invites
                    </.link>
                    <.link
                      href={~p"/admin/users#masquerade"}
                      role="menuitem"
                      tabindex="-1"
                      class="flex items-center justify-between px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700 text-amber-600 dark:text-amber-400 font-medium"
                    >
                      <span class="flex items-center gap-1.5">
                        <.icon name="hero-identification" class="w-3.5 h-3.5" /> Masquerade...
                      </span>
                      <span class="text-[10px] uppercase font-mono px-1 py-0.5 rounded bg-amber-100 dark:bg-amber-900/50 text-amber-700 dark:text-amber-300">
                        Switch
                      </span>
                    </.link>
                    <.link
                      href={~p"/admin/jobs"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Jobs
                    </.link>
                    <.link
                      href={~p"/admin/telemetry"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      Telemetry & OTel
                    </.link>
                    <.link
                      href={~p"/api/swagger-ui"}
                      target="_blank"
                      role="menuitem"
                      tabindex="-1"
                      class="flex items-center justify-between px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700 text-blue-600 dark:text-blue-400 font-medium"
                    >
                      <span class="flex items-center gap-1.5">
                        <.icon name="hero-code-bracket-square" class="w-3.5 h-3.5" />
                        REST API (Swagger)
                      </span>
                      <span class="text-[9px] uppercase font-mono px-1 py-0.5 rounded bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300">
                        OpenAPI
                      </span>
                    </.link>
                    <.link
                      href={~p"/admin/api-tokens"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors border-b border-neutral-100 dark:hover:bg-neutral-700 dark:border-neutral-700"
                    >
                      <.icon name="hero-key" class="w-3.5 h-3.5 inline mr-1 text-neutral-400" />
                      API Tokens
                    </.link>
                    <.link
                      href={~p"/admin/settings"}
                      role="menuitem"
                      tabindex="-1"
                      class="block px-4 py-2 text-xs hover:bg-neutral-50 transition-colors dark:hover:bg-neutral-700"
                    >
                      Settings
                    </.link>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>

        <div class="flex items-center gap-5 text-sm font-light tracking-wide">
          <button
            id="theme-toggle"
            phx-hook=".ThemeToggle"
            type="button"
            class="text-neutral-400 hover:text-neutral-700 dark:hover:text-neutral-200 transition-colors"
            title="Toggle theme"
            aria-label="Toggle dark mode"
          >
            <.icon name="hero-moon" class="w-4 h-4 block dark:hidden" />
            <.icon name="hero-sun" class="w-4 h-4 hidden dark:block" />
          </button>
          <%= if @current_scope do %>
            <.link
              href={~p"/users/settings"}
              class="flex items-center gap-1.5 text-neutral-400 hover:text-neutral-700 transition-colors"
              title="Account settings"
            >
              <.icon name="hero-user-circle" class="w-4 h-4" />
              <span class="hidden sm:inline">Account</span>
            </.link>
            <.link
              href={~p"/users/log-out"}
              method="delete"
              class="flex items-center gap-2 text-neutral-400 hover:text-neutral-700 transition-colors"
              title={"Log out #{@current_scope.user.email}"}
            >
              <.icon name="hero-arrow-right-on-rectangle" class="w-4 h-4" />
            </.link>
          <% else %>
            <.link href={~p"/users/log-in"} class="btn-line text-xs">
              Log in
            </.link>
          <% end %>
        </div>
      </nav>
    </header>

    <main class="flex-1 pb-8">
      {@inner_content}
    </main>

    <%= if assigns[:current_scope] do %>
      {live_render(@conn, RavnerWeb.ActivityDrawerLive,
        id: "activity-drawer",
        session: %{"user_id" => @current_scope.user.id},
        sticky: true
      )}
    <% end %>

    <footer class="bg-neutral-900 text-white dark:bg-neutral-950">
      <div class="max-w-6xl mx-auto px-6 py-8 flex items-center justify-between text-xs font-light text-neutral-500 tracking-wide">
        <span class="tracking-[0.2em] uppercase text-neutral-400">ravner</span>
        <span>v{Application.spec(:ravner, :vsn)}</span>
      </div>
    </footer>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".ThemeToggle">
      export default {
        mounted() {
          this.el.addEventListener("click", () => {
            const html = document.documentElement;
            const isDark = html.classList.toggle("dark");
            localStorage.setItem("theme", isDark ? "dark" : "light");
          });
        }
      }
    </script>

    <script :type={Phoenix.LiveView.ColocatedHook} name=".Dropdown">
      export default {
        mounted() {
          const btn = this.el.querySelector("button");
          const menu = this.el.querySelector("[role=menu]");
          const items = () => menu.querySelectorAll("[role=menuitem]");

          const open = () => {
            menu.classList.remove("opacity-0", "invisible");
            menu.classList.add("opacity-100", "visible");
            btn.setAttribute("aria-expanded", "true");
          };

          const close = () => {
            menu.classList.add("opacity-0", "invisible");
            menu.classList.remove("opacity-100", "visible");
            btn.setAttribute("aria-expanded", "false");
          };

          btn.addEventListener("click", () => {
            btn.getAttribute("aria-expanded") === "true" ? close() : open();
          });

          btn.addEventListener("keydown", (e) => {
            if (e.key === "ArrowDown" || e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              open();
              items()[0]?.focus();
            }
          });

          menu.addEventListener("keydown", (e) => {
            const all = [...items()];
            const idx = all.indexOf(e.target);
            if (e.key === "Escape") { close(); btn.focus(); }
            else if (e.key === "ArrowDown") { e.preventDefault(); (all[idx + 1] || all[0]).focus(); }
            else if (e.key === "ArrowUp") { e.preventDefault(); idx > 0 ? all[idx - 1].focus() : btn.focus(); }
            else if (e.key === "Home") { e.preventDefault(); all[0]?.focus(); }
            else if (e.key === "End") { e.preventDefault(); all[all.length - 1]?.focus(); }
          });

          this.el.addEventListener("focusout", (e) => {
            requestAnimationFrame(() => {
              if (!this.el.contains(document.activeElement)) close();
            });
          });

          document.addEventListener("click", (e) => {
            if (!this.el.contains(e.target)) close();
          });
        }
      }
    </script>
  </body>
</html>
