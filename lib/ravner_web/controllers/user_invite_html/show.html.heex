<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-md mx-auto px-6 py-16">
    <div class="mb-8 text-center">
      <h1 class="text-3xl font-thin tracking-tight mb-2">Accept Invite</h1>
      <p class="text-sm font-light text-neutral-500">
        You've been invited to join as <strong>{Ravner.Accounts.User.role_label(@invite.role)}</strong>.
        Set a secure password to activate your account.
      </p>
      <%= if @invite.name do %>
        <p class="text-sm font-light text-neutral-700 dark:text-neutral-300 mt-2">
          Welcome, {@invite.name}!
        </p>
      <% end %>
    </div>

    <div class="border border-neutral-200 dark:border-neutral-700 p-8 shadow-sm">
      <div class="mb-6 p-3 border border-neutral-200 dark:border-neutral-700 text-center">
        <span class="text-xs uppercase tracking-wider text-neutral-400 font-mono block mb-1">
          Account Email
        </span>
        <span class="text-sm font-light">{@invite.email}</span>
      </div>

      <form action={~p"/users/invite/#{@token}"} method="post" class="space-y-6">
        <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

        <div>
          <label class="block text-xs font-light tracking-wide uppercase text-neutral-500 mb-2">
            Password
          </label>
          <input
            type="password"
            name="user[password]"
            id="user-password"
            required
            minlength="12"
            placeholder="At least 12 characters"
            class="w-full px-0 py-2.5 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 dark:text-neutral-100 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 dark:focus:border-neutral-100 transition-colors text-sm"
          />
        </div>

        <button
          type="submit"
          class="w-full btn-line-filled justify-center py-2.5 text-xs uppercase tracking-wider"
        >
          Create Account
        </button>
      </form>
    </div>

    <p class="mt-6 text-center text-xs font-light text-neutral-400">
      Already have an account?
      <.link
        navigate={~p"/users/log-in"}
        class="underline hover:text-neutral-600 transition-colors"
      >
        Log in
      </.link>
    </p>
  </div>
</Layouts.app>
