<Layouts.root flash={@flash}>
  <div class="min-h-screen flex items-center justify-center bg-zinc-50 px-4">
    <div class="w-full max-w-sm">
      <div class="mb-8 text-center">
        <h1 class="text-2xl font-semibold text-zinc-900">Accept Invite</h1>
        <p class="text-sm text-zinc-500 mt-2">
          You've been invited to join as <strong>{@invite.role}</strong>.
          Set a password to activate your account.
        </p>
        <%= if @invite.name do %>
          <p class="text-sm text-zinc-600 mt-1">Welcome, {@invite.name}!</p>
        <% end %>
      </div>

      <div class="bg-white border border-zinc-200 rounded-2xl p-6 shadow-sm">
        <div class="mb-4 p-3 bg-zinc-50 rounded-lg">
          <p class="text-sm text-zinc-500 text-center">{@invite.email}</p>
        </div>

        <form action={~p"/users/invite/#{@token}"} method="post" class="space-y-4">
          <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />

          <div>
            <label class="block text-sm font-medium text-zinc-700 mb-1">Password</label>
            <input
              type="password"
              name="user[password]"
              id="user-password"
              required
              minlength="12"
              placeholder="At least 12 characters"
              class="w-full px-3 py-2 border border-zinc-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-zinc-400"
            />
          </div>

          <button
            type="submit"
            class="w-full py-2 px-4 text-sm font-medium text-white bg-zinc-900 rounded-lg hover:bg-zinc-700 transition-colors"
          >
            Create Account
          </button>
        </form>
      </div>

      <p class="mt-4 text-center text-xs text-zinc-400">
        Already have an account?
        <.link navigate={~p"/users/log-in"} class="text-zinc-600 hover:underline">Log in</.link>
      </p>
    </div>
  </div>
</Layouts.root>
