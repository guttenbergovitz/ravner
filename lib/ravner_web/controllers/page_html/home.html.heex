<Layouts.flash_group flash={@flash} />

<div class="max-w-6xl mx-auto px-6 py-24">
  <div class="max-w-2xl">
    <h1 class="text-5xl font-thin tracking-tight leading-tight text-neutral-900">
      Ecosystem <br />
      <span class="font-normal">visibility</span>
    </h1>

    <p class="mt-8 text-lg font-light text-neutral-500 leading-relaxed max-w-lg">
      Map your domain landscape. Track infrastructure, ownership, and lifecycle
      from a single, minimal dashboard.
    </p>

    <div class="mt-12 flex items-center gap-6">
      <.link href={~p"/users/register"} class="btn-line-filled">
        Get started <.icon name="hero-arrow-right" class="w-4 h-4" />
      </.link>
      <.link
        href={~p"/users/log-in"}
        class="text-sm font-light tracking-wide text-neutral-500 hover:text-neutral-900 transition-colors"
      >
        Already have an account?
      </.link>
    </div>
  </div>
</div>

<div class="border-t border-neutral-200">
  <div class="max-w-6xl mx-auto px-6 py-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <div class="card-line">
        <.icon name="hero-globe-alt" class="w-6 h-6 text-neutral-400 mb-6" />
        <h3 class="text-sm font-normal tracking-wide uppercase mb-3">Domains</h3>
        <p class="text-sm font-light text-neutral-500 leading-relaxed">
          Central inventory of all domains, subdomains, and services. Parent-child
          relationships, tags, and lifecycle tracking.
        </p>
      </div>

      <div class="card-line">
        <.icon name="hero-signal" class="w-6 h-6 text-neutral-400 mb-6" />
        <h3 class="text-sm font-normal tracking-wide uppercase mb-3">Metadata</h3>
        <p class="text-sm font-light text-neutral-500 leading-relaxed">
          HTTP, DNS, SSL, WHOIS, and infrastructure snapshots. Always current,
          always visible.
        </p>
      </div>

      <div class="card-line">
        <.icon name="hero-user-group" class="w-6 h-6 text-neutral-400 mb-6" />
        <h3 class="text-sm font-normal tracking-wide uppercase mb-3">Ownership</h3>
        <p class="text-sm font-light text-neutral-500 leading-relaxed">
          Clear assignment of PM, PO, and delivery organization. No orphaned assets.
        </p>
      </div>
    </div>
  </div>
</div>
