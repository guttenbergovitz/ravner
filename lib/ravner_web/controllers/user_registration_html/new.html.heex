<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-md mx-auto px-6 py-20">
    <h1 class="text-3xl font-thin tracking-tight mb-3">Register</h1>
    <p class="text-sm font-light text-neutral-500 mb-12">
      Already registered?
      <.link
        navigate={~p"/users/log-in"}
        class="text-neutral-900 underline underline-offset-4 hover:text-neutral-600"
      >
        Log in
      </.link>
    </p>

    <div class="border border-neutral-200 px-8 py-6">
      <.form :let={f} for={@changeset} action={~p"/users/register"} class="space-y-5">
        <div>
          <label class="block text-xs font-light tracking-wide uppercase text-neutral-500 mb-2">
            Email
          </label>
          <input
            type="email"
            name={f[:email].name}
            id={f[:email].id}
            value={f[:email].value}
            class="w-full px-0 py-2.5 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm"
            placeholder="you@company.com"
            autocomplete="username"
            spellcheck="false"
            required
            phx-mounted={JS.focus()}
          />
          <RavnerWeb.CoreComponents.error :for={msg <- f[:email].errors}>{translate_error(msg)}</RavnerWeb.CoreComponents.error>
        </div>
        <button
          type="submit"
          phx-disable-with="Creating account..."
          class="w-full px-5 py-2.5 border border-neutral-900 bg-neutral-900 text-white text-sm font-light tracking-wide uppercase transition-all duration-200 hover:bg-neutral-700 hover:border-neutral-700 cursor-pointer"
        >
          Create account
        </button>
      </.form>
    </div>
  </div>
</Layouts.app>
