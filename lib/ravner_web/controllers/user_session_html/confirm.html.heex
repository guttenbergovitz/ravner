<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-md mx-auto px-6 py-20">
    <h1 class="text-3xl font-thin tracking-tight mb-3">Welcome</h1>
    <p class="text-sm font-light text-neutral-500 mb-12">{@user.email}</p>

    <div class="border border-neutral-200 px-8 py-6">
      <.form
        :if={!@user.confirmed_at}
        for={@form}
        id="confirmation_form"
        action={~p"/users/log-in?_action=confirmed"}
        phx-mounted={JS.focus_first()}
        class="space-y-3"
      >
        <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
        <button
          type="submit"
          name={@form[:remember_me].name}
          value="true"
          phx-disable-with="Confirming..."
          class="w-full px-5 py-2.5 border border-neutral-900 bg-neutral-900 text-white text-sm font-light tracking-wide uppercase transition-all duration-200 hover:bg-neutral-700 hover:border-neutral-700 cursor-pointer"
        >
          Confirm and stay logged in
        </button>
        <button
          type="submit"
          phx-disable-with="Confirming..."
          class="w-full px-5 py-2.5 border border-neutral-900 text-sm font-light tracking-wide uppercase transition-all duration-200 bg-transparent hover:bg-neutral-900 hover:text-white cursor-pointer"
        >
          Confirm and log in only this time
        </button>
      </.form>

      <.form
        :if={@user.confirmed_at}
        for={@form}
        id="login_form"
        action={~p"/users/log-in"}
        phx-mounted={JS.focus_first()}
        class="space-y-3"
      >
        <input type="hidden" name={@form[:token].name} value={@form[:token].value} />
        <%= if @current_scope do %>
          <button
            type="submit"
            phx-disable-with="Logging in..."
            class="w-full px-5 py-2.5 border border-neutral-900 bg-neutral-900 text-white text-sm font-light tracking-wide uppercase transition-all duration-200 hover:bg-neutral-700 hover:border-neutral-700 cursor-pointer"
          >
            Log in
          </button>
        <% else %>
          <button
            type="submit"
            name={@form[:remember_me].name}
            value="true"
            phx-disable-with="Logging in..."
            class="w-full px-5 py-2.5 border border-neutral-900 bg-neutral-900 text-white text-sm font-light tracking-wide uppercase transition-all duration-200 hover:bg-neutral-700 hover:border-neutral-700 cursor-pointer"
          >
            Keep me logged in on this device
          </button>
          <button
            type="submit"
            phx-disable-with="Logging in..."
            class="w-full px-5 py-2.5 border border-neutral-900 text-sm font-light tracking-wide uppercase transition-all duration-200 bg-transparent hover:bg-neutral-900 hover:text-white cursor-pointer"
          >
            Log me in only this time
          </button>
        <% end %>
      </.form>

      <p :if={!@user.confirmed_at} class="mt-6 text-xs font-light text-neutral-400">
        Tip: If you prefer passwords, you can enable them in the user settings.
      </p>
    </div>
  </div>
</Layouts.app>
