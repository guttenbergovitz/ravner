<Layouts.app flash={@flash} current_scope={@current_scope}>
  <div class="max-w-md mx-auto px-6 py-20">
    <h1 class="text-3xl font-thin tracking-tight mb-3">Log in</h1>
    <p :if={@current_scope} class="text-sm font-light text-neutral-500 mb-12">
      You need to reauthenticate to perform sensitive actions.
    </p>
    <div :if={!@current_scope} class="mb-12"></div>

    <div
      :if={local_mail_adapter?()}
      class="mb-8 px-5 py-3 border border-neutral-200 text-xs font-light text-neutral-500"
    >
      <p>Running local mail adapter.</p>
      <p>Visit <.link href="/dev/mailbox" class="underline">the mailbox</.link> to see emails.</p>
    </div>

    <div class="border border-neutral-200 divide-y divide-neutral-200">
      <div class="px-8 py-6">
        <.form
          :let={f}
          for={@form}
          as={:user}
          id="login_form_magic"
          action={~p"/users/log-in"}
          class="space-y-5"
        >
          <div>
            <label class="block text-xs font-light tracking-wide uppercase text-neutral-500 mb-2">
              Email
            </label>
            <input
              type="email"
              name={f[:email].name}
              id={f[:email].id}
              value={f[:email].value}
              class="w-full px-0 py-2.5 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm"
              placeholder="you@company.com"
              autocomplete="username"
              spellcheck="false"
              required
              phx-mounted={JS.focus()}
            />
          </div>
          <button
            type="submit"
            class="w-full px-6 py-3 border border-neutral-900 bg-neutral-900 text-white text-sm font-light tracking-wide uppercase transition-all duration-200 hover:bg-neutral-700 hover:border-neutral-700 cursor-pointer"
          >
            Log in with email
          </button>
        </.form>
      </div>

      <div class="px-8 py-6">
        <.form
          :let={f}
          for={@form}
          as={:user}
          id="login_form_password"
          action={~p"/users/log-in"}
          class="space-y-5"
        >
          <div>
            <label class="block text-xs font-light tracking-wide uppercase text-neutral-500 mb-2">
              Email
            </label>
            <input
              type="email"
              name={f[:email].name}
              id={f[:email].id}
              value={f[:email].value}
              class="w-full px-0 py-2.5 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm"
              placeholder="you@company.com"
              autocomplete="username"
              spellcheck="false"
              required
            />
          </div>
          <div>
            <label class="block text-xs font-light tracking-wide uppercase text-neutral-500 mb-2">
              Password
            </label>
            <input
              type="password"
              name={f[:password].name}
              id={f[:password].id}
              class="w-full px-0 py-2.5 border-0 border-b border-neutral-300 bg-transparent text-neutral-900 placeholder-neutral-400 focus:outline-none focus:border-neutral-900 transition-colors text-sm"
              placeholder="••••••••"
              autocomplete="current-password"
              spellcheck="false"
            />
          </div>
          <div class="flex gap-3 pt-1">
            <button
              type="submit"
              name={@form[:remember_me].name}
              value="true"
              class="flex-1 px-5 py-2.5 border border-neutral-900 bg-neutral-900 text-white text-sm font-light tracking-wide uppercase transition-all duration-200 hover:bg-neutral-700 hover:border-neutral-700 cursor-pointer"
            >
              Stay logged in
            </button>
            <button
              type="submit"
              class="flex-1 px-5 py-2.5 border border-neutral-900 text-sm font-light tracking-wide uppercase transition-all duration-200 bg-transparent hover:bg-neutral-900 hover:text-white cursor-pointer"
            >
              This time only
            </button>
          </div>
        </.form>
      </div>
    </div>
  </div>
</Layouts.app>
